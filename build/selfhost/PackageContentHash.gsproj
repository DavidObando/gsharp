<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Adr0198.PackageContentHash</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PackageContentHash.gs" />
    <Reference Include="NuGet.Common" HintPath="$(MSBuildToolsPath)/NuGet.Common.dll" />
    <Reference Include="NuGet.Frameworks" HintPath="$(MSBuildToolsPath)/NuGet.Frameworks.dll" />
    <Reference Include="NuGet.Packaging" HintPath="$(MSBuildToolsPath)/NuGet.Packaging.dll" />
    <Reference Include="NuGet.Versioning" HintPath="$(MSBuildToolsPath)/NuGet.Versioning.dll" />
  </ItemGroup>
</Project>
