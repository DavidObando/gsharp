<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Gsharp.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IlVerifyDiagnostics</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.gs" />
    <Compile Include="..\..\test\Compiler.Tests\IlInstructionReader.gs" />
    <Compile Include="..\..\test\Compiler.Tests\IlVerifyStaticInterfaceRule.gs" />
    <Compile Include="..\..\test\Compiler.Tests\IlVerifyFalsePositives.gs" />
    <Compile Include="..\..\test\Shared\IlVerifyFilterInFinallyRule.gs" />
  </ItemGroup>
</Project>
