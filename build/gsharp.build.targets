<Project>
  <Import Project="$(MSBuildThisFileDirectory)../src/Sdk/Gsharp.NET.Sdk/build/Gsharp.NET.SourceLink.targets"
          Condition="'$(_GsharpSourceLinkTargetsImported)' != 'true'" />

   <!-- Disable test targets for non-test projects -->
  <Import Project="$(MSBuildThisFileDirectory)notest.targets" Condition="'$(IsTestProject)' != 'true'" />

  <!-- The pinned SDK does not track compiler contents as a compilation input.
       Track tool closures before reusing repository outputs for SDK publication. -->
  <Target Name="_GsharpTrackRepositoryBuildTools"
          BeforeTargets="CoreCompile;_GsharpRunSourceGenerators"
          DependsOnTargets="ResolveReferences;_GsharpResolveAnalyzers"
          Condition="'$(Language)' == 'Gsharp' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_GsharpRepositoryBuildTool Include="$([System.IO.Path]::GetDirectoryName('$(GsharpCompilerFullPath)'))/**/*;
                                           $([System.IO.Path]::GetDirectoryName('$(GsgenToolFullPath)'))/**/*;
                                           $(GsharpToolFullPath);
                                           @(GsharpCodeAnalyzer);
                                           @(GsharpAnalyzer)" />
    </ItemGroup>
    <GetFileHash Files="@(_GsharpRepositoryBuildTool)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_GsharpRepositoryBuildToolHash" />
    </GetFileHash>
    <PropertyGroup>
      <_GsharpRepositoryBuildToolsCache>$(IntermediateOutputPath)repository-build-tools.cache</_GsharpRepositoryBuildToolsCache>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_GsharpRepositoryBuildToolsCache)"
                      Lines="COMPILER:$(GsharpCompilerFullPath);
                             GENERATOR:$(GsgenToolFullPath);
                             TASK:$(GsharpToolFullPath);
                             @(_GsharpRepositoryBuildToolHash->'%(FullPath)|%(FileHash)');
                             @(Compile->'SOURCE:%(FullPath)');
                             @(ReferencePathWithRefAssemblies->'REFERENCE:%(FullPath)');
                             @(GsharpCodeAnalyzer->'ANALYZER:%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <PropertyGroup>
      <MSBuildAllProjects>$(MSBuildAllProjects);$(_GsharpRepositoryBuildToolsCache)</MSBuildAllProjects>
    </PropertyGroup>
    <ItemGroup>
      <FileWrites Include="$(_GsharpRepositoryBuildToolsCache)" />
    </ItemGroup>
  </Target>

  <!-- Issue #4910: fail the build if an in-tree Gsharp.Runtime.* ProjectReference is paired with
       the pinned SDK package's _ExplicitReference for the same assembly (which silently shadows
       the in-tree build when assembly versions match). Projects that reference an in-tree runtime
       must set GsharpNoChannelsRuntime=true / GsharpNoValuesRuntime=true. -->
  <Target Name="_GsharpValidateInTreeRuntimeReferences"
          BeforeTargets="ResolveAssemblyReferences;CoreCompile"
          Condition="'$(Language)' == 'Gsharp' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_GsharpInTreeRuntimeProjectReference Include="@(ProjectReference)"
                                            Condition="'%(ProjectReference.ReferenceOutputAssembly)' != 'false' and ('%(Filename)' == 'Gsharp.Runtime.Channels' or '%(Filename)' == 'Gsharp.Runtime.Values')" />
      <_GsharpSdkRuntimeExplicitReference Include="@(_ExplicitReference)"
                                          Condition="'%(Filename)' == 'Gsharp.Runtime.Channels' or '%(Filename)' == 'Gsharp.Runtime.Values'" />
    </ItemGroup>
    <Error Condition="'@(_GsharpInTreeRuntimeProjectReference->WithMetadataValue('Filename', 'Gsharp.Runtime.Channels'))' != '' and '@(_GsharpSdkRuntimeExplicitReference->WithMetadataValue('Filename', 'Gsharp.Runtime.Channels'))' != ''"
           Text="Project '$(MSBuildProjectFile)' has an in-tree ProjectReference to Gsharp.Runtime.Channels and also receives the SDK's _ExplicitReference ('$(GsharpChannelsRuntimeAssemblyFullPath)'). Set &lt;GsharpNoChannelsRuntime&gt;true&lt;/GsharpNoChannelsRuntime&gt; so the SDK copy cannot shadow the in-tree build (#4910)." />
    <Error Condition="'@(_GsharpInTreeRuntimeProjectReference->WithMetadataValue('Filename', 'Gsharp.Runtime.Values'))' != '' and '@(_GsharpSdkRuntimeExplicitReference->WithMetadataValue('Filename', 'Gsharp.Runtime.Values'))' != ''"
           Text="Project '$(MSBuildProjectFile)' has an in-tree ProjectReference to Gsharp.Runtime.Values and also receives the SDK's _ExplicitReference ('$(GsharpValuesRuntimeAssemblyFullPath)'). Set &lt;GsharpNoValuesRuntime&gt;true&lt;/GsharpNoValuesRuntime&gt; so the SDK copy cannot shadow the in-tree build (#4910)." />
  </Target>
</Project>
