<?xml version="1.0" encoding="utf-8"?>
<Project InitialTargets="InitGsharpProps">

  <PropertyGroup>
    <GsharpRepoRoot Condition="'$(GsharpRepoRoot)' == ''">$(MSBuildThisFileDirectory)..</GsharpRepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core -->
    <GsharpCore Include="$(GsharpRepoRoot)/src/Core/Core.gsproj" />
    <GsharpCompiler Include="$(GsharpRepoRoot)/src/Compiler/Compiler.gsproj" />
    <GsharpFormatting Include="$(GsharpRepoRoot)/src/Formatting/GSharp.Formatting/GSharp.Formatting.gsproj" />
    <GsharpFormatterCli Include="$(GsharpRepoRoot)/src/Formatting/Gsfmt.Cli/Gsfmt.Cli.gsproj" />
    <GsharpRepl Include="$(GsharpRepoRoot)/src/Repl/Repl.gsproj" />
    <GsharpLanguageServer Include="$(GsharpRepoRoot)/src/LanguageServer/LanguageServer.gsproj" />

    <!-- All -->
    <GsharpAll Include="@(GsharpCore)" />
    <GsharpAll Include="@(GsharpCompiler)" />
    <GsharpAll Include="@(GsharpFormatting)" />
    <GsharpAll Include="@(GsharpFormatterCli)" />
    <GsharpAll Include="@(GsharpRepl)" />
    <GsharpAll Include="@(GsharpLanguageServer)" />
  </ItemGroup>

  <Target Name="InitGsharpProps">
    <Message Text="GsharpAll: %(GsharpAll.FullPath)" Importance="low" />
    <Warning Text="Gsharp project does not exist: '%(GsharpAll.FullPath)'" Condition="!Exists('%(GsharpAll.FullPath)')" />
  </Target>

</Project>
