<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppTargetFramework)</TargetFramework>
    <RootNamespace>GSharp.GeneratorHost.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="@(CoverletCollectorPackageReference)" />
    <PackageReference Include="@(MicrosoftNetTestSdkPackageReference)" />
    <PackageReference Include="@(XunitPackageReference)" />
    <PackageReference Include="@(XunitRunnerVisualStudioPackageReference)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../src/Sdk/Gsharp.NET.Sdk/WorkerDiagnosticCapture.gs" Link="WorkerDiagnosticCapture.gs" />
    <ProjectReference Include="../GSharp.GeneratorHost/GSharp.GeneratorHost.gsproj" />
    <ProjectReference Include="../../cs2gs/Cs2Gs.ProjectLoading/Cs2Gs.ProjectLoading.gsproj" />
    <ProjectReference Include="../Gsgen.Cli/Gsgen.Cli.gsproj" />
    <ProjectReference Include="../../../src/Core/Core.gsproj" />
  </ItemGroup>

</Project>
