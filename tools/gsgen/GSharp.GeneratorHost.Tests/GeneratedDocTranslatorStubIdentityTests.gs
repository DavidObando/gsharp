package GSharp.GeneratorHost.Tests

import Compilation = GSharp.Core.CodeAnalysis.Compilation.Compilation
import Cs2Gs.Translator.Loading
import GSharp.Core.CodeAnalysis.Text
import GSharp.GeneratorHost
import GsSyntaxTree = GSharp.Core.CodeAnalysis.Syntax.SyntaxTree
import Microsoft.CodeAnalysis
import System
import System.Linq
import Xunit

/// ADR-0192 follow-on 2: the back-translation tells the stub (the user's G#
/// declaring parts) from generator output by tree path, so no generator hint
/// name may collide with the stub's path.
open class GeneratedDocTranslatorStubIdentityTests {
    @Fact
    func GeneratorOutputNamedLikeTheOldStubPath_IsStillAnImplementingPart() {
        let user = Compilation(GsSyntaxTree.Parse(SourceText.From(UserSource, "User.gs")))
        let result = GeneratorHostRunner.Run(
            user,
            CSharpProjectLoader.RuntimeReferences(),
            []IIncrementalGenerator{FixedHintGenerator("GsgenStubs.cs")}
        )
        Assert.Empty(result.Failures)
        let (hintName, generated) = Assert.Single(result.GeneratedGsFiles)
        Assert.Equal("GsgenStubs.cs", hintName)
        Assert.Contains("private partial func Compute(x int32) int32 {", generated, StringComparison.Ordinal)
    }

    @Fact
    func StubPath_IsRejectedAsAGeneratorHintName() {
        let user = Compilation(GsSyntaxTree.Parse(SourceText.From(UserSource, "User.gs")))
        let result = GeneratorHostRunner.Run(
            user,
            CSharpProjectLoader.RuntimeReferences(),
            []IIncrementalGenerator{FixedHintGenerator(GeneratedDocTranslator.StubPath)}
        )
        Assert.Empty(result.GeneratedGsFiles)
        let failure = Assert.Single(result.Failures)
        Assert.IsAssignableFrom[ArgumentException](failure.Exception)
    }

    /// Implements the stub's `Compute` under a fixed hint name.
    private class FixedHintGenerator : IIncrementalGenerator {
        private let hintName string

        init(hintName string) {
            this.hintName = hintName
        }

        func Initialize(context IncrementalGeneratorInitializationContext) {
            let hint = this.hintName
            context.RegisterSourceOutput(
                context.CompilationProvider,
                (spc SourceProductionContext, _ Microsoft.CodeAnalysis.Compilation) -> spc.AddSource(hint, `// <auto-generated/>
namespace App
{
    partial class P
    {
` + `        private partial int Compute(int x)
        {
            return x + 1;
        }
` + `    }
}
`)
            )
        }
    }

    shared {
        private const UserSource string = `package App

partial class P {
    private partial func Compute(x int32) int32;

    public func Use() int32 -> Compute(1)
}
`
    }
}
