/// Loads C# input into a fully bound (cref:CSharpCompilation) with a
/// (cref:SemanticModel) per file (ADR-0115 §A). Two entry points are
/// provided:
/// - (cref:LoadProjectAsync) — the primary loader that opens a real `.csproj` through Roslyn's
/// (cref:MSBuildWorkspace) (SDK resolution via (cref:MSBuildLocator)). This is the production ingestion
/// path.
/// - (cref:LoadInMemory(IReadOnlyList{ValueTuple{string, string}}, IReadOnlyList{MetadataReference},
/// string, OutputKind)) — a lightweight secondary loader that compiles in-memory C# source strings
/// against the running runtime's reference assemblies, for fast unit tests of the visitor without
/// spinning up MSBuild.
shared class CSharpProjectLoader {
    /// Diagnostic id for an MSBuild workspace load failure — the exact signal
    /// pipeline stages must gate on (issue #1742): a project that soft-failed
    /// to open (missing SDK/targets, an unresolvable project reference, an
    /// unsupported TFM, ...), as opposed to an ordinary C# semantic error in a
    /// document that did load (some corpus fixtures carry those deliberately,
    /// e.g. to exercise the later `gsc` compile-gap stage).
    const WorkspaceLoadFailureDiagnosticId string = "CS2GS0001"

    /// Diagnostic id for a benign NuGet audit vulnerability advisory (issue
    /// #2321) — a (cref:WorkspaceDiagnosticKind.Failure) MSBuildWorkspace
    /// diagnostic that (cref:NuGetAuditAdvisoryPolicy.IsBenignAdvisory(string))
    /// recognized as the stable NU1901-NU1904 advisory shape. Recorded at
    /// (cref:DiagnosticSeverity.Info) — visible in
    /// (cref:LoadedCSharpProject.LoadDiagnostics) for anything that later
    /// wants to surface it, but excluded from
    /// (cref:LoadedCSharpProject.ErrorDiagnostics) so it does not trip
    /// (cref:LoadedCSharpProject.BoundWithoutErrors) or
    /// (cref:LoadedCSharpProject.WorkspaceLoadFailed).
    const NuGetAuditAdvisoryDiagnosticId string = "CS2GS0003"

    private let MSBuildRegistrationLock object = SystemObject()

    /// Diagnostic id for an MSBuild workspace load failure (a project that
    /// soft-failed to load: missing SDK/targets, skipped project reference,
    /// wrong TFM, etc.). Surfaced as an (cref:DiagnosticSeverity.Error) so
    /// (cref:LoadedCSharpProject.BoundWithoutErrors) reflects the real
    /// state of the load instead of silently proceeding on a degraded project.
    private let MSBuildWorkspaceLoadFailureDescriptor DiagnosticDescriptor = DiagnosticDescriptor(
        id: WorkspaceLoadFailureDiagnosticId,
        title: "MSBuild workspace load failure",
        messageFormat: "MSBuild workspace failed to load the project: {0}",
        category: "Cs2Gs.Loading",
        defaultSeverity: DiagnosticSeverity.Error,
        isEnabledByDefault: true
    )

    /// Diagnostic id emitted (informationally) for each source file excluded from
    /// translation because it is genuinely build-generated (recognized by an
    /// `<auto-generated>` header or by living under the project's own
    /// `obj/`/`bin/` output directories) — never by file name alone.
    private let GeneratedSourceSkippedDescriptor DiagnosticDescriptor = DiagnosticDescriptor(
        id: "CS2GS0002",
        title: "Generated source file excluded from translation",
        messageFormat: "Skipped '{0}' because it is recognized as generated code",
        category: "Cs2Gs.Loading",
        defaultSeverity: DiagnosticSeverity.Info,
        isEnabledByDefault: true
    )

    /// Issue #2321: a NuGet audit vulnerability advisory (NU1901-NU1904 shape)
    /// that MSBuildWorkspace misclassified as a
    /// (cref:WorkspaceDiagnosticKind.Failure). Recorded informationally
    /// instead of as an error — the package still restores and builds.
    private let NuGetAuditAdvisoryDescriptor DiagnosticDescriptor = DiagnosticDescriptor(
        id: NuGetAuditAdvisoryDiagnosticId,
        title: "Benign NuGet audit vulnerability advisory",
        messageFormat: "MSBuild workspace reported a NuGet vulnerability advisory (non-fatal): {0}",
        category: "Cs2Gs.Loading",
        defaultSeverity: DiagnosticSeverity.Info,
        isEnabledByDefault: true
    )

    private var msbuildRegistered bool

    /// Opens a C# project through (cref:MSBuildWorkspace) and returns its
    /// bound compilation. Registers the SDK MSBuild via
    /// (cref:MSBuildLocator.RegisterDefaults) exactly once before the
    /// workspace is created.
    /// @param projectPath The absolute or relative path to the `.csproj`.
    /// @param cancellationToken A cancellation token.
    /// @param includeAutoGenerated Whether checked-in files carrying an auto-generated header are included.
    /// Files under build output directories remain excluded.
    /// @param includedAutoGeneratedPaths When supplied, limits auto-generated-header inclusion to these
    /// inventoried paths.
    /// @returns The loaded project with its compilation, documents, and diagnostics.
    /// @exception FileNotFoundException The project file does not exist.
    /// @exception InvalidOperationException The opened project did not produce a C# compilation.
    async func LoadProjectAsync(
        projectPath string?,
        cancellationToken CancellationToken = default(CancellationToken),
        includeAutoGenerated bool = false,
        includedAutoGeneratedPaths IReadOnlyCollection[string]? = nil,
        configuration string? = nil
    ) LoadedCSharpProject {
        if projectPath == nil {
            throw ArgumentNullException("projectPath")
        }
        let fullPath = Path.GetFullPath(projectPath)
        if !File.Exists(fullPath) {
            throw FileNotFoundException("Project file not found: $fullPath", fullPath)
        }
        EnsureMSBuildRegistered()
        let loadDiagnostics = List[Diagnostic]()
        using let workspace = CreateWorkspace(configuration)
        workspace.LoadMetadataForReferencedProjects = true
        let project = await workspace.OpenProjectAsync(fullPath, cancellationToken: cancellationToken).ConfigureAwait(
            false
        )
        // OD-T? (issue #1742): MSBuildWorkspace can soft-fail a project load (missing
        // SDK/targets, a project reference it had to skip, an unrecognized TFM, ...)
        // without throwing. Those failures land in workspace.Diagnostics and were
        // previously never inspected, so the translator proceeded on a degraded
        // compilation and the user only saw confusing downstream binding errors.
        // Surface them as load errors so BoundWithoutErrors reflects reality.
        // Issue #2321: a benign NuGet audit vulnerability advisory (NU1901-NU1904)
        // is exempted from that gate — see ClassifyWorkspaceLoadDiagnostics.
        // Issue #4767: attribute workspace load diagnostics to their owning
        // project so a referenced producer's load failure is not charged as a
        // consumer-owned load error.
        let referencedPaths = CollectExistingReferencedProjectPaths(
            fullPath,
            TransitiveCSharpProjectReferences(project),
            configuration
        )
        let diagnosticsByProject = PartitionWorkspaceLoadDiagnostics(
            workspace,
            fullPath,
            referencedPaths,
            configuration
        )
        if diagnosticsByProject.TryGetValue(fullPath, out var ownDiagnostics) {
            loadDiagnostics.AddRange(ownDiagnostics)
        }
        for activeRefPath in ReadActiveProjectReferencePaths(fullPath, configuration) {
            if !File.Exists(activeRefPath) && !loadDiagnostics.Any(
                (d Diagnostic) -> d.Id == WorkspaceLoadFailureDiagnosticId &&
                    MessageMentionsPath(d.GetMessage(), activeRefPath)
            ) {
                loadDiagnostics.Add(
                    Diagnostic.Create(
                        MSBuildWorkspaceLoadFailureDescriptor,
                        Location.None,
                        "The referenced project file '$activeRefPath' was not found."
                    )
                )
            }
        }
        let referencedWorkspaceLoadErrors = List[Diagnostic]()
        for referencedPath in referencedPaths {
            if diagnosticsByProject.TryGetValue(referencedPath, out var referencedDiagnostics) &&
                referencedDiagnostics != nil {
                for diagnostic in referencedDiagnostics {
                    if diagnostic.Id == WorkspaceLoadFailureDiagnosticId {
                        referencedWorkspaceLoadErrors.Add(diagnostic)
                    }
                }
            } else if !IsWellFormedProjectXml(referencedPath, out var xmlError) {
                referencedWorkspaceLoadErrors.Add(
                    Diagnostic.Create(
                        MSBuildWorkspaceLoadFailureDescriptor,
                        Location.None,
                        "Referenced project '$referencedPath' failed to load: $xmlError"
                    )
                )
            }
        }
        return await BuildLoadedProjectAsync(
            project,
            loadDiagnostics,
            cancellationToken,
            includeAutoGenerated,
            includedAutoGeneratedPaths,
            referencedWorkspaceLoadErrors
        ).ConfigureAwait(false)
    }

    /// Loads a C# project together with the transitive closure of its
    /// same-solution `ProjectReference`s, each as its own bound
    /// (cref:LoadedCSharpProject). The primary (requested) project is
    /// returned first and carries its own MSBuild workspace load-failure
    /// diagnostics; the referenced projects follow with their own diagnostics.
    /// This lets the migration pipeline translate sibling-project source into G#
    /// so an app's uses of sibling types resolve at the gsc compile stage
    /// (Refs #914). Package references are unaffected — they remain metadata
    /// references on each compilation.
    /// @param projectPath The absolute or relative path to the app's `.csproj`.
    /// @param cancellationToken A cancellation token.
    /// @param includeAutoGenerated Whether checked-in files carrying an auto-generated header are included.
    /// Files under build output directories remain excluded.
    /// @param includedAutoGeneratedPaths When supplied, limits auto-generated-header inclusion to these
    /// inventoried paths.
    /// @returns The primary project followed by its transitively referenced C# projects.
    async func LoadProjectWithReferencesAsync(
        projectPath string?,
        cancellationToken CancellationToken = default(CancellationToken),
        includeAutoGenerated bool = false,
        includedAutoGeneratedPaths IReadOnlyCollection[string]? = nil,
        configuration string? = nil
    ) IReadOnlyList[LoadedCSharpProject] {
        if projectPath == nil {
            throw ArgumentNullException("projectPath")
        }
        let fullPath = Path.GetFullPath(projectPath)
        if !File.Exists(fullPath) {
            throw FileNotFoundException("Project file not found: $fullPath", fullPath)
        }
        EnsureMSBuildRegistered()
        using let workspace = CreateWorkspace(configuration)
        // Issue #2412: unlike LoadProjectAsync, this loader's entire purpose is
        // to load referenced projects as their own bound source Projects so their
        // syntax is available to callers (e.g. cross-project oblivious-nullability
        // taint analysis, Refs #914). Setting LoadMetadataForReferencedProjects
        // makes MSBuildWorkspace collapse same-solution ProjectReferences into
        // pure metadata references instead of Solution.Projects entries, which
        // silently empties root.ProjectReferences/TransitiveCSharpProjectReferences
        // below and degrades this call to loading only the primary project — do
        // not set it here.
        let project = await workspace.OpenProjectAsync(fullPath, cancellationToken: cancellationToken).ConfigureAwait(
            false
        )
        // Issue #2321 / #4767: classify workspace load diagnostics and partition
        // them by owning project so referenced-producer workspace failures attach
        // to the referenced project rather than the root consumer.
        let referencedProjects = TransitiveCSharpProjectReferences(project).ToList()
        let referencedPaths = CollectExistingReferencedProjectPaths(fullPath, referencedProjects, configuration)
        let diagnosticsByProject = PartitionWorkspaceLoadDiagnostics(
            workspace,
            fullPath,
            referencedPaths,
            configuration
        )
        let rootDiagnostics = List[Diagnostic]()
        if diagnosticsByProject.TryGetValue(fullPath, out var ownDiagnostics) {
            rootDiagnostics.AddRange(ownDiagnostics)
        }
        for activeRefPath in ReadActiveProjectReferencePaths(fullPath, configuration) {
            if !File.Exists(activeRefPath) && !rootDiagnostics.Any(
                (d Diagnostic) -> d.Id == WorkspaceLoadFailureDiagnosticId &&
                    MessageMentionsPath(d.GetMessage(), activeRefPath)
            ) {
                rootDiagnostics.Add(
                    Diagnostic.Create(
                        MSBuildWorkspaceLoadFailureDescriptor,
                        Location.None,
                        "The referenced project file '$activeRefPath' was not found."
                    )
                )
            }
        }
        let results = List[LoadedCSharpProject]{
            await BuildLoadedProjectAsync(
                project,
                rootDiagnostics,
                cancellationToken,
                includeAutoGenerated,
                includedAutoGeneratedPaths
            ).ConfigureAwait(false)
        }
        let includedReferencedPaths = HashSet[string](StringComparer.OrdinalIgnoreCase)
        for referenced in referencedProjects {
            let referencedPath = if string.IsNullOrEmpty(referenced.FilePath) {
                string.Empty
            } else {
                Path.GetFullPath(referenced.FilePath!!)
            }
            if !string.IsNullOrEmpty(referencedPath) {
                includedReferencedPaths.Add(referencedPath)
            }
            let referencedDiagnostics = List[Diagnostic]()
            if !string.IsNullOrEmpty(referencedPath) && diagnosticsByProject.TryGetValue(
                referencedPath,
                out var assignedDiagnostics
            ) {
                referencedDiagnostics.AddRange(assignedDiagnostics)
            }
            results.Add(
                await BuildLoadedProjectAsync(
                    referenced,
                    referencedDiagnostics,
                    cancellationToken,
                    includeAutoGenerated,
                    includedAutoGeneratedPaths
                ).ConfigureAwait(false)
            )
        }
        for referencedPath in referencedPaths {
            if includedReferencedPaths.Contains(referencedPath) {
                continue
            }
            var unreachedDiagnostics List[Diagnostic]? = nil
            if !diagnosticsByProject.TryGetValue(referencedPath, out unreachedDiagnostics) ||
                unreachedDiagnostics == nil ||
                unreachedDiagnostics.Count == 0 {
                if !IsWellFormedProjectXml(referencedPath, out var xmlError) {
                    unreachedDiagnostics = List[Diagnostic]{
                        Diagnostic.Create(
                            MSBuildWorkspaceLoadFailureDescriptor,
                            Location.None,
                            "Referenced project '$referencedPath' failed to load: $xmlError"
                        )
                    }
                } else {
                    continue
                }
            }
            let assemblyName = Path.GetFileNameWithoutExtension(referencedPath)
            let emptyCompilation = CSharpCompilation.Create(
                assemblyName,
                syntaxTrees: Array.Empty[SyntaxTree](),
                references: RuntimeReferences(),
                options: CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary)
            )
            let projectDirectory string? = Path.GetDirectoryName(referencedPath)
            results.Add(
                LoadedCSharpProject(
                    emptyCompilation,
                    Array.Empty[LoadedDocument](),
                    unreachedDiagnostics,
                    projectDirectory,
                    assemblyName,
                    DiscoverResxFiles(projectDirectory),
                    Array.Empty[string](),
                    Array.Empty[string](),
                    referencedPath,
                    isTestProject: false
                )
            )
        }
        return results
    }

    /// Evaluates the transitive C# compile `ProjectReference` paths for a
    /// single project through (cref:MSBuildWorkspace) without building Roslyn
    /// compilations or semantic models.
    /// @param projectPath The `.csproj` path.
    /// @param cancellationToken A cancellation token.
    /// @returns The MSBuild-evaluated transitive C# `ProjectReference` paths.
    async func EvaluateCompileProjectReferencePathsAsync(
        projectPath string?,
        cancellationToken CancellationToken = default(CancellationToken),
        configuration string? = nil
    ) IReadOnlyList[string] {
        if projectPath == nil {
            throw ArgumentNullException("projectPath")
        }
        let fullPath = Path.GetFullPath(projectPath)
        if !File.Exists(fullPath) {
            throw FileNotFoundException("Project file not found: $fullPath", fullPath)
        }
        let evaluated = await EvaluateCompileProjectReferencePathsAsync(
            []string{fullPath},
            cancellationToken,
            configuration
        ).ConfigureAwait(false)
        return evaluated[fullPath]
    }

    /// Evaluates the transitive C# compile `ProjectReference` paths for a set
    /// of projects in a single shared (cref:MSBuildWorkspace), reusing
    /// already-opened projects in the workspace solution without building
    /// Roslyn compilations or semantic models.
    /// @param projectPaths The `.csproj` paths to evaluate.
    /// @param cancellationToken A cancellation token.
    /// @param configuration The optional MSBuild configuration (e.g. `Release`) to evaluate conditions under.
    /// @returns A dictionary mapping each normalized project path to its ordered transitive C# compile
    /// reference paths.
    async func EvaluateCompileProjectReferencePathsAsync(
        projectPaths IEnumerable[string]?,
        cancellationToken CancellationToken = default(CancellationToken),
        configuration string? = nil
    ) IReadOnlyDictionary[string, IReadOnlyList[string]] {
        if projectPaths == nil {
            throw ArgumentNullException("projectPaths")
        }
        let normalizedPaths = projectPaths
            .Where((path string) -> !string.IsNullOrEmpty(path))
            .Select(Path.GetFullPath)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList()
        let result = Dictionary[string, IReadOnlyList[string]](StringComparer.OrdinalIgnoreCase)
        if normalizedPaths.Count == 0 {
            return result
        }
        EnsureMSBuildRegistered()
        using let workspace = CreateWorkspace(configuration)
        for fullPath in normalizedPaths {
            if !File.Exists(fullPath) {
                throw FileNotFoundException("Project file not found: $fullPath", fullPath)
            }
            let existing Project? = workspace
                .CurrentSolution
                .Projects
                .FirstOrDefault(
                (p Project) -> !string.IsNullOrEmpty(p.FilePath) && string.Equals(
                    Path.GetFullPath(p.FilePath!!),
                    fullPath,
                    StringComparison.OrdinalIgnoreCase
                )
            )
            if existing == nil {
                try {
                    await workspace.OpenProjectAsync(fullPath, cancellationToken: cancellationToken).ConfigureAwait(
                        false
                    )
                } catch (ex Exception) when ex is not OperationCanceledException { }
            }
        }
        for fullPath in normalizedPaths {
            let project Project? = workspace
                .CurrentSolution
                .Projects
                .FirstOrDefault(
                (p Project) -> !string.IsNullOrEmpty(p.FilePath) && string.Equals(
                    Path.GetFullPath(p.FilePath!!),
                    fullPath,
                    StringComparison.OrdinalIgnoreCase
                )
            )
            if project == nil {
                result[fullPath] = Array.Empty[string]()
                continue
            }
            result[fullPath] = TransitiveCSharpProjectReferences(project)
                .Select((referenced Project) -> referenced.FilePath ?? string.Empty)
                .Where((path string) -> !string.IsNullOrEmpty(path))
                .Select(Path.GetFullPath)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList()
        }
        return result
    }

    /// Compiles a set of in-memory C# sources into a bound compilation. This is
    /// the fast path for unit tests; it does not touch MSBuild.
    /// @param sources The `(fileName, sourceText)` pairs to compile.
    /// @param references The metadata references; when `null` the running runtime's
    /// reference assemblies (from `TRUSTED_PLATFORM_ASSEMBLIES`) are used.
    /// @param assemblyName The output assembly name.
    /// @param outputKind The compilation's output kind. Defaults to a library, so
    /// `Compilation.GetEntryPoint` is `null` and entry-point
    /// flattening (`TranslateEntryType`) is not exercised. Pass
    /// (cref:OutputKind.ConsoleApplication) to test entry-point
    /// translation (issue #1904) with this fast in-memory harness.
    /// @returns The loaded project with its compilation, documents, and diagnostics.
    func LoadInMemory(
        sources IReadOnlyList[(FileName string, Source string)]?,
        references IReadOnlyList[MetadataReference]? = nil,
        assemblyName string = "Cs2Gs.InMemory",
        outputKind OutputKind = OutputKind.DynamicallyLinkedLibrary
    ) LoadedCSharpProject {
        if sources == nil {
            throw ArgumentNullException("sources")
        }
        let parseOptions = CSharpParseOptions(LanguageVersion.Latest)
        let trees = sources.Select(
            (s(FileName string, Source string)) -> CSharpSyntaxTree.ParseText(s.Source, parseOptions, path: s.FileName)
        )
            .ToImmutableArray()
        let resolvedReferences = references ?? RuntimeReferences()
        let compilation = CSharpCompilation.Create(
            assemblyName,
            trees,
            resolvedReferences,
            CSharpCompilationOptions(outputKind).WithAllowUnsafe(true)
        )
        let loadDiagnostics = List[Diagnostic]()
        let documents = BuildDocuments(compilation, projectDirectory: nil, loadDiagnostics, includeAutoGenerated: false)
        loadDiagnostics.AddRange(SignificantDiagnostics(compilation))
        return LoadedCSharpProject(compilation, documents, loadDiagnostics)
    }

    private let CachedRuntimeReferences Lazy[IReadOnlyList[MetadataReference]] = Lazy[IReadOnlyList[MetadataReference]](
        BuildRuntimeReferences,
        LazyThreadSafetyMode.ExecutionAndPublication
    )

    /// Builds the default metadata reference set from the running runtime's
    /// trusted platform assemblies (the shared framework).
    /// @returns The metadata references for the current runtime.
    func RuntimeReferences() IReadOnlyList[MetadataReference] -> CachedRuntimeReferences.Value

    private func BuildRuntimeReferences() IReadOnlyList[MetadataReference] {
        let tpa string? = AppContext.GetData("TRUSTED_PLATFORM_ASSEMBLIES") as string
        if string.IsNullOrEmpty(tpa) {
            throw InvalidOperationException(
                "TRUSTED_PLATFORM_ASSEMBLIES is unavailable; cannot derive default runtime references."
            )
        }
        return tpa
            .Split(Path.PathSeparator, StringSplitOptions.RemoveEmptyEntries)
            .Where((path string) -> path.EndsWith(".dll", StringComparison.OrdinalIgnoreCase) && File.Exists(path))
            .Select((path string) -> cast[MetadataReference](MetadataReference.CreateFromFile(path)))
            .ToImmutableArray()
    }

    /// Enumerates the transitive closure of a project's same-solution
    /// `ProjectReference`s that produce a C# compilation, each visited once
    /// (breadth-first). The root project itself is excluded.
    private func TransitiveCSharpProjectReferences(root Project) sequence[Project] {
        let solution = root.Solution
        let seen = HashSet[ProjectId]()
        let queue = Queue[Project]()
        for reference in root.ProjectReferences {
            let referenced Project? = solution.GetProject(reference.ProjectId)
            if referenced != nil {
                queue.Enqueue(referenced)
            }
        }
        while queue.Count > 0 {
            let current = queue.Dequeue()
            if !seen.Add(current.Id) {
                continue
            }
            if string.Equals(current.Language, LanguageNames.CSharp, StringComparison.Ordinal) {
                yield current
            }
            for reference in current.ProjectReferences {
                let referenced Project? = solution.GetProject(reference.ProjectId)
                if referenced != nil && !seen.Contains(referenced.Id) {
                    queue.Enqueue(referenced)
                }
            }
        }
    }

    /// Issue #2321: classifies every (cref:WorkspaceDiagnosticKind.Failure)
    /// diagnostic MSBuildWorkspace recorded while opening a project into either
    /// a genuine (cref:MSBuildWorkspaceLoadFailureDescriptor) error, or —
    /// when (cref:NuGetAuditAdvisoryPolicy.IsBenignAdvisory(string))
    /// recognizes the message as the stable NU1901-NU1904 advisory shape — a
    /// non-fatal (cref:NuGetAuditAdvisoryDescriptor) info diagnostic.
    /// Applied identically by both (cref:LoadProjectAsync) and
    /// (cref:LoadProjectWithReferencesAsync) so neither path lets a
    /// benign vulnerability warning trip (cref:WorkspaceLoadFailureDiagnosticId)
    /// (CS2GS0001), while every other soft-fail (missing SDK/imports, an
    /// unresolvable `ProjectReference`, an unsupported TFM, NU1900
    /// audit-fetch failures, or a mixed/multiline message with any non-advisory
    /// line) remains fatal.
    private func ClassifyWorkspaceLoadDiagnostic(diagnostic WorkspaceDiagnostic) Diagnostic {
        return if NuGetAuditAdvisoryPolicy.IsBenignAdvisory(diagnostic.Message) {
            Diagnostic.Create(NuGetAuditAdvisoryDescriptor, Location.None, diagnostic.Message)
        } else {
            Diagnostic.Create(MSBuildWorkspaceLoadFailureDescriptor, Location.None, diagnostic.Message)
        }
    }

    private func PartitionWorkspaceLoadDiagnostics(
        workspace MSBuildWorkspace,
        rootProjectPath string,
        referencedPaths IReadOnlyList[string],
        configuration string? = nil
    ) Dictionary[string, List[Diagnostic]] {
        let map_ = Dictionary[string, List[Diagnostic]](StringComparer.OrdinalIgnoreCase)
        for diagnostic in workspace.Diagnostics {
            if diagnostic.Kind != WorkspaceDiagnosticKind.Failure {
                continue
            }
            let classified = ClassifyWorkspaceLoadDiagnostic(diagnostic)
            let ownerPath = ResolveWorkspaceDiagnosticOwnerPath(
                diagnostic,
                rootProjectPath,
                referencedPaths,
                workspace,
                configuration
            )
            if !map_.TryGetValue(ownerPath, out var list) {
                list = List[Diagnostic]()
                map_[ownerPath] = list
            }
            list.Add(classified)
        }
        return map_
    }

    private func ResolveWorkspaceDiagnosticOwnerPath(
        diagnostic WorkspaceDiagnostic,
        rootProjectPath string,
        referencedPaths IReadOnlyList[string],
        workspace MSBuildWorkspace,
        configuration string? = nil
    ) string {
        if diagnostic is ProjectDiagnostic projectDiagnostic {
            let ownerFilePath = workspace.CurrentSolution.GetProject(projectDiagnostic.ProjectId)?.FilePath
            if !string.IsNullOrEmpty(ownerFilePath) {
                let fullOwnerPath = Path.GetFullPath(ownerFilePath)
                if !string.Equals(
                    fullOwnerPath,
                    Path.GetFullPath(rootProjectPath),
                    StringComparison.OrdinalIgnoreCase
                ) {
                    return fullOwnerPath
                }
            }
        }
        let message = diagnostic.Message ?? string.Empty
        for referencedPath in referencedPaths {
            if MessageMentionsPath(message, referencedPath) {
                return referencedPath
            }
        }
        let rootDeclaredTargets = ReadDeclaredTargetPaths(rootProjectPath, configuration)
        for referencedPath in referencedPaths {
            for targetPath in ReadDeclaredTargetPaths(referencedPath, configuration) {
                if !rootDeclaredTargets.Contains(targetPath) && MessageMentionsPath(message, targetPath) {
                    return referencedPath
                }
            }
        }
        if IsWellFormedProjectXml(rootProjectPath, out _) {
            for referencedPath in referencedPaths {
                if !IsWellFormedProjectXml(referencedPath, out var xmlError) && !string.IsNullOrWhiteSpace(xmlError) &&
                    message.Contains(xmlError, StringComparison.OrdinalIgnoreCase) {
                    return referencedPath
                }
            }
        }
        return rootProjectPath
    }

    private func IsWellFormedProjectXml(projectPath string, out errorMessage string?) bool {
        errorMessage = nil
        if string.IsNullOrEmpty(projectPath) || !File.Exists(projectPath) {
            errorMessage = "Project file not found."
            return false
        }
        try {
            XDocument.Load(projectPath)
            return true
        } catch (ex Exception) when ex is XmlException || ex is IOException || ex is UnauthorizedAccessException {
            errorMessage = ex.Message
            return false
        }
    }

    private func MessageMentionsPath(message string, candidatePath string) bool {
        if string.IsNullOrEmpty(message) || string.IsNullOrEmpty(candidatePath) {
            return false
        }
        let full = Path.GetFullPath(candidatePath)
        let slash = full.Replace('\\', '/')
        let backslash = full.Replace('/', '\\')
        if message.Contains(full, StringComparison.OrdinalIgnoreCase) || message.Contains(
            slash,
            StringComparison.OrdinalIgnoreCase
        ) ||
            message.Contains(backslash, StringComparison.OrdinalIgnoreCase) {
            return true
        }
        let fileName = Path.GetFileName(full)
        let parentDir = Path.GetFileName(Path.GetDirectoryName(full))
        if !string.IsNullOrEmpty(parentDir) && !string.IsNullOrEmpty(fileName) {
            let shortSlash = parentDir + "/" + fileName
            let shortBackslash = parentDir + "\\" + fileName
            if message.Contains(shortSlash, StringComparison.OrdinalIgnoreCase) || message.Contains(
                shortBackslash,
                StringComparison.OrdinalIgnoreCase
            ) {
                return true
            }
        }
        return false
    }

    private func CollectExistingReferencedProjectPaths(
        rootProjectPath string,
        loadedReferencedProjects IEnumerable[Project],
        configuration string? = nil
    ) IReadOnlyList[string] {
        let seen = HashSet[string](StringComparer.OrdinalIgnoreCase){rootProjectPath}
        let ordered = List[string]()
        let queue = Queue[string]()
        queue.Enqueue(rootProjectPath)
        for referenced in loadedReferencedProjects {
            if string.IsNullOrEmpty(referenced.FilePath) {
                continue
            }
            let full = Path.GetFullPath(referenced.FilePath!!)
            if seen.Add(full) {
                ordered.Add(full)
                queue.Enqueue(full)
            }
        }
        while queue.Count > 0 {
            let current = queue.Dequeue()
            for candidate in ReadActiveProjectReferencePaths(current, configuration) {
                if File.Exists(candidate) && seen.Add(candidate) {
                    ordered.Add(candidate)
                    queue.Enqueue(candidate)
                }
            }
        }
        return ordered
    }

    private func ReadActiveProjectReferencePaths(projectPath string, configuration string?) IReadOnlyList[string] ->
    ReadXmlActiveProjectReferencePaths(projectPath, configuration)

    private func ReadXmlActiveProjectReferencePaths(projectPath string, configuration string?) IReadOnlyList[string] {
        let paths = List[string]()
        if string.IsNullOrEmpty(projectPath) || !File.Exists(projectPath) {
            return paths
        }
        let fullProjectPath = Path.GetFullPath(projectPath)
        let projectDir string? = Path.GetDirectoryName(fullProjectPath)
        if string.IsNullOrEmpty(projectDir) {
            return paths
        }
        let effectiveConfig = if string.IsNullOrWhiteSpace(configuration) {
            "Debug"
        } else {
            configuration?.Trim() ?? "Debug"
        }
        let properties = Dictionary[string, string](StringComparer.OrdinalIgnoreCase)
        properties["Configuration"] = effectiveConfig
        properties["MSBuildProjectDirectory"] = projectDir
        let customItems = Dictionary[string, List[string]](StringComparer.OrdinalIgnoreCase)
        let visitedFiles = HashSet[string](StringComparer.OrdinalIgnoreCase)
        visitedFiles.Add(fullProjectPath)
        try {
            let document = XDocument.Load(fullProjectPath)
            let root = document.Root
            if root != nil {
                EvaluateXmlProjectContainer(root, projectDir, projectDir, properties, customItems, paths, visitedFiles)
            }
        } catch (ex Exception) when ex is IOException || ex is XmlException || ex is UnauthorizedAccessException {
            return paths
        }
        return paths
    }

    private func EvaluateXmlProjectContainer(
        container XElement,
        rootProjectDir string,
        currentFileDir string,
        properties Dictionary[string, string],
        customItems Dictionary[string, List[string]],
        projectReferences List[string],
        visitedFiles HashSet[string]
    ) {
        for child in container.Elements() {
            let localName = child.Name.LocalName
            if localName.Equals("PropertyGroup", StringComparison.OrdinalIgnoreCase) {
                if !EvaluateMsbuildCondition(child.Attribute(XName?("Condition")!!)?.Value, properties) {
                    continue
                }
                for propElement in child.Elements() {
                    if !EvaluateMsbuildCondition(propElement.Attribute(XName?("Condition")!!)?.Value, properties) {
                        continue
                    }
                    properties[propElement.Name.LocalName] = ExpandMsbuildExpressions(
                        propElement.Value,
                        currentFileDir,
                        properties,
                        customItems
                    )
                }
            } else if localName.Equals("Import", StringComparison.OrdinalIgnoreCase) {
                if !EvaluateMsbuildCondition(child.Attribute(XName?("Condition")!!)?.Value, properties) {
                    continue
                }
                let rawImport = ExpandMsbuildExpressions(
                    child.Attribute(XName?("Project")!!)?.Value,
                    currentFileDir,
                    properties,
                    customItems
                )
                if string.IsNullOrWhiteSpace(rawImport) || rawImport.Contains("$$(", StringComparison.Ordinal) ||
                    rawImport.Contains("@(", StringComparison.Ordinal) {
                    continue
                }
                let normalizedImport = rawImport.Replace('\\', Path.DirectorySeparatorChar).Replace(
                    '/',
                    Path.DirectorySeparatorChar
                )
                let importPath = Path.GetFullPath(Path.Combine(currentFileDir, normalizedImport))
                if !File.Exists(importPath) || !visitedFiles.Add(importPath) {
                    continue
                }
                let importDir string? = Path.GetDirectoryName(importPath)
                if string.IsNullOrEmpty(importDir) {
                    continue
                }
                try {
                    let importedDoc = XDocument.Load(importPath)
                    if importedDoc.Root != nil {
                        EvaluateXmlProjectContainer(
                            importedDoc.Root!!,
                            rootProjectDir,
                            importDir,
                            properties,
                            customItems,
                            projectReferences,
                            visitedFiles
                        )
                    }
                } catch (ex Exception) when ex is IOException ||
                    ex is XmlException ||
                    ex is UnauthorizedAccessException { }
            } else if localName.Equals("Choose", StringComparison.OrdinalIgnoreCase) {
                var matchedBranch = false
                for branch in child.Elements() {
                    if branch.Name.LocalName.Equals("When", StringComparison.OrdinalIgnoreCase) {
                        if !matchedBranch &&
                            EvaluateMsbuildCondition(branch.Attribute(XName?("Condition")!!)?.Value, properties) {
                            matchedBranch = true
                            EvaluateXmlProjectContainer(
                                branch,
                                rootProjectDir,
                                currentFileDir,
                                properties,
                                customItems,
                                projectReferences,
                                visitedFiles
                            )
                        }
                    } else if branch.Name.LocalName.Equals("Otherwise", StringComparison.OrdinalIgnoreCase) {
                        if !matchedBranch {
                            matchedBranch = true
                            EvaluateXmlProjectContainer(
                                branch,
                                rootProjectDir,
                                currentFileDir,
                                properties,
                                customItems,
                                projectReferences,
                                visitedFiles
                            )
                        }
                    }
                }
            } else if localName.Equals("ItemGroup", StringComparison.OrdinalIgnoreCase) {
                if !EvaluateMsbuildCondition(child.Attribute(XName?("Condition")!!)?.Value, properties) {
                    continue
                }
                for item in child.Elements() {
                    if !EvaluateMsbuildCondition(item.Attribute(XName?("Condition")!!)?.Value, properties) {
                        continue
                    }
                    let itemName = item.Name.LocalName
                    if itemName.Equals("ProjectReference", StringComparison.OrdinalIgnoreCase) {
                        let removeSpec = ExpandMsbuildExpressions(
                            item.Attribute(XName?("Remove")!!)?.Value,
                            currentFileDir,
                            properties,
                            customItems
                        )
                        if !string.IsNullOrWhiteSpace(removeSpec) {
                            for part in removeSpec.Split(';', StringSplitOptions.RemoveEmptyEntries) {
                                let trimmed = part.Trim()
                                if string.IsNullOrEmpty(trimmed) || trimmed.Contains("$$(", StringComparison.Ordinal) ||
                                    trimmed.Contains("@(", StringComparison.Ordinal) {
                                    continue
                                }
                                let normalizedRemove = trimmed.Replace('\\', Path.DirectorySeparatorChar).Replace(
                                    '/',
                                    Path.DirectorySeparatorChar
                                )
                                let fullRemove = Path.GetFullPath(Path.Combine(currentFileDir, normalizedRemove))
                                projectReferences.RemoveAll(
                                    (existing string) -> string.Equals(
                                        existing,
                                        fullRemove,
                                        StringComparison.OrdinalIgnoreCase
                                    )
                                )
                            }
                        }
                        let includeSpec = ExpandMsbuildExpressions(
                            item.Attribute(XName?("Include")!!)?.Value,
                            currentFileDir,
                            properties,
                            customItems
                        )
                        if string.IsNullOrWhiteSpace(includeSpec) || includeSpec.Contains(
                            "$$(",
                            StringComparison.Ordinal
                        ) ||
                            includeSpec.Contains("@(", StringComparison.Ordinal) {
                            continue
                        }
                        let refOutput = item.Attribute(XName?("ReferenceOutputAssembly")!!)
                            ?.Value ??
                            item
                            .Elements()
                            .FirstOrDefault(
                            (e XElement) -> e
                                .Name
                                .LocalName
                                .Equals("ReferenceOutputAssembly", StringComparison.OrdinalIgnoreCase)
                        )
                            ?.Value
                        if string.Equals(refOutput?.Trim(), "false", StringComparison.OrdinalIgnoreCase) {
                            continue
                        }
                        for part in includeSpec.Split(';', StringSplitOptions.RemoveEmptyEntries) {
                            let trimmed = part.Trim()
                            if string.IsNullOrEmpty(trimmed) {
                                continue
                            }
                            let normalized = trimmed.Replace('\\', Path.DirectorySeparatorChar).Replace(
                                '/',
                                Path.DirectorySeparatorChar
                            )
                            let fullInclude = Path.GetFullPath(Path.Combine(currentFileDir, normalized))
                            if !projectReferences.Contains(fullInclude, StringComparer.OrdinalIgnoreCase) {
                                projectReferences.Add(fullInclude)
                            }
                        }
                    } else {
                        if !customItems.TryGetValue(itemName, out var itemList) {
                            itemList = List[string]()
                            customItems[itemName] = itemList
                        }
                        let removeSpec = ExpandMsbuildExpressions(
                            item.Attribute(XName?("Remove")!!)?.Value,
                            currentFileDir,
                            properties,
                            customItems
                        )
                        if !string.IsNullOrWhiteSpace(removeSpec) {
                            for part in removeSpec.Split(';', StringSplitOptions.RemoveEmptyEntries) {
                                let trimmed = part.Trim()
                                itemList.RemoveAll(
                                    (existing string) -> string.Equals(
                                        existing,
                                        trimmed,
                                        StringComparison.OrdinalIgnoreCase
                                    )
                                )
                            }
                        }
                        let includeSpec = ExpandMsbuildExpressions(
                            item.Attribute(XName?("Include")!!)?.Value,
                            currentFileDir,
                            properties,
                            customItems
                        )
                        if !string.IsNullOrWhiteSpace(includeSpec) {
                            for part in includeSpec.Split(';', StringSplitOptions.RemoveEmptyEntries) {
                                let trimmed = part.Trim()
                                if !string.IsNullOrEmpty(trimmed) {
                                    itemList.Add(trimmed)
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    private func ExpandMsbuildExpressions(
        raw string?,
        currentFileDir string,
        properties Dictionary[string, string],
        customItems Dictionary[string, List[string]]
    ) string {
        if string.IsNullOrEmpty(raw) {
            return string.Empty
        }
        var result = raw.Replace(
            "$$(MSBuildThisFileDirectory)",
            currentFileDir + Path.DirectorySeparatorChar,
            StringComparison.OrdinalIgnoreCase
        )
        for kvp in properties {
            result = result.Replace("$$(" + kvp.Key + ")", kvp.Value, StringComparison.OrdinalIgnoreCase)
        }
        for kvp in customItems {
            result = result.Replace(
                "@(" + kvp.Key + ")",
                string.Join(";", kvp.Value),
                StringComparison.OrdinalIgnoreCase
            )
        }
        var openAt = result.IndexOf("@(", StringComparison.Ordinal)
        while openAt >= 0 {
            let closeAt = result.IndexOf(')', openAt + 2)
            if closeAt < 0 {
                break
            }
            let itemName = result.Substring(openAt + 2, closeAt - openAt - 2).Trim()
            if !customItems.ContainsKey(itemName) {
                result = result.Substring(0, openAt) + result.Substring(closeAt + 1)
                openAt = result.IndexOf("@(", StringComparison.Ordinal)
            } else {
                openAt = result.IndexOf("@(", closeAt + 1, StringComparison.Ordinal)
            }
        }
        return result
    }

    private func EvaluateMsbuildCondition(condition string?, properties Dictionary[string, string]) bool {
        if string.IsNullOrWhiteSpace(condition) {
            return true
        }
        var expanded = condition.Trim()
        for kvp in properties {
            expanded = expanded.Replace("$$(" + kvp.Key + ")", kvp.Value, StringComparison.OrdinalIgnoreCase)
        }
        expanded = expanded.Replace("'", string.Empty, StringComparison.Ordinal).Trim()
        if string.Equals(expanded, "true", StringComparison.OrdinalIgnoreCase) {
            return true
        }
        if string.Equals(expanded, "false", StringComparison.OrdinalIgnoreCase) {
            return false
        }
        let neqIndex = expanded.IndexOf("!=", StringComparison.Ordinal)
        if neqIndex >= 0 {
            let left = expanded.Substring(0, neqIndex).Trim()
            let right = expanded.Substring(neqIndex + 2).Trim()
            if !left.Contains("$$(", StringComparison.Ordinal) && !right.Contains("$$(", StringComparison.Ordinal) {
                return !string.Equals(left, right, StringComparison.OrdinalIgnoreCase)
            }
            return false
        }
        let eqIndex = expanded.IndexOf("==", StringComparison.Ordinal)
        if eqIndex >= 0 {
            let left = expanded.Substring(0, eqIndex).Trim()
            let right = expanded.Substring(eqIndex + 2).Trim()
            if !left.Contains("$$(", StringComparison.Ordinal) && !right.Contains("$$(", StringComparison.Ordinal) {
                return string.Equals(left, right, StringComparison.OrdinalIgnoreCase)
            }
            return false
        }
        return false
    }

    private func EvaluateSimpleMsbuildCondition(condition string?, configuration string?) bool {
        let props = Dictionary[string, string](StringComparer.OrdinalIgnoreCase)
        props["Configuration"] = if string.IsNullOrWhiteSpace(configuration) {
            "Debug"
        } else {
            configuration?.Trim() ?? "Debug"
        }
        return EvaluateMsbuildCondition(condition, props)
    }

    private func ReadDeclaredTargetPaths(projectPath string, configuration string? = nil) HashSet[string] {
        let paths = HashSet[string](StringComparer.OrdinalIgnoreCase)
        for activeRef in ReadActiveProjectReferencePaths(projectPath, configuration) {
            paths.Add(activeRef)
        }
        if string.IsNullOrEmpty(projectPath) || !File.Exists(projectPath) {
            return paths
        }
        let projectDir string? = Path.GetDirectoryName(Path.GetFullPath(projectPath))
        if string.IsNullOrEmpty(projectDir) {
            return paths
        }
        try {
            let document = XDocument.Load(projectPath)
            for element in document.Descendants().Where(
                (e XElement) -> e.Name.LocalName.Equals("Import", StringComparison.OrdinalIgnoreCase)
            ) {
                if !EvaluateSimpleMsbuildCondition(element.Attribute(XName?("Condition")!!)?.Value, configuration) {
                    continue
                }
                let rawPath = element.Attribute(XName?("Project")!!)?.Value
                if string.IsNullOrWhiteSpace(rawPath) || rawPath!!.Contains("$$(", StringComparison.Ordinal) ||
                    rawPath!!.Contains("@(", StringComparison.Ordinal) {
                    continue
                }
                let normalized = rawPath!!.Replace('\\', Path.DirectorySeparatorChar).Replace(
                    '/',
                    Path.DirectorySeparatorChar
                )
                paths.Add(Path.GetFullPath(Path.Combine(projectDir, normalized)))
            }
        } catch (ex Exception) when ex is IOException || ex is XmlException || ex is UnauthorizedAccessException {
            return paths
        }
        return paths
    }

    /// Builds a (cref:LoadedCSharpProject) from a bound Roslyn
    /// (cref:Project), seeding its diagnostics with the supplied list
    /// (e.g. workspace load failures for the primary project).
    private async func BuildLoadedProjectAsync(
        project Project,
        seedDiagnostics List[Diagnostic],
        cancellationToken CancellationToken,
        includeAutoGenerated bool,
        includedAutoGeneratedPaths IReadOnlyCollection[string]?,
        referencedWorkspaceLoadErrors IReadOnlyList[Diagnostic]? = nil
    ) LoadedCSharpProject {
        let compilation = await project.GetCompilationAsync(cancellationToken).ConfigureAwait(false)
        if compilation is not CSharpCompilation csharpCompilation {
            throw InvalidOperationException(
                "Project '${project.FilePath}' did not produce a C# compilation (language: ${project.Language})."
            )
        }
        let projectDirectory string? = Path.GetDirectoryName(project.FilePath)
        let documents = BuildDocuments(
            csharpCompilation,
            projectDirectory,
            seedDiagnostics,
            includeAutoGenerated,
            includedAutoGeneratedPaths
        )
        seedDiagnostics.AddRange(SignificantDiagnostics(csharpCompilation))
        let rootNamespace string? = ResolveRootNamespace(project)
        let resxFiles = DiscoverResxFiles(projectDirectory)
        let additionalFiles = DiscoverAdditionalFiles(project, projectDirectory)
        let analyzerReferencePaths = ResolveAnalyzerReferencePaths(project)
        let isTestProject = ReadIsTestProject(project)
        return LoadedCSharpProject(
            csharpCompilation,
            documents,
            seedDiagnostics,
            projectDirectory,
            rootNamespace,
            resxFiles,
            analyzerReferencePaths,
            additionalFiles,
            project.FilePath,
            isTestProject,
            referencedWorkspaceLoadErrors: referencedWorkspaceLoadErrors
        )
    }

    private func ReadIsTestProject(project Project) bool {
        return project
            .AnalyzerOptions
            .AnalyzerConfigOptionsProvider
            .GlobalOptions
            .TryGetValue("build_property.IsTestProject", out var isTestProject) &&
            bool.TryParse(isTestProject, out var value) && value
    }

    /// Issue #2223: the non-source generator inputs the project exposes to
    /// Roslyn analyzers/generators — the MSBuild `@(AdditionalFiles)` set
    /// (Roslyn (cref:Project.AdditionalDocuments), which Avalonia's
    /// targets populate with each `.axaml`), unioned with an explicit
    /// `*.axaml` glob under the project directory as a fallback for a
    /// workspace load that did not surface them. Files under the project's own
    /// `obj`/`bin` are excluded (generated/copied artifacts).
    private func DiscoverAdditionalFiles(project Project, projectDirectory string?) IReadOnlyList[string] {
        let seen = HashSet[string](StringComparer.OrdinalIgnoreCase)
        let result = List[string]()
        let Add = func (path string?) {
            if string.IsNullOrEmpty(path) || !File.Exists(path) {
                return
            }
            let full = Path.GetFullPath(path!!)
            if IsUnderObjOrBin(full, projectDirectory) {
                return
            }
            if seen.Add(full) {
                result.Add(full)
            }
        }
        for additional in project.AdditionalDocuments {
            Add(additional.FilePath)
        }
        if !string.IsNullOrEmpty(projectDirectory) && Directory.Exists(projectDirectory) {
            for axaml in Directory.EnumerateFiles(projectDirectory!!, "*.axaml", SearchOption.AllDirectories) {
                Add(axaml)
            }
        }
        return result.OrderBy((p string) -> p, StringComparer.OrdinalIgnoreCase).ToList()
    }

    private func IsUnderObjOrBin(fullPath string, projectDirectory string?) bool {
        if string.IsNullOrEmpty(projectDirectory) {
            return false
        }
        let objPrefix = Path.Combine(projectDirectory, "obj").Replace('\\', '/').TrimEnd('/') + "/"
        let binPrefix = Path.Combine(projectDirectory, "bin").Replace('\\', '/').TrimEnd('/') + "/"
        let normalized = fullPath.Replace('\\', '/')
        return normalized.StartsWith(objPrefix, StringComparison.OrdinalIgnoreCase) || normalized.StartsWith(
            binPrefix,
            StringComparison.OrdinalIgnoreCase
        )
    }

    /// Issue #2215: the on-disk analyzer/generator assembly paths the project
    /// references (its `<Analyzer>` items, resolved by MSBuild), so
    /// the Compile stage can forward them to gsc's `/analyzer:` flag and
    /// get the same generator output a real build of this project would
    /// produce. Only file-backed references resolve to a path; an in-memory or
    /// otherwise non-file analyzer reference is skipped.
    private func ResolveAnalyzerReferencePaths(project Project) IReadOnlyList[string] -> project
        .AnalyzerReferences
        .OfType[AnalyzerFileReference]()
        .Select((a AnalyzerFileReference) -> a.FullPath)
        .Where((p string) -> !string.IsNullOrEmpty(p) && File.Exists(p))
        .ToList()

    /// Resolves a project's effective root/default namespace (issue #2200): Roslyn's
    /// (cref:Project.DefaultNamespace) reflects MSBuild's
    /// `<RootNamespace>` for an SDK-style C# project; when unset (older
    /// non-SDK projects, or the property genuinely absent) MSBuild itself defaults
    /// `RootNamespace` to the assembly name, so falling back to
    /// (cref:Project.AssemblyName) and finally the project file's base name
    /// mirrors that same default.
    private func ResolveRootNamespace(project Project) string? {
        if !string.IsNullOrEmpty(project.DefaultNamespace) {
            return project.DefaultNamespace
        }
        if !string.IsNullOrEmpty(project.AssemblyName) {
            return project.AssemblyName
        }
        return Path.GetFileNameWithoutExtension(project.FilePath) ?? string.Empty
    }

    /// Finds every `.resx` file under [`projectDirectory`](paramref)
    /// (issue #2200), mirroring the .NET SDK's implicit default-item globbing for
    /// `EmbeddedResource` items — Roslyn's (cref:Project) does not
    /// surface `.resx` files itself, since they are an MSBuild
    /// `EmbeddedResource` item rather than an `AdditionalFiles`/document.
    /// Files under the project's own `obj`/`bin` output directories are
    /// excluded (generated/copied artifacts, not source).
    private func DiscoverResxFiles(projectDirectory string?) IReadOnlyList[string] {
        if string.IsNullOrEmpty(projectDirectory) || !Directory.Exists(projectDirectory) {
            return ImmutableArray[string].Empty
        }
        let objPrefix = Path.Combine(projectDirectory!!, "obj").Replace('\\', '/').TrimEnd('/') + "/"
        let binPrefix = Path.Combine(projectDirectory!!, "bin").Replace('\\', '/').TrimEnd('/') + "/"
        return Directory
            .EnumerateFiles(projectDirectory!!, "*.resx", SearchOption.AllDirectories)
            .Where(
            (path string) -> {
                let normalized = path.Replace('\\', '/')
                return !normalized.StartsWith(objPrefix, StringComparison.OrdinalIgnoreCase) && !normalized.StartsWith(
                    binPrefix,
                    StringComparison.OrdinalIgnoreCase
                )
            }
        )
            .OrderBy((path string) -> path, StringComparer.OrdinalIgnoreCase)
            .ToImmutableArray()
    }

    private func BuildDocuments(
        compilation CSharpCompilation,
        projectDirectory string?,
        diagnosticSink ICollection[Diagnostic],
        includeAutoGenerated bool,
        includedAutoGeneratedPaths IReadOnlyCollection[string]? = nil
    ) IReadOnlyList[LoadedDocument] {
        let documents = List[LoadedDocument]()
        for tree in compilation.SyntaxTrees {
            // OD-T4 (issue #1742): only skip a file when it is genuinely
            // build-generated — under the project's own obj/bin output, or
            // carrying the standard `<auto-generated>` header (Nerdbank.GitVersioning
            // `ThisAssembly`, SDK AssemblyInfo, resx Designer files, source-generator
            // output, ...). A hand-written file that merely happens to match a
            // generated-looking name (e.g. a hand-written `Api.Version.cs`) is kept.
            if IsGeneratedSource(tree, projectDirectory, includeAutoGenerated, includedAutoGeneratedPaths) {
                diagnosticSink.Add(Diagnostic.Create(GeneratedSourceSkippedDescriptor, Location.None, tree.FilePath))
                continue
            }
            let model = compilation.GetSemanticModel(tree, ignoreAccessibility: false)
            documents.Add(LoadedDocument(tree.FilePath, tree, model))
        }
        return documents
    }

    /// Determines whether a C# source is a build-generated artifact that should
    /// not be translated. A file is only considered generated when it lives under
    /// the project's own `obj/` or `bin/` output directories, or its text
    /// carries the standard `<auto-generated>` header — never by file
    /// name alone.
    private func IsGeneratedSource(
        tree SyntaxTree,
        projectDirectory string?,
        includeAutoGenerated bool,
        includedAutoGeneratedPaths IReadOnlyCollection[string]?
    ) bool {
        let filePath = tree.FilePath
        if string.IsNullOrEmpty(filePath) {
            return false
        }
        // The rule itself lives in GeneratedSourceDetection, shared with the
        // translator; only the includeAutoGenerated opt-in is loader-specific.
        if GeneratedSourceDetection.IsUnderBuildOutputDirectory(filePath, projectDirectory) {
            return true
        }
        if !GeneratedSourceDetection.HasAutoGeneratedHeader(tree) {
            return false
        }
        if !includeAutoGenerated ||
            (
            includedAutoGeneratedPaths != nil && !includedAutoGeneratedPaths.Contains(
                Path.GetFullPath(filePath),
                StringComparer.OrdinalIgnoreCase
            )
        ) {
            return true
        }
        return false
    }

    private func SignificantDiagnostics(compilation CSharpCompilation) IReadOnlyList[Diagnostic] -> compilation
        .GetDiagnostics()
        .Where((d Diagnostic) -> d.Severity == DiagnosticSeverity.Warning || d.Severity == DiagnosticSeverity.Error)
        .ToImmutableArray()

    /// Creates the (cref:MSBuildWorkspace) every design-time project
    /// load in this class uses. Issue #4278: under CI (`ContinuousIntegrationBuild`
    /// true, e.g. the self-migration nightly, which sets `GITHUB_ACTIONS`)
    /// the SDK's default targets turn on `DeterministicSourcePaths`, which
    /// requires `@(SourceRoot)` to resolve to a git repository. A throwaway
    /// fixture `.csproj` written under a scratch/test-output directory (or,
    /// worse, one loaded from inside the self-migration mirror, which has no
    /// `.git` by design — see `RepositoryFileInventory`) inherits this
    /// repo's root `Directory.Build.props` (SourceLink + git-versioning
    /// package references) via MSBuild's normal upward search, but has no git
    /// root to resolve against, and the design-time build fails outright with
    /// `CS2GS0001: SourceRoot items must include at least one top-level (not
    /// nested) item when DeterministicSourcePaths is true` instead of loading.
    /// This loader only ever READS a project's syntax/semantics for translation
    /// — it never persists a deterministic PathMap-mapped build output — so
    /// forcing the CI flag off for the load is safe and has no effect on any
    /// real build.
    private func CreateWorkspace(configuration string? = nil) MSBuildWorkspace {
        let properties = Dictionary[string, string]{["ContinuousIntegrationBuild"] = "false"}
        if !string.IsNullOrWhiteSpace(configuration) {
            properties["Configuration"] = configuration
        }
        return MSBuildWorkspace.Create(properties)
    }

    private func EnsureMSBuildRegistered() {
        if msbuildRegistered {
            return
        }
        lock MSBuildRegistrationLock {
            if msbuildRegistered {
                return
            }
            if !MSBuildLocator.IsRegistered {
                MSBuildLocator.RegisterDefaults()
            }
            msbuildRegistered = true
        }
    }
}
