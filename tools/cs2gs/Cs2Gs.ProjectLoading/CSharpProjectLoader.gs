/// Loads C# input into a fully bound (cref:CSharpCompilation) with a
/// (cref:SemanticModel) per file (ADR-0115 §A). Two entry points are
/// provided:
/// - (cref:LoadProjectAsync) — the primary loader that opens a real `.csproj` through Roslyn's
/// (cref:MSBuildWorkspace) (SDK resolution via (cref:MSBuildLocator)). This is the production ingestion
/// path.
/// - (cref:LoadInMemory(IReadOnlyList{ValueTuple{string, string}}, IReadOnlyList{MetadataReference},
/// string, OutputKind)) — a lightweight secondary loader that compiles in-memory C# source strings
/// against the running runtime's reference assemblies, for fast unit tests of the visitor without
/// spinning up MSBuild.
shared class CSharpProjectLoader {
    /// Diagnostic id for an MSBuild workspace load failure — the exact signal
    /// pipeline stages must gate on (issue #1742): a project that soft-failed
    /// to open (missing SDK/targets, an unresolvable project reference, an
    /// unsupported TFM, ...), as opposed to an ordinary C# semantic error in a
    /// document that did load (some corpus fixtures carry those deliberately,
    /// e.g. to exercise the later `gsc` compile-gap stage).
    const WorkspaceLoadFailureDiagnosticId string = "CS2GS0001"

    /// Diagnostic id for a benign NuGet audit vulnerability advisory (issue
    /// #2321) — a (cref:WorkspaceDiagnosticKind.Failure) MSBuildWorkspace
    /// diagnostic that (cref:NuGetAuditAdvisoryPolicy.IsBenignAdvisory(string))
    /// recognized as the stable NU1901-NU1904 advisory shape. Recorded at
    /// (cref:DiagnosticSeverity.Info) — visible in
    /// (cref:LoadedCSharpProject.LoadDiagnostics) for anything that later
    /// wants to surface it, but excluded from
    /// (cref:LoadedCSharpProject.ErrorDiagnostics) so it does not trip
    /// (cref:LoadedCSharpProject.BoundWithoutErrors) or
    /// (cref:LoadedCSharpProject.WorkspaceLoadFailed).
    const NuGetAuditAdvisoryDiagnosticId string = "CS2GS0003"

    private let MSBuildRegistrationLock object = SystemObject()

    /// Diagnostic id for an MSBuild workspace load failure (a project that
    /// soft-failed to load: missing SDK/targets, skipped project reference,
    /// wrong TFM, etc.). Surfaced as an (cref:DiagnosticSeverity.Error) so
    /// (cref:LoadedCSharpProject.BoundWithoutErrors) reflects the real
    /// state of the load instead of silently proceeding on a degraded project.
    private let MSBuildWorkspaceLoadFailureDescriptor DiagnosticDescriptor = DiagnosticDescriptor(
        id: WorkspaceLoadFailureDiagnosticId,
        title: "MSBuild workspace load failure",
        messageFormat: "MSBuild workspace failed to load the project: {0}",
        category: "Cs2Gs.Loading",
        defaultSeverity: DiagnosticSeverity.Error,
        isEnabledByDefault: true
    )

    /// Diagnostic id emitted (informationally) for each source file excluded from
    /// translation because it is genuinely build-generated (recognized by an
    /// `<auto-generated>` header or by living under the project's own
    /// `obj/`/`bin/` output directories) — never by file name alone.
    private let GeneratedSourceSkippedDescriptor DiagnosticDescriptor = DiagnosticDescriptor(
        id: "CS2GS0002",
        title: "Generated source file excluded from translation",
        messageFormat: "Skipped '{0}' because it is recognized as generated code",
        category: "Cs2Gs.Loading",
        defaultSeverity: DiagnosticSeverity.Info,
        isEnabledByDefault: true
    )

    /// Issue #2321: a NuGet audit vulnerability advisory (NU1901-NU1904 shape)
    /// that MSBuildWorkspace misclassified as a
    /// (cref:WorkspaceDiagnosticKind.Failure). Recorded informationally
    /// instead of as an error — the package still restores and builds.
    private let NuGetAuditAdvisoryDescriptor DiagnosticDescriptor = DiagnosticDescriptor(
        id: NuGetAuditAdvisoryDiagnosticId,
        title: "Benign NuGet audit vulnerability advisory",
        messageFormat: "MSBuild workspace reported a NuGet vulnerability advisory (non-fatal): {0}",
        category: "Cs2Gs.Loading",
        defaultSeverity: DiagnosticSeverity.Info,
        isEnabledByDefault: true
    )

    private var msbuildRegistered bool

    /// Opens a C# project through (cref:MSBuildWorkspace) and returns its
    /// bound compilation. Registers the SDK MSBuild via
    /// (cref:MSBuildLocator.RegisterDefaults) exactly once before the
    /// workspace is created.
    /// @param projectPath The absolute or relative path to the `.csproj`.
    /// @param cancellationToken A cancellation token.
    /// @param includeAutoGenerated Whether checked-in files carrying an auto-generated header are included.
    /// Files under build output directories remain excluded.
    /// @param includedAutoGeneratedPaths When supplied, limits auto-generated-header inclusion to these
    /// inventoried paths.
    /// @returns The loaded project with its compilation, documents, and diagnostics.
    /// @exception FileNotFoundException The project file does not exist.
    /// @exception InvalidOperationException The opened project did not produce a C# compilation.
    async func LoadProjectAsync(
        projectPath string?,
        cancellationToken CancellationToken = default(CancellationToken),
        includeAutoGenerated bool = false,
        includedAutoGeneratedPaths IReadOnlyCollection[string]? = nil
    ) LoadedCSharpProject {
        if projectPath == nil {
            throw ArgumentNullException("projectPath")
        }
        let fullPath = Path.GetFullPath(projectPath)
        if !File.Exists(fullPath) {
            throw FileNotFoundException("Project file not found: $fullPath", fullPath)
        }
        EnsureMSBuildRegistered()
        let loadDiagnostics = List[Diagnostic]()
        using let workspace = CreateWorkspace()
        workspace.LoadMetadataForReferencedProjects = true
        let project = await workspace.OpenProjectAsync(fullPath, cancellationToken: cancellationToken).ConfigureAwait(
            false
        )
        // OD-T? (issue #1742): MSBuildWorkspace can soft-fail a project load (missing
        // SDK/targets, a project reference it had to skip, an unrecognized TFM, ...)
        // without throwing. Those failures land in workspace.Diagnostics and were
        // previously never inspected, so the translator proceeded on a degraded
        // compilation and the user only saw confusing downstream binding errors.
        // Surface them as load errors so BoundWithoutErrors reflects reality.
        // Issue #2321: a benign NuGet audit vulnerability advisory (NU1901-NU1904)
        // is exempted from that gate — see ClassifyWorkspaceLoadDiagnostics.
        loadDiagnostics.AddRange(ClassifyWorkspaceLoadDiagnostics(workspace))
        return await BuildLoadedProjectAsync(
            project,
            loadDiagnostics,
            cancellationToken,
            includeAutoGenerated,
            includedAutoGeneratedPaths
        ).ConfigureAwait(false)
    }

    /// Loads a C# project together with the transitive closure of its
    /// same-solution `ProjectReference`s, each as its own bound
    /// (cref:LoadedCSharpProject). The primary (requested) project is
    /// returned first and carries any MSBuild workspace load-failure diagnostics;
    /// the referenced projects follow. This lets the migration pipeline translate
    /// sibling-project source into G# so an app's uses of sibling types resolve at
    /// the gsc compile stage (Refs #914). Package references are unaffected — they
    /// remain metadata references on each compilation.
    /// @param projectPath The absolute or relative path to the app's `.csproj`.
    /// @param cancellationToken A cancellation token.
    /// @param includeAutoGenerated Whether checked-in files carrying an auto-generated header are included.
    /// Files under build output directories remain excluded.
    /// @param includedAutoGeneratedPaths When supplied, limits auto-generated-header inclusion to these
    /// inventoried paths.
    /// @returns The primary project followed by its transitively referenced C# projects.
    async func LoadProjectWithReferencesAsync(
        projectPath string?,
        cancellationToken CancellationToken = default(CancellationToken),
        includeAutoGenerated bool = false,
        includedAutoGeneratedPaths IReadOnlyCollection[string]? = nil
    ) IReadOnlyList[LoadedCSharpProject] {
        if projectPath == nil {
            throw ArgumentNullException("projectPath")
        }
        let fullPath = Path.GetFullPath(projectPath)
        if !File.Exists(fullPath) {
            throw FileNotFoundException("Project file not found: $fullPath", fullPath)
        }
        EnsureMSBuildRegistered()
        let workspaceFailures = List[Diagnostic]()
        using let workspace = CreateWorkspace()
        // Issue #2412: unlike LoadProjectAsync, this loader's entire purpose is
        // to load referenced projects as their own bound source Projects so their
        // syntax is available to callers (e.g. cross-project oblivious-nullability
        // taint analysis, Refs #914). Setting LoadMetadataForReferencedProjects
        // makes MSBuildWorkspace collapse same-solution ProjectReferences into
        // pure metadata references instead of Solution.Projects entries, which
        // silently empties root.ProjectReferences/TransitiveCSharpProjectReferences
        // below and degrades this call to loading only the primary project — do
        // not set it here.
        let project = await workspace.OpenProjectAsync(fullPath, cancellationToken: cancellationToken).ConfigureAwait(
            false
        )
        // Issue #2321: same policy as LoadProjectAsync — a benign NuGet audit
        // vulnerability advisory must not trip the workspace-load-failure gate.
        workspaceFailures.AddRange(ClassifyWorkspaceLoadDiagnostics(workspace))
        let results = List[LoadedCSharpProject]{
            await BuildLoadedProjectAsync(
                project,
                workspaceFailures,
                cancellationToken,
                includeAutoGenerated,
                includedAutoGeneratedPaths
            ).ConfigureAwait(false)
        }
        for referenced in TransitiveCSharpProjectReferences(project) {
            results.Add(
                await BuildLoadedProjectAsync(
                    referenced,
                    List[Diagnostic](),
                    cancellationToken,
                    includeAutoGenerated,
                    includedAutoGeneratedPaths
                ).ConfigureAwait(false)
            )
        }
        return results
    }

    /// Compiles a set of in-memory C# sources into a bound compilation. This is
    /// the fast path for unit tests; it does not touch MSBuild.
    /// @param sources The `(fileName, sourceText)` pairs to compile.
    /// @param references The metadata references; when `null` the running runtime's
    /// reference assemblies (from `TRUSTED_PLATFORM_ASSEMBLIES`) are used.
    /// @param assemblyName The output assembly name.
    /// @param outputKind The compilation's output kind. Defaults to a library, so
    /// `Compilation.GetEntryPoint` is `null` and entry-point
    /// flattening (`TranslateEntryType`) is not exercised. Pass
    /// (cref:OutputKind.ConsoleApplication) to test entry-point
    /// translation (issue #1904) with this fast in-memory harness.
    /// @returns The loaded project with its compilation, documents, and diagnostics.
    func LoadInMemory(
        sources IReadOnlyList[(FileName string, Source string)]?,
        references IReadOnlyList[MetadataReference]? = nil,
        assemblyName string = "Cs2Gs.InMemory",
        outputKind OutputKind = OutputKind.DynamicallyLinkedLibrary
    ) LoadedCSharpProject {
        if sources == nil {
            throw ArgumentNullException("sources")
        }
        let parseOptions = CSharpParseOptions(LanguageVersion.Latest)
        let trees = sources.Select(
            (s(FileName string, Source string)) -> CSharpSyntaxTree.ParseText(s.Source, parseOptions, path: s.FileName)
        )
            .ToImmutableArray()
        let resolvedReferences = references ?? RuntimeReferences()
        let compilation = CSharpCompilation.Create(
            assemblyName,
            trees,
            resolvedReferences,
            CSharpCompilationOptions(outputKind).WithAllowUnsafe(true)
        )
        let loadDiagnostics = List[Diagnostic]()
        let documents = BuildDocuments(compilation, projectDirectory: nil, loadDiagnostics, includeAutoGenerated: false)
        loadDiagnostics.AddRange(SignificantDiagnostics(compilation))
        return LoadedCSharpProject(compilation, documents, loadDiagnostics)
    }

    private let CachedRuntimeReferences Lazy[IReadOnlyList[MetadataReference]] = Lazy[IReadOnlyList[MetadataReference]](
        BuildRuntimeReferences,
        LazyThreadSafetyMode.ExecutionAndPublication
    )

    /// Builds the default metadata reference set from the running runtime's
    /// trusted platform assemblies (the shared framework).
    /// @returns The metadata references for the current runtime.
    func RuntimeReferences() IReadOnlyList[MetadataReference] -> CachedRuntimeReferences.Value

    private func BuildRuntimeReferences() IReadOnlyList[MetadataReference] {
        let tpa string? = AppContext.GetData("TRUSTED_PLATFORM_ASSEMBLIES") as string
        if string.IsNullOrEmpty(tpa) {
            throw InvalidOperationException(
                "TRUSTED_PLATFORM_ASSEMBLIES is unavailable; cannot derive default runtime references."
            )
        }
        return tpa
            .Split(Path.PathSeparator, StringSplitOptions.RemoveEmptyEntries)
            .Where((path string) -> path.EndsWith(".dll", StringComparison.OrdinalIgnoreCase) && File.Exists(path))
            .Select((path string) -> cast[MetadataReference](MetadataReference.CreateFromFile(path)))
            .ToImmutableArray()
    }

    /// Enumerates the transitive closure of a project's same-solution
    /// `ProjectReference`s that produce a C# compilation, each visited once
    /// (breadth-first). The root project itself is excluded.
    private func TransitiveCSharpProjectReferences(root Project) sequence[Project] {
        let solution = root.Solution
        let seen = HashSet[ProjectId]()
        let queue = Queue[Project]()
        for reference in root.ProjectReferences {
            let referenced Project? = solution.GetProject(reference.ProjectId)
            if referenced != nil {
                queue.Enqueue(referenced)
            }
        }
        while queue.Count > 0 {
            let current = queue.Dequeue()
            if !seen.Add(current.Id) {
                continue
            }
            if string.Equals(current.Language, LanguageNames.CSharp, StringComparison.Ordinal) {
                yield current
            }
            for reference in current.ProjectReferences {
                let referenced Project? = solution.GetProject(reference.ProjectId)
                if referenced != nil && !seen.Contains(referenced.Id) {
                    queue.Enqueue(referenced)
                }
            }
        }
    }

    /// Issue #2321: classifies every (cref:WorkspaceDiagnosticKind.Failure)
    /// diagnostic MSBuildWorkspace recorded while opening a project into either
    /// a genuine (cref:MSBuildWorkspaceLoadFailureDescriptor) error, or —
    /// when (cref:NuGetAuditAdvisoryPolicy.IsBenignAdvisory(string))
    /// recognizes the message as the stable NU1901-NU1904 advisory shape — a
    /// non-fatal (cref:NuGetAuditAdvisoryDescriptor) info diagnostic.
    /// Applied identically by both (cref:LoadProjectAsync) and
    /// (cref:LoadProjectWithReferencesAsync) so neither path lets a
    /// benign vulnerability warning trip (cref:WorkspaceLoadFailureDiagnosticId)
    /// (CS2GS0001), while every other soft-fail (missing SDK/imports, an
    /// unresolvable `ProjectReference`, an unsupported TFM, NU1900
    /// audit-fetch failures, or a mixed/multiline message with any non-advisory
    /// line) remains fatal.
    private func ClassifyWorkspaceLoadDiagnostics(workspace MSBuildWorkspace) sequence[Diagnostic] {
        for diagnostic in workspace.Diagnostics {
            if diagnostic.Kind != WorkspaceDiagnosticKind.Failure {
                continue
            }
            let item Diagnostic = if NuGetAuditAdvisoryPolicy.IsBenignAdvisory(diagnostic.Message) {
                Diagnostic.Create(NuGetAuditAdvisoryDescriptor, Location.None, diagnostic.Message)
            } else {
                Diagnostic.Create(MSBuildWorkspaceLoadFailureDescriptor, Location.None, diagnostic.Message)
            }
            yield item
        }
    }

    /// Builds a (cref:LoadedCSharpProject) from a bound Roslyn
    /// (cref:Project), seeding its diagnostics with the supplied list
    /// (e.g. workspace load failures for the primary project).
    private async func BuildLoadedProjectAsync(
        project Project,
        seedDiagnostics List[Diagnostic],
        cancellationToken CancellationToken,
        includeAutoGenerated bool,
        includedAutoGeneratedPaths IReadOnlyCollection[string]?
    ) LoadedCSharpProject {
        let compilation = await project.GetCompilationAsync(cancellationToken).ConfigureAwait(false)
        if compilation is not CSharpCompilation csharpCompilation {
            throw InvalidOperationException(
                "Project '${project.FilePath}' did not produce a C# compilation (language: ${project.Language})."
            )
        }
        let projectDirectory string? = Path.GetDirectoryName(project.FilePath)
        let documents = BuildDocuments(
            csharpCompilation,
            projectDirectory,
            seedDiagnostics,
            includeAutoGenerated,
            includedAutoGeneratedPaths
        )
        seedDiagnostics.AddRange(SignificantDiagnostics(csharpCompilation))
        let rootNamespace string? = ResolveRootNamespace(project)
        let resxFiles = DiscoverResxFiles(projectDirectory)
        let additionalFiles = DiscoverAdditionalFiles(project, projectDirectory)
        let analyzerReferencePaths = ResolveAnalyzerReferencePaths(project)
        let isTestProject = ReadIsTestProject(project)
        return LoadedCSharpProject(
            csharpCompilation,
            documents,
            seedDiagnostics,
            projectDirectory,
            rootNamespace,
            resxFiles,
            analyzerReferencePaths,
            additionalFiles,
            project.FilePath,
            isTestProject
        )
    }

    private func ReadIsTestProject(project Project) bool {
        return project
            .AnalyzerOptions
            .AnalyzerConfigOptionsProvider
            .GlobalOptions
            .TryGetValue("build_property.IsTestProject", out var isTestProject) &&
            bool.TryParse(isTestProject, out var value) && value
    }

    /// Issue #2223: the non-source generator inputs the project exposes to
    /// Roslyn analyzers/generators — the MSBuild `@(AdditionalFiles)` set
    /// (Roslyn (cref:Project.AdditionalDocuments), which Avalonia's
    /// targets populate with each `.axaml`), unioned with an explicit
    /// `*.axaml` glob under the project directory as a fallback for a
    /// workspace load that did not surface them. Files under the project's own
    /// `obj`/`bin` are excluded (generated/copied artifacts).
    private func DiscoverAdditionalFiles(project Project, projectDirectory string?) IReadOnlyList[string] {
        let seen = HashSet[string](StringComparer.OrdinalIgnoreCase)
        let result = List[string]()
        let Add = func (path string?) {
            if string.IsNullOrEmpty(path) || !File.Exists(path) {
                return
            }
            let full = Path.GetFullPath(path!!)
            if IsUnderObjOrBin(full, projectDirectory) {
                return
            }
            if seen.Add(full) {
                result.Add(full)
            }
        }
        for additional in project.AdditionalDocuments {
            Add(additional.FilePath)
        }
        if !string.IsNullOrEmpty(projectDirectory) && Directory.Exists(projectDirectory) {
            for axaml in Directory.EnumerateFiles(projectDirectory!!, "*.axaml", SearchOption.AllDirectories) {
                Add(axaml)
            }
        }
        return result.OrderBy((p string) -> p, StringComparer.OrdinalIgnoreCase).ToList()
    }

    private func IsUnderObjOrBin(fullPath string, projectDirectory string?) bool {
        if string.IsNullOrEmpty(projectDirectory) {
            return false
        }
        let objPrefix = Path.Combine(projectDirectory, "obj").Replace('\\', '/').TrimEnd('/') + "/"
        let binPrefix = Path.Combine(projectDirectory, "bin").Replace('\\', '/').TrimEnd('/') + "/"
        let normalized = fullPath.Replace('\\', '/')
        return normalized.StartsWith(objPrefix, StringComparison.OrdinalIgnoreCase) || normalized.StartsWith(
            binPrefix,
            StringComparison.OrdinalIgnoreCase
        )
    }

    /// Issue #2215: the on-disk analyzer/generator assembly paths the project
    /// references (its `<Analyzer>` items, resolved by MSBuild), so
    /// the Compile stage can forward them to gsc's `/analyzer:` flag and
    /// get the same generator output a real build of this project would
    /// produce. Only file-backed references resolve to a path; an in-memory or
    /// otherwise non-file analyzer reference is skipped.
    private func ResolveAnalyzerReferencePaths(project Project) IReadOnlyList[string] -> project
        .AnalyzerReferences
        .OfType[AnalyzerFileReference]()
        .Select((a AnalyzerFileReference) -> a.FullPath)
        .Where((p string) -> !string.IsNullOrEmpty(p) && File.Exists(p))
        .ToList()

    /// Resolves a project's effective root/default namespace (issue #2200): Roslyn's
    /// (cref:Project.DefaultNamespace) reflects MSBuild's
    /// `<RootNamespace>` for an SDK-style C# project; when unset (older
    /// non-SDK projects, or the property genuinely absent) MSBuild itself defaults
    /// `RootNamespace` to the assembly name, so falling back to
    /// (cref:Project.AssemblyName) and finally the project file's base name
    /// mirrors that same default.
    private func ResolveRootNamespace(project Project) string? {
        if !string.IsNullOrEmpty(project.DefaultNamespace) {
            return project.DefaultNamespace
        }
        if !string.IsNullOrEmpty(project.AssemblyName) {
            return project.AssemblyName
        }
        return Path.GetFileNameWithoutExtension(project.FilePath) ?? string.Empty
    }

    /// Finds every `.resx` file under [`projectDirectory`](paramref)
    /// (issue #2200), mirroring the .NET SDK's implicit default-item globbing for
    /// `EmbeddedResource` items — Roslyn's (cref:Project) does not
    /// surface `.resx` files itself, since they are an MSBuild
    /// `EmbeddedResource` item rather than an `AdditionalFiles`/document.
    /// Files under the project's own `obj`/`bin` output directories are
    /// excluded (generated/copied artifacts, not source).
    private func DiscoverResxFiles(projectDirectory string?) IReadOnlyList[string] {
        if string.IsNullOrEmpty(projectDirectory) || !Directory.Exists(projectDirectory) {
            return ImmutableArray[string].Empty
        }
        let objPrefix = Path.Combine(projectDirectory!!, "obj").Replace('\\', '/').TrimEnd('/') + "/"
        let binPrefix = Path.Combine(projectDirectory!!, "bin").Replace('\\', '/').TrimEnd('/') + "/"
        return Directory
            .EnumerateFiles(projectDirectory!!, "*.resx", SearchOption.AllDirectories)
            .Where(
            (path string) -> {
                let normalized = path.Replace('\\', '/')
                return !normalized.StartsWith(objPrefix, StringComparison.OrdinalIgnoreCase) && !normalized.StartsWith(
                    binPrefix,
                    StringComparison.OrdinalIgnoreCase
                )
            }
        )
            .OrderBy((path string) -> path, StringComparer.OrdinalIgnoreCase)
            .ToImmutableArray()
    }

    private func BuildDocuments(
        compilation CSharpCompilation,
        projectDirectory string?,
        diagnosticSink ICollection[Diagnostic],
        includeAutoGenerated bool,
        includedAutoGeneratedPaths IReadOnlyCollection[string]? = nil
    ) IReadOnlyList[LoadedDocument] {
        let documents = List[LoadedDocument]()
        for tree in compilation.SyntaxTrees {
            // OD-T4 (issue #1742): only skip a file when it is genuinely
            // build-generated — under the project's own obj/bin output, or
            // carrying the standard `<auto-generated>` header (Nerdbank.GitVersioning
            // `ThisAssembly`, SDK AssemblyInfo, resx Designer files, source-generator
            // output, ...). A hand-written file that merely happens to match a
            // generated-looking name (e.g. a hand-written `Api.Version.cs`) is kept.
            if IsGeneratedSource(tree, projectDirectory, includeAutoGenerated, includedAutoGeneratedPaths) {
                diagnosticSink.Add(Diagnostic.Create(GeneratedSourceSkippedDescriptor, Location.None, tree.FilePath))
                continue
            }
            let model = compilation.GetSemanticModel(tree, ignoreAccessibility: false)
            documents.Add(LoadedDocument(tree.FilePath, tree, model))
        }
        return documents
    }

    /// Determines whether a C# source is a build-generated artifact that should
    /// not be translated. A file is only considered generated when it lives under
    /// the project's own `obj/` or `bin/` output directories, or its text
    /// carries the standard `<auto-generated>` header — never by file
    /// name alone.
    private func IsGeneratedSource(
        tree SyntaxTree,
        projectDirectory string?,
        includeAutoGenerated bool,
        includedAutoGeneratedPaths IReadOnlyCollection[string]?
    ) bool {
        let filePath = tree.FilePath
        if string.IsNullOrEmpty(filePath) {
            return false
        }
        // The rule itself lives in GeneratedSourceDetection, shared with the
        // translator; only the includeAutoGenerated opt-in is loader-specific.
        if GeneratedSourceDetection.IsUnderBuildOutputDirectory(filePath, projectDirectory) {
            return true
        }
        if !GeneratedSourceDetection.HasAutoGeneratedHeader(tree) {
            return false
        }
        if !includeAutoGenerated ||
            (
            includedAutoGeneratedPaths != nil && !includedAutoGeneratedPaths.Contains(
                Path.GetFullPath(filePath),
                StringComparer.OrdinalIgnoreCase
            )
        ) {
            return true
        }
        return false
    }

    private func SignificantDiagnostics(compilation CSharpCompilation) IReadOnlyList[Diagnostic] -> compilation
        .GetDiagnostics()
        .Where((d Diagnostic) -> d.Severity == DiagnosticSeverity.Warning || d.Severity == DiagnosticSeverity.Error)
        .ToImmutableArray()

    /// Creates the (cref:MSBuildWorkspace) every design-time project
    /// load in this class uses. Issue #4278: under CI (`ContinuousIntegrationBuild`
    /// true, e.g. the self-migration nightly, which sets `GITHUB_ACTIONS`)
    /// the SDK's default targets turn on `DeterministicSourcePaths`, which
    /// requires `@(SourceRoot)` to resolve to a git repository. A throwaway
    /// fixture `.csproj` written under a scratch/test-output directory (or,
    /// worse, one loaded from inside the self-migration mirror, which has no
    /// `.git` by design — see `RepositoryFileInventory`) inherits this
    /// repo's root `Directory.Build.props` (SourceLink + git-versioning
    /// package references) via MSBuild's normal upward search, but has no git
    /// root to resolve against, and the design-time build fails outright with
    /// `CS2GS0001: SourceRoot items must include at least one top-level (not
    /// nested) item when DeterministicSourcePaths is true` instead of loading.
    /// This loader only ever READS a project's syntax/semantics for translation
    /// — it never persists a deterministic PathMap-mapped build output — so
    /// forcing the CI flag off for the load is safe and has no effect on any
    /// real build.
    private func CreateWorkspace() MSBuildWorkspace -> MSBuildWorkspace.Create(
        Dictionary[string, string]{["ContinuousIntegrationBuild"] = "false"}
    )

    private func EnsureMSBuildRegistered() {
        if msbuildRegistered {
            return
        }
        lock MSBuildRegistrationLock {
            if msbuildRegistered {
                return
            }
            if !MSBuildLocator.IsRegistered {
                MSBuildLocator.RegisterDefaults()
            }
            msbuildRegistered = true
        }
    }
}
