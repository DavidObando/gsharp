package Cs2Gs.Pipeline

import System
import System.Collections.Generic
import System.IO
import System.Linq
import System.Threading
import System.Threading.Tasks
import System.Xml.Linq
import Cs2Gs.CodeModel.Ast
import Cs2Gs.CodeModel.Printing
import Cs2Gs.CodeModel.RoundTrip
import Cs2Gs.Translator
import Cs2Gs.Translator.Loading
import GSharp.Core.CodeAnalysis.Text
import GSharp.Formatting
import Microsoft.CodeAnalysis
import Microsoft.CodeAnalysis.CSharp
import Cs2Gs.Translator.Analyzers
import GSharp.Core.CodeAnalysis
import GSharp.Core.Resx
import System.Text
import System.Xml

/// Stage 1 (ADR-0115 §C): load the C# project, translate each document to
/// canonical G#, write the `.gs` set, and round-trip-parse every emitted
/// file with the real G# parser. Pass gate: every file parses AND zero
/// (cref:TranslationSeverity.Unsupported) diagnostics. On failure the
/// category is `translation-unsupported` and the app short-circuits.
class TranslateStage : IMigrationStage {
    /// ```xmldoc
    /// <inheritdoc />
    /// ```
    prop Kind MigrationStageKind -> MigrationStageKind.Translate

    /// ```xmldoc
    /// <inheritdoc />
    /// ```
    async func ExecuteAsync(
        context StageExecutionContext?,
        cancellationToken CancellationToken = default(CancellationToken)
    ) StageOutcome {
        if context == nil {
            throw ArgumentNullException("context")
        }
        // Issue #2412 (reopened): this must stay the ORIGINAL CompileViaSdk-gated
        // loader choice for `projects`/`project` — the values every other part of
        // this method (PE reference capture, document translation, the generated
        // `.gsproj`'s <Reference>/<ProjectReference> sets) depends on. `LoadProjectAsync`
        // sets `LoadMetadataForReferencedProjects = true`, which is why a sibling
        // ProjectReference shows up in `project.Compilation.References` as a
        // `PortableExecutableReference` pointing at the sibling's own prebuilt ref
        // assembly (e.g. `obj/Debug/net10.0/ref/Sibling.dll`) — exactly what the SDK-
        // backed compile stage needs to resolve sibling types via CLR reference
        // assemblies (Refs #914) without re-emitting the sibling's own G#.
        // `LoadProjectWithReferencesAsync` deliberately does NOT set that flag (a
        // sibling ProjectReference instead becomes a same-workspace `CompilationReference`
        // to a separately loaded source `Project`), so swapping it in here — as a
        // prior version of this fix did — silently emptied `project.Compilation`'s
        // own `PortableExecutableReference` set for every sibling, breaking every
        // downstream reference/type resolution the app's OWN generated `.gsproj` and
        // gsc compile depend on (a regression caught by re-running the real Oahu
        // corpus, not by any in-memory test). Cross-project taint analysis needs only
        // read-only sibling `CSharpCompilation`s. Linked-source declarations remap
        // by identical path, content and source span; other symbols fall back to
        // metadata identity (see `ObliviousNullabilityAnalyzer.RemapToCompilation`).
        // Neither requires object/reference identity with `project.Compilation`, so
        // the sibling graph is loaded independently below, via its own isolated
        // `LoadProjectWithReferencesAsync` call/workspace, and never touches
        // `projects`/`project` or anything derived from them.
        let projectPath = Path.GetFullPath(context.App.ProjectPath)
        let projects IReadOnlyList[LoadedCSharpProject] = if context
            .Options
            .RepositoryLoadedProjects != nil &&
            context
            .Options
            .RepositoryLoadedProjects!!.TryGetValue(projectPath, out var repositoryProject) {
            []LoadedCSharpProject{repositoryProject}
        } else {
            (
                if context.Options.CompileViaSdk {
                    []LoadedCSharpProject{
                        (
                            await CSharpProjectLoader.LoadProjectAsync(
                                projectPath,
                                cancellationToken,
                                includeAutoGenerated: context.Options.OutputLayout == MigrationOutputLayout.Repository,
                                includedAutoGeneratedPaths: context.Options.RepositorySourceFiles
                            )
                                .ConfigureAwait(false)
                        )
                    }
                } else {
                    (
                        await CSharpProjectLoader.LoadProjectWithReferencesAsync(
                            context.App.ProjectPath,
                            cancellationToken,
                            includeAutoGenerated: context.Options.OutputLayout == MigrationOutputLayout.Repository,
                            includedAutoGeneratedPaths: context.Options.RepositorySourceFiles
                        )
                            .ConfigureAwait(false)
                    )
                        .Select((loaded LoadedCSharpProject) -> loaded).ToArray()
                }
            )
        }
        let project = projects[0]
        context.IsTestProject = project.IsTestProject
        let artifacts = List[TriageArtifact]()
        Directory.CreateDirectory(context.ProjectOutputDir)
        Directory.CreateDirectory(context.ArtifactDir)
        // Issue #1742: a project that does not even bind in C# (missing SDK/
        // targets, an unresolved project reference, an unsupported TFM, ...)
        // must stop here — proceeding to translate produces only confusing
        // downstream binding errors instead of the real load failure. This is
        // scoped to the MSBuild workspace load failure signal specifically
        // (not every C# semantic error), since some corpus fixtures carry a
        // deliberate C# error to exercise a later stage (e.g. CompileGap-Library).
        if project.WorkspaceLoadFailed {
            artifacts.Add(
                context.Triage.ProjectLoadFailure(
                    MigrationStageKind.Translate,
                    TriageCategory.TranslationUnsupported,
                    project.WorkspaceLoadErrors
                )
            )
            return StageOutcome.Failed(artifacts)
        }
        // Issue #2321: a benign NuGet audit vulnerability advisory (CS2GS0003)
        // does not fail the workspace load above, but must not be dropped
        // silently either — record it in the per-app translate.log, the same
        // best-effort append-only text log TestParityStage's Note already
        // uses for non-fatal, informational events (test-parity.log).
        NoteNuGetAuditAdvisories(context, project)
        NoteCSharpBindingErrors(context, project)
        let usedOutputPaths = HashSet[string](StringComparer.OrdinalIgnoreCase)
        if context.Options.OutputLayout == MigrationOutputLayout.DiagnosticRun {
            CopyProjectFiles(project.ProjectDirectory!!, context.ProjectOutputDir, usedOutputPaths)
            CopyCentralPackageManagementFile(project.ProjectDirectory!!, context.ProjectOutputDir, context)
        }
        context.PackageReferences.AddRange(
            DeclaredProjectItems.BumpNerdbankGitVersioningVersion(
                DeclaredProjectItems
                    .Read(context.App.ProjectPath, "PackageReference")
                    .Where((item DeclaredProjectItem) -> !DeclaredProjectItems.HasMsbuildExpressionInclude(item))
                    .ToList()
            )
        )
        context.ProjectReferences.AddRange(DeclaredProjectItems.Read(context.App.ProjectPath, "ProjectReference"))
        // Issue #2412: every project's own `Compilation` in this run (app +
        // every transitively-referenced sibling), so `TranslationContext.
        // ResolveDeclaringCompilation` can redirect a whole-program fact query
        // (e.g. `ObliviousNullabilityAnalyzer`'s oblivious-taint fixpoint) for a
        // symbol declared in a REFERENCED sibling project back to that
        // sibling's OWN compilation — the one whose syntax trees actually
        // contain the tainting evidence — instead of always the current
        // document's own project compilation, which never sees it.
        //
        // Issue #2412 (reopened): under the default SDK-backed path `projects`
        // above is deliberately kept to the app's own project only (see the
        // loader comment), so it can no longer double as the sibling list here.
        // Load the transitive sibling projects a SECOND time, independently,
        // purely to bind their own compilations for this taint lookup — this
        // extra MSBuild workspace load only ever feeds `IsTainted`'s read-only
        // cross-compilation remap: identical linked-source declarations use path,
        // content and span, and other symbols use metadata identity (see
        // `ObliviousNullabilityAnalyzer.RemapToCompilation`). It is therefore safe
        // for this to be a wholly separate `Compilation` graph than `project`'s
        // own, and it never touches `projects`/`project`, PE reference capture,
        // or anything the generated `.gsproj` depends on.
        var siblingCompilations IReadOnlyList[CSharpCompilation]
        if context.Options.CompileViaSdk {
            let taintOnlyProjects = await CSharpProjectLoader.LoadProjectWithReferencesAsync(
                context.App.ProjectPath,
                cancellationToken,
                includeAutoGenerated: context.Options.OutputLayout == MigrationOutputLayout.Repository,
                includedAutoGeneratedPaths: context.Options.RepositorySourceFiles
            )
                .ConfigureAwait(false)
            siblingCompilations = taintOnlyProjects.Select((p LoadedCSharpProject) -> p.Compilation).ToList()
            // Source projects often express ProjectReference items through
            // evaluated item lists such as @(GsharpCore). Those expressions
            // are unavailable in the isolated generated project, so recover
            // the concrete paths from MSBuildWorkspace's evaluated graph.
            let knownProjectReferences = Dictionary[string, int32](StringComparer.OrdinalIgnoreCase)
            for var i = 0; i < context.ProjectReferences.Count; i++ {
                let sourceInclude string? = context.ProjectReferences[i].SourceInclude
                if !string.IsNullOrEmpty(sourceInclude) {
                    knownProjectReferences[Path.GetFullPath(sourceInclude)] = i
                }
            }
            for referencedProject in taintOnlyProjects.Skip(1) {
                if string.IsNullOrEmpty(referencedProject.ProjectPath) {
                    continue
                }
                let referencedPath = Path.GetFullPath(referencedProject.ProjectPath!!)
                let referencedAssemblyName string? = referencedProject.Compilation.AssemblyName
                if knownProjectReferences.TryGetValue(referencedPath, out var existingIndex) {
                    let existing = context.ProjectReferences[existingIndex]
                    context.ProjectReferences[existingIndex] = DeclaredProjectItem(
                        existing.ItemGroupCondition,
                        XElement(existing.Element),
                        referencedPath,
                        referencedAssemblyName
                    )
                    continue
                }
                knownProjectReferences[referencedPath] = context.ProjectReferences.Count
                context.ProjectReferences.Add(
                    DeclaredProjectItem(
                        itemGroupCondition: nil,
                        element: XElement(
                            XName?("ProjectReference")!!,
                            XAttribute(XName?("Include")!!, referencedPath)
                        ),
                        sourceInclude: referencedPath,
                        sourceAssemblyName: referencedAssemblyName
                    )
                )
            }
        } else {
            siblingCompilations = projects.Select((p LoadedCSharpProject) -> p.Compilation).ToList()
        }
        let repositoryCompilations IReadOnlyList[CSharpCompilation]? = context
            .Options
            .RepositoryLoadedProjects
            ?.Values
            .Select((p LoadedCSharpProject) -> p.Compilation)
            .ToList()
        // Translate the app itself (index 0) plus, in the no-via-sdk path,
        // its transitively referenced sibling projects (Refs #914); under the
        // default SDK-backed path `projects` above contains only the app
        // itself, so this loop's `projectIndex > 0` branch never runs there —
        // a referenced sibling is migrated and compiled as its own,
        // independent app, linked back in by the Compile stage's rewritten
        // ProjectReference/prebuilt CLR reference assembly (Refs #914), and
        // its `Compilation` is already available above via
        // `siblingCompilations` for cross-project taint resolution. Sibling
        // G# is emitted here only in the no-via-sdk path, so the app's uses
        // of sibling types resolve at the gsc compile stage; those files are
        // flagged IsFromReferencedProject so the Compile stage attributes errors
        // only to the app's own files (a sibling's own gaps are measured in its
        // own run, not charged against every dependent).
        for var projectIndex = 0; projectIndex < projects.Count; projectIndex++ {
            let currentProject = projects[projectIndex]
            let isReferencedProject = projectIndex > 0
            // Capture the external (NuGet package) assemblies each project
            // resolved against so the Compile stage can add them to gsc's
            // reference set. Only on-disk file-backed references are recorded
            // here; the Compile stage further excludes any whose file name
            // collides with a framework assembly (ref-pack / runtime
            // double-identity) and stripped sibling outputs are already absent
            // from disk (Refs #914).
            for peReference in currentProject.Compilation.References.OfType[PortableExecutableReference]() {
                let referencePath string? = peReference.FilePath
                if !string.IsNullOrEmpty(referencePath) && File.Exists(referencePath) {
                    context.ExternalReferencePaths.Add(referencePath!!)
                }
            }
            // Issue #2215: only the app's OWN analyzer/generator references
            // (not a referenced sibling project's) drive gsc's /analyzer: —
            // a sibling's generators already ran in that sibling's own
            // migration run, so re-running them here would just duplicate
            // (or, worse, collide with) output that belongs to the sibling.
            if !isReferencedProject {
                context.RootNamespace = currentProject.RootNamespace
                context.AssemblyName = currentProject.Compilation.AssemblyName
                for analyzerPath in currentProject.AnalyzerReferencePaths {
                    if ShouldForwardAnalyzer(analyzerPath) {
                        context.AnalyzerReferencePaths.Add(analyzerPath)
                    }
                }
                // Issue #2223: forward the app's non-source generator inputs
                // (.axaml) and project options so gsc's gsgen run materializes
                // file-driven generator output (e.g. Avalonia's InitializeComponent).
                for additionalFile in currentProject.AdditionalFiles {
                    let copiedPath = MirroredPath(
                        additionalFile,
                        currentProject.ProjectDirectory!!,
                        context.ProjectOutputDir
                    )
                    var spec = (
                        if File.Exists(copiedPath) {
                            copiedPath
                        } else {
                            additionalFile
                        }
                    )
                    let ext = Path.GetExtension(additionalFile)
                    if ext.Equals(".axaml", StringComparison.OrdinalIgnoreCase) || ext.Equals(
                        ".xaml",
                        StringComparison.OrdinalIgnoreCase
                    ) ||
                        ext.Equals(".paml", StringComparison.OrdinalIgnoreCase) {
                        spec += ";SourceItemGroup=AvaloniaXaml"
                    }
                    context.AdditionalGeneratorFiles.Add(spec)
                }
                if context.AdditionalGeneratorFiles.Count > 0 {
                    if !string.IsNullOrEmpty(currentProject.RootNamespace) {
                        context.GeneratorGlobalOptions.Add("RootNamespace=" + currentProject.RootNamespace)
                    }
                    if !string.IsNullOrEmpty(currentProject.ProjectDirectory) {
                        context.GeneratorGlobalOptions.Add("ProjectDir=" + context.ProjectOutputDir)
                    }
                }
            }
            // Issue #2215: exclude generator-produced parts from source-part
            // ownership decisions. They are absent from `Documents` and gsc's
            // own gsgen run adds them back later; retained source parts remain
            // standalone partial declarations (issue #3410).
            let hasAnalyzerReferences = currentProject.AnalyzerReferencePaths.Count > 0
            let retainedFilePaths List[string]? = if hasAnalyzerReferences {
                currentProject.Documents.Select((d LoadedDocument) -> d.FilePath).ToList()
            } else {
                default(List[string]?)
            }
            // ADR-0169: a project declaring Roslyn diagnostic analyzers is
            // translated in analyzer-API mode — Microsoft.CodeAnalysis usage
            // is rewritten to the G# analyzer API instead of passing through.
            // Issue #3686 (M5): so is its TEST project. The two halves of one
            // pair must translate against the SAME analyzer API — otherwise
            // the migrated tests hand a GSharpDiagnosticAnalyzer to a
            // parameter still typed Microsoft's DiagnosticAnalyzer (GS0154).
            let isAnalyzerProject = AnalyzerProjectDetector.IsAnalyzerProject(currentProject.Compilation)
            let isAnalyzerTestProject = !isAnalyzerProject && AnalyzerProjectDetector.IsAnalyzerTestProject(
                currentProject.Compilation
            )
            let analyzerApiMode = isAnalyzerProject || isAnalyzerTestProject
            if !isReferencedProject {
                context.IsAnalyzerProject = analyzerApiMode
                context.IsAnalyzerTestProject = isAnalyzerTestProject
                if context.Options.OutputLayout == MigrationOutputLayout.Repository && !string.IsNullOrEmpty(
                    context.Options.RepositorySdkMoniker
                ) &&
                    context
                    .Options
                    .GeneratedProjectPaths
                    ?.TryGetValue(Path.GetFullPath(context.App.ProjectPath), out var generatedProjectPath) == true {
                    // Issue #3780: only an analyzer test project needs the
                    // verifier package version; a repository migration with
                    // none never has to have the package built locally.
                    if isAnalyzerTestProject && string.IsNullOrEmpty(
                        context.Options.RepositoryAnalyzerVerifierPackageVersion
                    ) {
                        throw InvalidOperationException(
                            "Could not resolve a local GSharp.CodeAnalysis.Analyzers.Testing " +
                                "package for the mirrored analyzer test project '" +
                                context
                                .App
                                .ProjectPath +
                                "'."
                        )
                    }
                    GSharpProjectTransformer.Transform(
                        context.App.ProjectPath,
                        Path.GetDirectoryName(generatedProjectPath),
                        context.Options.RepositorySdkMoniker,
                        context.Options.GeneratedProjectPaths,
                        isAnalyzerTestProject,
                        context.Options.RepositoryAnalyzerVerifierPackageVersion
                    )
                        .Save(generatedProjectPath, SaveOptions.DisableFormatting)
                }
            }
            // Issue #3645: an executable another app compiles against keeps its
            // entry-point class (see PipelineOptions.ProjectsReferencedByOtherApps);
            // flattening it to top-level statements would erase the type from
            // the migrated assembly and break cross-project use sites (GS0157).
            let preserveEntryType = context
                .Options
                .ProjectsReferencedByOtherApps
                ?.Contains(Path.GetFullPath(currentProject.ProjectPath ?? context.App.ProjectPath)) == true
            // Issue #4370: exactly the documents translated below, so a
            // partial member's generated implementation counts as translated
            // when this run emits it (a git-tracked `<auto-generated>` file
            // in a repository-layout migration).
            let translatedFilePaths = currentProject
                .Documents
                .Where((d LoadedDocument) -> !IsResxDesignerCodebehind(d.FilePath))
                .Select((d LoadedDocument) -> d.FilePath)
                .ToList()
            let translator = CSharpToGSharpTranslator(
                preservePartialParts: true,
                retainedFilePaths: retainedFilePaths,
                analyzerApiMode: analyzerApiMode,
                preserveEntryType: preserveEntryType,
                projectDirectory: currentProject.ProjectDirectory,
                emitPartialMethodPairs: true,
                translatedFilePaths: translatedFilePaths
            ){ConditionalCompilation = context.Options.ConditionalCompilation}
            PreserveGeneratedFriendAssemblyAnnotations(context, currentProject, isReferencedProject, usedOutputPaths)
            // ADR-0143 2026-09-23 amendment / ADR-0192: translate EVERY unit of
            // the project first, reconciling the tentative partial method pairs
            // across all of them (only then are both parts' spellings known;
            // a mismatched pair's units are re-translated with it suppressed),
            // then print/format/write each unit exactly as before, in the same
            // order.
            let translatedDocuments = List[TranslatedDocument]()
            for document in currentProject.Documents {
                cancellationToken.ThrowIfCancellationRequested()
                if IsResxDesignerCodebehind(document.FilePath) {
                    continue
                }
                let packages IReadOnlyList[string] = if context
                    .Options
                    .OutputLayout == MigrationOutputLayout
                    .Repository {
                    cast[IReadOnlyList[string]](
                        CSharpToGSharpTranslator
                            .GetDeclaredPackages(document)
                            .OrderBy(($package string) -> $package.Count((c char) -> c == '.'))
                            .ToList()
                    )
                } else {
                    cast[IReadOnlyList[string]](Array.Empty[string]())
                }
                let translatedDocument = TranslatedDocument(document, packages)
                let unitCount = Math.Max(1, packages.Count)
                for var unitIndex = 0; unitIndex < unitCount; unitIndex++ {
                    let package_ string? = if packages.Count > 1 {
                        packages[unitIndex]
                    } else {
                        default(string?)
                    }
                    // One translator per unit, reused if the unit is
                    // re-translated (its anonymous-type registry must survive).
                    let unitTranslator = if package_ == nil {
                        translator
                    } else {
                        CSharpToGSharpTranslator(
                            preservePartialParts: true,
                            retainedFilePaths: retainedFilePaths,
                            packageFilter: package_,
                            includeFileAttributes: unitIndex == 0,
                            includeGlobalNamespace: unitIndex == 0,
                            analyzerApiMode: analyzerApiMode,
                            preserveEntryType: preserveEntryType,
                            projectDirectory: currentProject.ProjectDirectory,
                            emitPartialMethodPairs: true,
                            translatedFilePaths: translatedFilePaths
                        ){ConditionalCompilation = context.Options.ConditionalCompilation}
                    }
                    translatedDocument.Units.Add(TranslatedUnit(document, unitIndex, package_, unitTranslator))
                }
                translatedDocuments.Add(translatedDocument)
            }
            let allUnits = translatedDocuments.SelectMany(
                func (d TranslatedDocument) IEnumerable[TranslatedUnit] {
                    return d.Units
                }
            )
                .ToList()
            let stableUnits = PartialMethodPairReconciler.TranslateUntilStable(
                allUnits.Count,
                (index int32, suppressedPartialPairKeys IReadOnlyCollection[string]) -> {
                    cancellationToken.ThrowIfCancellationRequested()
                    let pending = allUnits[index]
                    // A fresh context per (re-)translation: its diagnostics are
                    // the ones this unit's final output reports.
                    let translationContext = TranslationContext(
                        currentProject.Compilation,
                        pending.Document.SemanticModel,
                        pending.Document.FilePath,
                        siblingCompilations,
                        repositoryCompilations
                    )
                    // ADR-0169 M5 / issue #3778: analyzer-test snippets are C#
                    // source embedded in the tests, and the migrated verifier
                    // compiles them as G#. The snippet translator needs a C#
                    // project loader, so it lives one assembly above the
                    // translator and is injected here.
                    translationContext.TranslateAnalyzerSnippet = SnippetTranslator.Translate
                    pending.Context = translationContext
                    try {
                        return pending.Translator.TranslateDocument(
                            pending.Document,
                            translationContext,
                            suppressedPartialPairKeys
                        )
                    } catch (ex Exception) when !(ex is OperationCanceledException) &&
                        !(ex is TranslationCrashException) {
                        // Issue #3804: annotate, do NOT absorb. A translator
                        // crash stays a crash — turning it into a diagnostic
                        // here would silently drop the file from the migrated
                        // tree and file a cs2gs defect as a language gap. All
                        // this adds is the one fact the artifact was missing:
                        // which source was on the table.
                        throw TranslationCrashException(pending.Document.FilePath, ex)
                    }
                }
            )
            for var i = 0; i < allUnits.Count; i++ {
                allUnits[i].Unit = stableUnits[i]
            }
            // Issue #4612: generic-store bridges can number in the
            // hundreds per app, so each one goes to translate.log and stderr
            // gets one count per app.
            var genericStoreBridges = 0
            for translatedDocument in translatedDocuments {
                let document = translatedDocument.Document
                let packages = translatedDocument.Packages
                var primaryGsRelativePath string? = nil
                for translatedUnit in translatedDocument.Units {
                    cancellationToken.ThrowIfCancellationRequested()
                    let unitIndex = translatedUnit.UnitIndex
                    let package_ string? = translatedUnit.Package
                    let translationContext = translatedUnit.Context
                    var printed string
                    try {
                        printed = GSharpPrinter.Print(translatedUnit.Unit)
                    } catch (ex Exception) when !(ex is OperationCanceledException) &&
                        !(ex is TranslationCrashException) {
                        // Issue #3804: see the translate loop above.
                        throw TranslationCrashException(document.FilePath, ex)
                    }
                    var formatFailure string? = nil
                    if context.Options.FormatOutput {
                        let format = GSharpFormatter.Format(SourceText.From(printed, document.FilePath))
                        if format.Diagnostics.IsEmpty {
                            printed = format.Text!!.ToString()
                        } else {
                            formatFailure = "gsfmt post-pass: " + string.Join(
                                "; ",
                                format.Diagnostics.Select(
                                    (diagnostic GSharp.Core.CodeAnalysis.Diagnostic) -> diagnostic.Message
                                )
                            )
                        }
                    }
                    var gsRelativePath string
                    if unitIndex == 0 {
                        gsRelativePath = if context.Options.OutputLayout == MigrationOutputLayout.Repository {
                            RepositoryOutputPathForSource(document.FilePath, context, usedOutputPaths)
                        } else {
                            OutputPathForSource(document.FilePath, currentProject, isReferencedProject, usedOutputPaths)
                        }
                        primaryGsRelativePath = gsRelativePath
                        if context.Options.OutputLayout == MigrationOutputLayout.Repository {
                            RegisterRepositoryTranslation(context.Options, document.FilePath, printed)
                        }
                    } else {
                        gsRelativePath = NamespaceSplitOutputPath(
                            primaryGsRelativePath,
                            package_,
                            packages[0],
                            usedOutputPaths
                        )
                        context.Options.RepositoryAdditionalFiles!!.Add(
                            Path.GetRelativePath(
                                Path.GetFullPath(context.Options.OutputRoot!!),
                                Path.Combine(context.ProjectOutputDir, gsRelativePath)
                            )
                        )
                    }
                    let gsPath = Path.Combine(context.ProjectOutputDir, gsRelativePath)
                    Directory.CreateDirectory(Path.GetDirectoryName(gsPath)!!)
                    if context.Options.OutputLayout == MigrationOutputLayout.Repository {
                        // Issue #4850: a source copied verbatim AND compiled by a
                        // translated project is dual-owned, and a checked-in `.gs` may
                        // already sit at any emitted unit's destination (the primary
                        // output or a namespace-split sibling). The first emission of a
                        // path in this run must not silently overwrite it. A repeat is
                        // allowed only for the same source with identical text (a linked
                        // source translated by several projects); anything else is two
                        // different emitters claiming one path.
                        context
                            .Options
                            .RepositoryEmittedOutputs ??= Dictionary[string, (Source string, Text string)](
                            StringComparer.OrdinalIgnoreCase
                        )
                        let fullGsPath = Path.GetFullPath(gsPath)
                        let fullSourcePath = Path.GetFullPath(document.FilePath)
                        if context.Options.RepositoryEmittedOutputs!!.TryGetValue(fullGsPath, out var prior) {
                            if !string.Equals(prior.Source, fullSourcePath, StringComparison.OrdinalIgnoreCase) ||
                                !string
                                .Equals(prior.Text, printed, StringComparison.Ordinal) {
                                throw InvalidOperationException(
                                    "Migration output collision: '${document.FilePath}' and '${prior.Source}' both emit '$gsPath'."
                                )
                            }
                        } else if File.Exists(gsPath) {
                            throw InvalidOperationException(
                                "Migration output collision: translating '${document.FilePath}' would overwrite the " +
                                    "checked-in '$gsPath'."
                            )
                        }
                        context.Options.RepositoryEmittedOutputs!![fullGsPath] = (fullSourcePath, printed)
                    }
                    File.WriteAllText(gsPath, printed)
                    let relativeGsPath = MigrationPipeline.SanitizeAppId(context.App.Id) + "/" + gsRelativePath.Replace(
                        Path.DirectorySeparatorChar,
                        '/'
                    )
                    let emitted = EmittedGsFile(gsPath, relativeGsPath, document.FilePath, printed){
                        IsFromReferencedProject = isReferencedProject
                    }
                    if context
                        .Options
                        .OutputLayout == MigrationOutputLayout.Repository &&
                        RepositoryFileInventory
                        .IsBuildOutputPath(
                        Path.GetRelativePath(
                            CanonicalRootPath.Resolve(context.Options.SourceRoot)!!,
                            CanonicalRootPath.Resolve(document.FilePath)!!
                        )
                    ) &&
                        context
                        .Options
                        .RepositorySourceFiles
                        ?.Contains(Path.GetFullPath(document.FilePath)) == false {
                        emitted.GeneratedSource = GeneratedValidationSource.Capture(
                            document.SyntaxTree.GetText().ToString(),
                            Path.GetRelativePath(
                                CanonicalRootPath.Resolve(context.Options.SourceRoot)!!,
                                CanonicalRootPath.Resolve(currentProject.ProjectPath)!!
                            )
                                .Replace('\\', '/')
                        )
                    }
                    context.EmittedFiles.Add(emitted)
                    if !isReferencedProject && formatFailure != nil {
                        artifacts.Add(context.Triage.RoundTripFailure(emitted, formatFailure))
                    }
                    if isReferencedProject {
                        continue
                    }
                    for diagnostic in translationContext.Diagnostics.Where(
                        (d TranslationDiagnostic) -> d.Severity == TranslationSeverity.Unsupported
                    ) {
                        artifacts.Add(context.Triage.TranslationUnsupported(diagnostic))
                    }
                    // Issue #3778: an analyzer-mode adaptation that is NOT a
                    // gate failure — a snippet whose [|…|] marker could not be
                    // re-placed, a multi-namespace snippet collapsed into one
                    // G# package — still changes what the migrated test
                    // asserts, so it must reach the human running the
                    // migration. Warnings are otherwise dropped here, which
                    // would make "reported, never silent" untrue.
                    for diagnostic in translationContext.Diagnostics.Where(
                        (d TranslationDiagnostic) -> d.Severity == TranslationSeverity.Warning &&
                            d.DiagnosticId == "CS2GS-ANALYZER-SNIPPET"
                    ) {
                        Console.WriteLine(
                            "cs2gs: ${diagnostic.DiagnosticId}: ${diagnostic.Message} " + "[${document.FilePath}]"
                        )
                    }
                    // Issues #4294/#4370: non-fatal translation loss or a
                    // translation caveat still reaches the run through stderr
                    // and the per-app translate.log. No triage artifact is
                    // produced, so the app result and gap ledger are unchanged.
                    for diagnostic in translationContext.Diagnostics.Where(
                        (d TranslationDiagnostic) -> d.Severity == TranslationSeverity.Warning &&
                            IsForwardedTranslationWarning(d)
                    ) {
                        let line = FormatForwardedTranslationWarning(diagnostic, document.FilePath)
                        Note(context, line)
                        if diagnostic.DiagnosticId == CSharpToGSharpTranslator.GenericStoreBridgeDiagnosticId {
                            genericStoreBridges++
                        } else {
                            Console.Error.WriteLine("cs2gs: warning: ${context.App.Id}: $line")
                        }
                    }
                    let roundTrip = GSharpRoundTrip.Validate(printed)
                    if !roundTrip.Success {
                        artifacts.Add(
                            context.Triage.RoundTripFailure(
                                emitted,
                                roundTrip.Errors.FirstOrDefault() ?? "unknown parse error"
                            )
                        )
                    }
                }
            }
            if genericStoreBridges > 0 {
                Console.Error.WriteLine(
                    "cs2gs: warning: ${context.App.Id}: $genericStoreBridges " +
                        "${CSharpToGSharpTranslator.GenericStoreBridgeDiagnosticId} site(s): a fail-fast '!!' on a " +
                        "value stored into generic storage (a type-parameter slot, an array or collection element, or a " +
                        "C# '!' on a type-parameter value), where C# would store a null (#4612). " +
                        "Each site is listed in translate.log."
                )
            }
            // Issue #2200: generate each .resx's strongly-typed codebehind via the
            // shared GSharp.Core.Resx generator instead of translating a
            // hand-authored Resources.Designer.cs (which BuildDocuments already
            // skips above as generated source, via its <auto-generated> header).
            // Without this, a `using R = ...Resources;` alias in the migrated
            // source cannot resolve (GS0157), cascading into GS0159 errors.
            for resxPath in currentProject.ResxFiles {
                cancellationToken.ThrowIfCancellationRequested()
                var generated string
                try {
                    generated = ResxCodeGenerator.GenerateFromFile(
                        resxPath,
                        currentProject.ProjectDirectory!!,
                        currentProject.RootNamespace
                    )
                } catch (ex Exception) when ex is IOException ||
                    ex is XmlException ||
                    ex is UnauthorizedAccessException {
                    // A malformed/unreadable .resx must not crash the whole
                    // Translate stage; report it (for the app's own project
                    // only, mirroring the translation-diagnostics gate below)
                    // and move on to the remaining files.
                    if !isReferencedProject {
                        // Issue #3804: an unreadable .resx is a tooling failure,
                        // not a C# construct without a G# form — it gets the
                        // crash category, and names the file it choked on.
                        artifacts.Add(
                            context.Triage.StageCrash(
                                MigrationStageKind.Translate,
                                TriageCategory.PipelineCrash,
                                "CS2GS0003",
                                ex,
                                resxPath
                            )
                        )
                    }
                    continue
                }
                let gsRelativePath = OutputPathForResx(resxPath, currentProject, isReferencedProject, usedOutputPaths)
                let gsPath = Path.Combine(context.ProjectOutputDir, gsRelativePath)
                Directory.CreateDirectory(Path.GetDirectoryName(gsPath)!!)
                File.WriteAllText(gsPath, generated)
                let relativeGsPath = MigrationPipeline.SanitizeAppId(context.App.Id) + "/" + gsRelativePath.Replace(
                    Path.DirectorySeparatorChar,
                    '/'
                )
                let emittedResx = EmittedGsFile(gsPath, relativeGsPath, resxPath, generated){
                    IsFromReferencedProject = isReferencedProject
                }
                context.EmittedFiles.Add(emittedResx)
                if isReferencedProject {
                    continue
                }
                let resxRoundTrip = GSharpRoundTrip.Validate(generated)
                if !resxRoundTrip.Success {
                    artifacts.Add(
                        context.Triage.RoundTripFailure(
                            emittedResx,
                            resxRoundTrip.Errors.FirstOrDefault() ?? "unknown parse error"
                        )
                    )
                }
            }
        }
        // Issue #2225: nbgv only generates the `ThisAssembly` source for the
        // languages its MSBuild `<Language>` switch supports; G# first shipped in
        // 3.11.13-beta. If the migrated project references an older nbgv it would
        // silently drop `ThisAssembly`. Emit a bumped copy of whichever project /
        // props file pins a below-floor nbgv literal (source is never mutated).
        EmitNerdbankGitVersioningBumps(context)
        return if artifacts.Count == 0 {
            StageOutcome.Passed()
        } else {
            StageOutcome.Failed(artifacts)
        }
    }

    // One source document's translated units (one per namespace in the
    // repository layout, otherwise exactly one), held between the translate
    // pass and the print pass so partial method pairs can be reconciled across
    // the whole project first.
    private class TranslatedDocument {
        init(document LoadedDocument, packages IReadOnlyList[string]) {
            Units = List[TranslatedUnit]()
            this.Document = document
            this.Packages = packages
        }

        prop Document LoadedDocument {
            get;
        }

        prop Packages IReadOnlyList[string] {
            get;
        }

        prop Units List[TranslatedUnit] {
            get;
        }
    }

    private class TranslatedUnit {
        init(document LoadedDocument, unitIndex int32, $package string?, translator CSharpToGSharpTranslator) {
            this.Document = document
            this.UnitIndex = unitIndex
            this.Package = $package
            this.Translator = translator
        }

        prop Document LoadedDocument {
            get;
        }

        prop UnitIndex int32 {
            get;
        }

        prop Package string? {
            get;
        }

        prop Translator CSharpToGSharpTranslator {
            get;
        }

        // The context of the unit's latest (final) translation.
        prop Context TranslationContext

        prop Unit CompilationUnit
    }

    shared {
        /// The maximum number of individual C# binding errors written to
        /// `translate.log` by (cref:NoteCSharpBindingErrors); a project
        /// bound against a stale reference assembly can report hundreds of
        /// cascading errors and the log is a diagnostic aid, not a build log.
        private const CSharpBindingErrorNoteLimit int32 = 25

        internal func FormatForwardedTranslationWarning(diagnostic TranslationDiagnostic, documentPath string) string {
            let documentIdentifier = if string.IsNullOrEmpty(documentPath) {
                "<unknown document>"
            } else {
                documentPath
            }
            var rendered = "${diagnostic.ConstructKind}: ${diagnostic.Message}"
            if diagnostic.Location is {IsInSource: true} location {
                let span = location.GetLineSpan()
                let sourcePath = if string.IsNullOrEmpty(span.Path) {
                    documentIdentifier
                } else {
                    span.Path
                }
                rendered = "$sourcePath(${span.StartLinePosition.Line + 1},${span.StartLinePosition.Character + 1}): $rendered"
            } else {
                rendered += " [$documentIdentifier]"
            }
            return "${diagnostic.DiagnosticId} (non-fatal): $rendered"
        }

        internal func ShouldForwardAnalyzer(analyzerPath string) bool -> !string.IsNullOrEmpty(analyzerPath) &&
            analyzerPath.IndexOf(
            "/Microsoft.NET.Sdk.Razor/source-generators/",
            StringComparison.OrdinalIgnoreCase
        ) < 0 &&
            analyzerPath.IndexOf(
            "\\Microsoft.NET.Sdk.Razor\\source-generators\\",
            StringComparison.OrdinalIgnoreCase
        ) < 0

        private func PreserveGeneratedFriendAssemblyAnnotations(
            context StageExecutionContext,
            project LoadedCSharpProject,
            isReferencedProject bool,
            usedOutputPaths ISet[string]
        ) {
            const attributeName = "System.Runtime.CompilerServices.InternalsVisibleToAttribute"
            let handAuthoredTrees = project
                .Documents
                .Select((document LoadedDocument) -> document.SyntaxTree)
                .ToHashSet()
            let friendAssemblies = project
                .Compilation
                .Assembly
                .GetAttributes()
                .Where(
                (attribute AttributeData) -> attribute.AttributeClass?.ToDisplayString() == attributeName &&
                    attribute
                    .ConstructorArguments
                    .Length == 1 &&
                    attribute
                    .ConstructorArguments[0]
                    .Value is string &&
                    !handAuthoredTrees.Contains((attribute.ApplicationSyntaxReference?.SyntaxTree)!!)
            )
                .Select((attribute AttributeData) -> cast[string](attribute.ConstructorArguments[0].Value))
                .Distinct(StringComparer.Ordinal)
                .ToList()
            if !isReferencedProject {
                for friendAssembly in friendAssemblies {
                    context.GeneratedFriendAssemblies.Add(friendAssembly)
                }
            }
            if context.Options.OutputLayout == MigrationOutputLayout.Repository {
                return
            }
            if friendAssemblies.Count == 0 {
                return
            }
            let source = string.Join(
                Environment.NewLine,
                friendAssemblies.Select(
                    (name string) -> "@assembly:InternalsVisibleTo(" + SymbolDisplay.FormatLiteral(name, quote: true) +
                        ")"
                )
            ) +
                Environment.NewLine
            let relativePath = UniqueOutputPath(
                PrefixReferencedProject("AssemblyInfo.gs", project, isReferencedProject),
                usedOutputPaths
            )
            let path = Path.Combine(context.ProjectOutputDir, relativePath)
            Directory.CreateDirectory(Path.GetDirectoryName(path)!!)
            File.WriteAllText(path, source)
            let emittedRelativePath = MigrationPipeline.SanitizeAppId(context.App.Id) + "/" + relativePath.Replace(
                Path.DirectorySeparatorChar,
                '/'
            )
            context.EmittedFiles.Add(
                EmittedGsFile(path, emittedRelativePath, context.App.ProjectPath, source){
                    IsFromReferencedProject = isReferencedProject
                }
            )
        }

        /// Issue #2321: records any benign NuGet audit vulnerability advisory
        /// ((cref:CSharpProjectLoader.NuGetAuditAdvisoryDiagnosticId),
        /// CS2GS0003) MSBuildWorkspace reported while opening [`project`](paramref)
        /// into the per-app `translate.log`. The advisory never fails this
        /// stage — (cref:CSharpProjectLoader) already excludes it from
        /// (cref:LoadedCSharpProject.ErrorDiagnostics) — this only keeps it
        /// from being silently dropped once (cref:LoadedCSharpProject.LoadDiagnostics)
        /// is no longer inspected past the (cref:LoadedCSharpProject.WorkspaceLoadFailed)
        /// gate above.
        private func NoteNuGetAuditAdvisories(context StageExecutionContext, project LoadedCSharpProject) {
            for advisory in project.LoadDiagnostics.Where(
                (d Microsoft.CodeAnalysis.Diagnostic) -> d.Id == CSharpProjectLoader.NuGetAuditAdvisoryDiagnosticId
            ) {
                Note(context, "NuGet audit advisory (CS2GS0003, non-fatal): " + advisory.GetMessage())
            }
        }

        /// Issue #2842: records every ordinary C# compiler error the loaded project
        /// reported into the per-app `translate.log` and onto stderr.
        ///
        /// The (cref:LoadedCSharpProject.WorkspaceLoadFailed) gate above is
        /// deliberately narrow — it stops only when MSBuild could not open the
        /// project at all — because some corpus fixtures carry a deliberate C#
        /// error to exercise a later stage (`CompileGap-Library`'s
        /// `Residual.Probe`). The cost of that narrowness was that a project
        /// whose C# genuinely does NOT bind was translated anyway, silently and
        /// with no signal: `CSharpProjectLoader.SignificantDiagnostics`
        /// already collected the errors into
        /// (cref:LoadedCSharpProject.LoadDiagnostics), but nothing past the
        /// workspace gate ever looked at them.
        ///
        /// That is not a cosmetic gap. cs2gs resolves a `ProjectReference` to
        /// the sibling's on-disk reference assembly
        /// (`obj/<Config>/ref/X.dll`), so a STALE build artifact makes a
        /// member vanish while its containing type still resolves. Roslyn then
        /// hands the translator an error type with a null symbol, every
        /// nullability predicate keyed on that symbol answers "no", and the
        /// migration emits G# that is subtly wrong in a way whose only visible
        /// symptom is an inexplicable `gsc` diagnostic in an unrelated place.
        /// That is exactly how issue #2842 presented: a stale `Oahu.Data`
        /// reference assembly turned `conversion.FailureReason` into an
        /// unbound expression, which suppressed the `!!` forgiveness and
        /// produced `GS0156` hundreds of lines downstream.
        ///
        /// Reporting is non-fatal so the deliberate-error fixtures keep exercising
        /// the stages after this one, and no triage artifact is produced so run
        /// fingerprints and the gap ledger are unchanged.
        private func NoteCSharpBindingErrors(context StageExecutionContext, project LoadedCSharpProject) {
            let errors = project.LoadDiagnostics.Where(IsCSharpCompilerError).ToList()
            if errors.Count == 0 {
                return
            }
            let header = "C# binding errors (${errors.Count}, non-fatal): the loaded C# project does not bind cleanly, so the " +
                "emitted G# is translated from partially-unbound syntax and may be silently wrong. A common cause " +
                "is a STALE build artifact — cs2gs binds each ProjectReference against the sibling's on-disk " +
                "reference assembly (obj/<Config>/ref/*.dll), so rebuild the C# solution in the same configuration " +
                "and re-run."
            Note(context, header)
            for error in errors.Take(CSharpBindingErrorNoteLimit) {
                Note(context, "  ${error.Id} ${error.Location.GetLineSpan()}: ${error.GetMessage()}")
            }
            if errors.Count > CSharpBindingErrorNoteLimit {
                Note(context, "  ... and ${errors.Count - CSharpBindingErrorNoteLimit} more.")
            }
            let warning = "cs2gs: warning: ${context.App.Id}: ${errors.Count} C# binding error(s) in the source project; " +
                "translated G# may be wrong (first: ${errors[0].Id} ${errors[0].GetMessage()}). " +
                "See translate.log; rebuild the C# solution if its build artifacts are stale."
            Console.Error.WriteLine(warning)
        }

        // Issue #4704: takes the diagnostic, not its id. DiagnosticId is null for
        // most warnings (null means "derived from the classification"), and the
        // self-migrated G# types it `string?`. Passing it to a `string` parameter
        // made cs2gs bridge the argument with a fail-fast `!!`, so the migrated
        // Translate stage threw on the first warning without an id. Comparing the
        // id here accepts null in both languages.
        private func IsForwardedTranslationWarning(
            diagnostic TranslationDiagnostic
        ) bool -> diagnostic.DiagnosticId == CSharpToGSharpTranslator.AccessorAttributeDroppedDiagnosticId ||
            diagnostic.DiagnosticId == CSharpToGSharpTranslator.LibraryImportStringReturnDiagnosticId ||
            diagnostic.DiagnosticId == CSharpToGSharpTranslator.LibraryImportCallConvDiagnosticId ||
            diagnostic.DiagnosticId == CSharpToGSharpTranslator.ConditionalCompilationDiagnosticId ||
            diagnostic.DiagnosticId == CSharpToGSharpTranslator.GenericStoreBridgeDiagnosticId

        /// True for an ordinary C# compiler error (`CS####`). cs2gs's own
        /// loader diagnostics share the `CS` prefix (`CS2GS0001`
        /// workspace-load failure, `CS2GS0003` NuGet audit advisory) and are
        /// already handled by their own gates, so they are excluded here.
        private func IsCSharpCompilerError(
            diagnostic Microsoft.CodeAnalysis.Diagnostic
        ) bool -> diagnostic.Severity == Microsoft
            .CodeAnalysis
            .DiagnosticSeverity
            .Error &&
            diagnostic
            .Id
            .StartsWith("CS", StringComparison.Ordinal) && !diagnostic.Id.StartsWith("CS2GS", StringComparison.Ordinal)

        /// A best-effort, append-only per-app text log — the Translate-stage
        /// counterpart of (cref:TestParityStage)'s identical `Note`
        /// helper (which writes `test-parity.log`). Never fails the stage on
        /// a log write.
        private func Note(context StageExecutionContext, message string) {
            try {
                File.AppendAllText(Path.Combine(context.ArtifactDir, "translate.log"), message + Environment.NewLine)
            } catch (IOException) {
                // A best-effort diagnostic log; never fail the stage on a log write.

            }
        }

        private func CopyProjectFiles(projectDirectory string, outputDirectory string, usedOutputPaths ISet[string]) {
            if string.IsNullOrEmpty(projectDirectory) || !Directory.Exists(projectDirectory) {
                return
            }
            for sourcePath in Directory.EnumerateFiles(projectDirectory, "*", SearchOption.AllDirectories) {
                let relativePath = Path.GetRelativePath(projectDirectory, sourcePath)
                if HasExcludedDirectory(relativePath) || Path.GetExtension(sourcePath).Equals(
                    ".cs",
                    StringComparison.OrdinalIgnoreCase
                ) ||
                    IsResxDesignerCodebehind(sourcePath) ||
                    Path
                    .GetExtension(sourcePath).Equals(".csproj", StringComparison.OrdinalIgnoreCase) ||
                    IsUnderDirectory(sourcePath, outputDirectory) {
                    continue
                }
                let destinationPath = Path.Combine(outputDirectory, relativePath)
                Directory.CreateDirectory(Path.GetDirectoryName(destinationPath)!!)
                File.Copy(sourcePath, destinationPath, overwrite: true)
                usedOutputPaths.Add(relativePath)
            }
        }

        private func IsResxDesignerCodebehind(sourcePath string) bool {
            let fileName = Path.GetFileName(sourcePath)
            let suffix string? = if fileName.EndsWith(".Designer.cs", StringComparison.OrdinalIgnoreCase) {
                ".Designer.cs"
            } else {
                (
                    if fileName.EndsWith(ResxCodeGenerator.DesignerFileSuffix, StringComparison.OrdinalIgnoreCase) {
                        ResxCodeGenerator.DesignerFileSuffix
                    } else {
                        default(string?)
                    }
                )
            }
            if suffix == nil {
                return false
            }
            let resxPath = Path.Combine(
                Path.GetDirectoryName(sourcePath) ?? string.Empty,
                fileName[.. ^suffix.Length] + ".resx"
            )
            return File.Exists(resxPath)
        }

        /// Locates the ancestor `Directory.Packages.props` that governs the
        /// source project (Central Package Management) and writes it into the
        /// generated app root — the file NuGet actually restores the generated
        /// `.gsproj` against. Issue #2319: a below-floor literal nbgv
        /// `PackageVersion` is bumped here, in this copy, using the same
        /// (cref:NerdbankGitVersioningPolicy.TryBumpProjectXml) the
        /// project-file bump path already uses — the previous behavior copied the
        /// file verbatim and wrote the bumped text to an inert
        /// `nbgv-bump/Directory.Packages.props` that nothing ever restored
        /// against, so NuGet still saw the below-floor version while
        /// (cref:SdkCompileRunner) independently emitted a bumped
        /// `Version=` attribute on the generated NBGV `PackageReference` —
        /// a combination Central Package Management rejects outright (NU1008).
        /// Also records on [`context`](paramref) whether the copied file
        /// actually enables CPM (`ManagePackageVersionsCentrally`), so the
        /// `--via-sdk` compile path knows to omit `Version=` from any
        /// `PackageReference` it synthesizes rather than reconstructs
        /// verbatim from the source project.
        private func CopyCentralPackageManagementFile(
            projectDirectory string,
            outputDirectory string,
            context StageExecutionContext
        ) {
            var directory string? = projectDirectory
            while !string.IsNullOrEmpty(directory) {
                let sourcePath = Path.Combine(directory, "Directory.Packages.props")
                if File.Exists(sourcePath) {
                    var original string
                    try {
                        original = File.ReadAllText(sourcePath)
                    } catch (ex Exception) when ex is IOException || ex is UnauthorizedAccessException {
                        return
                    }
                    let content = if NerdbankGitVersioningPolicy.TryBumpProjectXml(original, out var bumped) {
                        bumped
                    } else {
                        original
                    }
                    File.WriteAllText(Path.Combine(outputDirectory, "Directory.Packages.props"), content)
                    context.UsesCentralPackageManagement = CentralPackageManagementPolicy.IsEnabled(
                        projectDirectory,
                        directory,
                        content
                    )
                    return
                }
                directory = Directory.GetParent(directory)?.FullName
            }
        }

        private func OutputPathForSource(
            sourcePath string,
            project LoadedCSharpProject,
            isReferencedProject bool,
            usedOutputPaths ISet[string]
        ) string {
            var relativePath = RelativeSourcePath(sourcePath, project.ProjectDirectory!!)
            relativePath = Path.ChangeExtension(relativePath, ".gs")
            return UniqueOutputPath(
                PrefixReferencedProject(relativePath, project, isReferencedProject),
                usedOutputPaths
            )
        }

        private func RepositoryOutputPathForSource(
            sourcePath string,
            context StageExecutionContext,
            usedOutputPaths ISet[string]
        ) string {
            let sourceRelativePath = Path.GetRelativePath(context.Options.SourceRoot!!, sourcePath)
            if IsOutsideDirectory(sourceRelativePath) {
                throw InvalidOperationException(
                    "Source file '$sourcePath' is outside repository root '${context.Options.SourceRoot}'."
                )
            }
            let destinationPath = Path.Combine(
                Path.GetFullPath(context.Options.OutputRoot!!),
                Path.ChangeExtension(sourceRelativePath, ".gs")
            )
            let relativeToProject = Path.GetRelativePath(context.ProjectOutputDir, destinationPath)
            if !usedOutputPaths.Add(relativeToProject) {
                throw InvalidOperationException("Multiple C# documents map to repository output '$destinationPath'.")
            }
            return relativeToProject
        }

        private func NamespaceSplitOutputPath(
            primaryPath string?,
            $package string?,
            primaryPackage string,
            usedOutputPaths ISet[string]
        ) string {
            var suffix string? = if $package!!.StartsWith(primaryPackage + ".", StringComparison.Ordinal) {
                $package!![(primaryPackage.Length + 1) ..]
            } else {
                $package
            }
            suffix = suffix!!.Replace('.', '_')
            let splitPath = Path.Combine(
                Path.GetDirectoryName(primaryPath) ?? string.Empty,
                Path.GetFileNameWithoutExtension(primaryPath) + "." + suffix + ".gs"
            )
            if !usedOutputPaths.Add(splitPath) {
                throw InvalidOperationException("Multiple namespace outputs map to repository output '$splitPath'.")
            }
            return splitPath
        }

        private func RegisterRepositoryTranslation(options PipelineOptions, sourcePath string, generated string) {
            let canonicalSourcePath = Path.GetFullPath(sourcePath)
            options.RepositoryTranslations ??= Dictionary[string, string](StringComparer.OrdinalIgnoreCase)
            if options.RepositoryTranslations!!.TryGetValue(canonicalSourcePath, out var priorGenerated) {
                if !string.Equals(priorGenerated, generated, StringComparison.Ordinal) {
                    let priorLines = priorGenerated.Split('\n')
                    let currentLines = generated.Split('\n')
                    var line = 0
                    while line < priorLines.Length && line < currentLines.Length && string.Equals(
                        priorLines[line],
                        currentLines[line],
                        StringComparison.Ordinal
                    ) {
                        line++
                    }
                    // Issue #3804: one line of each side is not enough to act on —
                    // the two renderings routinely differ in how one expression is
                    // BROKEN ACROSS lines, so the first differing line can be a
                    // bare prefix that says nothing about what actually changed.
                    // Print a short window of both.
                    throw InvalidOperationException(
                        "Linked source '$sourcePath' translates differently in multiple projects. " +
                            (`First divergence at line ` + "${line + 1}" + `.
`) +
                            (`  prior (as translated by the first project to reach it):
` + "${Window(priorLines, line)}") +
                            (`  current (as translated by this app):
` + "${Window(currentLines, line)}")
                    )
                }
                return
            }
            options.RepositoryTranslations!![canonicalSourcePath] = generated
        }

        /// Renders a few lines of [`lines`](paramref) around
        /// [`index`](paramref), for the linked-source divergence report
        /// (issue #3804).
        /// @param lines The translated file, split into lines.
        /// @param index The zero-based index of the first differing line.
        /// @returns The rendered window, one indented line per entry.
        private func Window(lines[]string, index int32) string {
            const Context = 2
            let window = StringBuilder()
            for var i = Math.Max(0, index - Context); i < Math.Min(lines.Length, index + Context + 1); i++ {
                window
                    .Append(
                    if i == index {
                        "  > "
                    } else {
                        "    "
                    }
                )
                    .Append(lines[i].TrimEnd())
                    .Append('\n')
            }
            if index >= lines.Length {
                window.Append("  > <eof>\n")
            }
            return window.ToString()
        }

        private func OutputPathForResx(
            sourcePath string,
            project LoadedCSharpProject,
            isReferencedProject bool,
            usedOutputPaths ISet[string]
        ) string {
            var relativePath = RelativeSourcePath(sourcePath, project.ProjectDirectory!!)
            let directory string? = Path.GetDirectoryName(relativePath)
            let fileName = Path.GetFileNameWithoutExtension(relativePath) + ResxCodeGenerator.DesignerFileSuffix
            relativePath = if string.IsNullOrEmpty(directory) {
                fileName
            } else {
                Path.Combine(directory!!, fileName)
            }
            return UniqueOutputPath(
                PrefixReferencedProject(relativePath, project, isReferencedProject),
                usedOutputPaths
            )
        }

        private func PrefixReferencedProject(
            relativePath string,
            project LoadedCSharpProject,
            isReferencedProject bool
        ) string {
            if !isReferencedProject {
                return relativePath
            }
            var projectName = project.Compilation.AssemblyName ?? "ReferencedProject"
            for invalid in Path.GetInvalidFileNameChars() {
                projectName = projectName.Replace(invalid, '_')
            }
            return Path.Combine(".references", projectName, relativePath)
        }

        private func RelativeSourcePath(sourcePath string, projectDirectory string) string {
            let relativePath = Path.GetRelativePath(projectDirectory, sourcePath)
            return if IsOutsideDirectory(relativePath) {
                Path.GetFileName(sourcePath)
            } else {
                relativePath
            }
        }

        private func UniqueOutputPath(relativePath string, usedOutputPaths ISet[string]) string {
            if usedOutputPaths.Add(relativePath) {
                return relativePath
            }
            let directory string? = Path.GetDirectoryName(relativePath)
            let extension = Path.GetExtension(relativePath)
            let baseName = Path.GetFileNameWithoutExtension(relativePath)
            for var suffix = 2; ; suffix++ {
                let fileName = baseName + "." + suffix.ToString() + extension
                let candidate = if string.IsNullOrEmpty(directory) {
                    fileName
                } else {
                    Path.Combine(directory!!, fileName)
                }
                if usedOutputPaths.Add(candidate) {
                    return candidate
                }
            }
        }

        private func MirroredPath(sourcePath string, projectDirectory string, outputDirectory string) string {
            let relativePath = Path.GetRelativePath(projectDirectory, sourcePath)
            return if IsOutsideDirectory(relativePath) {
                sourcePath
            } else {
                Path.Combine(outputDirectory, relativePath)
            }
        }

        private func HasExcludedDirectory(relativePath string) bool {
            let segments = relativePath.Split(
                []char{Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar},
                StringSplitOptions.RemoveEmptyEntries
            )
            return segments.Any(
                (s string) -> s.Equals("bin", StringComparison.OrdinalIgnoreCase) || s.Equals(
                    "obj",
                    StringComparison.OrdinalIgnoreCase
                )
            )
        }

        private func IsOutsideDirectory(relativePath string) bool -> Path.IsPathRooted(relativePath) ||
            relativePath.Equals("..", StringComparison.Ordinal) || relativePath.StartsWith(
            ".." + Path.DirectorySeparatorChar,
            StringComparison.Ordinal
        ) ||
            relativePath.StartsWith(".." + Path.AltDirectorySeparatorChar, StringComparison.Ordinal)

        private func IsUnderDirectory(path string, directory string) bool {
            let relativePath = Path.GetRelativePath(directory, path)
            return !IsOutsideDirectory(relativePath)
        }

        /// Scans the app's own `.csproj` plus every ancestor
        /// `Directory.Packages.props`/`Directory.Build.props` for a literal
        /// `Nerdbank.GitVersioning` version below
        /// (cref:NerdbankGitVersioningPolicy.MinimumGSharpVersion) and, when
        /// found, writes a bumped copy into `<AppRunDir>/nbgv-bump/` alongside
        /// a manifest recording the source path. The original files are never touched
        /// (the corpus tree is read-only); the migrated project can adopt the bumped
        /// file so nbgv produces the G# `ThisAssembly` source (issue #2225).
        /// Also resolves, across the same candidate set, the nbgv package's effective
        /// id/version/`PrivateAssets`/`IncludeAssets` declaration and — when
        /// found — records it on (cref:StageExecutionContext.BuildOnlyPackageReferences)
        /// so the `--via-sdk` compile path can re-declare it in the isolated
        /// gsproj (issue #2267): nbgv is a build/dev-only dependency that contributes
        /// no compile-time reference DLL, so it would otherwise be silently dropped
        /// and its `ThisAssembly` source generator would never run.
        private func EmitNerdbankGitVersioningBumps(context StageExecutionContext) {
            let candidates = List[string]()
            let projectPath = context.App.ProjectPath
            if !string.IsNullOrEmpty(projectPath) && File.Exists(projectPath) {
                candidates.Add(projectPath)
            }
            var dir string? = Path.GetDirectoryName(projectPath)
            while !string.IsNullOrEmpty(dir) {
                for name in[]string{"Directory.Packages.props", "Directory.Build.props"} {
                    let candidate = Path.Combine(dir, name)
                    if File.Exists(candidate) {
                        candidates.Add(candidate)
                    }
                }
                let parent DirectoryInfo? = Directory.GetParent(dir)
                dir = parent?.FullName
            }
            var outputDir string? = nil
            let manifest = List[string]()
            let usedNames = HashSet[string](StringComparer.OrdinalIgnoreCase)
            var nbgvFound = false
            var rawVersion string? = nil
            var privateAssets string? = nil
            var includeAssets string? = nil
            for candidate in candidates {
                var original string
                try {
                    original = File.ReadAllText(candidate)
                } catch (ex Exception) when ex is IOException || ex is UnauthorizedAccessException {
                    continue
                }
                // Issue #2267: combine the nbgv declaration across every candidate
                // file — CPM commonly splits it between a versionless
                // <PackageReference PrivateAssets="all"> (project/Directory.Build.props)
                // and the actual <PackageVersion Version="..."> (Directory.Packages.props).
                if NerdbankGitVersioningPolicy.TryFindDeclaration(
                    original,
                    out var candidateVersion,
                    out var candidatePrivateAssets,
                    out var candidateIncludeAssets
                ) {
                    nbgvFound = true
                    rawVersion ??= candidateVersion
                    privateAssets ??= candidatePrivateAssets
                    includeAssets ??= candidateIncludeAssets
                }
                if !NerdbankGitVersioningPolicy.TryBumpProjectXml(original, out var bumped) {
                    continue
                }
                if outputDir == nil {
                    outputDir = Path.Combine(context.ArtifactDir, "nbgv-bump")
                    Directory.CreateDirectory(outputDir)
                }
                let baseName = Path.GetFileName(candidate)
                var outName = baseName
                var suffix = 1
                while !usedNames.Add(outName) {
                    outName = Path.GetFileNameWithoutExtension(baseName) + "." + suffix.ToString() + Path.GetExtension(
                        baseName
                    )
                    suffix++
                }
                File.WriteAllText(Path.Combine(outputDir, outName), bumped)
                manifest.Add(outName + " <- " + candidate)
            }
            if outputDir != nil && manifest.Count > 0 {
                let manifestText = "# Nerdbank.GitVersioning bumped to " +
                    NerdbankGitVersioningPolicy.MinimumGSharpVersion +
                    " for G# ThisAssembly support (issue #2225)." +
                    Environment.NewLine +
                    "# Each line: <emitted file> <- <original source file>." +
                    Environment.NewLine +
                    string.Join(Environment.NewLine, manifest) + Environment.NewLine
                File.WriteAllText(Path.Combine(outputDir, "manifest.txt"), manifestText)
            }
            if nbgvFound {
                context.BuildOnlyPackageReferences.Add(
                    DeclaredPackageReference(
                        NerdbankGitVersioningPolicy.PackageId,
                        NerdbankGitVersioningPolicy.ResolveEffectiveVersion(rawVersion)!!,
                        privateAssets ?? "all",
                        includeAssets
                    )
                )
            }
        }
    }
}
