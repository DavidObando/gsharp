package Cs2Gs.Translator

import Cs2Gs.CodeModel.Ast
import Cs2Gs.CodeModel.Printing
import Cs2Gs.Translator.Analyzers
import Cs2Gs.Translator.Loading
import IdentifierNameContext = GSharp.Core.CodeAnalysis.Syntax.IdentifierNameContext
import Microsoft.CodeAnalysis
import Microsoft.CodeAnalysis.CSharp
import Microsoft.CodeAnalysis.CSharp.Syntax
import Microsoft.CodeAnalysis.Operations
import Microsoft.CodeAnalysis.Text
import System
import System.Collections.Generic
import System.Collections.Immutable
import System.Globalization
import System.Linq
import System.Runtime.CompilerServices
import System.Threading

/// The C#→G# translation entry point (ADR-0115 §A). It walks a bound C#
/// document and builds a (cref:CompilationUnit) of the
/// (cref:Cs2Gs.CodeModel) emit AST that the canonical pretty-printer
/// consumes.
///
/// This is the <b>step-6</b> declaration mapper: it fully maps namespaces,
/// imports, type declarations (class/struct/data-class/data-struct/interface/
/// enum), and member <i>signatures</i> + fields (ADR-0115 §B.1, §B.3–§B.12).
/// Method / property / constructor <i>bodies</i> are routed through the single
/// (cref:DeclarationVisitor.TranslateBody) seam, which emits a minimal,
/// parseable placeholder block today; step 7 replaces that implementation with
/// real statement / expression translation. Every construct with no canonical
/// G# form is recorded as a structured (cref:TranslationDiagnostic)
/// rather than being silently dropped (ADR-0115 §B/§D).
partial class CSharpToGSharpTranslator {
    // ADR-0145 (§C/§D) / issue #3410: preserve each C# `partial` declaration as
    // a standalone G# `partial` part by default. This keeps members in the G#
    // file corresponding to their declaring C# file and lets the G# compiler's
    // partial-type merger combine the parts. The legacy issue #1910 translation
    // shape remains available when false: all parts merge into one non-partial
    // G# declaration emitted in the primary file.
    private let preservePartialParts bool

    // Issue #2215: when the legacy merge path (`!preservePartialParts`) is used,
    // the MERGED result keeps a `partial` modifier when the
    // C# source itself was `partial` — so gsc's own `/analyzer:`-triggered
    // gsgen run can later add a real, additional generated `partial` part
    // (ADR-0145) that merges into this type instead of colliding with it
    // (GS0475/GS0102). Set by the caller only for a project that actually has
    // analyzer references; every other translation is byte-for-byte unchanged.
    private let markMergedTypePartial bool

    // Issue #2610: generator-produced nullable-oblivious reference fields
    // (Avalonia x:Name fields are the common case) must remain nullable when
    // back-translated. This is generator-host behavior, not a consequence of
    // preserving ordinary source partial declarations (issue #3410).
    private let widenObliviousReferenceFields bool

    // Issue #2215: when set, restricts the "other partial parts to merge in"
    // set (`CollectPartialTypeParts`, built from `INamedTypeSymbol.
    // DeclaringSyntaxReferences` across the WHOLE compilation) to only the
    // documents the caller actually kept for translation. Without this, a
    // generator-produced partial part that `CSharpProjectLoader.BuildDocuments`
    // correctly excludes as generated (so it is NOT translated on its own)
    // still gets its members silently merged into the primary part here —
    // duplicating what gsc's own `/analyzer:`-triggered gsgen run later adds
    // (GS0102). Null (default) preserves the exact prior no-filter behavior.
    private let retainedFilePaths HashSet[string]?

    // Issue #4370: the exact file set this run translates (every document the
    // caller will hand to TranslateDocument), or null when unknown. Unlike
    // retainedFilePaths it is authoritative for "is this part translated?":
    // a repository-layout migration also translates git-tracked
    // `<auto-generated>` files, which the header heuristic would call
    // untranslated.
    private let translatedFilePaths HashSet[string]?

    // ADR-0192 / ADR-0143 amendment: when true, a hand-authored implemented C#
    // partial method may be emitted as a TENTATIVE G# partial pair (both
    // parts tagged with MethodDeclaration.PartialPairKey). The caller MUST
    // translate the project through PartialMethodPairReconciler.
    // TranslateUntilStable, which compares both files' spellings and
    // re-translates a mismatched pair's units with it suppressed. False
    // (default) keeps the single-implementation shape.
    private let emitPartialMethodPairs bool

    // ADR-0192 follow-on 2 (gsgen): when true, a C# partial method
    // IMPLEMENTATION whose definition lives in a tree this run does not emit
    // (the gsgen stub rendered from the user's G# declaring part) is emitted
    // as a G# implementing part (`partial func` with its body). Only the
    // source-generator host enables it; see GeneratedImplementingPartDefinition.
    private let emitGeneratedImplementingParts bool

    // Issues #5252/#5253 (gsgen): the types the stub rendered abstract only
    // semantically, keyed by (cref:SemanticAbstractTypeKey), each with
    // whether the user declared it `open`. Null or empty for none.
    private let semanticOnlyAbstractTypes IReadOnlyDictionary[string, bool]?

    // The translated project's directory, when known, so the translator applies
    // the loader's full generated-source rule (the obj/bin path half of
    // GeneratedSourceDetection) to a partial method's other part.
    private let projectDirectory string?

    private let packageFilter string?
    private let includeFileAttributes bool
    private let includeGlobalNamespace bool
    private let analyzerApiMode bool

    // Issue #3645: when true, the C# entry-point class is always preserved as
    // a G# class (with a class-scoped static `Main`, issue #1996) instead of
    // being flattened to top-level statements (ADR-0115 §B.11 T3). Set by the
    // pipeline for an executable project that is itself referenced by another
    // project in the same migration run — its entry class is consumable API
    // surface (e.g. `GsgenProgram.Run(...)` from a test project), and
    // flattening it erases the type from the migrated assembly (GS0157 at
    // every cross-project use site).
    private let preserveEntryType bool

    // One registry per resolved G# package deduplicates declarations across
    // documents (#2292). Synthetic names themselves are derived from the full
    // ordered shape (#2598), so distinct shapes cannot reuse a simple name
    // across imported packages or independently translated projects.
    private let anonymousTypeRegistriesByPackage Dictionary[string, AnonymousTypeRegistry] = Dictionary[
        string,
        AnonymousTypeRegistry
    ](StringComparer.Ordinal)

    /// Initializes a new instance of the (cref:CSharpToGSharpTranslator) class.
    /// @param preservePartialParts When `true` (default), each C# `partial`
    /// declaration is translated as a standalone G# `partial` part with
    /// no cross-part merge, preserving source-file member ownership (issue
    /// #3410). When `false`, all parts are merged into one
    /// non-partial G# type (legacy issue #1910 behavior).
    /// @param markMergedTypePartial When `true`, the merged type produced by the legacy
    /// ([`preservePartialParts`](paramref) `false`) path
    /// keeps a G# `partial` modifier if the C# source declared the type
    /// `partial` (issue #2215: the project has analyzer/generator
    /// references, so gsc's own gsgen run will add another real partial part
    /// afterward). Ignored when [`preservePartialParts`](paramref) is
    /// `true` (that mode already always carries the modifier).
    /// @param retainedFilePaths The caller's own file set considered eligible for translation (issue
    /// #2215). When supplied, partial declarations outside this set (i.e.
    /// excluded as generated) do not participate in legacy merging or
    /// source-part ownership selection. Pass `null` (default)
    /// to keep every part regardless of file.
    /// @param packageFilter When supplied, emits only declarations whose containing namespace
    /// matches this package.
    /// @param includeFileAttributes When `false`, omits compilation-unit assembly/module
    /// attributes. Used for secondary package-split outputs so file-level
    /// metadata is emitted once.
    /// @param includeGlobalNamespace With [`packageFilter`](paramref), also emits the document's
    /// global-namespace declarations (and top-level statements) into this
    /// unit's package. A package-split caller passes `true`
    /// for exactly one unit, so a global type lands where the unsplit
    /// translation hoists it (a package) instead of matching no filter and
    /// vanishing. Ignored without [`packageFilter`](paramref).
    /// @param widenObliviousReferenceFields When `true`, nullable-oblivious reference fields are
    /// emitted as nullable. Used by the source-generator host for generated
    /// partial parts (issue #2610); ordinary source translation leaves this
    /// `false`.
    /// @param analyzerApiMode ADR-0169 analyzer translation mode: Microsoft.CodeAnalysis usage is
    /// rewritten to the G# analyzer API via (cref:Analyzers.RoslynAnalyzerApiMap).
    /// Enabled by the pipeline when (cref:Analyzers.AnalyzerProjectDetector)
    /// recognizes an analyzer project.
    /// @param preserveEntryType When `true`, the C# entry-point class is preserved as a
    /// G# class with a class-scoped static `Main` instead of being
    /// flattened to top-level statements (issue #3645). Set by the pipeline for
    /// an executable project referenced by another project in the same run,
    /// whose entry class is consumable API surface.
    /// @param emitPartialMethodPairs When `true`, hand-authored implemented C# partial
    /// methods may be emitted as tentative ADR-0192 partial pairs; the caller
    /// must translate every unit of the project through
    /// (cref:PartialMethodPairReconciler.TranslateUntilStable) before
    /// printing.
    /// Default `false`: the implementation alone is emitted.
    /// @param translatedFilePaths Issue #4370: every file path this run translates, or
    /// `null` when the caller does not know the full set.
    /// Decides whether a generated partial-member implementation is
    /// translated alongside its definition; without it the
    /// `<auto-generated>`/obj heuristic is used.
    /// @param emitGeneratedImplementingParts ADR-0192 follow-on 2: when `true`, a partial method
    /// implementation whose definition is in a tree this run does not
    /// translate is emitted as a G# implementing part (`partial func`
    /// with its body), to pair with the user's hand-written G# declaring part.
    /// Used only by the source-generator host (gsgen), whose definitions live
    /// in the stub rendered from the user's G#; pass
    /// [`translatedFilePaths`](paramref) with it. Default
    /// `false`: such an implementation is an ordinary method.
    /// @param projectDirectory The translated project's directory, or `null` when
    /// unknown (in-memory sources). Used only to recognize a partial method
    /// part in a build-generated file ((cref:Loading.GeneratedSourceDetection)).
    /// @param semanticOnlyAbstractTypes Issues #5252/#5253: the types the gsgen stub rendered
    /// `abstract` only because they inherit unimplemented abstract members, keyed by
    /// (cref:SemanticAbstractTypeKey) and mapped to whether the user declared
    /// them `open`. A generated part of such a type states neither `abstract` nor
    /// `open` (the user's part states the shape, gsc unions the parts) and its
    /// members are `open` only when the user declared the type `open`. `null`
    /// (default) for none.
    init(
        preservePartialParts bool = true,
        markMergedTypePartial bool = false,
        retainedFilePaths IReadOnlyCollection[string]? = nil,
        packageFilter string? = nil,
        includeFileAttributes bool = true,
        widenObliviousReferenceFields bool = false,
        analyzerApiMode bool = false,
        preserveEntryType bool = false,
        projectDirectory string? = nil,
        emitPartialMethodPairs bool = false,
        translatedFilePaths IReadOnlyCollection[string]? = nil,
        emitGeneratedImplementingParts bool = false,
        includeGlobalNamespace bool = false,
        semanticOnlyAbstractTypes IReadOnlyDictionary[string, bool]? = nil
    ) {
        // Arms the telemetry's exit dump (when requested) for every run that
        // translates, including one in which no forgiveness rule ever fires.
        NullForgivenessTelemetry.EnsureInitialized()
        this.emitGeneratedImplementingParts = emitGeneratedImplementingParts
        this.semanticOnlyAbstractTypes = semanticOnlyAbstractTypes
        this.includeGlobalNamespace = includeGlobalNamespace
        this.translatedFilePaths = if translatedFilePaths == nil {
            default(HashSet[string]?)
        } else {
            HashSet[string](translatedFilePaths, StringComparer.Ordinal)
        }
        this.projectDirectory = projectDirectory
        this.emitPartialMethodPairs = emitPartialMethodPairs
        this.analyzerApiMode = analyzerApiMode
        this.preserveEntryType = preserveEntryType
        this.preservePartialParts = preservePartialParts
        this.markMergedTypePartial = markMergedTypePartial
        this.widenObliviousReferenceFields = widenObliviousReferenceFields
        this.retainedFilePaths = if retainedFilePaths == nil {
            default(HashSet[string]?)
        } else {
            HashSet[string](retainedFilePaths, StringComparer.Ordinal)
        }
        this.packageFilter = packageFilter
        this.includeFileAttributes = includeFileAttributes
    }

    /// Translates a loaded C# document into a G# (cref:CompilationUnit),
    /// recording any unsupported constructs on a fresh context. Use
    /// (cref:TranslateDocument(LoadedDocument, TranslationContext)) when the
    /// caller needs to inspect the recorded diagnostics.
    /// @param document The bound C# document to translate.
    /// @returns The G# compilation unit.
    func TranslateDocument(document LoadedDocument) CompilationUnit {
        let context = TranslationContext(
            cast[CSharpCompilation](document.SemanticModel.Compilation),
            document.SemanticModel,
            document.FilePath
        )
        return this.TranslateDocument(document, context)
    }

    /// Translates a loaded C# document into a G# (cref:CompilationUnit),
    /// recording any unsupported constructs on the supplied context.
    /// @param document The bound C# document to translate.
    /// @param context The translation context that accumulates diagnostics.
    /// @returns The G# compilation unit.
    func TranslateDocument(
        document LoadedDocument,
        context TranslationContext
    ) CompilationUnit -> this.TranslateDocument(document, context, suppressedPartialPairKeys: nil)

    /// Translates a loaded C# document, treating every partial method whose
    /// pair key ((cref:MethodDeclaration.PartialPairKey)) is in
    /// [`suppressedPartialPairKeys`](paramref) as if
    /// `emitPartialMethodPairs` were off: no declaring part, and the
    /// implementation emitted as an ordinary method. Used by
    /// (cref:PartialMethodPairReconciler.TranslateUntilStable) to
    /// re-translate the units of a pair whose two parts did not spell the same
    /// signature.
    /// @param document The bound C# document to translate.
    /// @param context The translation context that accumulates diagnostics.
    /// @param suppressedPartialPairKeys Pair keys to emit as ordinary methods, or `null`.
    /// @returns The G# compilation unit.
    func TranslateDocument(
        document LoadedDocument,
        context TranslationContext,
        suppressedPartialPairKeys IReadOnlyCollection[string]?
    ) CompilationUnit {
        let root = document.GetRoot()
        // A document split into several package units is translated once per
        // unit; only the first (or only) unit reports its directives.
        if this.packageFilter == nil || this.includeGlobalNamespace {
            ReportConditionalCompilation(root, context, this.ConditionalCompilation)
        }
        var partialTypeParts = GetOrCollectPartialTypeParts(context.Compilation)
        if this.retainedFilePaths != nil {
            partialTypeParts = FilterPartialTypeParts(partialTypeParts, this.retainedFilePaths)
        }
        let ownedExtensions = GetOrCollectOwnedExtensions(context.Compilation).Filter(this.retainedFilePaths)
        let nameAllocator = EmittedNameAllocator.For(context.Compilation)
        let package_ string? = if this.packageFilter == nil {
            this.ResolvePackage(root, context, nameAllocator)
        } else {
            this.ResolvePackageName(this.packageFilter, context, nameAllocator)
        }
        // T3 (ADR-0115 §B.1/§B.11): the C# program entry point and its enclosing
        // static class normally become top-level G#. When the entry class owns a
        // nested aggregate type, keep the class intact instead. Issue #3645: the
        // caller can also force preservation — a sibling project that references
        // this executable consumes the entry class as an ordinary CLR type
        // (e.g. `GsgenProgram.Run(...)` from a test project), so flattening it
        // would erase the type from the migrated assembly and break every
        // cross-project use site (GS0157). G# supports a class-scoped static
        // `Main` (issue #1996), so the preserved form still runs as the entry
        // point.
        // Issue #3837: the same erasure happens whenever the entry class
        // declares ANY non-entry member visible outside itself, whether or not
        // the pipeline recognized the consuming reference — an `@(ItemName)`
        // ProjectReference, an `InternalsVisibleTo` test project, or reflection
        // are all invisible to #3645's declared-reference scan. Preserving the
        // class whenever hoisting would erase externally visible surface makes
        // the decision local and total; a `private`-only entry class exports
        // nothing and still hoists to the canonical top-level form.
        // Issue #4301: an entry class declaring a `[GeneratedRegex]` partial
        // method is kept too. That method translates to a G# declaring part,
        // and a top-level func cannot be partial.
        let entryPoint IMethodSymbol? = context.Compilation.GetEntryPoint(default(CancellationToken))
        let entryType INamedTypeSymbol? = entryPoint?.ContainingType
        let preserveEntryType = entryType != nil &&
            (
            this.preserveEntryType || entryType.GetTypeMembers().Any(
                (type INamedTypeSymbol) -> type.TypeKind != TypeKind.Delegate
            ) ||
                EntryTypeExportsNonEntryMembers(entryType, entryPoint) ||
                DeclaresGeneratedRegexDefinition(entryType)
        )
        let keptTopLevelProgram INamedTypeSymbol? = if preserveEntryType && IsTopLevelStatementsProgram(entryType) {
            entryType
        } else {
            default(INamedTypeSymbol?)
        }
        // Issue #1910 (gap 3): a merged-in member from a non-primary partial
        // part (see `VisitAggregateCore`) is translated using ITS OWN file's
        // semantic model (`TranslationContext.UseSemanticModelFor`), so a short
        // type/member name it emits may only resolve under a `using` that
        // lives in that OTHER file, not this (primary) one. Union in the
        // `using` directives of every non-primary part whose primary part is
        // declared in THIS tree, so the merged output's import block covers
        // every name the merged-in bodies rely on.
        // ADR-0145 preserve mode: each part is a standalone declaration, so it
        // must NOT pull in sibling parts' `using` directives — its own imports
        // are all it needs (there is no cross-part member merge to resolve).
        let contributingTrees = CollectContributingDeclarationTrees(
            root,
            context,
            partialTypeParts,
            ownedExtensions,
            this.preservePartialParts,
            this.packageFilter,
            this.includeGlobalNamespace,
            if preserveEntryType {
                default(INamedTypeSymbol?)
            } else {
                entryType
            }
        )
        let extraUsingTrees IEnumerable[Microsoft.CodeAnalysis.SyntaxTree] = contributingTrees.Where(
            (tree Microsoft.CodeAnalysis.SyntaxTree) -> tree != root.SyntaxTree
        )
            .OrderBy((tree Microsoft.CodeAnalysis.SyntaxTree) -> tree.FilePath, StringComparer.Ordinal)
        let imports = this.TranslateImports(root, extraUsingTrees, context, nameAllocator)
        let openBases = GetOrCollectSubclassedBaseTypes(context.Compilation)
        let staticUsingTargets = CollectStaticUsingTargets(root, context)
        // Share the anonymous-type registry with every other
        // document already translated (by this same translator instance)
        // into the same package, so distinct/identical shapes across FILES
        // never collide (see `anonymousTypeRegistriesByPackage`'s comment).
        // `package` is null for a file with no namespace declaration (the
        // global namespace, e.g. a top-level-statements `Program.cs`) — a
        // Dictionary key cannot be null, so the global namespace is keyed by
        // the empty string instead (still one shared registry for every
        // global-namespace file in this translator's project, exactly
        // mirroring the non-null-package case).
        let registryKey = package_ ?? string.Empty
        if !this.anonymousTypeRegistriesByPackage.TryGetValue(registryKey, out var anonymousTypeRegistry) {
            anonymousTypeRegistry = AnonymousTypeRegistry()
            this.anonymousTypeRegistriesByPackage[registryKey] = anonymousTypeRegistry
        }
        let typeMapper = CSharpTypeMapper(anonymousTypeRegistry, nameAllocator){AnalyzerApiMode = this.analyzerApiMode}
        typeMapper.SetTopLevelStatementsEntryPoint(
            if keptTopLevelProgram == nil {
                default(IMethodSymbol?)
            } else {
                entryPoint
            }
        )
        typeMapper.ReserveImportNames(imports, contributingTrees, context)
        let visitor = DeclarationVisitor(
            context,
            typeMapper,
            openBases,
            staticUsingTargets,
            if preserveEntryType {
                default(IMethodSymbol?)
            } else {
                entryPoint
            },
            keptTopLevelProgram,
            partialTypeParts,
            ownedExtensions,
            nameAllocator,
            this.preservePartialParts,
            this.markMergedTypePartial,
            this.widenObliviousReferenceFields,
            this.retainedFilePaths,
            this.projectDirectory,
            this.emitPartialMethodPairs,
            suppressedPartialPairKeys,
            this.translatedFilePaths,
            this.emitGeneratedImplementingParts,
            this.semanticOnlyAbstractTypes
        )
        let fileAttributes = if this.includeFileAttributes {
            visitor.MapFileAttributes(
                root.AttributeLists.Where(
                    (list AttributeListSyntax) -> (list.Target?.Identifier.ValueText is "assembly" or "module")
                )
            )
        } else {
            cast[IReadOnlyList[AttributeUse]](Array.Empty[AttributeUse]())
        }
        // Issue #2382: a NATIVE C# top-level-statements program (`GlobalStatementSyntax`
        // members directly under the compilation unit — no enclosing class/method
        // syntax at all, unlike the explicit-`Main` case handled by `entryType`
        // below) is recognized by its synthesized entry point's declaring syntax
        // reference pointing at THIS file's `CompilationUnitSyntax` itself, rather
        // than at any real method/type declaration. At most one file in a
        // compilation may contribute top-level statements (ADR-0066 D1 / CS8802),
        // so this only ever matches one document.
        let globalStatements = root
            .Members
            .OfType[Microsoft.CodeAnalysis.CSharp.Syntax.GlobalStatementSyntax]()
            .ToList()
        let hasNativeTopLevelStatements = globalStatements.Count > 0 &&
            (this.packageFilter == nil || this.includeGlobalNamespace) &&
            entryPoint != nil &&
            entryPoint
            .DeclaringSyntaxReferences
            .Length > 0 &&
            entryPoint
            .DeclaringSyntaxReferences[0]
            .SyntaxTree == root.SyntaxTree &&
            entryPoint
            .DeclaringSyntaxReferences[0]
            .GetSyntax() is Microsoft.CodeAnalysis.CSharp.Syntax.CompilationUnitSyntax
        let members = List[GNode]()
        let trailingStatements = List[GNode]()
        if hasNativeTopLevelStatements {
            let (hoistedFuncs, entryStatements) = visitor.TranslateTopLevelProgram(globalStatements, entryPoint)
            members.AddRange(hoistedFuncs)
            trailingStatements.AddRange(entryStatements)
        }
        for member in EnumerateTopLevelDeclarations(root).Where(
            (member MemberDeclarationSyntax) -> this.packageFilter == nil ||
                DeclarationBelongsToPackage(member, context, this.packageFilter, this.includeGlobalNamespace)
        ) {
            if member is Microsoft.CodeAnalysis.CSharp.Syntax.GlobalStatementSyntax {
                // Already handled in a single pass above (native top-level
                // statements are not visited one-by-one like an ordinary member —
                // the whole sequence is translated together so the local-function
                // capture/hoist analysis can see every sibling statement).
                continue
            }
            if !preserveEntryType &&
                entryType != nil &&
                member is TypeDeclarationSyntax typeDecl &&
                context.GetDeclaredSymbol(member) is INamedTypeSymbol declaredType &&
                SymbolEqualityComparer
                .Default
                .Equals(declaredType.OriginalDefinition, entryType.OriginalDefinition) {
                let (hoistedFuncs, entryStatements) = visitor.TranslateEntryType(typeDecl, entryPoint)
                members.AddRange(hoistedFuncs)
                trailingStatements.AddRange(entryStatements)
                continue
            }
            let translated GMember? = visitor.Visit(member)
            if translated != nil {
                // Issue #3469: a top-level type's own leading comments (file
                // headers, ADR references, type doc comments) ride on the
                // translated declaration.
                DeclarationVisitor.AttachSourceComments(translated, member)
                members.Add(translated)
            }
            // Synthesized top-level receiver funcs/operators are emitted as
            // siblings immediately after their source aggregate.
            members.AddRange(visitor.DrainPendingTopLevel())
        }
        // Issue #2282: every anonymous type reached during translation has been
        // mapped, by now, to a synthesized `data class` (see
        // `CSharpTypeMapper.GetOrCreateAnonymousDataClass`); the mapper cannot
        // append these to the compilation unit itself (`Map` is called from
        // many contexts with no member list in scope), so they are drained
        // here, once, in first-seen (deterministic) order — before the trailing
        // top-level statements, so a program-entry statement that constructs
        // one can see it declared.
        members.AddRange(typeMapper.PendingAnonymousDataClasses)
        // Top-level statements are appended after every declaration so the program
        // entry runs with all package types and funcs already in scope.
        members.AddRange(trailingStatements)
        // Issue #2211: a Roslyn source generator (and other fully-qualified,
        // no-`using` C# input) can reference a BCL/external type by its
        // fully-qualified name with no matching `using` directive. The type
        // mapper still shortens such a reference to its bare name (§B.7/§B.12
        // qualification rules), so without a corresponding `import` the
        // shortened name is unresolvable in the emitted G# (GS0113/GS0157).
        // Synthesize the missing imports here, once every member is
        // translated (so every shortened reference has been recorded) —
        // skipping the file's own package (needs no import) and any namespace
        // an explicit `using` already covers.
        let allImports = if imports is List[ImportDirective]list {
            list
        } else {
            imports.ToList()
        }
        let existingAliases = HashSet[string](
            allImports.Where(($import ImportDirective) -> $import.Alias != nil).Select(
                ($import ImportDirective) -> $import.Alias!!
            ),
            StringComparer.Ordinal
        )
        for alias in typeMapper.SynthesizedTypeAliases.OrderBy(
            (pair KeyValuePair[string, string]) -> pair.Key,
            StringComparer.Ordinal
        ) {
            if existingAliases.Add(alias.Key) {
                allImports.Add(ImportDirective(alias.Value, alias.Key))
            }
        }
        let alreadyImported = HashSet[string](
            allImports.Where(($import ImportDirective) -> $import.Alias == nil).Select(
                ($import ImportDirective) -> $import.Name
            )
        )
        for ns in typeMapper.ShortenedNamespaces.OrderBy((n string) -> n, StringComparer.Ordinal) {
            var importName = ns
            // ADR-0169 analyzer mode / issue #3734: a synthesized import goes
            // through the SAME Roslyn→G# namespace mapping the `using`
            // directives above already get. Some shortened references record
            // their C# symbol's own namespace (an attribute type, an extension
            // method's declaring namespace), so without this a translated
            // analyzer emitted `import Microsoft.CodeAnalysis` ALONGSIDE the
            // `import GSharp.Core.CodeAnalysis` its references were retargeted
            // onto — two namespaces exporting `DiagnosticDescriptor`,
            // `SyntaxKind`, `Diagnostic`, ... and the bare name silently
            // binding whichever came first (now GS0547). The reference is G#'s;
            // the Roslyn namespace it was translated away from must not be
            // imported at all.
            if this.analyzerApiMode && RoslynAnalyzerApiMap.IsRoslynNamespace(importName) &&
                !RoslynAnalyzerApiMap.TryMapNamespace(importName, out importName) {
                continue
            }
            if importName != package_ && alreadyImported.Add(importName) {
                allImports.Add(ImportDirective(importName))
            }
        }
        // The C# file's header comment (license, copyright) stays at the top
        // of every G# unit translated from it.
        return CompilationUnit(
            package_,
            allImports,
            members,
            leadingComments: FileHeader.GetLines(root),
            fileAttributes: fileAttributes
        )
    }

    private func ResolvePackage(
        root Microsoft.CodeAnalysis.CSharp.Syntax.CompilationUnitSyntax,
        context TranslationContext,
        nameAllocator EmittedNameAllocator
    ) string? {
        let namespaces List[(Name string, Location Location)] = EnumerateTopLevelDeclarations(root)
            .Select(
            (member MemberDeclarationSyntax) -> (
                Symbol: context.GetDeclaredSymbol(member),
                Location: member.GetLocation()
            )
        )
            .Where(
            (item(Symbol ISymbol, Location Location)) -> item.Item1?.ContainingNamespace is {IsGlobalNamespace: false}
        )
            .Select(
            (item(Symbol ISymbol, Location Location)) -> (
                nameAllocator.GetNamespaceName(item.Item1.ContainingNamespace)!!,
                item.Item2
            )
        )
            .ToList()
        if namespaces.Count == 0 {
            return nil
        }
        let dominant = namespaces[0].Name
        let distinct = namespaces.Select((n(Name string, Location Location)) -> n.Name).Distinct()
        if distinct.Count() > 1 {
            context.Report(
                TranslationDiagnostic(
                    "NamespaceDeclaration",
                    "Multiple namespaces in one file; hoisting to the dominant namespace '$dominant' (ADR-0115 §B.1).",
                    namespaces[0].Location,
                    TranslationSeverity.Warning
                )
            )
        }
        return dominant
    }

    private func ResolvePackageName(
        packageName string?,
        context TranslationContext,
        nameAllocator EmittedNameAllocator
    ) string? {
        var current INamespaceSymbol? = context.Compilation.GlobalNamespace
        for rawSegment in packageName!!.Split('.') {
            // Issue #3610 / ADR-0170: a keyword-named namespace arrives in its
            // C# display spelling (`@class`) — from ToDisplayString on the
            // package-split path — while the SYMBOL's Name is the bare
            // metadata name (`class`). Compare the bare spelling so the walk
            // succeeds and the allocator can hand back the G# `$class`
            // escape; falling through returned the raw `@` text, which does
            // not round-trip-parse (the Cs2Gs.Tests selfmig AtToken wall).
            let segment = if rawSegment.Length > 1 && rawSegment[0] == '@' {
                rawSegment.Substring(1)
            } else {
                rawSegment
            }
            current = current!!.GetNamespaceMembers().FirstOrDefault(
                (candidate INamespaceSymbol) -> candidate.Name == segment
            )
            if current == nil {
                return packageName
            }
        }
        return nameAllocator.GetNamespaceName(current)
    }

    private func TranslateImports(
        root Microsoft.CodeAnalysis.CSharp.Syntax.CompilationUnitSyntax,
        extraUsingTrees IEnumerable[Microsoft.CodeAnalysis.SyntaxTree],
        context TranslationContext,
        nameAllocator EmittedNameAllocator
    ) IReadOnlyList[ImportDirective] {
        let imports = List[ImportDirective]()
        let seen = HashSet[(Name string?, Alias string?)]()
        var usings = root.Usings.Concat(
            root
                .DescendantNodes()
                .OfType[BaseNamespaceDeclarationSyntax]()
                .SelectMany(
                func (n BaseNamespaceDeclarationSyntax) IEnumerable[UsingDirectiveSyntax] {
                    return n.Usings
                }
            )
        )
        for extraTree in extraUsingTrees {
            let extraRoot = cast[Microsoft.CodeAnalysis.CSharp.Syntax.CompilationUnitSyntax](extraTree.GetRoot())
            usings = usings.Concat(extraRoot.Usings).Concat(
                extraRoot
                    .DescendantNodes()
                    .OfType[BaseNamespaceDeclarationSyntax]()
                    .SelectMany(
                    func (n BaseNamespaceDeclarationSyntax) IEnumerable[UsingDirectiveSyntax] {
                        return n.Usings
                    }
                )
            )
        }
        for directive in usings {
            using let modelScope = context.UseSemanticModelFor(directive.SyntaxTree)
            // C# 12 alias-any-type directives (`using X = (int, string);`,
            // arrays, pointers, nullable value types, ...) put a non-name
            // TypeSyntax where a plain dotted name used to be the only option;
            // `directive.Name` is null for those (issue #1914). `NamespaceOrType`
            // is the generalized property that covers both forms.
            let namespaceOrType TypeSyntax? = directive.NamespaceOrType
            if namespaceOrType == nil {
                context.ReportUnsupported(directive, "using directive without a resolvable name.")
                continue
            }
            let alias string? = if directive.Alias == nil {
                default(string?)
            } else {
                nameAllocator.GetName(context.GetDeclaredSymbol(directive), IdentifierNameContext.Type) ??
                    nameAllocator.GetName(directive.Alias!!.Name.Identifier.ValueText, IdentifierNameContext.Type)
            }
            if !(namespaceOrType is NameSyntax) {
                // G#'s `import` statement (ImportSyntax) only spells a
                // dotted-identifier path, so a tuple/array/pointer/nullable
                // alias target has no faithful import line to emit. That is
                // harmless: every USE of the alias resolves through the
                // semantic model straight to its underlying type (e.g. a
                // tuple-alias use-site maps to G#'s positional
                // TupleTypeReference the same as a written-out tuple type), so
                // the alias fully expands at each reference without needing an
                // import (issue #1914). Only array/pointer/nullable-value-type
                // RHS forms remain unexercised by the corpus; tuple RHS is the
                // one this issue asks for.
                if alias != nil {
                    context.Report(
                        TranslationDiagnostic(
                            "UsingDirective",
                            "'using $alias = $namespaceOrType' aliases a type G#'s import statement cannot spell; omitted from the import block, but every use of '$alias' still expands to its underlying G# type (issue #1914).",
                            directive.GetLocation(),
                            TranslationSeverity.Warning
                        )
                    )
                }
                continue
            }
            // Issue #2222: strip a `global::` alias-qualifier prefix before
            // recording the import name — `using global::Foo.Bar;` must
            // become `import Foo.Bar`, not the unparseable `import
            // global::Foo.Bar` (G#'s import syntax has no alias-qualifier
            // form).
            var name string? = this.TranslateImportName(namespaceOrType, context, nameAllocator)
            // ADR-0169 analyzer mode: Roslyn namespaces map onto the G#
            // analyzer API's namespaces (several collapse onto one; the
            // (name, alias) de-dup below absorbs the collision). A Roslyn
            // namespace with no mapping is dropped with a gap record rather
            // than passing through to a namespace gsc cannot resolve.
            if this.analyzerApiMode && RoslynAnalyzerApiMap.IsRoslynNamespace(name) {
                if RoslynAnalyzerApiMap.TryMapNamespace(name, out var gsNamespace) {
                    name = gsNamespace
                } else {
                    context.Report(
                        TranslationDiagnostic(
                            "analyzer-api",
                            "Roslyn namespace '$name' has no G# analyzer-API mapping (ADR-0169); the import was dropped.",
                            directive.GetLocation()
                        )
                    )
                    continue
                }
            }
            if !directive.StaticKeyword.IsKind(Microsoft.CodeAnalysis.CSharp.SyntaxKind.None) {
                // Issue #1201 / ADR-0134: a C# `using static X` translates to a
                // bare type import `import X`, which gsc now hoists X's `shared`
                // (static) members into scope for unqualified reference — so the
                // member references are emitted bare (NOT qualified through X).
                // An alias on a `using static` has no unqualified-hoisting form
                // and degrades to a plain (alias) import.
                if alias != nil {
                    context.Report(
                        TranslationDiagnostic(
                            "UsingDirective",
                            "'using static $name' with an alias has no G# member-hoisting form; emitted as a plain import (ADR-0134).",
                            directive.GetLocation(),
                            TranslationSeverity.Warning
                        )
                    )
                }
            }
            // Issue #1910 (gap 3): dedup by (name, alias) once non-primary
            // parts' `using` directives are unioned in — the same directive
            // commonly appears in both files.
            if seen.Add((name, alias)) {
                imports.Add(ImportDirective(name, alias))
            }
        }
        return imports
    }

    private func TranslateImportName(
        namespaceOrType TypeSyntax,
        context TranslationContext,
        nameAllocator EmittedNameAllocator
    ) string? {
        let symbol ISymbol? = context.GetSymbolInfo(namespaceOrType).Symbol
        return switch symbol {
            case ns is INamespaceSymbol: nameAllocator.GetNamespaceName(ns)
            case type is INamedTypeSymbol: this.QualifiedImportTypeName(type, nameAllocator)
            default: CSharpTypeMapper.StripGlobalPrefix(namespaceOrType.ToString())
        }
    }

    private func QualifiedImportTypeName(type INamedTypeSymbol, nameAllocator EmittedNameAllocator) string {
        let typeParts = Stack[string]()
        var outermost INamedTypeSymbol? = type
        for var current INamedTypeSymbol? = type; current != nil; current = current!!.ContainingType {
            typeParts.Push(nameAllocator.GetName(current)!!)
            outermost = current
        }
        let typeName = string.Join(".", typeParts)
        return if outermost!!.ContainingNamespace is {IsGlobalNamespace: false} ns {
            "${nameAllocator.GetNamespaceName(ns)}.$typeName"
        } else {
            typeName
        }
    }

    /// The step-6 declaration dispatcher: a (cref:CSharpSyntaxVisitor{TResult})
    /// that maps each type declaration (kind, name, visibility, generics, base
    /// clause) and its member signatures + fields. Method / property /
    /// constructor bodies are routed through (cref:TranslateBody), which
    /// emits a parseable placeholder block today (step 7 replaces it). Every
    /// construct with no canonical G# form is recorded as a structured
    /// (cref:TranslationDiagnostic) rather than dropped.
    private partial class DeclarationVisitor : CSharpSyntaxVisitor[GMember] {
        private let context TranslationContext
        private let typeMapper CSharpTypeMapper
        private let subclassedBases HashSet[INamedTypeSymbol]?
        private let unscopedRefAttributeType INamedTypeSymbol?

        // Issue #1910: every `partial` type symbol with more than one
        // declaration part, mapped to its parts in canonical (deterministic)
        // order — see `CSharpToGSharpTranslator.CollectPartialTypeParts`. Only
        // `parts[0]` (the "primary" part) is translated into a G# type
        // declaration; every other part's members are merged into it.
        private let partialTypeParts Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]]

        // Issue #2821: same-package source extension methods are emitted as
        // members of their owned receiver type, not as top-level receiver funcs.
        private let ownedExtensions OwnedExtensionRegistry

        private let nameAllocator EmittedNameAllocator

        // Issue #3750: the source files this translation still emits (null when
        // the whole compilation is translated). A `typeof` in a file that is not
        // retained cannot keep an elided extension holder alive — that file
        // produces no G# output.
        private let retainedFilePaths HashSet[string]?

        // See `CSharpToGSharpTranslator.projectDirectory`.
        private let projectDirectory string?

        // See `CSharpToGSharpTranslator.translatedFilePaths`.
        private let translatedFilePaths HashSet[string]?

        // See `CSharpToGSharpTranslator.emitPartialMethodPairs`.
        private let emitPartialMethodPairs bool

        // See `CSharpToGSharpTranslator.emitGeneratedImplementingParts`.
        private let emitGeneratedImplementingParts bool

        // See `CSharpToGSharpTranslator.semanticOnlyAbstractTypes`.
        private let semanticOnlyAbstractTypes IReadOnlyDictionary[string, bool]?

        // Pair keys the reconciliation loop demoted: those partial methods
        // translate as if emitPartialMethodPairs were off.
        private let suppressedPartialPairKeys IReadOnlyCollection[string]?

        // ADR-0145 (§C/§D): when true, `partial` parts are NOT merged — every
        // part is emitted as its own standalone G# `partial` declaration (using
        // only its own members), so a generated part augments the user's real G#
        // type (ADR-0144). See `CSharpToGSharpTranslator.preservePartialParts`.
        private let preservePartialParts bool

        // Issue #2215: see `CSharpToGSharpTranslator.markMergedTypePartial`.
        private let markMergedTypePartial bool

        // Issue #2610: see
        // `CSharpToGSharpTranslator.widenObliviousReferenceFields`.
        private let widenObliviousReferenceFields bool

        // Issue #1201 / ADR-0134: the types targeted by `using static X` in this
        // document. A bare reference to one of their static members is left
        // UNQUALIFIED (gsc resolves it through `import X`), unlike a sibling
        // static, which is qualified through its owning type.
        private let staticUsingTargets HashSet[INamedTypeSymbol]

        // Set only while translating an owner-scoped extension's forwarding companion.
        private var attributeOmission((AttributeSyntax) -> bool)?

        // The C# program entry type (the static class containing `Main`). Its
        // members are flattened to top-level G# funcs (never a `shared { }`
        // block), so a sibling static call inside it must stay bare rather than
        // be qualified through a non-existent type (ADR-0115 §B.1/§B.18).
        private let entryType INamedTypeSymbol?

        private let keptTopLevelProgram INamedTypeSymbol?
        private let efEntityTypes HashSet[INamedTypeSymbol]

        // The per-document MUTABLE working state (caches, suppression/pending
        // sets, per-scope scalars set-and-restored around nested scopes, and
        // the monotonic name counters). Extracted into its own object (#1361
        // Wave 2, T-1) so "where state lives" is decoupled from "where behavior
        // lives"; the visitor methods reference `this.state.X`. Created here,
        // one instance per document, matching the previous per-document field
        // lifetime exactly.
        private let state DocumentTranslationState = DocumentTranslationState()

        init(
            context TranslationContext,
            typeMapper CSharpTypeMapper,
            subclassedBases HashSet[INamedTypeSymbol]?,
            staticUsingTargets HashSet[INamedTypeSymbol]?,
            entryPoint IMethodSymbol?,
            keptTopLevelProgram INamedTypeSymbol?,
            partialTypeParts Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]]?,
            ownedExtensions OwnedExtensionRegistry,
            nameAllocator EmittedNameAllocator,
            preservePartialParts bool = false,
            markMergedTypePartial bool = false,
            widenObliviousReferenceFields bool = false,
            retainedFilePaths HashSet[string]? = nil,
            projectDirectory string? = nil,
            emitPartialMethodPairs bool = false,
            suppressedPartialPairKeys IReadOnlyCollection[string]? = nil,
            translatedFilePaths HashSet[string]? = nil,
            emitGeneratedImplementingParts bool = false,
            semanticOnlyAbstractTypes IReadOnlyDictionary[string, bool]? = nil
        ) {
            this.emitGeneratedImplementingParts = emitGeneratedImplementingParts
            this.semanticOnlyAbstractTypes = semanticOnlyAbstractTypes
            this.suppressedPartialPairKeys = suppressedPartialPairKeys
            this.translatedFilePaths = translatedFilePaths
            this.retainedFilePaths = retainedFilePaths
            this.projectDirectory = projectDirectory
            this.emitPartialMethodPairs = emitPartialMethodPairs
            this.context = context
            this.typeMapper = typeMapper
            this.subclassedBases = subclassedBases
            this.unscopedRefAttributeType = context.Compilation.GetTypeByMetadataName(UnscopedRefAttributeFullName)
            this.staticUsingTargets = staticUsingTargets ?? HashSet[INamedTypeSymbol](SymbolEqualityComparer.Default)
            this.partialTypeParts = partialTypeParts ??
                Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]](SymbolEqualityComparer.Default)
            this.ownedExtensions = ownedExtensions ?? OwnedExtensionRegistry(context.Compilation.Assembly)
            this.nameAllocator = nameAllocator ?? EmittedNameAllocator.For(context.Compilation)
            this.preservePartialParts = preservePartialParts
            this.markMergedTypePartial = markMergedTypePartial
            this.widenObliviousReferenceFields = widenObliviousReferenceFields
            this.efEntityTypes = ObliviousNullabilityAnalyzer.CollectEfEntityTypes(context.Compilation)
            this.keptTopLevelProgram = keptTopLevelProgram
            // `entryPoint` is threaded in by the caller (`TranslateDocument`)
            // instead of being recomputed here: `Compilation.GetEntryPoint`
            // re-walks the compilation and was otherwise called twice per
            // document (once by the caller, once here).
            this.entryType = entryPoint?.ContainingType
        }

        func MapFileAttributes(attributeLists IEnumerable[AttributeListSyntax]) IReadOnlyList[
            AttributeUse
        ] -> this.MapAttributes(attributeLists)

        override func VisitClassDeclaration(node ClassDeclarationSyntax) GMember? -> this.VisitAggregate(node)

        override func VisitStructDeclaration(
            node Microsoft.CodeAnalysis.CSharp.Syntax.StructDeclarationSyntax
        ) GMember? -> this.VisitAggregate(node)

        override func VisitRecordDeclaration(node RecordDeclarationSyntax) GMember? -> this.VisitAggregate(node)

        override func VisitInterfaceDeclaration(
            node Microsoft.CodeAnalysis.CSharp.Syntax.InterfaceDeclarationSyntax
        ) GMember? -> this.VisitAggregate(node)

        override func VisitDelegateDeclaration(
            node Microsoft.CodeAnalysis.CSharp.Syntax.DelegateDeclarationSyntax
        ) GMember -> this.TranslateDelegateDeclaration(node)

        shared {
            // gsc's ADR-0044 implicit numeric widening lattice (mirrors
            // Conversion.NumericWideningTargets), keyed on the C# SpecialType of the
            // source → set of widening targets. `char` widens like an unsigned 16-bit
