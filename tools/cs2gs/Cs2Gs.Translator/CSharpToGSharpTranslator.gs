    private class OwnedExtensionRegistry {
        private let assembly IAssemblySymbol?
        private let methodsByReceiver Dictionary[INamedTypeSymbol, List[MethodDeclarationSyntax]] = Dictionary[
            INamedTypeSymbol,
            List[MethodDeclarationSyntax]
        ](SymbolEqualityComparer.Default)
        private let receiversByMethod Dictionary[MethodDeclarationSyntax, INamedTypeSymbol] = Dictionary[
            MethodDeclarationSyntax,
            INamedTypeSymbol
        ]()
        private let staticHelpers HashSet[
            (Tree Microsoft.CodeAnalysis.SyntaxTree, Start int32, Length int32)
        ] = HashSet[(Tree Microsoft.CodeAnalysis.SyntaxTree, Start int32, Length int32)]()
        private let receiverCompanions HashSet[
            (Tree Microsoft.CodeAnalysis.SyntaxTree, Start int32, Length int32)
        ] = HashSet[(Tree Microsoft.CodeAnalysis.SyntaxTree, Start int32, Length int32)]()

        init(assembly IAssemblySymbol? = nil) {
            this.assembly = assembly
        }

        func Add(receiver INamedTypeSymbol, method MethodDeclarationSyntax) {
            if !this.methodsByReceiver.TryGetValue(receiver, out var methods) {
                methods = List[MethodDeclarationSyntax]()
                this.methodsByReceiver.Add(receiver, methods)
            }
            methods.Add(method)
            this.receiversByMethod.Add(method, receiver)
        }

        func Contains(method MethodDeclarationSyntax) bool -> this.receiversByMethod.ContainsKey(method)

        func AddStaticHelper(method MethodDeclarationSyntax) -> this.staticHelpers.Add(
            (method.SyntaxTree, method.SpanStart, method.Span.Length)
        )

        func AddReceiverCompanion(method MethodDeclarationSyntax) -> this.receiverCompanions.Add(
            (method.SyntaxTree, method.SpanStart, method.Span.Length)
        )

        func IsStaticHelper(method IMethodSymbol?) bool {
            let original IMethodSymbol? = method?.ReducedFrom ?? method
            if original == nil {
                return false
            }
            if original.DeclaringSyntaxReferences.Any(
                (reference SyntaxReference) -> this.staticHelpers.Contains(
                    (reference.SyntaxTree, reference.Span.Start, reference.Span.Length)
                )
            ) {
                return true
            }
            // Referenced projects do not share this compilation's syntax-keyed
            // registry. Re-run the declaration-only rule on metadata symbols.
            return !SymbolEqualityComparer.Default.Equals(original.ContainingAssembly, this.assembly) &&
                CSharpToGSharpTranslator.IsReproducibleStaticHelper(original)
        }

        func HasReceiverCompanion(method IMethodSymbol?) bool {
            let original IMethodSymbol? = method?.ReducedFrom ?? method
            if original == nil {
                return false
            }
            if original.DeclaringSyntaxReferences.Any(
                (reference SyntaxReference) -> this.receiverCompanions.Contains(
                    (reference.SyntaxTree, reference.Span.Start, reference.Span.Length)
                )
            ) {
                return true
            }
            return !SymbolEqualityComparer.Default.Equals(original.ContainingAssembly, this.assembly) &&
                CSharpToGSharpTranslator.IsReproducibleReceiverCompanion(original)
        }

        func TryGetMethods(receiver INamedTypeSymbol?, out methods IReadOnlyList[MethodDeclarationSyntax]) bool {
            if receiver != nil && this.methodsByReceiver.TryGetValue(receiver.OriginalDefinition, out var found) {
                methods = found
                return true
            }
            methods = Array.Empty[MethodDeclarationSyntax]()
            return false
        }

        func Filter(retainedFilePaths HashSet[string]?) OwnedExtensionRegistry {
            if retainedFilePaths == nil {
                return this
            }
            let filtered = OwnedExtensionRegistry(this.assembly)
            for entry in this.methodsByReceiver {
                let targetIsRetained = entry
                    .Key
                    .DeclaringSyntaxReferences
                    .Any((r SyntaxReference) -> retainedFilePaths.Contains(r.SyntaxTree.FilePath))
                if !targetIsRetained {
                    continue
                }
                for method in entry.Value {
                    if retainedFilePaths.Contains(method.SyntaxTree.FilePath) {
                        filtered.Add(entry.Key, method)
                    }
                }
            }
            for (tree, start, length) in this.staticHelpers {
                if retainedFilePaths.Contains(tree.FilePath) {
                    filtered.staticHelpers.Add((tree, start, length))
                }
            }
            for (tree, start, length) in this.receiverCompanions {
                if retainedFilePaths.Contains(tree.FilePath) {
                    filtered.receiverCompanions.Add((tree, start, length))
                }
            }
            return filtered
        }
    }

    shared {
        // A subclass can only ever be declared in source, never synthesized from a
        // referenced assembly's metadata, so the set of "is this base type ever
        // subclassed" facts is a pure function of the *source* assembly's symbol
        // tree and is invariant across every document translated from the same
        // `Compilation`. `Compilation.GlobalNamespace` is the merged namespace
        // across every metadata reference too, so scanning it (as the previous
        // implementation did) forces materialization of the entire BCL symbol
        // tree — tens of thousands of `INamedTypeSymbol`s — on every single
        // document. Caching per `Compilation` (keyed by reference identity via
        // `ConditionalWeakTable`, so a new/edited `Compilation` naturally gets a
        // fresh entry and stale ones are collectible) plus restricting the walk to
        // `compilation.Assembly.GlobalNamespace` (the source assembly only) turns
        // an O(assemblies × types × documents) cost into a single O(source types)
        // pass per compilation.
        private let SubclassedBaseTypesCache ConditionalWeakTable[
            Compilation,
            HashSet[INamedTypeSymbol]
        ] = ConditionalWeakTable[Compilation, HashSet[INamedTypeSymbol]]()

        // Issue #1910: a `partial` class/struct/interface/record has ONE symbol but
        // MULTIPLE `TypeDeclarationSyntax` parts (one per file/declaration). Each
        // part used to be translated independently, emitting a complete, duplicate
        // G# type declaration per part (GS0102) instead of one merged declaration.
        // Cached per `Compilation` for the same reason as `SubclassedBaseTypesCache`
        // above: it is a pure function of the source symbol tree, invariant across
        // every document translated from the same compilation.
        private let PartialTypePartsCache ConditionalWeakTable[
            Compilation,
            Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]]
        ] = ConditionalWeakTable[Compilation, Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]]]()

        // Issue #2821: classic C# extension methods whose receiver type is declared
        // in the same source compilation and namespace belong to that output
        // package. Collect them once per compilation so the receiver's declaration
        // can absorb them even when the extension and target live in different
        // files (including partial target declarations).
        private let OwnedExtensionsCache ConditionalWeakTable[
            Compilation,
            OwnedExtensionRegistry
        ] = ConditionalWeakTable[Compilation, OwnedExtensionRegistry]()

        // Issue #3750: every type named by a `typeof(...)` anywhere in the
        // compilation, mapped to the source files that name it. A `static class`
        // holding only extension methods is normally ELIDED (its members lift to
        // top-level receiver-clause funcs, ADR-0115 §B.5) — but `typeof` observes
        // the holder's IDENTITY, which the lifted funcs cannot carry, so a holder
        // that is named this way must survive. `typeof` is the only surviving
        // reference form: `nameof` constant-folds to a string literal before it
        // reaches the printer, and a static-form/bare call through the holder is
        // already rewritten to the receiver form (see `TranslateInvocation`).
        // Computed once per compilation — `typeof` nodes are rare, so the scan is
        // cheap and only resolves symbols for those nodes.
        private let TypeOfReferencedTypesCache ConditionalWeakTable[
            Compilation,
            Dictionary[INamedTypeSymbol, HashSet[string]]
        ] = ConditionalWeakTable[Compilation, Dictionary[INamedTypeSymbol, HashSet[string]]]()

        // Lifted helpers from separate partial-type documents share one CLR type;
        // LiftedLocalFunctionNameAllocator.For keeps their readable names unique
        // across the whole compilation.
        private let IdentifierTokenIndexes ConditionalWeakTable[
            Compilation,
            Dictionary[string, List[Microsoft.CodeAnalysis.SyntaxToken]]
        ] = ConditionalWeakTable[Compilation, Dictionary[string, List[Microsoft.CodeAnalysis.SyntaxToken]]]()

        private let AllStaticUsingTargetsCache ConditionalWeakTable[
            Compilation,
            HashSet[INamedTypeSymbol]
        ] = ConditionalWeakTable[Compilation, HashSet[INamedTypeSymbol]]()

        /// Gets the distinct source namespaces declared by a document.
        /// @param document The bound source document.
        /// @returns Declared namespaces in source order.
        func GetDeclaredPackages(document LoadedDocument) IReadOnlyList[string] -> EnumerateTopLevelDeclarations(
            document.GetRoot()
        )
            .Select((member MemberDeclarationSyntax) -> document.SemanticModel.GetDeclaredSymbol(member))
            .Where((symbol ISymbol) -> symbol?.ContainingNamespace is {IsGlobalNamespace: false})
            .Select((symbol ISymbol) -> symbol.ContainingNamespace.ToDisplayString())
            .Distinct(StringComparer.Ordinal)
            .ToList()

        /// Issue #3837: whether the C# entry class declares a member OTHER than the
        /// entry point itself that is visible outside the class. T3's hoist drops
        /// the enclosing class, so every such member loses its `Program.`
        /// container — a use site that spells `Program.Member` from another
        /// project then binds nothing (GS0157 "Cannot find type <first segment>").
        ///
        /// Issue #3645 already preserves the class for a reference the pipeline can
        /// see in declared `ProjectReference` XML, but an `@(ItemName)`
        /// include, an `InternalsVisibleTo` test project, or reflection are all
        /// invisible to that scan. This check needs no cross-project knowledge: if
        /// hoisting would erase externally visible surface, keep the class. An entry
        /// class whose non-entry members are all `private` exports nothing and
        /// still hoists to the canonical top-level form (ADR-0115 §B.1/§B.11).
        /// @param entryType The entry point's enclosing type.
        /// @param entryPoint The bound entry-point method.
        /// @returns `true` when hoisting would erase visible surface.
        private func EntryTypeExportsNonEntryMembers(entryType INamedTypeSymbol?, entryPoint IMethodSymbol?) bool {
            for member in entryType!!.GetMembers() {
                if member.IsImplicitlyDeclared || SymbolEqualityComparer.Default.Equals(member, entryPoint) ||
                    (
                    member is IMethodSymbol method &&
                        (
                        method.MethodKind == MethodKind.Constructor || method.MethodKind == MethodKind.StaticConstructor
                    )
                ) {
                    continue
                }
                if member.DeclaredAccessibility != Accessibility.Private &&
                    member.DeclaredAccessibility != Accessibility.NotApplicable {
                    return true
                }
            }
            return false
        }

        private func IsTopLevelStatementsProgram(type INamedTypeSymbol?) bool -> type != nil && !type.GetMembers(
            WellKnownMemberNames.TopLevelStatementsEntryPointMethodName
        )
            .IsEmpty

        private func EnumerateTopLevelDeclarations(
            root Microsoft.CodeAnalysis.CSharp.Syntax.CompilationUnitSyntax
        ) sequence[MemberDeclarationSyntax] {
            for member in root.Members {
                for flattened in FlattenNamespaceMembers(member) {
                    yield flattened
                }
            }
        }

        // A package-split unit's declarations: those of its own namespace, plus,
        // for the one unit that takes them, the global namespace's.
        private func DeclarationBelongsToPackage(
            member MemberDeclarationSyntax,
            context TranslationContext,
            $package string?,
            includeGlobalNamespace bool
        ) bool -> NamespaceBelongsToPackage(
            context.GetDeclaredSymbol(member)?.ContainingNamespace,
            $package,
            includeGlobalNamespace
        )

        private func NamespaceBelongsToPackage(
            containingNamespace INamespaceSymbol?,
            $package string?,
            includeGlobalNamespace bool
        ) bool {
            if containingNamespace == nil {
                return false
            }
            if containingNamespace.IsGlobalNamespace {
                return includeGlobalNamespace
            }
            return containingNamespace.ToDisplayString() == $package
        }

        private func FlattenNamespaceMembers(member MemberDeclarationSyntax) sequence[MemberDeclarationSyntax] {
            // A namespace (block `namespace X { ... }` or file-scoped) maps to G#
            // package structure; its declarations are flattened. Namespaces nest
            // (`namespace X { namespace Y { ... } }`), so flatten recursively.
            if member is BaseNamespaceDeclarationSyntax ns {
                for nested in ns.Members {
                    for flattened in FlattenNamespaceMembers(nested) {
                        yield flattened
                    }
                }
            } else {
                yield member
            }
        }

        private func GetOrCollectSubclassedBaseTypes(compilation Compilation) HashSet[INamedTypeSymbol] {
            return SubclassedBaseTypesCache.GetValue(compilation, CollectSubclassedBaseTypes)
        }

        /// Issue #1910: maps every `partial` type symbol declared with more
        /// than one (cref:TypeDeclarationSyntax) part to its parts, ordered
        /// deterministically (file path, then position) so every document
        /// translated from this compilation agrees on which part is the "primary"
        /// one (parts[0]) — the one declaration point that actually emits the
        /// merged G# type. A partial record's part carrying the positional
        /// parameter list is preferred first: only that part can supply the G#
        /// primary-constructor parameters ((cref:DeclarationVisitor.MapPrimaryConstructor)).
        private func GetOrCollectPartialTypeParts(compilation Compilation) Dictionary[
            INamedTypeSymbol,
            List[TypeDeclarationSyntax]
        ] {
            return PartialTypePartsCache.GetValue(compilation, CollectPartialTypeParts)
        }

        private func GetOrCollectOwnedExtensions(compilation Compilation) OwnedExtensionRegistry {
            return OwnedExtensionsCache.GetValue(compilation, CollectOwnedExtensions)
        }

        /// Issue #3750: reports whether [`type`](paramref) is named by a
        /// `typeof(...)` in a source file this translation still emits. Used
        /// to decide whether an extension-method holder `static class` whose
        /// members all lifted to top-level receiver-clause funcs may be elided:
        /// eliding a type whose identity is still observed leaves the reference
        /// dangling (GS0113).
        private func IsTypeOfReferenced(
            compilation Compilation,
            type INamedTypeSymbol?,
            retainedFilePaths HashSet[string]?
        ) bool {
            if type == nil {
                return false
            }
            let references = TypeOfReferencedTypesCache.GetValue(compilation, CollectTypeOfReferencedTypes)
            if !references.TryGetValue(type.OriginalDefinition, out var filePaths) {
                return false
            }
            return retainedFilePaths == nil || filePaths.Overlaps(retainedFilePaths)
        }

        private func CollectTypeOfReferencedTypes(compilation Compilation) Dictionary[
            INamedTypeSymbol,
            HashSet[string]
        ] {
            let result = Dictionary[INamedTypeSymbol, HashSet[string]](SymbolEqualityComparer.Default)
            for tree in compilation.SyntaxTrees {
                let typeOfExpressions = tree
                    .GetRoot()
                    .DescendantNodes()
                    .OfType[Microsoft.CodeAnalysis.CSharp.Syntax.TypeOfExpressionSyntax]()
                    .ToList()
                if typeOfExpressions.Count == 0 {
                    continue
                }
                let model = compilation.GetSemanticModel(tree)
                for typeOf in typeOfExpressions {
                    if model.GetSymbolInfo(typeOf.Type).Symbol is not INamedTypeSymbol referenced {
                        continue
                    }
                    let definition = referenced.OriginalDefinition
                    if !result.TryGetValue(definition, out var filePaths) {
                        filePaths = HashSet[string](StringComparer.Ordinal)
                        result.Add(definition, filePaths)
                    }
                    filePaths.Add(tree.FilePath)
                }
            }
            return result
        }

        private func CollectOwnedExtensions(compilation Compilation) OwnedExtensionRegistry {
            let result = OwnedExtensionRegistry(compilation.Assembly)
            let candidates = List[(Receiver INamedTypeSymbol?, Syntax MethodDeclarationSyntax, Method IMethodSymbol)]()
            for tree in compilation.SyntaxTrees {
                let model = compilation.GetSemanticModel(tree)
                for methodDeclaration in tree.GetRoot().DescendantNodes().OfType[MethodDeclarationSyntax]() {
                    if model.GetDeclaredSymbol(methodDeclaration) is not IMethodSymbol method ||
                        !method.IsExtensionMethod {
                        continue
                    }
                    // Issue #3413: a lifted receiver func is emitted on the synthetic
                    // top-level <Program> type, which cannot legally access a private
                    // nested aggregate retained on the source extension owner. Keep
                    // every extension on such an owner as its CLR-native static method;
                    // translated receiver calls already use the static-helper rewrite.
                    if RequiresOwnerScopedExtension(method) {
                        result.AddStaticHelper(methodDeclaration)
                        if IsOwnerScopedCompanionShapeEligible(method) {
                            result.AddReceiverCompanion(methodDeclaration)
                        }
                        continue
                    }
                    if !TryGetOwnedExtensionReceiver(method, out var receiverDefinition) {
                        continue
                    }
                    candidates.Add((receiverDefinition, methodDeclaration, method))
                }
            }
            for (receiver, syntax, method) in candidates {
                let crossContainerOverload = HasCrossContainerOwnedExtensionOverload(receiver, method)
                let reducedCollision = HasReducedDeclarationCollision(receiver, method)
                let byRefReceiver = method.Parameters[0].RefKind != RefKind.None
                if crossContainerOverload || reducedCollision || byRefReceiver {
                    result.AddStaticHelper(syntax)
                    if crossContainerOverload &&
                        !HasCrossContainerOwnedExtensionDuplicate(receiver, method) &&
                        !reducedCollision &&
                        !byRefReceiver {
                        result.AddReceiverCompanion(syntax)
                    }
                    continue
                }
                if (receiver!!.TypeKind == TypeKind.Class || receiver!!.TypeKind == TypeKind.Struct) &&
                    method
                    .Parameters[0]
                    .NullableAnnotation != Microsoft
                    .CodeAnalysis
                    .NullableAnnotation
                    .Annotated &&
                    method
                    .Parameters[0]
                    .Type is INamedTypeSymbol receiverType &&
                    !IsGenericReceiver(receiverType) &&
                    !HasApplicableInstanceMember(receiver!!, method) {
                    result.Add(receiver!!, syntax)
                }
            }
            return result
        }

        private func TryGetOwnedExtensionReceiver(
            method IMethodSymbol?,
            out receiverDefinition INamedTypeSymbol?
        ) bool {
            receiverDefinition = nil
            if method == nil ||
                !method.IsExtensionMethod ||
                method
                .Parameters
                .Length == 0 ||
                method
                .Parameters[0]
                .Type is not INamedTypeSymbol receiverType {
                return false
            }
            receiverDefinition = receiverType.OriginalDefinition
            if receiverDefinition!!.TypeKind == TypeKind.Enum {
                return true
            }
            return (
                receiverDefinition!!.TypeKind == TypeKind.Class || receiverDefinition!!.TypeKind == TypeKind.Struct
            ) &&
                SymbolEqualityComparer
                .Default
                .Equals(receiverDefinition!!.ContainingAssembly, method.ContainingAssembly) &&
                SymbolEqualityComparer
                .Default
                .Equals(receiverDefinition!!.ContainingNamespace, method.ContainingNamespace)
        }

        private func HasCrossContainerOwnedExtensionOverload(receiver INamedTypeSymbol?, method IMethodSymbol?) bool {
            for type in method!!.ContainingNamespace.GetTypeMembers() {
                for other in type.GetMembers(method!!.Name).OfType[IMethodSymbol]() {
                    if !SymbolEqualityComparer.Default.Equals(other.ContainingType, method!!.ContainingType) &&
                        TryGetOwnedExtensionReceiver(other, out var otherReceiver) &&
                        SymbolEqualityComparer
                        .Default
                        .Equals(otherReceiver, receiver) {
                        return true
                    }
                }
            }
            return false
        }

        private func HasCrossContainerOwnedExtensionDuplicate(receiver INamedTypeSymbol?, method IMethodSymbol?) bool {
            for type in method!!.ContainingNamespace.GetTypeMembers() {
                for other in type.GetMembers(method!!.Name).OfType[IMethodSymbol]() {
                    if !SymbolEqualityComparer.Default.Equals(other.ContainingType, method!!.ContainingType) &&
                        TryGetOwnedExtensionReceiver(other, out var otherReceiver) &&
                        SymbolEqualityComparer
                        .Default
                        .Equals(otherReceiver, receiver) && HaveSameReducedSignature(method, other) {
                        return true
                    }
                }
            }
            return false
        }

        private func IsReproducibleStaticHelper(method IMethodSymbol?) bool {
            let original IMethodSymbol? = method?.ReducedFrom ?? method
            return TryGetOwnedExtensionReceiver(original, out var receiver) &&
                (
                HasCrossContainerOwnedExtensionOverload(receiver, original) ||
                    HasReducedDeclarationCollision(receiver, original) ||
                    original!!
                    .Parameters[0]
                    .RefKind != RefKind.None
            )
        }

        private func RequiresOwnerScopedExtension(method IMethodSymbol?) bool {
            let original IMethodSymbol? = method?.ReducedFrom ?? method
            // Issue #4676: only an extension whose receiver the project OWNS (a source
            // type in the same namespace, or an enum) still needs the owner-scoped
            // scheme, because such an extension is moved into the receiver type, which
            // cannot reach the owner's private nested types. An extension on an
            // external receiver (`this Type`, `this string`, `this T`) is lifted to a
            // top-level function and hosted on its owner through `@ExtensionOwner`,
            // which gives it the owner's private access: one function with the real
            // body, one `[Extension]` method on the owner, as in C#. The scheme this
            // replaces kept the body as an in-owner helper and published a forwarding
            // companion on the package's public `<Program>`: an extra public type, and
            // the owner's own method without its extension marker.
            //
            // The same scheme also stays for an extension whose SIGNATURE or ATTRIBUTES name one of
            // the owner's private nested types: gsc binds a function's receiver, parameter and
            // return types, and its attributes, before it resolves `@ExtensionOwner`, so a lifted
            // top-level function cannot name (or access) the private type, while the in-owner
            // helper can. A method whose SIGNATURE names such a type cannot be public API (CS0050);
            // one that only has an attribute naming it can: it keeps the helper and its
            // forwarding companion, and the companion (top level, where the private type cannot
            // be named) leaves off only the attributes that name it, in any position (see
            // TranslateOwnerScopedCompanion).
            return original?.IsExtensionMethod == true &&
                HasPrivateNestedAggregate(original!!.ContainingType) &&
                (
                TryGetOwnedExtensionReceiver(original, out _) ||
                    SignatureTypesNamePrivateNestedType(original) ||
                    AttributesNamePrivateNestedType(original)
            )
        }

        /// Whether the receiver, a parameter, the return type or a type-parameter constraint of
        /// [`method`](paramref) names one of its owner's private nested types.
        /// @param method The extension method.
        /// @returns `true` when a signature type names an owner-private nested type.
        private func SignatureTypesNamePrivateNestedType(
            method IMethodSymbol?
        ) bool -> SignatureTypesNamePrivateNestedType(
            method,
            method!!.ContainingType,
            HashSet[ITypeSymbol](SymbolEqualityComparer.Default)
        )

        private func SignatureTypesNamePrivateNestedType(
            method IMethodSymbol?,
            owner INamedTypeSymbol?,
            visited HashSet[ITypeSymbol]
        ) bool {
            if NamesPrivateNestedType(method!!.ReturnType, owner, visited) {
                return true
            }
            for parameter in method!!.Parameters {
                if NamesPrivateNestedType(parameter.Type, owner, visited) {
                    return true
                }
            }
            for typeParameter in method!!.TypeParameters {
                for constraint in typeParameter.ConstraintTypes {
                    if NamesPrivateNestedType(constraint, owner, visited) {
                        return true
                    }
                }
            }
            return false
        }

        /// Whether an attribute on [`method`](paramref), its return value or a parameter
        /// names one of its owner's private nested types (as the attribute class or in an argument).
        /// @param method The extension method.
        /// @returns `true` when an attribute names an owner-private nested type.
        private func AttributesNamePrivateNestedType(
            method IMethodSymbol?
        ) bool -> AttributeApplicationsNamingPrivateNestedType(method).Count > 0

        /// The syntax of every attribute on [`method`](paramref), its return value
        /// or a parameter that names one of its owner's private nested types.
        /// @param method The extension method.
        /// @returns The attribute syntax nodes (empty when none names such a type).
        private func AttributeApplicationsNamingPrivateNestedType(method IMethodSymbol?) HashSet[
            Microsoft.CodeAnalysis.SyntaxNode
        ] {
            let found = HashSet[Microsoft.CodeAnalysis.SyntaxNode]()
            let owner INamedTypeSymbol? = method!!.ContainingType
            CollectAttributeApplicationsNamingPrivateNestedType(method!!.GetAttributes(), owner, found)
            CollectAttributeApplicationsNamingPrivateNestedType(method!!.GetReturnTypeAttributes(), owner, found)
            for parameter in method!!.Parameters {
                CollectAttributeApplicationsNamingPrivateNestedType(parameter.GetAttributes(), owner, found)
            }
            // Type-parameter attributes are not translated (the code model's type parameter carries
            // only constraints and variance), so no emitted declaration names the type through one.
            return found
        }

        private func CollectAttributeApplicationsNamingPrivateNestedType(
            attributes ImmutableArray[AttributeData],
            owner INamedTypeSymbol?,
            found HashSet[Microsoft.CodeAnalysis.SyntaxNode]
        ) {
            for attribute in attributes {
                if AttributesNamePrivateNestedType(ImmutableArray.Create(attribute), owner) &&
                    attribute
                    .ApplicationSyntaxReference
                    ?.GetSyntax() is Microsoft.CodeAnalysis.SyntaxNode syntax {
                    found.Add(syntax)
                }
            }
        }

        private func AttributesNamePrivateNestedType(
            attributes ImmutableArray[AttributeData],
            owner INamedTypeSymbol?
        ) bool {
            for attribute in attributes {
                if attribute.AttributeClass != nil && NamesPrivateNestedType(attribute.AttributeClass, owner) {
                    return true
                }
                for argument in attribute.ConstructorArguments {
                    if ConstantNamesPrivateNestedType(argument, owner) {
                        return true
                    }
                }
                for named in attribute.NamedArguments {
                    if ConstantNamesPrivateNestedType(named.Value, owner) {
                        return true
                    }
                }
            }
            return false
        }

        private func ConstantNamesPrivateNestedType(constant TypedConstant, owner INamedTypeSymbol?) bool {
            // Every constant carries its own type (an enum constant's is the enum, which the
            // translated argument names), whatever its kind; then recurse into the two kinds
            // that hold more types: `typeof(T)` (the value) and arrays (the elements).
            if constant.Type != nil && NamesPrivateNestedType(constant.Type, owner) {
                return true
            }
            switch constant.Kind {
                case TypedConstantKind.Type {
                    return constant.Value is ITypeSymbol type && NamesPrivateNestedType(type, owner)
                }
                case TypedConstantKind.Array {
                    // A null array argument (`[Marker(null)]` for a `Type[]` parameter) is an
                    // Array constant whose `Values` is the default array, which cannot be enumerated.
                    if constant.Values.IsDefaultOrEmpty {
                        return false
                    }
                    for element in constant.Values {
                        if ConstantNamesPrivateNestedType(element, owner) {
                            return true
                        }
                    }
                    return false
                }
                default {
                    return false
                }
            }
        }

        private func NamesPrivateNestedType(type ITypeSymbol?, owner INamedTypeSymbol?) bool -> NamesPrivateNestedType(
            type,
            owner,
            HashSet[ITypeSymbol](SymbolEqualityComparer.Default)
        )

        private func NamesPrivateNestedType(
            type ITypeSymbol?,
            owner INamedTypeSymbol?,
            visited HashSet[ITypeSymbol]
        ) bool {
            if !visited.Add(type!!) {
                return false
            }
            switch type {
                case array is IArrayTypeSymbol {
                    return NamesPrivateNestedType(array.ElementType, owner, visited)
                }
                case pointer is IPointerTypeSymbol {
                    return NamesPrivateNestedType(pointer.PointedAtType, owner, visited)
                }
                case functionPointer is IFunctionPointerTypeSymbol {
                    return SignatureTypesNamePrivateNestedType(functionPointer.Signature, owner, visited)
                }
                case typeParameter is ITypeParameterSymbol {
                    for constraint in typeParameter.ConstraintTypes {
                        if NamesPrivateNestedType(constraint, owner, visited) {
                            return true
                        }
                    }
                    return false
                }
                case named is INamedTypeSymbol {
                    let liftedDelegate = CSharpTypeMapper.IsLiftedNestedDelegate(named)
                    if liftedDelegate {
                        // Lifting makes the nominal delegate reachable, not private types
                        // exposed by its declaration. Inspect the definition: constructed
                        // signatures can expand generic recursion indefinitely.
                        let definition = named.OriginalDefinition
                        if definition.DelegateInvokeMethod is IMethodSymbol invoke &&
                            SignatureTypesNamePrivateNestedType(invoke, owner, visited) {
                            return true
                        }
                        for parameter in definition.TypeParameters {
                            if NamesPrivateNestedType(parameter, owner, visited) {
                                return true
                            }
                        }
                    }
                    // Every type in the containing chain: it may be an owner-private nested type
                    // itself, and it may carry type arguments (`Outer<Box>.Inner` names `Box`
                    // through the CONTAINING type's arguments, not Inner's own).
                    for var current INamedTypeSymbol? = named; current != nil; current = current!!.ContainingType {
                        if !liftedDelegate && SymbolEqualityComparer.Default.Equals(current.ContainingType, owner) &&
                            current.DeclaredAccessibility == Accessibility.Private {
                            return true
                        }
                        for argument in current.TypeArguments {
                            if NamesPrivateNestedType(argument, owner, visited) {
                                return true
                            }
                        }
                    }
                    return false
                }
                default {
                    return false
                }
            }
        }

        private func IsOwnerScopedCompanionShapeEligible(method IMethodSymbol?) bool {
            let original IMethodSymbol? = method?.ReducedFrom ?? method
            if !(original?.Parameters.Length > 0) ||
                original!!.DeclaredAccessibility == Accessibility.Private ||
                original!!.IsExtern ||
                !IsEffectivelyPublic(original!!.ContainingType) ||
                original!!
                .Parameters[0]
                .RefKind != RefKind.None ||
                original!!
                .Parameters
                .Any((parameter IParameterSymbol) -> parameter.IsParams) ||
                original!!.ReturnsByRef ||
                original!!.ReturnsByRefReadonly ||
                SignatureTypesNamePrivateNestedType(original) {
                return false
            }
            return true
        }

        private func IsEffectivelyPublic(type INamedTypeSymbol?) bool {
            for var current INamedTypeSymbol? = type; current != nil; current = current!!.ContainingType {
                if current.DeclaredAccessibility != Accessibility.Public || current.IsFileLocal {
                    return false
                }
            }
            return true
        }

        private func HasPrivateNestedAggregate(type INamedTypeSymbol?) bool {
            if type == nil {
                return false
            }
            for nested in type.GetTypeMembers() {
                if (nested.TypeKind != TypeKind.Delegate && nested.DeclaredAccessibility == Accessibility.Private) ||
                    HasPrivateNestedAggregate(nested) {
                    return true
                }
            }
            return false
        }

        private func IsReproducibleReceiverCompanion(method IMethodSymbol?) bool {
            let original IMethodSymbol? = method?.ReducedFrom ?? method
            if RequiresOwnerScopedExtension(original) {
                return IsOwnerScopedCompanionShapeEligible(original)
            }
            return TryGetOwnedExtensionReceiver(original, out var receiver) &&
                original!!
                .Parameters[0]
                .RefKind == RefKind.None &&
                HasCrossContainerOwnedExtensionOverload(receiver, original) &&
                !HasCrossContainerOwnedExtensionDuplicate(receiver, original) &&
                !HasReducedDeclarationCollision(receiver, original)
        }

        private func IsGenericReceiver(type INamedTypeSymbol) bool {
            for var current INamedTypeSymbol? = type; current != nil; current = current!!.ContainingType {
                if current.IsGenericType {
                    return true
                }
            }
            return false
        }

        private func HasReducedDeclarationCollision(type INamedTypeSymbol?, extension IMethodSymbol?) bool {
            for var current INamedTypeSymbol? = type; current != nil; current = current!!.BaseType {
                for member in current.GetMembers(extension!!.Name) {
                    if member.IsStatic {
                        continue
                    }
                    if member is not IMethodSymbol method ||
                        HaveSameReducedSignature(extension, method, leftIsExtension: true, rightIsExtension: false) {
                        return true
                    }
                }
            }
            return false
        }

        private func HasApplicableInstanceMember(type INamedTypeSymbol, extension IMethodSymbol) bool {
            for var current INamedTypeSymbol? = type; current != nil; current = current!!.BaseType {
                for method in current.GetMembers(extension.Name).OfType[IMethodSymbol]() {
                    if !method.IsStatic && HasOverlappingApplicability(method, extension) {
                        return true
                    }
                }
            }
            return false
        }

        private func HasOverlappingApplicability(instanceMethod IMethodSymbol, extension IMethodSymbol) bool {
            let instanceMinimum = MinimumArgumentCount(instanceMethod.Parameters, 0)
            let extensionMinimum = MinimumArgumentCount(extension.Parameters, 1)
            let instanceMaximum = MaximumArgumentCount(instanceMethod.Parameters, 0)
            let extensionMaximum = MaximumArgumentCount(extension.Parameters, 1)
            return Math.Max(instanceMinimum, extensionMinimum) <= Math.Min(instanceMaximum, extensionMaximum)
        }

        private func MinimumArgumentCount(parameters ImmutableArray[IParameterSymbol], offset int32) int32 -> parameters
            .Skip(offset).Count((parameter IParameterSymbol) -> !parameter.IsOptional && !parameter.IsParams)

        private func MaximumArgumentCount(
            parameters ImmutableArray[IParameterSymbol],
            offset int32
        ) int32 -> if parameters.Length > offset &&
            parameters[parameters.Length - 1].IsParams {
            int32.MaxValue
        } else {
            parameters.Length - offset
        }

        private func HaveSameReducedSignature(
            left IMethodSymbol?,
            right IMethodSymbol,
            leftIsExtension bool = true,
            rightIsExtension bool = true
        ) bool {
            if left!!.Name != right.Name || left!!.TypeParameters.Length != right.TypeParameters.Length {
                return false
            }
            let leftOffset = if leftIsExtension {
                1
            } else {
                0
            }
            let rightOffset = if rightIsExtension {
                1
            } else {
                0
            }
            if left!!.Parameters.Length - leftOffset != right.Parameters.Length - rightOffset {
                return false
            }
            for var i = 0; i < left!!.Parameters.Length - leftOffset; i++ {
                let leftParameter = left!!.Parameters[leftOffset + i]
                let rightParameter = right.Parameters[rightOffset + i]
                if leftParameter.RefKind != rightParameter.RefKind ||
                    SignatureType(leftParameter.Type) != SignatureType(rightParameter.Type) {
                    return false
                }
            }
            return true
        }

        private func SignatureType(type ITypeSymbol) string -> string.Concat(
            type.ToDisplayParts(SymbolDisplayFormat.FullyQualifiedFormat).Select(
                (part SymbolDisplayPart) -> if part.Symbol is ITypeParameterSymbol parameter &&
                    parameter.TypeParameterKind == TypeParameterKind.Method {
                    "!" + parameter.Ordinal.ToString(CultureInfo.InvariantCulture)
                } else {
                    part.ToString()
                }
            )
        )

        private func CollectPartialTypeParts(compilation Compilation) Dictionary[
            INamedTypeSymbol,
            List[TypeDeclarationSyntax]
        ] {
            let result = Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]](SymbolEqualityComparer.Default)
            for type in EnumerateNamedTypes(compilation.Assembly.GlobalNamespace) {
                if type.DeclaringSyntaxReferences.Length <= 1 {
                    continue
                }
                let parts = type
                    .DeclaringSyntaxReferences
                    .Select((r SyntaxReference) -> r.GetSyntax())
                    .OfType[TypeDeclarationSyntax]()
                    .OrderByDescending(
                    (p TypeDeclarationSyntax) -> p is RecordDeclarationSyntax record && record.ParameterList != nil
                )
                    .ThenBy((p TypeDeclarationSyntax) -> p.SyntaxTree.FilePath, StringComparer.Ordinal)
                    .ThenBy((p TypeDeclarationSyntax) -> p.SpanStart)
                    .ToList()
                if parts.Count > 1 {
                    result[type] = parts
                }
            }
            return result
        }

        /// Issue #2215: re-derives the raw (cached, whole-compilation) partial-parts
        /// map to only the caller's own retained (translatable) files, dropping a
        /// type entirely once it has one or zero remaining parts (it is then no
        /// longer "partial" from the caller's point of view — its excluded part,
        /// e.g. generator output, is not this caller's concern).
        private func FilterPartialTypeParts(
            raw Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]],
            retainedFilePaths HashSet[string]?
        ) Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]] {
            let result = Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]](SymbolEqualityComparer.Default)
            for entry in raw {
                let kept = entry
                    .Value
                    .Where((p TypeDeclarationSyntax) -> retainedFilePaths!!.Contains(p.SyntaxTree.FilePath))
                    .ToList()
                if kept.Count > 1 {
                    result[entry.Key] = kept
                }
            }
            return result
        }

        // Builds the cycle-safe closure of declarations actually emitted into the
        // root document: root aggregates, their merged partial declarations, their
        // nested aggregates, and owned extension methods absorbed by those exact
        // aggregate symbols. Imports and alias reservation consume the resulting
        // tree set; unrelated declarations sharing one of those trees are never
        // traversed.
        private func CollectContributingDeclarationTrees(
            root Microsoft.CodeAnalysis.CSharp.Syntax.CompilationUnitSyntax,
            context TranslationContext,
            partialTypeParts Dictionary[INamedTypeSymbol, List[TypeDeclarationSyntax]],
            ownedExtensions OwnedExtensionRegistry,
            preservePartialParts bool,
            packageFilter string?,
            includeGlobalNamespace bool,
            flattenedEntryType INamedTypeSymbol?
        ) HashSet[Microsoft.CodeAnalysis.SyntaxTree] {
            let trees = HashSet[Microsoft.CodeAnalysis.SyntaxTree]{root.SyntaxTree}
            let pending = Queue[TypeDeclarationSyntax]()
            let rootModel = context.Compilation.GetSemanticModel(root.SyntaxTree)
            for declaration in EnumerateTopLevelDeclarations(root).OfType[TypeDeclarationSyntax]() {
                let type INamedTypeSymbol? = rootModel.GetDeclaredSymbol(declaration)
                if packageFilter != nil &&
                    !NamespaceBelongsToPackage(type?.ContainingNamespace, packageFilter, includeGlobalNamespace) {
                    continue
                }
                if !preservePartialParts && type != nil && partialTypeParts.TryGetValue(type, out var parts) &&
                    (parts[0].SyntaxTree != declaration.SyntaxTree || parts[0].Span != declaration.Span) {
                    continue
                }
                pending.Enqueue(declaration)
            }
            let seen = HashSet[TypeDeclarationSyntax]()
            while pending.Count > 0 {
                let declaration = pending.Dequeue()
                if !seen.Add(declaration) {
                    continue
                }
                trees.Add(declaration.SyntaxTree)
                let model = context.Compilation.GetSemanticModel(declaration.SyntaxTree)
                let type INamedTypeSymbol? = model.GetDeclaredSymbol(declaration)
                let isFlattenedEntry = type != nil && SymbolEqualityComparer.Default.Equals(
                    type.OriginalDefinition,
                    flattenedEntryType?.OriginalDefinition
                )
                if isFlattenedEntry {
                    continue
                }
                var attachOwnedExtensions = true
                if type != nil && partialTypeParts.TryGetValue(type, out var parts) {
                    let isPrimary = parts[0].SyntaxTree == declaration.SyntaxTree && parts[0].Span == declaration.Span
                    attachOwnedExtensions = isPrimary
                    if !preservePartialParts && isPrimary {
                        for part in parts.Skip(1) {
                            pending.Enqueue(part)
                        }
                    }
                }
                for nested in declaration.Members.OfType[TypeDeclarationSyntax]() {
                    pending.Enqueue(nested)
                }
                if attachOwnedExtensions && type != nil && ownedExtensions.TryGetMethods(type, out var methods) {
                    for method in methods {
                        trees.Add(method.SyntaxTree)
                    }
                }
            }
            return trees
        }

        private func CollectSubclassedBaseTypes(compilation Compilation) HashSet[INamedTypeSymbol] {
            let bases = HashSet[INamedTypeSymbol](SymbolEqualityComparer.Default)
            for type in EnumerateNamedTypes(compilation.Assembly.GlobalNamespace) {
                let baseType INamedTypeSymbol? = type.BaseType
                if baseType != nil &&
                    baseType.SpecialType != SpecialType.System_Object &&
                    baseType.TypeKind == TypeKind.Class {
                    bases.Add(baseType.OriginalDefinition)
                }
            }
            return bases
        }

        private func EnumerateNamedTypes(ns INamespaceSymbol) sequence[INamedTypeSymbol] {
            for type in ns.GetTypeMembers() {
                yield type
                for nested in EnumerateNestedTypes(type) {
                    yield nested
                }
            }
            for child in ns.GetNamespaceMembers() {
                for type in EnumerateNamedTypes(child) {
                    yield type
                }
            }
        }

        private func EnumerateNestedTypes(type INamedTypeSymbol) sequence[INamedTypeSymbol] {
            for nested in type.GetTypeMembers() {
                yield nested
                for deeper in EnumerateNestedTypes(nested) {
                    yield deeper
                }
            }
        }

        /// Issue #1201 / ADR-0134: collects the type symbols targeted by C#
        /// `using static X` directives in the document. Members referenced from
        /// such a directive are brought into unqualified scope in G# by the bare
        /// type import `import X`, so the translator must NOT qualify those
        /// references through the owning type (unlike a sibling static, which still
        /// needs qualification). Aliased `using static` directives are excluded:
        /// an alias does not hoist members. Original definitions are stored so the
        /// comparison is stable across constructed generics.
        private func CollectStaticUsingTargets(
            root Microsoft.CodeAnalysis.CSharp.Syntax.CompilationUnitSyntax,
            context TranslationContext
        ) HashSet[INamedTypeSymbol] {
            let targets = HashSet[INamedTypeSymbol](SymbolEqualityComparer.Default)
            let usings = root.Usings.Concat(
                root
                    .DescendantNodes()
                    .OfType[BaseNamespaceDeclarationSyntax]()
                    .SelectMany(
                    func (n BaseNamespaceDeclarationSyntax) IEnumerable[UsingDirectiveSyntax] {
                        return n.Usings
                    }
                )
            )
            for directive in usings {
                if directive.StaticKeyword.IsKind(Microsoft.CodeAnalysis.CSharp.SyntaxKind.None) ||
                    directive.Name == nil ||
                    directive.Alias != nil {
                    continue
                }
                if context.GetSymbolInfo(directive.Name).Symbol is INamedTypeSymbol typeSymbol {
                    targets.Add(typeSymbol.OriginalDefinition)
                }
            }
            return targets
        }

        private func GetOrCollectAllStaticUsingTargets(compilation Compilation) HashSet[
            INamedTypeSymbol
        ] -> AllStaticUsingTargetsCache
            .GetValue(
            compilation,
            (current Compilation) -> {
                let targets = HashSet[INamedTypeSymbol](SymbolEqualityComparer.Default)
                for tree in current.SyntaxTrees {
                    if tree.GetRoot() is not Microsoft.CodeAnalysis.CSharp.Syntax.CompilationUnitSyntax root {
                        continue
                    }
                    let model = current.GetSemanticModel(tree)
                    let usings = root.Usings.Concat(
                        root
                            .DescendantNodes()
                            .OfType[BaseNamespaceDeclarationSyntax]()
                            .SelectMany(
                            func (declaration BaseNamespaceDeclarationSyntax) IEnumerable[UsingDirectiveSyntax] {
                                return declaration.Usings
                            }
                        )
                    )
                    for directive in usings {
                        if directive.StaticKeyword.IsKind(Microsoft.CodeAnalysis.CSharp.SyntaxKind.None) ||
                            directive.Name == nil ||
                            directive.Alias != nil {
                            continue
                        }
                        if model.GetSymbolInfo(directive.Name!!).Symbol is INamedTypeSymbol type {
                            targets.Add(type.OriginalDefinition)
                        }
                    }
                }
                return targets
            }
        )
    }
}
