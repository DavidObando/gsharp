            // conversion when gsc already widens the operand implicitly.
            private let NumericWideningTargets Dictionary[SpecialType, HashSet[SpecialType]] = Dictionary[
                SpecialType,
                HashSet[SpecialType]
            ]{
                [SpecialType.System_SByte] = HashSet[SpecialType]{
