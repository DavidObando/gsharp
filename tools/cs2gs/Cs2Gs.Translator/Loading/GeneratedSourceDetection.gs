package Cs2Gs.Translator.Loading

import Microsoft.CodeAnalysis
import Microsoft.CodeAnalysis.Text
import System
import System.IO

/// cs2gs's "is this C# file build-generated?" rule (OD-T4, issue #1742): a file
/// is generated when it lives under the project's own `obj/` or
/// `bin/` output directory, or when its text carries the standard
/// `<auto-generated>` header — never by file name alone.
/// `CSharpProjectLoader` drops such files from the documents it hands to
/// the translator; the translator applies the same rule to recognize a dropped
/// part of a partial method pair (ADR-0143 2026-09-23 amendment), so the two
/// can never disagree.
shared class GeneratedSourceDetection {
    /// Whether [`tree`](paramref) is build-generated: under the project's
    /// `obj/`/`bin/` directory ((cref:IsUnderBuildOutputDirectory))
    /// or carrying the `<auto-generated>` header
    /// ((cref:HasAutoGeneratedHeader)).
    /// @param tree The C# syntax tree to inspect.
    /// @param projectDirectory The owning project's directory, or `null` when unknown (in-memory sources),
    /// which disables the path rule.
    /// @returns `true` when the file is build-generated.
    func IsGeneratedSource(tree SyntaxTree?, projectDirectory string?) bool -> IsUnderBuildOutputDirectory(
        tree!!.FilePath,
        projectDirectory
    ) ||
        HasAutoGeneratedHeader(tree)

    /// Whether [`filePath`](paramref) lies under
    /// [`projectDirectory`](paramref)'s own `obj/` or `bin/`
    /// output directory.
    /// @param filePath The source file path.
    /// @param projectDirectory The owning project's directory, or `null` when unknown.
    /// @returns `true` for a build-output path.
    func IsUnderBuildOutputDirectory(filePath string, projectDirectory string?) bool {
        if string.IsNullOrEmpty(filePath) || string.IsNullOrEmpty(projectDirectory) {
            return false
        }
        let normalized = filePath.Replace('\\', '/')
        let objPrefix = Path.Combine(projectDirectory!!, "obj").Replace('\\', '/').TrimEnd('/') + "/"
        let binPrefix = Path.Combine(projectDirectory!!, "bin").Replace('\\', '/').TrimEnd('/') + "/"
        return normalized.StartsWith(objPrefix, StringComparison.OrdinalIgnoreCase) || normalized.StartsWith(
            binPrefix,
            StringComparison.OrdinalIgnoreCase
        )
    }

    /// Sniffs the leading comment lines of a source file for the standard
    /// `// <auto-generated>` marker (the convention emitted by T4,
    /// resx code-gen, source generators, and the SDK's own generated files).
    /// @param tree The C# syntax tree to inspect.
    /// @returns `true` when the file carries the marker.
    func HasAutoGeneratedHeader(tree SyntaxTree?) bool {
        let text = tree!!.GetText()
        let linesToCheck = Math.Min(text.Lines.Count, 5)
        for var i = 0; i < linesToCheck; i++ {
            let line = text.Lines[i].ToString().Trim()
            if line.Length == 0 {
                continue
            }
            if !line.StartsWith("//", StringComparison.Ordinal) {
                break
            }
            if line.Contains("<auto-generated", StringComparison.OrdinalIgnoreCase) {
                return true
            }
        }
        return false
    }
}
