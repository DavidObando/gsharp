package Cs2Gs.Tests

import Cs2Gs.CodeModel.Ast
import Cs2Gs.CodeModel.Printing
import Cs2Gs.Translator
import Cs2Gs.Translator.Loading
import Microsoft.CodeAnalysis
import Microsoft.CodeAnalysis.CSharp
import System
import System.Collections.Generic
import System.IO
import System.Linq
import Xunit

/// ADR-0192 follow-on 2, step 3: the source-generator host (gsgen) binds the
/// C# stub rendered from the user's G# together with the generator output and
/// back-translates ONLY the generator output. A generated partial method
/// implementation whose definition is in the stub (the user's G# declaring
/// part, e.g. `@GeneratedRegex(...) private partial func Digits() Regex;`)
/// must come out as a G# implementing part — `partial func` with its body —
/// so it pairs with that declaring part at build time. The mode is opt-in
/// (`emitGeneratedImplementingParts`); every other caller keeps the
/// ordinary-method shape.
open class Adr0192GeneratedImplementingPartTests {
    @Fact
    func OptionOn_ImplementationOfStubDefinition_IsAnImplementingPartWithItsBody() {
        let (printed, diagnostics) = TranslateGenerated(
            ComputeStub,
            ("C.g.cs", ComputeGenerated),
            emitGeneratedImplementingParts: true
        )
        Assert.DoesNotContain(diagnostics, (d TranslationDiagnostic) -> d.Severity == TranslationSeverity.Unsupported)
        Assert.Contains("private partial func Compute(x int32) int32 {", printed, StringComparison.Ordinal)
        Assert.Contains("return x + 1", printed, StringComparison.Ordinal)
        Assert.DoesNotContain("Compute(x int32) int32;", printed, StringComparison.Ordinal)
        // It pairs with the user's hand-written G# declaring part.
        const userPart = `package Demo

partial class C {
    private partial func Compute(x int32) int32;
    public func Use() int32 -> Compute(1)
}
`
        TranslationTestValidation.AssertBinds(userPart, printed)
    }

    @Fact
    func OptionOff_ImplementationOfStubDefinition_StaysAnOrdinaryMethod() {
        let (printed, _) = TranslateGenerated(
            ComputeStub,
            ("C.g.cs", ComputeGenerated),
            emitGeneratedImplementingParts: false
        )
        Assert.Contains("private func Compute(x int32) int32 {", printed, StringComparison.Ordinal)
        Assert.DoesNotContain("partial func", printed, StringComparison.Ordinal)
    }

    @Fact
    func OptionOn_BothPartsInTranslatedGeneratedTrees_KeepsTheSingleImplementationShape() {
        // A generator emitting both halves: the definition is in a tree this
        // run translates, so the pair follows ADR-0143 with pairs off — the
        // definition is dropped (and not reported: its implementation is
        // translated) and the implementation is an ordinary method.
        const definition = `// <auto-generated/>
namespace Demo
{
    public partial class C
    {
        private partial int Compute(int x);
        public int Use() => Compute(1);
    }
}`
        let (printed, diagnostics) = TranslateGeneratedFiles(
            "// no user declarations\n",
            [](string, string){("C.Def.g.cs", definition), ("C.g.cs", ComputeGenerated)},
            emitGeneratedImplementingParts: true
        )
        Assert.DoesNotContain(diagnostics, (d TranslationDiagnostic) -> d.Severity == TranslationSeverity.Unsupported)
        Assert.DoesNotContain("partial func", printed[0], StringComparison.Ordinal)
        Assert.DoesNotContain("func Compute", printed[0], StringComparison.Ordinal)
        Assert.Contains("private func Compute(x int32) int32 {", printed[1], StringComparison.Ordinal)
        Assert.DoesNotContain("partial func", printed[1], StringComparison.Ordinal)
        TranslationTestValidation.AssertBinds(printed.ToArray())
    }

    @Theory
    @InlineData("Digits.RegexGenerator.g.cs.txt")
    @InlineData("Backtracking.RegexGenerator.g.cs.txt")
    func OptionOn_RealGeneratedRegexOutput_EmitsTheImplementingPart(fixture string) {
        let (printed, diagnostics) = TranslateGenerated(
            RegexStub,
            ("RegexGenerator.g.cs", ReadFixture(fixture)),
            emitGeneratedImplementingParts: true
        )
        Assert.DoesNotContain(diagnostics, (d TranslationDiagnostic) -> d.Severity == TranslationSeverity.Unsupported)
        Assert.Contains("private partial func Digits() Regex -> Digits_0.Instance", printed, StringComparison.Ordinal)
        // A static implementing part lives in the type's `shared { }` block,
        // like the user's static declaring part.
        let shared = printed.IndexOf("shared {", StringComparison.Ordinal)
        Assert.True(shared >= 0 && shared < printed.IndexOf("partial func Digits", StringComparison.Ordinal), printed)
    }

    @Fact
    func OptionOff_RealGeneratedRegexOutput_StaysAnOrdinaryMethod() {
        let (printed, _) = TranslateGenerated(
            RegexStub,
            ("RegexGenerator.g.cs", ReadFixture("Digits.RegexGenerator.g.cs.txt")),
            emitGeneratedImplementingParts: false
        )
        Assert.Contains("private func Digits() Regex -> Digits_0.Instance", printed, StringComparison.Ordinal)
        Assert.DoesNotContain("partial func", printed, StringComparison.Ordinal)
    }

    shared {
        private const StubPath string = "GsgenStubs.cs"

        private const ComputeStub string = `#nullable enable
namespace Demo
{
    public partial class C
    {
        private partial int Compute(int x);
        public int Use() => throw null!;
    }
}`

        private const ComputeGenerated string = `// <auto-generated/>
#nullable enable
namespace Demo
{
    partial class C
    {
        private partial int Compute(int x)
        {
            return x + 1;
        }
    }
}`

        private const RegexStub string = `#nullable enable
namespace App
{
    public partial class P
    {
        [global::System.Text.RegularExpressions.GeneratedRegexAttribute("\\d+")]
        private static partial global::System.Text.RegularExpressions.Regex Digits();
        public static bool Test(string s) => throw null!;
    }
}`

        private func ReadFixture(name string) string -> File.ReadAllText(
            Path.Combine(AppContext.BaseDirectory, "Fixtures", "Adr0192GeneratedRegex", name)
        )

        private func TranslateGenerated(
            stub string,
            generated(Path string, Source string),
            emitGeneratedImplementingParts bool
        )(Printed string, Diagnostics IReadOnlyList[TranslationDiagnostic]) {
            let (printed, diagnostics) = TranslateGeneratedFiles(
                stub,
                [](Path string, Source string){generated},
                emitGeneratedImplementingParts
            )
            return (printed[0], diagnostics)
        }

        // Mirrors GeneratedDocTranslator: stub + generated trees bound in one
        // compilation, only the generated trees translated, each with its own
        // translator instance.
        private func TranslateGeneratedFiles(
            stub string,
            generated IReadOnlyList[(Path string, Source string)],
            emitGeneratedImplementingParts bool
        )(Printed IReadOnlyList[string], Diagnostics IReadOnlyList[TranslationDiagnostic]) {
            let parseOptions = CSharpParseOptions(LanguageVersion.Latest)
            let trees = List[SyntaxTree]{CSharpSyntaxTree.ParseText(stub, parseOptions, path: StubPath)}
            trees.AddRange(
                generated.Select(
                    (file(Path string, Source string)) -> CSharpSyntaxTree.ParseText(
                        file.Source,
                        parseOptions,
                        path: file.Path
                    )
                )
            )
            let compilation = CSharpCompilation.Create(
                "GsgenBackTranslate",
                trees,
                CSharpProjectLoader.RuntimeReferences(),
                CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary).WithNullableContextOptions(
                    NullableContextOptions.Enable
                )
                    .WithAllowUnsafe(true)
            )
            let errors = compilation
                .GetDiagnostics()
                .Where((diagnostic Diagnostic) -> diagnostic.Severity == DiagnosticSeverity.Error)
                .ToArray()
            Assert.True(
                errors.Length == 0,
                string.Join(Environment.NewLine, errors.Select((error Diagnostic) -> error.ToString()))
            )
            let translatedFilePaths = generated.Select((file(Path string, Source string)) -> file.Path).ToArray()
            let printed = List[string]()
            let diagnostics = List[TranslationDiagnostic]()
            for tree in trees.Skip(1) {
                let model = compilation.GetSemanticModel(tree)
                let context = TranslationContext(compilation, model, tree.FilePath)
                let unit = CSharpToGSharpTranslator(
                    preservePartialParts: true,
                    widenObliviousReferenceFields: true,
                    translatedFilePaths: translatedFilePaths,
                    emitGeneratedImplementingParts: emitGeneratedImplementingParts
                ).TranslateDocument(LoadedDocument(tree.FilePath, tree, model), context)
                printed.Add(GSharpPrinter.Print(unit))
                diagnostics.AddRange(context.Diagnostics)
            }
            return (printed, diagnostics)
        }
    }
}
