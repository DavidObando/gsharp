package Cs2Gs.Tests.Coverage

import Cs2Gs.CodeModel.Ast
import Cs2Gs.Pipeline
import GSharp.Tests
import System
import System.Collections.Generic
import System.IO
import System.Linq
import System.Text
import Xunit

/// The code-model surface contract: a reflection snapshot of every concrete
/// public (cref:GNode) subclass (grouped by base) and every enum in
/// `Cs2Gs.CodeModel.Ast` must match its golden. Adding a node type or an
/// enum member fails here until printer coverage and a
/// (cref:GNodeSamples) entry exist and the golden is regenerated.
open class CodeModelSurfaceTests {
    @Fact
    func CodeModelSurface_MatchesGolden() {
        let generated = BuildSnapshot()
        let goldenPath = Path.Combine(
            RepoRoot(),
            "tools",
            "cs2gs",
            "Cs2Gs.Tests",
            "Coverage",
            "code-model-surface.golden.txt"
        )
        GoldenFile.AssertMatches(
            goldenPath,
            generated,
            "Code-model surface changed. Add printer coverage and a minimal GNodeSamples entry " +
                "for every new node type before accepting the snapshot."
        )
    }

    shared {
        /// Builds the deterministic code-model surface snapshot: concrete public
        /// (cref:GNode) subclasses grouped by base class, then the
        /// `Cs2Gs.CodeModel.Ast` enums with their members. Ordinal ordering
        /// throughout.
        /// @returns The snapshot text.
        internal func BuildSnapshot() string {
            let assembly = typeof(GNode).Assembly
            let concrete = assembly.GetExportedTypes().Where(GNodeSamples.IsConcreteNodeType).ToList()
            let groups = [](Header string, Match(Type) -> bool){
                ("GExpression", (t Type) -> typeof(GExpression).IsAssignableFrom(t)),
                ("GStatement", (t Type) -> typeof(GStatement).IsAssignableFrom(t)),
                ("GMember", (t Type) -> typeof(GMember).IsAssignableFrom(t)),
                ("GPattern", (t Type) -> typeof(GPattern).IsAssignableFrom(t)),
                ("GTypeReference", (t Type) -> typeof(GTypeReference).IsAssignableFrom(t))
            }
            let sb = StringBuilder()
            sb.Append("# Cs2Gs.CodeModel emit-AST surface (generated by CodeModelSurfaceTests).\n")
            sb.Append("# On drift: add printer coverage plus a GNodeSamples entry for each new node\n")
            sb.Append("# type, then replace this golden with the generated `.actual` file.\n")
            let remaining = HashSet[Type](concrete)
            for (header, match) in groups {
                sb.Append('\n').Append('[').Append(header).Append("]\n")
                for type in concrete.Where(match).OrderBy((t Type) -> t.Name, StringComparer.Ordinal) {
                    sb.Append(type.Name).Append('\n')
                    remaining.Remove(type)
                }
            }
            sb.Append(`
[GNode (other)]
`)
            for type in remaining.OrderBy((t Type) -> t.Name, StringComparer.Ordinal) {
                sb.Append(type.Name).Append('\n')
            }
            sb.Append(`
[enums]
`)
            let enums = assembly
                .GetExportedTypes()
                .Where((t Type) -> t.IsEnum && t.Namespace == typeof(GNode).Namespace)
                .OrderBy((t Type) -> t.Name, StringComparer.Ordinal)
            for enumType in enums {
                sb.Append(enumType.Name).Append(" = ").Append(string.Join(", ", Enum.GetNames(enumType))).Append('\n')
            }
            return sb.ToString()
        }

        private func RepoRoot() string {
            var dir DirectoryInfo? = DirectoryInfo(
                Path.GetDirectoryName(typeof(CodeModelSurfaceTests).Assembly.Location)!!
            )
            while dir != nil {
                if RepositoryRootMarker.IsRoot(dir.FullName) {
                    return dir.FullName
                }
                dir = dir.Parent
            }
            throw InvalidOperationException("GSharp.sln or GSharp.slnx not found above the test assembly.")
        }
    }
}
