<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppTargetFramework)</TargetFramework>
    <RootNamespace>Cs2Gs.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="@(CoverletCollectorPackageReference)" />
    <PackageReference Include="@(MicrosoftNetTestSdkPackageReference)" />
    <PackageReference Include="@(XunitPackageReference)" />
    <PackageReference Include="@(XunitRunnerVisualStudioPackageReference)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cs2Gs.CodeModel\Cs2Gs.CodeModel.csproj" />
    <ProjectReference Include="..\Cs2Gs.Translator\Cs2Gs.Translator.csproj" />
    <ProjectReference Include="..\Cs2Gs.ProjectLoading\Cs2Gs.ProjectLoading.csproj" />
    <ProjectReference Include="..\Cs2Gs.Pipeline\Cs2Gs.Pipeline.csproj" />
    <ProjectReference Include="..\Cs2Gs.Report\Cs2Gs.Report.csproj" />
    <ProjectReference Include="..\Cs2Gs.Cli\Cs2Gs.Cli.csproj" />

    <!-- Issue #1912 review follow-up: the e2e tests shell out to the built
         gsc.dll (see Issue1912ExplicitEnumValueTranslationTests.FindCompiler)
         rather than referencing it as an assembly. Without this reference,
         `dotnet test` run in isolation on this project can silently compile
         and run against a stale gsc.dll left over from a previous build.
         ReferenceOutputAssembly=false: only needed for build ordering, this
         project never calls into Compiler's API directly. -->
    <ProjectReference Include="..\..\..\src\Compiler\Compiler.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0156 Phase 3c (#3176): the shared emitted oracle replaces the
         retired Compilation.Evaluate for semantic round-trip checks. -->
    <Compile Include="..\..\..\test\Shared\EmittedOracle.cs" Link="EmittedOracle.cs" />
    <Compile Include="..\..\..\test\Shared\EmittedOracleOptions.cs" Link="EmittedOracleOptions.cs" />
    <Compile Include="..\..\..\test\Shared\EmittedOracleResult.cs" Link="EmittedOracleResult.cs" />
    <Compile Include="..\..\..\test\Shared\GoldenFile.cs" Link="GoldenFile.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixture .cs files are translation-test DATA, not test code. -->
    <Compile Remove="Fixtures\**\*.cs" />
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
