package Cs2Gs.Tests

import Cs2Gs.CodeModel.Ast
import Cs2Gs.CodeModel.Printing
import Cs2Gs.Translator
import Cs2Gs.Translator.Loading
import Microsoft.CodeAnalysis
import System
import System.Collections.Generic
import System.IO
import System.Linq
import Xunit

/// Issue #4301 (ADR-0192 follow-on 3): a C# `[GeneratedRegex]` partial
/// method translates to a G# declaring part,
/// `@GeneratedRegex(...) partial func F() Regex;`, whose implementing
/// part gsgen generates at build; the generated C# implementation is dropped,
/// and no `__generatedRegex_` cache field is minted. Shapes G# cannot
/// pair with a generated implementing part are reported. The real-generator
/// round trip (attribute arguments, escaping, culture, instance methods) is
/// `GSharp.GeneratorHost.Tests.GeneratedRegexImplementingPartTests.MigratedGeneratedRegex_*`.
/// @remarks The fixtures model the generator output as a second
/// `// <auto-generated/>` document holding the implementation, the
/// shape a repository migration hands cs2gs: the loader retains explicitly
/// included generated documents, and the translator omits generator-owned
/// declarations while preserving the original compilation.
open class Issue4301GeneratedRegexTranslationTests {
    @Fact
    func StaticMethod_TranslatesToASharedDeclaringPart_WithoutACacheField() {
        const source = `
using System.Text.RegularExpressions;

namespace App;

public partial class P
{
    [GeneratedRegex(@"\d+")]
    private static partial Regex Digits();

    public static bool Test(string s) => Digits().IsMatch(s);
}`
        const generated = `// <auto-generated/>
namespace App;

partial class P
{
    [System.CodeDom.Compiler.GeneratedCode(
        "System.Text.RegularExpressions.Generator", "test")]
    private static partial System.Text.RegularExpressions.Regex Digits() => null!;
}`
        let (printed, diagnostics) = Translate(("P.cs", source), ("P.g.cs", generated))
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.DoesNotContain("__generatedRegex_", printed, StringComparison.Ordinal)
        Assert.Contains(
            "@GeneratedRegex(\"\\\\d+\")" + Environment.NewLine + "        private partial func Digits() Regex;",
            printed,
            StringComparison.Ordinal
        )
        let shared = printed.IndexOf("shared {", StringComparison.Ordinal)
        Assert.True(shared >= 0 && shared < printed.IndexOf("partial func Digits", StringComparison.Ordinal), printed)
        TranslationTestValidation.AssertBinds(printed, DigitsImplementingPart)
    }

    @Fact
    func AliasedAttribute_IsRecognizedByItsResolvedType_AndOtherAttributesStay() {
        const source = `
using System;
using System.Text.RegularExpressions;
using Rx = System.Text.RegularExpressions.GeneratedRegexAttribute;

namespace App;

public partial class P
{
    private const string Pattern = @"\d+";

    [Obsolete("old")]
    [Rx(Pattern, RegexOptions.IgnoreCase | RegexOptions.CultureInvariant, matchTimeoutMilliseconds: 250)]
    private static partial Regex Digits();
}`
        const generated = `// <auto-generated/>
namespace App;

partial class P
{
    private static partial System.Text.RegularExpressions.Regex Digits() => null!;
}`
        let (printed, diagnostics) = Translate(("P.cs", source), ("P.g.cs", generated))
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("@Obsolete(\"old\")", printed, StringComparison.Ordinal)
        // The const pattern is re-spelled as its value, the named timeout is
        // positional (G# binds `name:` arguments as properties), and the
        // flags are spelled as enum members.
        Assert.Contains(
            "(\"\\\\d+\", RegexOptions.CultureInvariant | RegexOptions.IgnoreCase, 250)",
            printed,
            StringComparison.Ordinal
        )
        Assert.Contains("private partial func Digits() Regex;", printed, StringComparison.Ordinal)
        TranslationTestValidation.AssertBinds(printed, DigitsImplementingPart)
    }

    @Fact
    func GeneratedImplementationInATranslatedTree_IsDropped() {
        // A committed generator output (a repository migration translates
        // git-tracked `<auto-generated>` files too): gsgen regenerates the
        // implementation, so emitting it would duplicate the implementing part.
        const source = `
using System.Text.RegularExpressions;

namespace App;

public partial class P
{
    [GeneratedRegex(@"\d+")]
    private static partial Regex Digits();
}`
        const generated = `// <auto-generated/>
namespace App;

partial class P
{
    [System.CodeDom.Compiler.GeneratedCode(
        "System.Text.RegularExpressions.Generator", "test")]
    private static partial System.Text.RegularExpressions.Regex Digits() => new("x");
}`
        let project = CSharpProjectLoader.LoadInMemory([](string, string){("P.cs", source), ("P.g.cs", generated)})
        Assert.True(project.BoundWithoutErrors, string.Join(Environment.NewLine, project.ErrorDiagnostics))
        let generatedTree = project.Compilation.SyntaxTrees.Single((tree SyntaxTree) -> tree.FilePath == "P.g.cs")
        let translator = CSharpToGSharpTranslator(translatedFilePaths: []string{"P.cs", "P.g.cs"})
        let model = project.Compilation.GetSemanticModel(generatedTree)
        let context = TranslationContext(project.Compilation, model, generatedTree.FilePath)
        let printed = GSharpPrinter.Print(
            translator.TranslateDocument(LoadedDocument(generatedTree.FilePath, generatedTree, model), context)
        )
        Assert.DoesNotContain("func Digits", printed, StringComparison.Ordinal)
    }

    @Fact
    func GeneratedImplementationAndHelpers_AreKeptWhenDefinitionIsNotTranslated() {
        const source = `using System.Text.RegularExpressions;

namespace App;

public partial class P
{
    [GeneratedRegex(@"\d+")]
    private static partial Regex Digits();
}`
        let generated = File.ReadAllText(
            Path.Combine(
                AppContext.BaseDirectory,
                "Fixtures",
                "Adr0192GeneratedRegex",
                "Digits.RegexGenerator.g.cs.txt"
            )
        )
        let project = CSharpProjectLoader.LoadInMemory(
            [](string, string){("P.cs", source), ("P.RegexGenerator.g.cs", generated)}
        )
        Assert.True(project.BoundWithoutErrors, string.Join(Environment.NewLine, project.ErrorDiagnostics))
        let generatedTree = project
            .Compilation
            .SyntaxTrees
            .Single((tree SyntaxTree) -> tree.FilePath == "P.RegexGenerator.g.cs")
        let translator = CSharpToGSharpTranslator(translatedFilePaths: []string{"P.RegexGenerator.g.cs"})
        let model = project.Compilation.GetSemanticModel(generatedTree)
        let context = TranslationContext(project.Compilation, model, generatedTree.FilePath)
        let printed = GSharpPrinter.Print(
            translator.TranslateDocument(LoadedDocument(generatedTree.FilePath, generatedTree, model), context)
        )
        Assert.DoesNotContain(
            context.Diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("func Digits() Regex -> Digits_0.Instance", printed, StringComparison.Ordinal)
        Assert.Contains("class Digits_0", printed, StringComparison.Ordinal)
        Assert.Contains("class Utilities", printed, StringComparison.Ordinal)
        TranslationTestValidation.AssertBinds(printed)
    }

    @Fact
    func UserWrittenImplementation_IsReportedInsteadOfSilentlyReplaced() {
        const source = `using System.Text.RegularExpressions;

partial class P
{
    [GeneratedRegex("generated")]
    private static partial Regex Value();

    private static partial Regex Value() => new("written");
}`
        let (printed, diagnostics) = Translate(("P.cs", source))
        let unsupported = Assert.Single(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("user-written partial implementation", unsupported.Message, StringComparison.Ordinal)
        Assert.DoesNotContain("new Regex(\"written\")", printed, StringComparison.Ordinal)
    }

    @Fact
    func MixedTranslatedAndRetainedDefinitions_AreReported() {
        const translatedDefinition = `using System.Text.RegularExpressions;

partial class A
{
    [GeneratedRegex("a")]
    private static partial Regex ARegex();
}`
        const retainedDefinition = `using System.Text.RegularExpressions;

partial class B
{
    [GeneratedRegex("b")]
    private static partial Regex BRegex();
}`
        const generated = `// <auto-generated/>
partial class A
{
    [System.CodeDom.Compiler.GeneratedCode(
        "System.Text.RegularExpressions.Generator", "test")]
    private static partial System.Text.RegularExpressions.Regex ARegex() => ARegex_0.Instance;
}

partial class B
{
    [System.CodeDom.Compiler.GeneratedCode(
        "System.Text.RegularExpressions.Generator", "test")]
    private static partial System.Text.RegularExpressions.Regex BRegex() => BRegex_0.Instance;
}

[System.CodeDom.Compiler.GeneratedCode(
    "System.Text.RegularExpressions.Generator", "test")]
file static class ARegex_0
{
    internal static readonly System.Text.RegularExpressions.Regex Instance = new("a");
}

[System.CodeDom.Compiler.GeneratedCode(
    "System.Text.RegularExpressions.Generator", "test")]
file static class BRegex_0
{
    internal static readonly System.Text.RegularExpressions.Regex Instance = new("b");
}`
        let project = CSharpProjectLoader.LoadInMemory(
            [](string, string){
                ("A.cs", translatedDefinition),
                ("B.cs", retainedDefinition),
                ("RegexGenerator.g.cs", generated)
            }
        )
        Assert.True(project.BoundWithoutErrors, string.Join(Environment.NewLine, project.ErrorDiagnostics))
        let generatedTree = project
            .Compilation
            .SyntaxTrees
            .Single((tree SyntaxTree) -> tree.FilePath == "RegexGenerator.g.cs")
        let translator = CSharpToGSharpTranslator(translatedFilePaths: []string{"A.cs", "RegexGenerator.g.cs"})
        let model = project.Compilation.GetSemanticModel(generatedTree)
        let context = TranslationContext(project.Compilation, model, generatedTree.FilePath)
        translator.TranslateDocument(LoadedDocument(generatedTree.FilePath, generatedTree, model), context)
        let unsupported = Assert.Single(
            context.Diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("only partly included", unsupported.Message, StringComparison.Ordinal)
    }

