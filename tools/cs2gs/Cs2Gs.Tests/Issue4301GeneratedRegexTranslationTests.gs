    @Fact
    func HandWrittenTypeWithRegexGeneratorMetadata_IsPreserved() {
        const source = `using System.CodeDom.Compiler;

[GeneratedCode("System.Text.RegularExpressions.Generator", "test")]
internal class HandWritten
{
    internal static int Value => 42;
}`
        let (printed, diagnostics) = Translate(("HandWritten.cs", source))
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
