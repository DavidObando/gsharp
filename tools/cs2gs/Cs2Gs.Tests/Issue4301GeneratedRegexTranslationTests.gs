    @Fact
    func EntryClassWithMain_IsKeptAsAClass_SoTheDeclaringPartHasAnOwner() {
        // A private-only entry class is otherwise hoisted to top-level funcs,
        // which cannot be partial.
        const source = `
using System;
using System.Text.RegularExpressions;

namespace App;

internal static partial class P
{
    private static void Main()
    {
        Console.WriteLine(Digits().IsMatch("42"));
    }

    [GeneratedRegex(@"\d+")]
    private static partial Regex Digits();
}`
        const generated = `// <auto-generated/>
namespace App;

partial class P
{
    private static partial System.Text.RegularExpressions.Regex Digits() => null!;
}`
        let (printed, diagnostics) = Translate(
            CSharpToGSharpTranslator(),
            OutputKind.ConsoleApplication,
            ("P.cs", source),
            ("P.g.cs", generated)
        )
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("shared partial class P {", printed, StringComparison.Ordinal)
        Assert.Contains("private partial func Digits() Regex;", printed, StringComparison.Ordinal)
        Assert.DoesNotContain("shared {", printed, StringComparison.Ordinal)
        TranslationTestValidation.AssertBinds(printed, SharedDigitsImplementingPart)
    }

    @Fact
    func TopLevelStatementsProgram_KeepsItsPartialProgramClass_AndWidensItsPrivateMembers() {
        // C# top-level statements are the body of Program's entry point, so
        // they reach its private members. G# top-level statements are not in
        // the kept `Program` class, so its private members become internal
        // (GS0472 otherwise); the hoisted form was no stricter.
        const source = `
using System;
using System.Text.RegularExpressions;

Console.WriteLine(Digits().IsMatch("42"));
Console.WriteLine(Describe("x"));
Console.WriteLine("x".Echo());
Console.WriteLine(Program.Box.Secret());

internal static partial class Program
{
    [GeneratedRegex(@"\d+")]
    private static partial Regex Digits();

    private static string Describe(string s) => Digits().IsMatch(s) ? "digits" : s.Echo();

    private static string Echo(this string s) => s;

    private static class Box
    {
        public static string Secret() => "secret";
    }
}

internal static class Unrelated
{
    private static string Hidden() => "hidden";
}`
        const generated = `// <auto-generated/>
partial class Program
{
    private static partial System.Text.RegularExpressions.Regex Digits() => null!;
}`
        const implementingPart = `import System.Text.RegularExpressions

shared partial class Program {
    internal partial func Digits() Regex -> Regex("\\d+")
}
`
        let (printed, diagnostics) = Translate(
            CSharpToGSharpTranslator(),
            OutputKind.ConsoleApplication,
            ("Program.cs", source),
            ("Program.g.cs", generated)
        )
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("shared partial class Program {", printed, StringComparison.Ordinal)
        Assert.Contains("internal partial func Digits() Regex;", printed, StringComparison.Ordinal)
        Assert.Contains("internal func Describe(s string) string", printed, StringComparison.Ordinal)
        // Issue #4676: `Echo` is an extension on an external receiver (`string`) of a class
        // that has a private nested type (`Box`), so it is lifted once and hosted on its
        // owner, which reaches `Box` and the other private members, instead of staying
        // an in-owner helper.
        Assert.Contains("@ExtensionOwner(typeof(Program))", printed, StringComparison.Ordinal)
        Assert.Contains("internal func (s string) Echo() string -> s", printed, StringComparison.Ordinal)
        Assert.DoesNotContain("internal func Echo(s string) string", printed, StringComparison.Ordinal)
        Assert.Contains("internal shared class Box", printed, StringComparison.Ordinal)
        Assert.Contains("func Secret() string", printed, StringComparison.Ordinal)
        Assert.Contains("Program.Digits()", printed, StringComparison.Ordinal)
        Assert.Contains("private func Hidden() string", printed, StringComparison.Ordinal)
        TranslationTestValidation.AssertBinds(printed, implementingPart)
    }

    shared {
        // gsgen's implementing part for `Digits`, standing in for the build: a
        // lone declaring part is GS0609, so binding needs its partner.
        private const DigitsImplementingPart string = `package App

import System.Text.RegularExpressions

partial class P {
    shared {
        private partial func Digits() Regex -> Regex("\\d+")
    }
}
`

        // The same, for a C# static class: its G# form is a `shared class` (ADR-0195), every
        // part of which says `shared` (a part is the body of the type, and `shared` decides
        // what that body means), with the members flat.
        private const SharedDigitsImplementingPart string = `package App

import System.Text.RegularExpressions

shared partial class P {
    private partial func Digits() Regex -> Regex("\\d+")
}
`

        private func Translate(files ...(FileName string, Source string))(
            Printed string,
            Diagnostics IReadOnlyList[TranslationDiagnostic]
        ) -> Translate(CSharpToGSharpTranslator(), OutputKind.DynamicallyLinkedLibrary, files)

        private func Translate(
            translator CSharpToGSharpTranslator,
            outputKind OutputKind,
            files ...(FileName string, Source string)
        )(Printed string, Diagnostics IReadOnlyList[TranslationDiagnostic]) {
            let project = CSharpProjectLoader.LoadInMemory(files, outputKind: outputKind)
            Assert.True(
                project.BoundWithoutErrors,
                "Snippet should bind with no C# errors: " + string.Join(Environment.NewLine, project.ErrorDiagnostics)
            )
            let document = Assert.Single(project.Documents)
            let context = TranslationContext(project.Compilation, document.SemanticModel, document.FilePath)
            let unit = translator.TranslateDocument(document, context)
            return (GSharpPrinter.Print(unit), context.Diagnostics)
        }
    }
}
