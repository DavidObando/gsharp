        Assert.Contains("Value", printed, StringComparison.Ordinal)
    }

    @Theory
    @InlineData("record", "data class")
    @InlineData("record struct", "data struct")
    func RecordOwner_TranslatesToADataTypeDeclaringPart(csharpKind string, gsharpKind string) {
        let source = `
using System.Text.RegularExpressions;

public partial ` + csharpKind + ` Url(string Text)
{
    [GeneratedRegex("^https://")]
    private static partial Regex Scheme();

    public bool IsHttps() => Scheme().IsMatch(Text);
}`
        let generated = "// <auto-generated/>\npartial " + csharpKind + ` Url
{
    private static partial System.Text.RegularExpressions.Regex Scheme() => null!;
}`
        let (printed, diagnostics) = Translate(("Url.cs", source), ("Url.g.cs", generated))
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.DoesNotContain("__generatedRegex_", printed, StringComparison.Ordinal)
        Assert.Contains("partial " + gsharpKind + " Url", printed, StringComparison.Ordinal)
        Assert.Contains("@GeneratedRegex(\"^https://\")", printed, StringComparison.Ordinal)
        Assert.Contains("private partial func Scheme() Regex;", printed, StringComparison.Ordinal)
    }

    @Fact
    func NestedOwner_IsReportedUnsupported() {
        const source = `
using System.Text.RegularExpressions;

public partial class Outer
{
    public partial class Inner
    {
        [GeneratedRegex("\\d+")]
        private static partial Regex Digits();

        public static bool Test(string s) => Digits().IsMatch(s);
    }
}`
        const generated = `// <auto-generated/>
partial class Outer
{
    partial class Inner
    {
        private static partial System.Text.RegularExpressions.Regex Digits() => null!;
    }
}`
        let (printed, diagnostics) = Translate(("Outer.cs", source), ("Outer.g.cs", generated))
        let unsupported = Assert.Single(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("[GeneratedRegex] method 'Inner.Digits'", unsupported.Message, StringComparison.Ordinal)
        Assert.Contains("its type is nested", unsupported.Message, StringComparison.Ordinal)
        Assert.DoesNotContain("__generatedRegex_", printed, StringComparison.Ordinal)
        Assert.DoesNotContain("func Digits", printed, StringComparison.Ordinal)
    }

