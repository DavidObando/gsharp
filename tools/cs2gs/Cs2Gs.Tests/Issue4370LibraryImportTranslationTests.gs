    @Fact
    func StringMarshalAs_Utf8OnEveryString_FoldsIntoStringMarshalling() {
        const source = `
using System.Runtime.InteropServices;

public static partial class Env
{
    [LibraryImport("libc", EntryPoint = "getenv")]
    [return: MarshalAs(UnmanagedType.LPUTF8Str)]
    public static partial string Get([MarshalAs(UnmanagedType.LPUTF8Str)] string name);

    [LibraryImport("libc", EntryPoint = "strlen")]
    public static partial nint Len([MarshalAs(UnmanagedType.LPUTF8Str)] string text);
}`
        const generated = `// <auto-generated/>
public static partial class Env
{
    public static partial string Get(string name) => null;
    public static partial nint Len(string text) => 0;
}`
        let (printed, diagnostics) = Translate(("Env.cs", source), ("Env.g.cs", generated))
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains(
            "@LibraryImport(\"libc\", EntryPoint = \"getenv\", StringMarshalling = StringMarshalling.Utf8)",
            printed,
            StringComparison.Ordinal
        )
        Assert.Contains(
            "@LibraryImport(\"libc\", EntryPoint = \"strlen\", StringMarshalling = StringMarshalling.Utf8)",
            printed,
            StringComparison.Ordinal
        )
        Assert.DoesNotContain("MarshalAs", printed, StringComparison.Ordinal)
