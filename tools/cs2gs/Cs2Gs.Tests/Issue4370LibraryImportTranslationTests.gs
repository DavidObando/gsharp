    @Fact
    func AliasedMarshalAs_IsIdentifiedByType_FoldedAndRemoved() {
        // cs2gs keeps the alias spelling (`@MA`), so a rendered-name match
        // would fold the encoding yet leave `@MA` on the parameter (GS0360).
        const source = `
using System.Runtime.InteropServices;
using MA = System.Runtime.InteropServices.MarshalAsAttribute;

public static partial class Env
{
    [LibraryImport("libc", EntryPoint = "strlen")]
    public static partial nint Len([MA(UnmanagedType.LPUTF8Str)] string text);
}`
        const generated = `// <auto-generated/>
public static partial class Env
{
    public static partial nint Len(string text) => 0;
}`
        let (printed, diagnostics) = Translate(("Env.cs", source), ("Env.g.cs", generated))
        Assert.DoesNotContain(
            diagnostics,
