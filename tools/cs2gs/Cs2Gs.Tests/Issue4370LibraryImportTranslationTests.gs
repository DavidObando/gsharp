        let assembly = CompileInProcess(printed)
        if RuntimeInformation.IsOSPlatform(OSPlatform.Linux) || RuntimeInformation.IsOSPlatform(OSPlatform.OSX) {
            let env = assembly.GetTypes().Single((type Type) -> type.Name == "Env")
            let length object? = env.GetMethod("Len", BindingFlags.Public | BindingFlags.Static)!!.Invoke(
