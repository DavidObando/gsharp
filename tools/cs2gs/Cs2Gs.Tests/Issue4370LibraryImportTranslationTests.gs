    @Fact
    func GeneratedImplementationThisRunTranslates_IsNotReported() {
        // A repository-layout migration also TRANSLATES a git-tracked
        // `<auto-generated>` file. When it is in the run's translated set,
        // its implementation reaches the G# output, so the definition's
        // omission is the ordinary partial rule, not a gap.
        const source = `
public static partial class Registry
{
    public static partial int Count();

    public static partial string Name { get; }

    public static string Show() => (Count() * 2).ToString() + Name;
}`
        const generated = `// <auto-generated/>
public static partial class Registry
{
    public static partial int Count() => 21;

    public static partial string Name => "x";
}`
        let project = CSharpProjectLoader.LoadInMemory(
            [](string, string){("Registry.cs", source), ("Registry.Generated.cs", generated)}
        )
        Assert.True(project.BoundWithoutErrors, string.Join(Environment.NewLine, project.ErrorDiagnostics))
        let documents = project
            .Compilation
            .SyntaxTrees
            .Select(
            (tree Microsoft.CodeAnalysis.SyntaxTree) -> LoadedDocument(
                tree.FilePath,
                tree,
                project.Compilation.GetSemanticModel(tree)
            )
        )
            .ToList()
        let translator = CSharpToGSharpTranslator(
            translatedFilePaths: documents.Select((document LoadedDocument) -> document.FilePath).ToList()
        )
        let diagnostics = List[TranslationDiagnostic]()
        let printed = List[string]()
        for document in documents {
            let context = TranslationContext(project.Compilation, document.SemanticModel, document.FilePath)
            printed.Add(GSharpPrinter.Print(translator.TranslateDocument(document, context)))
            diagnostics.AddRange(context.Diagnostics)
        }
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("func Count() int32 -> 21", printed[1], StringComparison.Ordinal)
        TranslationTestValidation.AssertBinds(printed.ToArray())
    }

    @Fact
    func GeneratedRegexPartialProperty_IsReportedNotSilentlyDropped() {
        // Issue #4301: cs2gs translates the partial METHOD form to a G#
        // declaring part, but G# has no partial properties (ADR-0192 §F), so
        // the property form would otherwise vanish (GS0157 at its uses).
        const source = `
using System.Text.RegularExpressions;

public static partial class Rx
{
    [GeneratedRegex("a+b")]
    private static partial Regex AbProp { get; }

    public static bool Test(string s) => AbProp.IsMatch(s);
}`
        const generated = `// <auto-generated/>
using System.Text.RegularExpressions;

public static partial class Rx
{
    private static partial Regex AbProp => new Regex("a+b");
}`
        let (_, diagnostics) = Translate(("Rx.cs", source), ("Rx.g.cs", generated))
        let unsupported = Assert.Single(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("Rx.AbProp", unsupported.Message, StringComparison.Ordinal)
        Assert.Contains("G# has no partial properties", unsupported.Message, StringComparison.Ordinal)
        Assert.Contains("partial METHOD,", unsupported.Message, StringComparison.Ordinal)
    }

