        let (printed, diagnostics) = Translate(("Native.cs", source), ("Native.g.cs", generated))
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("(\"libc\", EntryPoint = \"getpid\")", printed, StringComparison.Ordinal)
        Assert.Contains("func GetPid() int32;", printed, StringComparison.Ordinal)
    }

    @Fact
    func NamedConstructorArgument_IsEmittedPositionally() {
        // `libraryName:` names the attribute CONSTRUCTOR parameter; G# binds
        // every `name:` argument as a property, which left gsc with no library
        // name (GS0322).
        const source = `
using System.Runtime.InteropServices;

public static partial class Native
{
    private const string Lib = "libc";

    [LibraryImport(libraryName: Lib, EntryPoint = "getpid")]
    public static partial int GetPid();
}`
        const generated = `// <auto-generated/>
public static partial class Native
{
    public static partial int GetPid() => 0;
}`
        let (printed, diagnostics) = Translate(("Native.cs", source), ("Native.g.cs", generated))
        Assert.DoesNotContain(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
        )
        Assert.Contains("@LibraryImport(\"libc\", EntryPoint = \"getpid\")", printed, StringComparison.Ordinal)
        Assert.DoesNotContain("libraryName", printed, StringComparison.Ordinal)
        TranslationTestValidation.AssertBinds(printed)
        let assembly = CompileInProcess(printed)
        if RuntimeInformation.IsOSPlatform(OSPlatform.Linux) || RuntimeInformation.IsOSPlatform(OSPlatform.OSX) {
            let native = assembly.GetTypes().Single((type Type) -> type.Name == "Native")
            let pid object? = native.GetMethod("GetPid", BindingFlags.Public | BindingFlags.Static)!!.Invoke(nil, nil)
            Assert.Equal(Environment.ProcessId, int32(pid))
        }
    }

    @Fact
    func CaveatWarnings_CarryTheirForwardedDiagnosticIds() {
        const source = `
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;

public static partial class Native
{
    [LibraryImport("libc", EntryPoint = "getenv", StringMarshalling = StringMarshalling.Utf8)]
    [UnmanagedCallConv(CallConvs = new[] { typeof(CallConvCdecl) })]
    public static partial string GetEnv(string name);
}`
        const generated = `// <auto-generated/>
public static partial class Native
{
    public static partial string GetEnv(string name) => null;
}`
        let (_, diagnostics) = Translate(("Native.cs", source), ("Native.g.cs", generated))
        Assert.Contains(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Warning &&
                diagnostic.DiagnosticId == CSharpToGSharpTranslator.LibraryImportStringReturnDiagnosticId
        )
        Assert.Contains(
            diagnostics,
            (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Warning &&
                diagnostic.DiagnosticId == CSharpToGSharpTranslator.LibraryImportCallConvDiagnosticId
        )
    }

    shared {
        private const IssueRepro string = `
using System.Runtime.InteropServices;

public static partial class Native
{
    [LibraryImport("libc", EntryPoint = "getpid")]
    public static partial int GetPid();

    public static int Call() => GetPid();
}`

        private const IssueReproGenerated string = `// <auto-generated/>
public static partial class Native
{
    public static partial int GetPid() => 0;
}`

        private func Translate(files ...(FileName string, Source string))(
            Printed string,
            Diagnostics IReadOnlyList[TranslationDiagnostic]
        ) {
            let project = CSharpProjectLoader.LoadInMemory(files)
            Assert.True(
                project.BoundWithoutErrors,
                "Snippet should bind with no C# errors: " + string.Join(Environment.NewLine, project.ErrorDiagnostics)
            )
            // The loader drops the `<auto-generated>` generator output, as a real
            // build's loader does; only the hand-authored document translates.
            let document = Assert.Single(project.Documents)
            let context = TranslationContext(project.Compilation, document.SemanticModel, document.FilePath)
            let unit = CSharpToGSharpTranslator().TranslateDocument(document, context)
            return (GSharpPrinter.Print(unit), context.Diagnostics)
        }

        private func CompileInProcess(source string) Assembly {
            let compilation = GSharpCompilation(GSharpSyntaxTree.Parse(GSharpSourceText.From(source))){IsLibrary = true}
            using let peStream = MemoryStream()
            let result = compilation.Emit(peStream)
            Assert.True(
                result.Success,
                "Emit failed:\n" + string.Join(
                    "\n",
                    result.Diagnostics.Select((d GSharp.Core.CodeAnalysis.Diagnostic) -> d.ToString())
                ) +
                    `

` +
                    source
            )
            peStream.Position = 0
            let loadContext = AssemblyLoadContext("Issue4370-" + Guid.NewGuid().ToString("N"), isCollectible: true)
            return loadContext.LoadFromStream(peStream)
        }
    }
