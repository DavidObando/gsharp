package Cs2Gs.Tests

import Cs2Gs.Pipeline
import System
import System.IO
import System.Linq
import System.Threading.Tasks
import Xunit

/// Stage-level tests for issue #2200: (cref:TranslateStage) must generate a
/// `Resources.Designer.gs` codebehind for each `.resx` file discovered in
/// the loaded C# project (via (cref:GSharp.Core.Resx.ResxCodeGenerator))
/// instead of relying solely on skipping a hand-authored
/// `Resources.Designer.cs` as generated source. Without this, a
/// `using R = ...Resources;` alias in migrated source cannot resolve
/// (GS0157), cascading into GS0159 errors.
open class TranslateStageResxTests {
    @Fact
    async func TranslateStage_DiscoversResxAndEmitsDesignerCodebehind() {
        let compiler string? = FindCompiler()
        if compiler == nil {
            return
        }
        let projectDir = NewScratchDir("translate-resx")
        const DirectoryBuildProps = "<Project><PropertyGroup><SampleProperty>true</SampleProperty></PropertyGroup></Project>"
        File.WriteAllText(Path.Combine(projectDir, "Directory.Build.props"), DirectoryBuildProps)
        let projectPath = Path.Combine(projectDir, "Sample.csproj")
        File.WriteAllText(projectPath, `<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sample.App</RootNamespace>
  </PropertyGroup>
</Project>`)
        let propertiesDir = Path.Combine(projectDir, "Properties")
        Directory.CreateDirectory(propertiesDir)
        File.WriteAllText(Path.Combine(propertiesDir, "Resources.resx"), SampleResx)
        File.WriteAllText(Path.Combine(propertiesDir, "Resources.Designer.gs"), `// <auto-generated>
//     stale designer from a prior design-time generation pass.
// </auto-generated>
package Wrong.Namespace
internal class Resources { }`)
        // A hand-authored Designer.cs carrying the standard auto-generated header
        // must still be skipped from translation (pre-existing behavior); the resx
        // discovery path is what now fills the gap it leaves.
        File.WriteAllText(Path.Combine(propertiesDir, "Resources.Designer.cs"), `//------------------------------------------------------------------------------
// <auto-generated>
//     This code was generated by a tool.
// </auto-generated>
//------------------------------------------------------------------------------
namespace Sample.App.Properties
{
    internal class Resources
    {
        internal static string Greeting => "Hello, world!";
    }
}`)
        File.WriteAllText(
            Path.Combine(projectDir, "Program.cs"),
            "public class Program { public static void Main() { } }"
        )
        let viewsDir = Path.Combine(projectDir, "Views")
        Directory.CreateDirectory(viewsDir)
        File.WriteAllText(
            Path.Combine(viewsDir, "MainView.cs"),
            "namespace Sample.App.Views; public class MainView { }"
        )
        File.WriteAllText(Path.Combine(viewsDir, "MainView.axaml"), "<UserControl />")
        let assetsDir = Path.Combine(projectDir, "Assets")
        Directory.CreateDirectory(assetsDir)
        File.WriteAllBytes(Path.Combine(assetsDir, "logo.bin"), []uint8{1, 2, 3})
        Directory.CreateDirectory(Path.Combine(projectDir, "bin"))
        File.WriteAllText(Path.Combine(projectDir, "bin", "ignored.txt"), "ignore")
        Directory.CreateDirectory(Path.Combine(projectDir, "obj"))
        File.WriteAllText(Path.Combine(projectDir, "obj", "ignored.txt"), "ignore")
        let outRoot = NewOutputRoot("translate-resx")
        let options = PipelineOptions{GscPath: compiler, OutputRoot: outRoot}
        let pipeline = MigrationPipeline(options, []IMigrationStage{TranslateStage()})
        let app = CorpusApp("test/ResxApp", projectPath, TargetKind.Exe)
        let result = await pipeline.RunAsync([]CorpusApp{app})
        let appResult = Assert.Single(result.Apps)
        Assert.True(appResult.Succeeded, "Translate stage must succeed for a project with a valid resx.")
        let designerFiles = Directory.GetFiles(outRoot, "Resources.Designer.gs", SearchOption.AllDirectories)
        let designerFile = Assert.Single(designerFiles)
        let generated = File.ReadAllText(designerFile)
        Assert.Contains("Sample.App.Properties", generated)
        Assert.Contains("Greeting", generated)
        Assert.DoesNotContain("Wrong.Namespace", generated)
        let appOutputDir = Directory.GetParent(Path.GetDirectoryName(designerFile)!!)!!.FullName
        Assert.True(File.Exists(Path.Combine(appOutputDir, "Program.gs")))
        Assert.True(File.Exists(Path.Combine(appOutputDir, "Views", "MainView.gs")))
        Assert.Equal("<UserControl />", File.ReadAllText(Path.Combine(appOutputDir, "Views", "MainView.axaml")))
        Assert.Equal([]uint8{1, 2, 3}, File.ReadAllBytes(Path.Combine(appOutputDir, "Assets", "logo.bin")))
        Assert.True(File.Exists(Path.Combine(appOutputDir, "Properties", "Resources.resx")))
        Assert.Equal(DirectoryBuildProps, File.ReadAllText(Path.Combine(appOutputDir, "Directory.Build.props")))
        Assert.False(File.Exists(Path.Combine(appOutputDir, "Sample.csproj")))
        Assert.False(Directory.Exists(Path.Combine(appOutputDir, "bin")))
        Assert.False(Directory.Exists(Path.Combine(appOutputDir, "obj")))
        // The hand-authored Resources.Designer.cs must not itself have been
        // translated into a second competing .gs file.
        let allGsFiles = Directory.GetFiles(outRoot, "*.gs", SearchOption.AllDirectories)
        Assert.DoesNotContain(allGsFiles, (f string) -> f.Contains("Designer.cs", StringComparison.OrdinalIgnoreCase))
        Assert.DoesNotContain(
            allGsFiles,
            (f string) -> f.EndsWith("Resources.Designer.2.gs", StringComparison.OrdinalIgnoreCase)
        )
    }

    @Fact
    async func TranslateStage_MalformedResx_DoesNotCrashStage() {
        let compiler string? = FindCompiler()
        if compiler == nil {
            return
        }
        let projectDir = NewScratchDir("translate-resx-malformed")
        File.WriteAllText(Path.Combine(projectDir, "Directory.Build.props"), "<Project></Project>")
        let projectPath = Path.Combine(projectDir, "Sample.csproj")
        File.WriteAllText(projectPath, `<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sample.App</RootNamespace>
  </PropertyGroup>
</Project>`)
        File.WriteAllText(Path.Combine(projectDir, "Broken.resx"), "<root><data name=\"X\"><value>unterminated")
        File.WriteAllText(
            Path.Combine(projectDir, "Program.cs"),
            "public class Program { public static void Main() { } }"
        )
        let outRoot = NewOutputRoot("translate-resx-malformed")
        let options = PipelineOptions{GscPath: compiler, OutputRoot: outRoot}
        let pipeline = MigrationPipeline(options, []IMigrationStage{TranslateStage()})
        let app = CorpusApp("test/BrokenResx", projectPath, TargetKind.Exe)
        // Must complete (fail gracefully with a triage artifact), never throw.
        let result = await pipeline.RunAsync([]CorpusApp{app})
        let appResult = Assert.Single(result.Apps)
        Assert.False(appResult.Succeeded)
        let triageFiles = Directory
            .GetFiles(outRoot, "*.json", SearchOption.AllDirectories)
            .Where((f string) -> !Path.GetFileName(f).Equals("summary.json", StringComparison.OrdinalIgnoreCase))
            .ToArray()
        let match string? = triageFiles.FirstOrDefault((f string) -> File.ReadAllText(f).Contains("CS2GS0003"))
        Assert.NotNull(match)
    }

    shared {
        private const SampleResx string = `<?xml version="1.0" encoding="utf-8"?>
<root>
  <data name="Greeting" xml:space="preserve">
    <value>Hello, world!</value>
  </data>
</root>`

        private func NewOutputRoot(label string) string {
            let root = Path.Combine(AppContext.BaseDirectory, "pipeline-tests", label, Guid.NewGuid().ToString("N"))
            Directory.CreateDirectory(root)
            return root
        }

        private func NewScratchDir(label string) string {
            let root = Path.Combine(AppContext.BaseDirectory, "loader-tests", label, Guid.NewGuid().ToString("N"))
            Directory.CreateDirectory(root)
            return root
        }

        private func FindCompiler() string? {
            var dir DirectoryInfo? = DirectoryInfo(AppContext.BaseDirectory)
            while dir != nil {
                for config in[]string{"Release", "Debug"} {
                    let candidate = Path.Combine(dir.FullName, "out", "bin", config, "Compiler", "gsc.dll")
                    if File.Exists(candidate) {
                        return candidate
                    }
                }
                dir = dir.Parent
            }
            return nil
        }
    }
}
