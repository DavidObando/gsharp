package Cs2Gs.Tests

import Cs2Gs.CodeModel.Ast
import Cs2Gs.CodeModel.Printing
import Cs2Gs.Translator
import Cs2Gs.Translator.Loading
import Microsoft.CodeAnalysis
import Microsoft.CodeAnalysis.CSharp
import System.Collections.Generic
import System.Collections.Immutable
import System.Linq
import Xunit

/// Issue #3851 — the runtime half of #3676. A declaration in an
/// `<auto-generated/>` file is OBLIVIOUS to the C# compiler, so a
/// hand-authored, nullable-ENABLED file may write a maybe-null value into it
/// with no CS8601 (verified empirically: adding the header to the declaring
/// file makes the warning at the WRITE site disappear). #3676 promoted such a
/// declaration only when some source spelled a literal `null`/`default`
/// into it, so the far commoner maybe-null shapes — a `T?` local, a
/// `?.`/`??` chain — still translated as non-null G# with a use-site
/// `!!`, which then THREW on the null the C# quietly accepted. That is how
/// migrated `LanguageServer.Tests` lost tests to
/// (cref:System.NullReferenceException) at
/// `LspServer.InitializeAsync` and
/// `SelectionRangeComputer.ComputeSelectionRange` while the app compiled
/// and IL-verified clean.
open class Issue3851MaybeNullWriteEvidenceTests {
    /// SelectionRangeComputer.gs:23 (`Parent: current!!` → NRE). A generated
    /// file's non-null property that a hand-authored file writes a `T?` local
    /// into renders `T?`, and the write needs no `!!`.
    @Fact
    func GeneratedFileProperty_AssignedMaybeNullLocal_PromotesDeclaration() {
        let printed = TranslateEnabled(("Models.cs", GeneratedModelSource), ("Computer.cs", `
namespace Demo
{
    public static class Computer
    {
        public static SelectionRange Build(string[] ranges)
        {
            SelectionRange current = null;
            for (var i = ranges.Length - 1; i >= 0; i--)
            {
                current = new SelectionRange { Range = ranges[i], Parent = current };
            }

            return current;
        }
    }
}`))
        Assert.Contains("Parent SelectionRange?", printed[0])
        Assert.Contains("Range string", printed[0])
        Assert.DoesNotContain("Range string?", printed[0])
        Assert.Contains("Parent: current", printed[1])
        Assert.DoesNotContain("Parent: current!!", printed[1])
    }

    /// LspServer.gs:81 (`(request?.RootPath ?? request?.RootUri?.Path())!!` →
    /// NRE when the client sends neither). A generated file's non-null FIELD
    /// assigned a `?.`/`??` chain renders `string?`, and the assignment needs
    /// no `!!`.
    @Fact
    func GeneratedFileField_AssignedNullConditionalChain_PromotesDeclaration() {
        let printed = TranslateEnabled(("Server.cs", `// <auto-generated/>
namespace Demo
{
    public sealed class Params
    {
        public string RootPath { get; set; }

        public Uri RootUri { get; set; }
    }

    public sealed class Uri
    {
        public string Path() => "p";
    }

    public sealed class Server
    {
        private string pendingRootPath;

        public string Initialize(Params request)
        {
            this.pendingRootPath = request?.RootPath ?? request?.RootUri?.Path();
            return this.pendingRootPath;
        }
    }
}`))
        Assert.Contains("pendingRootPath string?", printed[0])
        Assert.DoesNotContain("!!", printed[0])
    }

    /// Anti-over-promotion guard rail: #3676 deliberately refused the transitive
    /// taint fixpoint here because it over-promoted an enabled compilation's
    /// mostly-annotated graph. Flow state is per-write, so a generated
    /// declaration every write proves non-null keeps its non-null G# type.
    @Fact
    func GeneratedFileDeclaration_AssignedOnlyNonNullValues_StaysNonNull() {
        let printed = TranslateEnabled(("Options.cs", `// <auto-generated/>
namespace Demo
{
    public sealed class Options
    {
        public string Name { get; set; }
    }

    public static class OptionsFactory
    {
        public static Options Create() => new Options { Name = "gsharp" };
    }
}`), ("Consumer.cs", `
namespace Demo
{
    public static class Consumer
    {
        public static Options Configure(string name)
        {
            var options = OptionsFactory.Create();
            options.Name = name ?? "fallback";
            return options;
        }
    }
}`))
        Assert.Contains("Name string", printed[0])
        Assert.DoesNotContain("Name string?", printed[0])
    }

    shared {
        // The `Protocol/Models.cs` shape: a generated model whose `Parent` really is
        // the null terminator of a chain. `Range` is the control — same file, same
        // shape, only ever written a non-null value.
        private const GeneratedModelSource string = `// <auto-generated/>
namespace Demo
{
    public sealed class SelectionRange
    {
        public string Range { get; set; }

        public SelectionRange Parent { get; set; }
    }
}`

        private func TranslateEnabled(sources ...(Path string, Source string))[]string {
            let trees = sources.Select(
                (source(Path string, Source string)) -> CSharpSyntaxTree.ParseText(
                    source.Source,
                    CSharpParseOptions(LanguageVersion.Latest),
                    path: source.Path
                )
            )
                .ToArray()
            let compilation = CSharpCompilation.Create(
                "Snippet",
                trees,
                CSharpProjectLoader.RuntimeReferences().ToImmutableArray(),
                CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary).WithNullableContextOptions(
                    NullableContextOptions.Enable
                )
            )
            Assert.DoesNotContain(
                compilation.GetDiagnostics(),
                (diagnostic Diagnostic) -> diagnostic.Severity == DiagnosticSeverity.Error
            )
            let printed = List[string]()
            for tree in trees {
                let document = LoadedDocument(tree.FilePath, tree, compilation.GetSemanticModel(tree))
                let context = TranslationContext(
                    compilation,
                    document.SemanticModel,
                    document.FilePath,
                    []CSharpCompilation{compilation}
                )
                let unit = CSharpToGSharpTranslator().TranslateDocument(document, context)
                printed.Add(GSharpPrinter.Print(unit))
            }
            return printed.ToArray()
        }
    }
}
