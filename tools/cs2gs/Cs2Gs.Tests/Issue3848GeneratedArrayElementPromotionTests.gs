package Cs2Gs.Tests

import Cs2Gs.CodeModel.Ast
import Cs2Gs.CodeModel.Printing
import Cs2Gs.Pipeline
import Cs2Gs.Translator
import Cs2Gs.Translator.Loading
import Microsoft.CodeAnalysis
import Microsoft.CodeAnalysis.CSharp
import Microsoft.CodeAnalysis.Emit
import System
import System.Collections.Generic
import System.Collections.Immutable
import System.IO
import System.Linq
import System.Reflection
import System.Runtime.Loader
import Xunit

/// Issue #3848, family B — ELEMENT-level promotion of a generated array
/// declaration.
///
/// <b>The defect.</b> `Protocol/Models.cs` is
/// `<auto-generated/>` and declares `public object[] Arguments
/// { get; set; }`. Hand-authored, nullable-ENABLED
/// `CodeLensComputer.CreateReferenceLens` writes `Arguments = [uri,
/// range.Start]` with `uri` a `string?`. The C# compiler suppresses
/// its nullable diagnostics in generated code, so the CS8601 it would otherwise
/// raise for storing a maybe-null value into a non-null element slot never
/// appears and the write is accepted silently. cs2gs translated the annotation
/// at face value — `[]object` — and the use-site forgiveness pass bridged
/// the gap with `[]object{uri!!, …}`. G#'s `!!` is a RUNTIME
/// assertion, so the migrated LSP threw a (cref:NullReferenceException)
/// on the null the C# stored quite happily.
///
/// <b>This is #3676/#3851's rule at element granularity, NOT #3930's
/// forwarding rule.</b> Nothing forwards here: `uri` is an ordinary,
/// compiler-CHECKED `string?` parameter, which
/// `IsPromotedByPureForwarding` rejects outright (clause 6 admits only a
/// direct call or field/property read of an already-promoted symbol). Nor would
/// #3930's declaration-level promotion produce the right answer if it did fire:
/// it widens the DECLARATION, i.e. `object[]` → `[]?object`, the
/// nullable ARRAY. It is a value in the array that is null, not the array, so
/// the promotion this evidence licenses is `[]object?` — the
/// element-nullable spelling (issue #1212 / ADR-0132). The single fact both
/// rules do share is the safety boundary: the sink is generated, so the
/// compiler stopped checking it, so the write is better evidence than the
/// annotation.
///
/// <b>The boundary.</b> A hand-authored `object[]` sink promotes
/// nothing and its element keeps its `!!`, because there the compiler
/// really did raise CS8601 and the author really did have to answer for it.
/// (cref:HandAuthoredArraySink_KeepsItsElementAssertion) and its
/// executing twin
/// (cref:TranslatedHandAuthoredArraySink_StillThrowsOnTheNullElement)
/// hold that down; without them "promote every array element" passes this
/// file.
class Issue3848GeneratedArrayElementPromotionTests {
    /// THE EXECUTING PROOF, and the shape family B actually is. gsc compiles the
    /// translated G# and a C# driver calls `Lens.Create(null, 1)`. The C#
    /// stores the null in `Arguments[0]` and returns; before this change the
    /// migrated G# threw (cref:NullReferenceException) out of the
    /// `uri!!` inside the slice literal. No printed-shape assertion can
    /// tell those two apart once someone "fixes" it by deleting the wrong
    /// `!!`, so the assertion is on what the driver gets back.
    @Fact
    func TranslatedGeneratedArrayElement_HoldsTheNullInsteadOfThrowing() {
        Assert.Equal(DriverNullResult, RunDriver("TranslatedGeneratedArrayElement_HoldsTheNullInsteadOfThrowing", `namespace Repro
{
    public static class Driver
    {
        public static int Run()
        {
            try
            {
                var command = Lens.Create(null, 1);
                return command.Arguments[0] == null ? 1 : 2;
            }
            catch (System.NullReferenceException)
            {
                return 3;
            }
        }
    }
}`, ("Models.cs", GeneratedModelSource), ("Lens.cs", LensSource)))
    }

    /// The same repro read as shapes, and the ADR-0132 axis decision. The
    /// generated slot renders `[]object?` — an array of nullable elements —
    /// and specifically NOT `[]?object`, the nullable array (issue #1212
    /// spells the two apart). cs2gs is right about that distinction and this
    /// change must not blur it: the array reference is not null here, one of the
    /// values in it is.
    ///
    /// The literal at the write site widens with the slot and the element
    /// loses its `!!` — that `!!` is the throw this issue is about.
    @Fact
    func GeneratedArrayElement_IsPromotedAtTheElement_NotAtTheArray() {
        let printed = Translate(("Models.cs", GeneratedModelSource), ("Lens.cs", LensSource))
        Assert.Contains("Arguments []object?", printed["Models.cs"], StringComparison.Ordinal)
        Assert.DoesNotContain("Arguments []?object", printed["Models.cs"], StringComparison.Ordinal)
        Assert.Contains("Arguments: []object?{uri, line}", printed["Lens.cs"], StringComparison.Ordinal)
        Assert.DoesNotContain("!!", printed["Lens.cs"], StringComparison.Ordinal)
    }

    /// ANTI-VACUITY, the "not everything" direction. Two other generated array
    /// slots in the very same generated class are written from the very same
    /// hand-authored method and are NOT promoted: `Tags` is a
    /// `string[]` written only non-null elements, and `Offsets` is an
    /// `int[]` whose value-typed elements can never receive a null at all.
    /// The evidence is the maybe-null WRITE, not "the declaration is generated"
    /// and not "the declaration is an array".
    @Fact
    func GeneratedArraysWithoutMaybeNullElements_AreNotPromoted() {
        let printed = Translate(("Models.cs", GeneratedModelSource), ("Lens.cs", LensSource))
        Assert.Contains("Tags []string\n", printed["Models.cs"], StringComparison.Ordinal)
        Assert.DoesNotContain("Tags []string?", printed["Models.cs"], StringComparison.Ordinal)
        Assert.Contains("Offsets []int32\n", printed["Models.cs"], StringComparison.Ordinal)
        Assert.DoesNotContain("Offsets []int32?", printed["Models.cs"], StringComparison.Ordinal)
    }

    /// ANTI-VACUITY IN THE DANGEROUS DIRECTION. An identical `object[]`
    /// slot in a HAND-AUTHORED, nullable-enabled file is a write the C# compiler
    /// really did check (CS8601), so its annotation stands, the element stays
    /// non-null, and the genuinely-null element must STILL be asserted. Delete
    /// the generated restriction — i.e. promote any array element written a
    /// maybe-null value — and this test fails.
    @Fact
    func HandAuthoredArraySink_KeepsItsElementAssertion() {
        let printed = Translate(("Handwritten.cs", HandAuthoredModelSource), ("HandLens.cs", HandAuthoredLensSource))
        Assert.Contains("Payload []object\n", printed["Handwritten.cs"], StringComparison.Ordinal)
        Assert.DoesNotContain("Payload []object?", printed["Handwritten.cs"], StringComparison.Ordinal)
        Assert.Contains("uri!!", printed["HandLens.cs"], StringComparison.Ordinal)
    }

    /// The executing half of that guard: the retained `!!` is a real
    /// runtime assertion and not decoration. A null genuinely arrives at the
    /// hand-authored element slot and the migrated G# genuinely throws — which
    /// is what "the element still gets its assertion" has to mean, and is the
    /// #3787/#3771 failure mode this rule must not reintroduce.
    @Fact
    func TranslatedHandAuthoredArraySink_StillThrowsOnTheNullElement() {
        Assert.Equal(DriverThrewResult, RunDriver("TranslatedHandAuthoredArraySink_StillThrowsOnTheNullElement", `namespace Repro
{
    public static class Driver
    {
        public static int Run()
        {
            try
            {
                var box = HandLens.Create(null);
                return box.Payload[0] == null ? 1 : 2;
            }
            catch (System.NullReferenceException)
            {
                return 3;
            }
        }
    }
}`, ("Handwritten.cs", HandAuthoredModelSource), ("HandLens.cs", HandAuthoredLensSource)))
    }

    /// SYMMETRY, and the reason the write-site half is gated on the DECLARATION
    /// rather than on this literal's own elements. Once `Arguments` is
    /// `[]object?`, a SECOND write whose elements are all non-null must
    /// widen with it: a `[]object` literal does not convert to a
    /// `[]object?` slot (gsc GS0155), so leaving that literal narrow would
    /// promote the declaration and stop the project compiling — the same class
    /// of break #3930's conversion-operator regression was.
    @Fact
    func SecondWriteWithoutANullElement_WidensWithThePromotedSlot() {
        let printed = Translate(("Models.cs", GeneratedModelSource), ("Lens.cs", LensSource), ("Other.cs", `namespace Repro
{
    public static class Other
    {
        public static Command Plain() => new Command
        {
            Title = "t",
            Arguments = ["a", 1],
            Tags = ["a"],
            Offsets = [1],
        };
    }
}`))
        Assert.Contains("Arguments: []object?{\"a\", 1}", printed["Other.cs"], StringComparison.Ordinal)
        // ... and only the slot the evidence names. `Tags` has no maybe-null
        // write anywhere in the run, so its literal stays narrow.
        Assert.Contains("Tags: []string{\"a\"}", printed["Other.cs"], StringComparison.Ordinal)
    }

    /// The classic array-creation spelling reaches the same answer as the C# 12
    /// collection expression. The evidence is the maybe-null element written
    /// into the generated slot, not the syntax the literal happens to use, and
    /// both spellings translate to the same G# slice literal.
    @Fact
    func ExplicitArrayCreationWrite_PromotesTheSameSlot() {
        let printed = Translate(("Models.cs", GeneratedModelSource), ("Classic.cs", `namespace Repro
{
    public static class Classic
    {
        public static Command Create(string? uri) => new Command
        {
            Title = "t",
            Arguments = new object[] { uri, 1 },
            Tags = new string[] { "a" },
            Offsets = new int[] { 1 },
        };
    }
}`))
        Assert.Contains("Arguments []object?", printed["Models.cs"], StringComparison.Ordinal)
        Assert.Contains("Arguments: []object?{uri, 1}", printed["Classic.cs"], StringComparison.Ordinal)
        Assert.DoesNotContain("!!", printed["Classic.cs"], StringComparison.Ordinal)
    }

    /// DECISION: a SPREAD element is no evidence. `[..values]` hides its
    /// elements behind an enumerable this rule does not walk, so the
    /// conservative answer is "no promotion" and the ordinary forgiveness
    /// behaviour is unchanged there. Recorded because the alternative — treating
    /// the spread's static element type as evidence — is a widening someone
    /// could reach for later, and it would promote on a source's ANNOTATION
    /// rather than on a write the compiler failed to check.
    @Fact
    func SpreadElement_IsNoEvidence() {
        let printed = Translate(("Models.cs", GeneratedModelSource), ("Spread.cs", `using System.Collections.Generic;

namespace Repro
{
    public static class Spread
    {
        public static Command Create(IEnumerable<object> values) => new Command
        {
            Title = "t",
            Arguments = [.. values],
            Tags = ["a"],
            Offsets = [1],
        };
    }
}`))
        Assert.Contains("Arguments []object\n", printed["Models.cs"], StringComparison.Ordinal)
        Assert.DoesNotContain("Arguments []object?", printed["Models.cs"], StringComparison.Ordinal)
    }

    shared {
        // The `Protocol/Models.cs` shape: a generated protocol model with an
        // `object[]` slot whose annotation the C# compiler never checked, plus a
        // second array slot written only non-null values and a value-typed array,
        // so "promoted" can be told apart from "promoted everything".
        private const GeneratedModelSource string = `// <auto-generated/>
namespace Repro
{
    public sealed class Command
    {
        public string Title { get; set; }

        public object[] Arguments { get; set; }

        public string[] Tags { get; set; }

        public int[] Offsets { get; set; }
    }
}`

        // The `CodeLensComputer.CreateReferenceLens` shape, hand-authored and
        // nullable-ENABLED: a `string?` written as an ELEMENT of the generated
        // `object[]`.
        private const LensSource string = `namespace Repro
{
    public static class Lens
    {
        public static Command Create(string? uri, int line) => new Command
        {
            Title = "t",
            Arguments = [uri, line],
            Tags = ["a", "b"],
            Offsets = [1, 2],
        };
    }
}`

        // The hand-authored mirror of the generated model: byte-for-byte the same
        // declaration and the same write, differing ONLY in the
        // `<auto-generated/>` header. That is the whole safety boundary, so the two
        // sources are kept side by side.
        private const HandAuthoredModelSource string = `namespace Repro
{
    public sealed class Box
    {
        public object[] Payload { get; set; }
    }
}`

        private const HandAuthoredLensSource string = `namespace Repro
{
    public static class HandLens
    {
        public static Box Create(string? uri) => new Box
        {
            Payload = [uri, 1],
        };
    }
}`

        private const DriverNullResult int32 = 1
        private const DriverThrewResult int32 = 3

        private func Translate(sources ...(Path string, Source string)) IReadOnlyDictionary[string, string] {
            let trees = sources.Select(
                (source(Path string, Source string)) -> CSharpSyntaxTree.ParseText(
                    source.Source,
                    CSharpParseOptions(LanguageVersion.Latest),
                    path: source.Path
                )
            )
                .ToArray()
            let compilation = CSharpCompilation.Create(
                "Repro",
                trees,
                CSharpProjectLoader.RuntimeReferences().ToImmutableArray(),
                CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary).WithNullableContextOptions(
                    NullableContextOptions.Enable
                )
            )
            Assert.DoesNotContain(
                compilation.GetDiagnostics(),
                (diagnostic Diagnostic) -> diagnostic.Severity == DiagnosticSeverity.Error
            )
            let printed = Dictionary[string, string](StringComparer.Ordinal)
            for tree in trees {
                let document = LoadedDocument(tree.FilePath, tree, compilation.GetSemanticModel(tree))
                let context = TranslationContext(
                    compilation,
                    document.SemanticModel,
                    document.FilePath,
                    []CSharpCompilation{compilation}
                )
                let unit = CSharpToGSharpTranslator().TranslateDocument(document, context)
                Assert.DoesNotContain(
                    context.Diagnostics,
                    (diagnostic TranslationDiagnostic) -> diagnostic.Severity == TranslationSeverity.Unsupported
                )
                printed[tree.FilePath] = GSharpPrinter.Print(unit)
            }
            return printed
        }

        // Translates `sources`, compiles the result with gsc, compiles `driverSource`
        // as C# against the emitted assembly, and returns what `Repro.Driver.Run()`
        // answered. Only this can tell a removed `!!` from a retained one at run
        // time, which is the entire subject of this file.
        private func RunDriver(name string, driverSource string, sources ...(Path string, Source string)) int32 {
            let compiler string? = FindCompiler()
            Assert.True(compiler != nil, "gsc.dll must be built for the runtime tests in this file.")
            let printed = Translate(sources)
            let workDir = NewDirectory(name)
            let gsPaths = List[string]()
            for (path, _) in sources {
                let gsPath = Path.Combine(workDir, Path.ChangeExtension(path, ".gs"))
                File.WriteAllText(gsPath, printed[path] + Environment.NewLine)
                gsPaths.Add(gsPath)
            }
            let libraryPath = Path.Combine(workDir, "Repro.dll")
            let arguments = List[string]{compiler!!, "/target:library", "/out:" + libraryPath}
            arguments.AddRange(gsPaths)
            let compile = ProcessRunner.Run("dotnet", arguments, workDir)
            Assert.True(compile.ExitCode == 0, "gsc must compile the translated model. Output:\n" + compile.Output + `
Translated G#:
` + string.Join(`
----
`, printed.Values))
            let loadContext = AssemblyLoadContext(name, isCollectible: true)
            try {
                let library = loadContext.LoadFromAssemblyPath(libraryPath)
                let references = List[MetadataReference](
                    CSharpProjectLoader.RuntimeReferences()
                ){MetadataReference.CreateFromFile(libraryPath)}
                let driverCompilation = CSharpCompilation.Create(
                    "Repro.Driver",
                    []SyntaxTree{CSharpSyntaxTree.ParseText(driverSource, CSharpParseOptions(LanguageVersion.Latest))},
                    references,
                    CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary)
                )
                let driverPath = Path.Combine(workDir, "Repro.Driver.dll")
                let emitted = driverCompilation.Emit(driverPath)
                Assert.True(
                    emitted.Success,
                    "The C# driver must compile against the gsc-emitted assembly. Diagnostics:\n" + string.Join(
                        Environment.NewLine,
                        emitted.Diagnostics
                    )
                )
                let driver = loadContext.LoadFromAssemblyPath(driverPath)
                let result object? = driver.GetType("Repro.Driver")!!.GetMethod("Run")!!.Invoke(nil, nil)
                return Assert.IsType[int32](result)
            } finally {
                loadContext.Unload()
            }
        }

        private func NewDirectory(category string) string {
            let path = Path.Combine(
                AppContext.BaseDirectory,
                "issue-3848-array-element",
                category,
                Guid.NewGuid().ToString("N")
            )
            Directory.CreateDirectory(path)
            return path
        }

        private func FindCompiler() string? {
            var dir DirectoryInfo? = DirectoryInfo(AppContext.BaseDirectory)
            while dir != nil {
                for config in[]string{"Release", "Debug"} {
                    let candidate = Path.Combine(dir.FullName, "out", "bin", config, "Compiler", "gsc.dll")
                    if File.Exists(candidate) {
                        return candidate
                    }
                }
                dir = dir.Parent
            }
            return nil
        }
    }
}
