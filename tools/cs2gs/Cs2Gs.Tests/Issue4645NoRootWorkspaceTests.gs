package Cs2Gs.Tests

import Cs2Gs.CodeModel.Printing
import Cs2Gs.Pipeline
import Cs2Gs.Translator
import Cs2Gs.Translator.Loading
import System
import System.IO
import System.Threading.Tasks
import Xunit

/// The real LSP initialize/initialized path must pass an absent workspace root
/// to its null-tolerant initializer without a throwing migration bridge.
open class Issue4645NoRootWorkspaceTests {
    @Fact
    async func LanguageServerSelfMigration_NoRootHasNoFailFastBridge() {
        let repoRoot = GsharpTestProjectRunner.FindRepoRoot()!!
        let project = await CSharpProjectLoader.LoadProjectAsync(
            Path.Combine(repoRoot, "src", "LanguageServer", "LanguageServer.csproj"),
            includeAutoGenerated: true
        )
        let Translate = func (name string) string {
            let document = Assert.Single(
                project.Documents,
                (candidate LoadedDocument) -> Path.GetFileName(candidate.FilePath) == name
            )
            let context = TranslationContext(project.Compilation, document.SemanticModel, document.FilePath)
            return GSharpPrinter.Print(
                CSharpToGSharpTranslator(preservePartialParts: true).TranslateDocument(document, context)
            )
        }
        Assert.True(
            project.BoundWithoutErrors,
            "LanguageServer should bind with no C# errors: " + string.Join(
                Environment.NewLine,
                project.ErrorDiagnostics
            )
        )
        let server = Translate("LspServer.cs")
        Assert.Contains("func InitializeAsync(", server, StringComparison.Ordinal)
        Assert.Contains("func Initialized(", server, StringComparison.Ordinal)
        Assert.Contains("WorkspaceInitializer.Initialize(", server, StringComparison.Ordinal)
        Assert.DoesNotContain("rootPath!!", server, StringComparison.Ordinal)
        Assert.DoesNotContain("pendingWorkspaceRootPath!!", server, StringComparison.Ordinal)
        Assert.DoesNotContain(
            "(request?.RootPath ?? request?.RootUri?.GetFileSystemPath())!!",
            server,
            StringComparison.Ordinal
        )
        let initializer = Translate("WorkspaceInitializer.cs")
        Assert.Contains("rootPath string?", initializer, StringComparison.Ordinal)
    }
}
