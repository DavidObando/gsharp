<Project Sdk="Gsharp.NET.Sdk">

  <!-- ADR-0192 follow-on 2: `@GeneratedRegex` on a G# partial method. The
       System.Text.RegularExpressions.Generator ships in the targeting pack, so
       no PackageReference is needed: the Gsharp.NET.Sdk resolves it
       (ADR-0145 §E), gsgen runs it before gsc and writes the generated
       implementing parts under obj/.../gsgen/, and gsc pairs each with its
       declaring part (ADR-0192). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GeneratedRegex</RootNamespace>
  </PropertyGroup>

</Project>
