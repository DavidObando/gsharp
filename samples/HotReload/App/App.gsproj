<Project Sdk="Gsharp.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HotReloadApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="GeneratedValue.axaml">
      <SourceItemGroup>AvaloniaXaml</SourceItemGroup>
    </AdditionalFiles>
    <ProjectReference Include="..\Lib\Lib.gsproj" />
  </ItemGroup>

  <!-- Models an Avalonia-style package target: consume XAML input, materialize
       C# under obj/, then let Gsharp.NET.Sdk route that generated Compile item
       through gsgen before gsc. -->
  <Target Name="_GenerateHotReloadAvaloniaSource"
          BeforeTargets="_GsharpPartitionForeignCompile">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\GeneratedValue.axaml"
             Query="/GeneratedValue/@Value">
      <Output TaskParameter="Result" PropertyName="_HotReloadGeneratedValue" />
    </XmlPeek>
    <PropertyGroup>
      <_HotReloadGeneratedDirectory>$(IntermediateOutputPath)hotreload-generated\</_HotReloadGeneratedDirectory>
      <_HotReloadGeneratedCSharp>$(_HotReloadGeneratedDirectory)GeneratedLike.g.cs</_HotReloadGeneratedCSharp>
    </PropertyGroup>
    <MakeDir Directories="$(_HotReloadGeneratedDirectory)" />
    <ItemGroup>
      <_HotReloadGeneratedLine Remove="@(_HotReloadGeneratedLine)" />
      <_HotReloadGeneratedLine Include="namespace HotReloadApp%3B" />
      <_HotReloadGeneratedLine Include="public static class GeneratedLike" />
      <_HotReloadGeneratedLine Include="{" />
      <_HotReloadGeneratedLine Include="    public static int Current() =&gt; $(_HotReloadGeneratedValue)%3B" />
      <_HotReloadGeneratedLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_HotReloadGeneratedCSharp)"
                      Lines="@(_HotReloadGeneratedLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_HotReloadGeneratedCSharp)" />
      <FileWrites Include="$(_HotReloadGeneratedCSharp)" />
    </ItemGroup>
  </Target>

</Project>
