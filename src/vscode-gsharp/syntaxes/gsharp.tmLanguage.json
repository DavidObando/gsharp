{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GSharp",
  "scopeName": "source.gsharp",
  "fileTypes": ["gs"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#escaped-identifiers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#function-calls" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.gsharp",
          "begin": "///",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.documentation.gsharp" }
          },
          "patterns": [
            {
              "name": "storage.type.class.gsharp.doc",
              "match": "@(summary|remarks|param|typeparam|returns|value|exception|seealso|inheritdoc)\\b"
            }
          ]
        },
        {
          "name": "comment.block.gsharp",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.gsharp",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#byte-string" },
        { "include": "#interpreted-string" },
        { "include": "#raw-string" }
      ]
    },
    "byte-string": {
      "name": "string.quoted.byte.gsharp",
      "begin": "(?<![\\w$])b\"",
      "end": "\"|(?=$)",
      "applyEndPatternLast": true,
      "patterns": [
        {
          "name": "constant.character.escape.gsharp",
          "match": "\\\\([\"\\\\0nrt]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.unrecognized-string-escape.gsharp",
          "match": "\\\\."
        }
      ]
    },
    "interpreted-string": {
      "name": "string.quoted.double.gsharp",
      "begin": "\"",
      "end": "\"|(?=$)",
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#string-escape" },
        {
          "name": "constant.character.escape.dollar.gsharp",
          "match": "\\$\\$"
        },
        { "include": "#interpolation-braced" },
        { "include": "#interpolation-ident" }
      ]
    },
    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.gsharp",
          "match": "\\\\(['\"\\\\0abfnrtv]|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.unrecognized-string-escape.gsharp",
          "match": "\\\\."
        }
      ]
    },
    "raw-string": {
      "name": "string.quoted.raw.backtick.gsharp",
      "begin": "`",
      "end": "`"
    },
    "interpolation-braced": {
      "name": "meta.interpolation.gsharp",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.gsharp" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.gsharp" }
      },
      "patterns": [
        { "include": "#interpolation-postfix" },
        { "include": "#interpolation-type-context" },
        { "include": "#interpolation-member-name" },
        { "include": "#interpolation-object-header" },
        { "include": "#interpolation-conditional" },
        { "include": "#interpolation-format" },
        { "include": "#interpolation-alignment" },
        { "include": "#interpolation-nested-braces" },
        { "include": "#interpolation-nested-parentheses" },
        { "include": "#interpolation-nested-brackets" },
        { "include": "source.gsharp" }
      ]
    },
    "interpolation-type-context": {
      "patterns": [
        {
          "begin": "(?<![\\p{L}\\p{Nd}_$])(as)(?![\\p{L}\\p{Nd}_])",
          "beginCaptures": { "1": { "name": "keyword.other.gsharp" } },
          "end": "(\\?(?![?.\\[]))|(?=\\S)",
          "endCaptures": { "1": { "name": "keyword.operator.gsharp" } },
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#interpolation-type-head" },
            { "include": "#interpolation-type-tail" }
          ]
        },
        { "include": "#interpolation-pattern" },
        {
          "begin": "(?=\\[(?:\\s|/\\*.*?\\*/)*(?:[0-9][0-9a-zA-Z_]*|(?:,(?:\\s|/\\*.*?\\*/)*)*)?(?:\\s|/\\*.*?\\*/)*\\])",
          "end": "(\\?(?![?.\\[]))|(?=\\S)",
          "endCaptures": { "1": { "name": "keyword.operator.gsharp" } },
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#interpolation-type-head" },
            { "include": "#interpolation-type-tail" }
          ]
        }
      ]
    },
    "interpolation-type-head": {
      "comment": "Enter once at the parent's anchor. Consuming the head in end returns to its tail state; trivia and delimited prefixes can persist across physical lines.",
      "begin": "\\G",
      "end": "((?!(?:as|is)\\b)\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)|(?<=\\))|(?=\\S)",
      "endCaptures": { "1": { "patterns": [{ "include": "source.gsharp" }] } },
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#comments" },
        { "include": "#interpolation-function-type" },
        {
          "match": "(?:readonly(?=\\s+(?:managed|slice)\\b)|async(?=\\s+(?:func\\b|sequence\\b|\\())|(?:in|out)(?=\\s+chan\\b))|\\*|\\?(?![?.\\[])",
          "captures": { "0": { "patterns": [{ "include": "source.gsharp" }] } }
        },
        { "include": "#interpolation-nested-brackets" },
        { "include": "#interpolation-nested-parentheses" }
      ]
    },
    "interpolation-type-tail": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#interpolation-nested-brackets" },
        { "include": "#interpolation-member-name" },
        {
          "begin": "->",
          "beginCaptures": { "0": { "name": "keyword.operator.gsharp" } },
          "end": "(\\?(?![?.\\[]))|(?=\\S)",
          "endCaptures": { "1": { "name": "keyword.operator.gsharp" } },
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#interpolation-type-head" },
            { "include": "#interpolation-type-tail" }
          ]
        }
      ]
    },
    "interpolation-function-type": {
      "begin": "(?<![\\p{L}\\p{Nd}_$])(?:func\\b|unmanaged\\b(?=(?:\\s|/\\*.*?\\*/)*(?:[\\[(]|$)))",
      "beginCaptures": { "0": { "name": "keyword.other.gsharp" } },
      "end": "(\\?(?![?.\\[]))|(?=\\S)",
      "endCaptures": { "1": { "name": "keyword.operator.gsharp" } },
      "applyEndPatternLast": true,
      "patterns": [
        {
          "begin": "\\G",
          "end": "(?<=\\))|(?=\\S)",
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#comments" },
            { "include": "#interpolation-nested-brackets" },
            { "include": "#interpolation-nested-parentheses" }
          ]
        },
        { "include": "#comments" },
        {
          "begin": "(?!(?:as|is)\\b)(?=[\\[(*$\\p{L}_])",
          "end": "(\\?(?![?.\\[]))|(?=\\S)",
          "endCaptures": { "1": { "name": "keyword.operator.gsharp" } },
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#interpolation-type-head" },
            { "include": "#interpolation-type-tail" }
          ]
        },
        { "include": "#interpolation-type-tail" }
      ]
    },
    "interpolation-pattern": {
      "comment": "is introduces pattern primaries, not an unconditional type. Only type primaries enter the nullable tail state.",
      "begin": "(?<![\\p{L}\\p{Nd}_$])(is)(?![\\p{L}\\p{Nd}_])",
      "beginCaptures": { "1": { "name": "keyword.other.gsharp" } },
      "end": "(?=\\S)",
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#comments" },
        {
          "match": "(?<![\\p{L}\\p{Nd}_$])(?:not|and|or|is|nil|true|false)\\b|(?<![\\p{L}\\p{Nd}_$])_(?![\\p{L}\\p{Nd}_])(?!(?:\\s|/\\*.*?\\*/)*[.(])",
          "captures": { "0": { "patterns": [{ "include": "source.gsharp" }] } }
        },
        {
          "begin": "(?<![\\p{L}\\p{Nd}_$])(var)(?![\\p{L}\\p{Nd}_])",
          "beginCaptures": { "1": { "name": "keyword.other.gsharp" } },
          "end": "(\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)|(?=\\S)",
          "endCaptures": { "1": { "name": "variable.other.gsharp" } },
          "patterns": [{ "include": "#comments" }]
        },
        { "include": "#strings" },
        { "include": "#characters" },
        { "include": "#numbers" },
        {
          "begin": "(?!(?:as|is|not|and|or|var|when)\\b)(?=[\\[(*$\\p{L}_])",
          "end": "(\\?(?![?.\\[]))(?:\\s+((?!(?:as|is|not|and|or|when)\\b)\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*))?|((?!(?:as|is|not|and|or|when)\\b)\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)|(?=\\S)",
          "endCaptures": {
            "1": { "name": "keyword.operator.gsharp" },
            "2": { "name": "variable.other.gsharp" },
            "3": { "name": "variable.other.gsharp" }
          },
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#interpolation-type-head" },
            { "include": "#interpolation-type-tail" }
          ]
        },
        { "include": "#interpolation-nested-braces" }
      ]
    },
    "interpolation-postfix": {
      "comment": "An index after an operand is not an array type prefix, including when separated by comments or a physical newline.",
      "begin": "(?<=[\\p{L}\\p{Nd}_\\])}])(?=\\s|\\[|/\\*|//)",
      "end": "(?=\\S)",
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#comments" },
        { "include": "#interpolation-nested-brackets" }
      ]
    },
    "interpolation-object-header": {
      "begin": "(?<![\\p{L}\\p{Nd}_$])(object)(?![\\p{L}\\p{Nd}_])",
      "beginCaptures": {
        "1": { "name": "keyword.other.gsharp" }
      },
      "end": "(?<=:)|(?=\\S)",
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#comments" },
        {
          "name": "punctuation.separator.gsharp",
          "match": ":"
        }
      ]
    },
    "interpolation-member-name": {
      "begin": "\\?\\.|(?<!\\.)\\.(?![.0-9])",
      "end": "(\\$[\\p{L}_][\\p{L}\\p{Nd}_]*)|([\\p{L}_][\\p{L}\\p{Nd}_]*)(?=\\s*\\()|([\\p{L}_][\\p{L}\\p{Nd}_]*)|(?=\\S)",
      "endCaptures": {
        "1": { "name": "variable.other.gsharp" },
        "2": { "name": "entity.name.function.gsharp" },
        "3": { "name": "variable.other.gsharp" }
      },
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#comments" }
      ]
    },
    "interpolation-conditional": {
      "name": "meta.conditional.interpolation.gsharp",
      "begin": "(?<!\\?)\\?(?![?.\\[])",
      "end": ":",
      "patterns": [
        { "include": "#interpolation-postfix" },
        { "include": "#interpolation-type-context" },
        { "include": "#interpolation-member-name" },
        { "include": "#interpolation-object-header" },
        { "include": "#interpolation-conditional" },
        { "include": "#interpolation-nested-braces" },
        { "include": "#interpolation-nested-parentheses" },
        { "include": "#interpolation-nested-brackets" },
        { "include": "source.gsharp" }
      ]
    },
    "interpolation-alignment": {
      "match": ",\\s*(-?[0-9]+)",
      "captures": {
        "1": { "name": "constant.numeric.alignment.gsharp" }
      }
    },
    "interpolation-format": {
      "match": ":([^}]*)",
      "captures": {
        "1": { "name": "string.unquoted.format.gsharp" }
      }
    },
    "interpolation-nested-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#interpolation-nested-braces" },
        { "include": "#interpolation-nested-parentheses" },
        { "include": "#interpolation-nested-brackets" },
        { "include": "source.gsharp" }
      ]
    },
    "interpolation-nested-parentheses": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        { "include": "#interpolation-nested-braces" },
        { "include": "#interpolation-nested-parentheses" },
        { "include": "#interpolation-nested-brackets" },
        { "include": "source.gsharp" }
      ]
    },
    "interpolation-nested-brackets": {
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        { "include": "#interpolation-nested-braces" },
        { "include": "#interpolation-nested-parentheses" },
        { "include": "#interpolation-nested-brackets" },
        { "include": "source.gsharp" }
      ]
    },
    "interpolation-ident": {
      "match": "(\\$)([\\p{L}_][\\p{L}\\p{Nd}_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.interpolation.begin.gsharp" },
        "2": { "name": "variable.other.interpolation.gsharp" }
      }
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.gsharp",
          "match": "'(?:\\\\(?:['\"\\\\0abfnrtv]|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})|[^'\\\\\\r\\n])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.gsharp",
          "match": "(?<![\\p{L}\\p{Nd}_$])0[xX]_*[0-9a-fA-F](?:_*[0-9a-fA-F])*(?:[uU][lL]?|[lL][uU]?)?(?![\\p{L}\\p{Nd}_])"
        },
        {
          "name": "constant.numeric.binary.gsharp",
          "match": "(?<![\\p{L}\\p{Nd}_$])0[bB]_*[01](?:_*[01])*(?:[uU][lL]?|[lL][uU]?)?(?![\\p{L}\\p{Nd}_])"
        },
        {
          "name": "constant.numeric.octal.gsharp",
          "match": "(?<![\\p{L}\\p{Nd}_$])0[oO]_*[0-7](?:_*[0-7])*(?:[uU][lL]?|[lL][uU]?)?(?![\\p{L}\\p{Nd}_])"
        },
        {
          "name": "constant.numeric.decimal.gsharp",
          "match": "(?<![\\p{L}\\p{Nd}_$])(?:[0-9](?:_*[0-9])*(?:\\.[0-9](?:_*[0-9])*)?|(?<!\\.)\\.[0-9](?:_*[0-9])*)(?:[eE][+-]?[0-9](?:_*[0-9])*)?(?:[uU][lL]?|[lL][uU]?|[fFdDmM])?(?![\\p{L}\\p{Nd}_])"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.assembly.gsharp",
          "match": "(@)(assembly)(:)\\s*([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.gsharp" },
            "2": { "name": "storage.modifier.annotation-target.gsharp" },
            "3": { "name": "punctuation.separator.annotation-target.gsharp" },
            "4": { "name": "storage.type.annotation.gsharp" }
          }
        },
        {
          "name": "meta.annotation.gsharp",
          "match": "(@)([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.gsharp" },
            "2": { "name": "storage.type.annotation.gsharp" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "Explicit-interface function: `func (IFoo) Name(...)`",
          "match": "\\b(func)\\s+(\\()((?:\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*\\.)*\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*(?:\\[[^\\]\\r\\n]+\\])?)(\\))\\s+(\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.gsharp" },
            "2": { "name": "punctuation.definition.interface.begin.gsharp" },
            "3": { "name": "entity.name.type.interface.gsharp" },
            "4": { "name": "punctuation.definition.interface.end.gsharp" },
            "5": { "name": "entity.name.function.gsharp" }
          }
        },
        {
          "comment": "Explicit-interface property/indexer: `prop (IFoo) Name T`",
          "match": "\\b(prop)\\s+(\\()((?:\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*\\.)*\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*(?:\\[[^\\]\\r\\n]+\\])?)(\\))\\s+(this|\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.gsharp" },
            "2": { "name": "punctuation.definition.interface.begin.gsharp" },
            "3": { "name": "entity.name.type.interface.gsharp" },
            "4": { "name": "punctuation.definition.interface.end.gsharp" },
            "5": { "name": "entity.name.variable.property.gsharp" }
          }
        },
        {
          "comment": "Explicit-interface event: `event (IFoo) Changed Handler`",
          "match": "\\b(event)\\s+(\\()((?:\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*\\.)*\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*(?:\\[[^\\]\\r\\n]+\\])?)(\\))\\s+(\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.gsharp" },
            "2": { "name": "punctuation.definition.interface.begin.gsharp" },
            "3": { "name": "entity.name.type.interface.gsharp" },
            "4": { "name": "punctuation.definition.interface.end.gsharp" },
            "5": { "name": "entity.name.variable.event.gsharp" }
          }
        },
        {
          "comment": "Aggregate declarations per ADR-0078: `class|struct|enum|interface Name`",
          "match": "\\b(class|struct|enum|interface)\\s+(\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.gsharp" },
            "2": { "name": "entity.name.type.gsharp" }
          }
        },
        {
          "comment": "Named delegate type declaration (canonical form, issue #3510): `delegate Name(params) R;`",
          "match": "\\b(delegate)\\s+(\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "keyword.modifier.contextual.gsharp" },
            "2": { "name": "entity.name.type.gsharp" }
          }
        },
        {
          "comment": "Erased type alias: `type Name = Target`; only the delegate RHS spelling is retired.",
          "match": "\\b(type)\\s+(\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "keyword.modifier.contextual.gsharp" },
            "2": { "name": "entity.name.type.gsharp" }
          }
        },
        {
          "comment": "Function/sequence declaration: `func Name(...)` or `sequence Name(...)`",
          "match": "\\b(func|sequence)\\s+(\\$?[\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.gsharp" },
            "2": { "name": "entity.name.function.gsharp" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gsharp",
          "match": "\\b(if|else|for|while|do|guard|switch|case|default|break|continue|return|goto|fallthrough|range|select)\\b"
        },
        {
          "name": "keyword.control.flow.gsharp",
          "match": "\\b(try|catch|finally|throw|rethrow|defer|lock)\\b"
        },
        {
          "name": "keyword.control.async.gsharp",
          "match": "\\b(async|suspend|await|go)\\b"
        },
        {
          "name": "keyword.declaration.gsharp",
          "match": "\\b(func|class|struct|enum|interface|operator|sequence)\\b"
        },
        {
          "name": "keyword.modifier.gsharp",
          "match": "\\b(public|private|protected|internal|open|sealed|override|const)\\b"
        },
        {
          "name": "keyword.modifier.contextual.gsharp",
          "match": "\\b(abstract|adapt|and|any|array|cancelled|cast|checked|comparable|convenience|data|deinit|delegate|event|explicit|fixed|implicit|in|init|inline|make|managed|nameof|not|or|out|params|partial|prop|raise|readonly|record|ref|remove|scoped|shared|sizeof|slice|stackalloc|type|typeof|unchecked|unmanaged|unsafe|when|with|yield)\\b"
        },
        {
          "name": "keyword.other.accessor.gsharp",
          "match": "\\b(get|set|add|remove|raise)\\b"
        },
        {
          "name": "keyword.other.gsharp",
          "match": "\\b(import|package|using|var|let|is|as|scope|chan|map)\\b"
        },
        {
          "name": "keyword.declaration.anonymous-object.gsharp",
          "match": "\\bobject(?=\\s*(?:\\{|:))"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.gsharp",
          "match": "\\b(bool|uint8|int8|int16|uint16|int32|uint32|int64|uint64|nint|nuint|float32|float64|decimal|char|string|bytestring|object|void|byte|sbyte|short|ushort|int|uint|long|ulong|float|double)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.gsharp",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.gsharp",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.gsharp",
          "match": "\\bnil\\b"
        },
        {
          "name": "variable.language.this.gsharp",
          "match": "\\b(this|base)\\b"
        }
      ]
    },
    "operators": {
      "comment": "Patterns are ordered longest-match-first so multi-character operators win over their single-character prefixes.",
      "patterns": [
        {
          "name": "keyword.operator.spread.gsharp",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.gsharp",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.gsharp",
