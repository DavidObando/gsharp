<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetCoreAppTargetFramework)</TargetFramework>
    <RootNamespace>GSharp.LanguageServer</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Protocol/Server files are hand-authored LSP plumbing (marked auto-generated for StyleCop);
         they intentionally omit XML doc comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <_ExplicitReference Remove="$(GsharpValuesRuntimeAssemblyFullPath)" />
    <ProjectReference Include="../Sdk/Gsharp.Runtime.Values/Gsharp.Runtime.Values.gsproj" />
    <ProjectReference Include="@(GsharpCore-&gt;'%(RootDir)%(Directory)%(Filename).gsproj')" />
    <ProjectReference Include="../Formatting/GSharp.Formatting/GSharp.Formatting.gsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="@(StreamJsonRpcPackageReference)" />
    <PackageReference Include="@(MessagePackPackageReference)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GSharp.LanguageServer.Tests" />
  </ItemGroup>

</Project>
