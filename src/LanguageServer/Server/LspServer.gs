    // Mutating ("write") path. Mirrors Roslyn's RequestExecutionQueue handling of
    // MutatesSolutionState=true requests: the gate is held for the whole (brief,
    // parse-only) body so the mutation is fully applied before any later request
    // captures its snapshot. didOpen/didChange/didSave/didClose/watchedFiles use this.
    private async func GuardAsync[T](
        body() -> T,
        @System.Runtime.CompilerServices.CallerMemberName caller string = nil
    ) T {
        await this.gate.WaitAsync().ConfigureAwait(false)
        try {
            try {
                return body()
            } catch (OperationCanceledException) {
                rethrow
            } catch (ex Exception) {
                // Issue #816: handler crashes (e.g., NRE deep in symbol resolution when
                // editing a file whose syntax outpaces the bundled LS) used to surface as
                // a per-request "Object reference not set to an instance of an object"
                // popup for every diagnostic / inlayHint / codeLens / semanticTokens pull
                // until the user restarted the editor. Swallow the exception, log it to
                // structured logging for diagnosis, and return a safe default (null for reference
                // types — LSP clients treat that as "no result" rather than an error).
                LogHandlerException(caller, ex)
                return default(T)
            }
        } finally {
            this.gate.Release()
        }
    }

    // Non-mutating ("read") path. Mirrors Roslyn's RequestExecutionQueue handling of
    // non-mutating requests: the request's snapshot (here, the immutable DocumentContent)
    // is captured serially under the gate so it reflects every prior mutation, and the
    // gate is held only for that O(1) capture. The actual computation then runs OFF the
    // gate on the thread pool via Task.Run so that:
    //   * concurrent read requests never serialize behind one another, and
    //   * a long-running read (e.g. the first cold full-workspace bind, ~17s on a large
    //     workspace) never blocks unrelated reads or, crucially, a didChange while typing.
    // Roslyn likewise dispatches non-mutating work via Task.Run "to enforce parallelizability".
    // CancellationToken is honored end-to-end: StreamJsonRpc maps the LSP $/cancelRequest
    // notification onto this token, it is checked immediately before compute() runs below,
    // and it is threaded all the way into every per-document computer's expensive per-item
    // loops (hover/definition/references/rename/completion/documentSymbol/codeLens/
    // semanticTokens/inlayHint/folding/etc., and the shared SemanticLookup model/reference-index
    // builds they all route through) so a superseded request aborts mid-loop instead of running
    // the whole (potentially per-member FindReferences, per-token, or whole-workspace model
    // build) walk to completion (issue #1662). Note: textDocument/semanticTokens/range
    // recomputes the whole document instead of just the requested range — a separate,
    // pre-existing inefficiency this change does not address.
    private async func ReadDocumentAsync[T](
        identifier TextDocumentIdentifier,
        compute(DocumentContent, CancellationToken) -> T,
        missing T,
        cancellationToken CancellationToken,
        waitForWorkspaceDiscovery bool = true,
        @System.Runtime.CompilerServices.CallerMemberName caller string = nil
    ) T {
        var content DocumentContent?
        try {
            if waitForWorkspaceDiscovery {
                await this.workspaceDiscoveryCompletion.WaitAsync(cancellationToken).ConfigureAwait(false)
                if this.shutdownRequested {
                    return missing
                }
            }
            await this.gate.WaitAsync(cancellationToken).ConfigureAwait(false)
            try {
                if !this.TryGet(identifier, out content) || content == nil {
                    return missing
                }
            } finally {
                this.gate.Release()
            }
        } catch (OperationCanceledException) {
            rethrow
        } catch (ex Exception) {
            // Issue #816: even the snapshot lookup can throw (a faulted content service).
            // Degrade to "no result" rather than surfacing an error popup to the client.
            LogHandlerException(caller, ex)
            return missing
        }
        return await Task.Run(
            () -> {
                try {
                    cancellationToken.ThrowIfCancellationRequested()
                    return compute(content!!, cancellationToken)
                } catch (OperationCanceledException) {
                    rethrow
                } catch (ex Exception) {
                    LogHandlerException(caller, ex)
                    return missing
                }
            },
            cancellationToken
        )
            .ConfigureAwait(false)
    }

    // Non-mutating read over the whole open-document set (workspace symbols, test
    // discovery). The document list is snapshotted under the gate, then enumerated and
    // computed off the gate, identical in spirit to <see cref="ReadDocumentAsync{T}"/>.
    private async func ReadWorkspaceAsync[T](
        compute(IReadOnlyList[KeyValuePair[string, DocumentContent]], CancellationToken) -> T,
        missing T,
        cancellationToken CancellationToken,
        @System.Runtime.CompilerServices.CallerMemberName caller string = nil
    ) T {
        var documents IReadOnlyList[KeyValuePair[string, DocumentContent]]
        try {
            await this.gate.WaitAsync(cancellationToken).ConfigureAwait(false)
            try {
                documents = this.documentContentService.AllDocuments.ToList()
            } finally {
                this.gate.Release()
            }
        } catch (OperationCanceledException) {
            rethrow
        } catch (ex Exception) {
            LogHandlerException(caller, ex)
            return missing
        }
        return await Task.Run(
            () -> {
                try {
                    cancellationToken.ThrowIfCancellationRequested()
                    return compute(documents, cancellationToken)
                } catch (OperationCanceledException) {
                    rethrow
                } catch (ex Exception) {
                    LogHandlerException(caller, ex)
                    return missing
                }
            },
            cancellationToken
        )
            .ConfigureAwait(false)
    }

    // Non-mutating read over the whole workspace's test-bearing source files (the
    // gsharp/discoverTests request). Unlike ReadWorkspaceAsync — which only sees
    // currently-open editor buffers — this snapshots every parsed source tree across
    // all discovered projects, then overlays open buffers so unsaved edits win. This
    // is what makes the Test Explorer reflect every test in the workspace (even in
    // files that have never been opened) after a build. The snapshot is captured under
    // the gate; the (immutable) syntax trees are walked off the gate on the thread pool.
    private async func ReadTestSnapshotAsync[T](
        compute(IReadOnlyList[TestSource], CancellationToken) -> T,
        missing T,
        cancellationToken CancellationToken,
        @System.Runtime.CompilerServices.CallerMemberName caller string = nil
    ) T {
        var sources IReadOnlyList[TestSource]
        try {
            await this.workspaceDiscoveryCompletion.WaitAsync(cancellationToken).ConfigureAwait(false)
            if this.shutdownRequested {
                return missing
            }
            await this.gate.WaitAsync(cancellationToken).ConfigureAwait(false)
            try {
                sources = this.SnapshotTestSources_NoLock()
            } finally {
                this.gate.Release()
            }
        } catch (OperationCanceledException) {
            rethrow
        } catch (ex Exception) {
            LogHandlerException(caller, ex)
            return missing
        }
        return await Task.Run(
            () -> {
                try {
                    cancellationToken.ThrowIfCancellationRequested()
                    return compute(sources, cancellationToken)
                } catch (OperationCanceledException) {
                    rethrow
                } catch (ex Exception) {
                    LogHandlerException(caller, ex)
                    return missing
                }
            },
            cancellationToken
        )
            .ConfigureAwait(false)
    }

    // Builds the de-duplicated set of test sources used by discovery: every project
    // source tree keyed by absolute path (carrying its owning project's identity), with
    // open editor buffers overlaid on top so in-flight edits are reflected and loose
    // (project-less) open files are included.
    private func SnapshotTestSources_NoLock() IReadOnlyList[TestSource] {
        let byPath = Dictionary[string, TestSource](StringComparer.OrdinalIgnoreCase)
        for project in this.workspaceState.Projects {
            let projectFile = project.ProjectFilePath
            let projectLabel = ProjectLabel(project)
            for file in project.SourceFiles {
                if object.ReferenceEquals(this.workspaceState.GetProjectForFile(file), project) &&
                    project.TryGetSyntaxTree(file, out var tree) && tree != nil {
                    let path = PathKeyFor(tree, file)
                    byPath[path] = TestSource(
                        DocumentUri.FromFileSystemPath(file)!!.ToString(),
                        tree,
                        projectFile,
                        projectLabel
                    )
                }
            }
        }
        for pair in this.documentContentService.AllDocuments {
            let tree SyntaxTree? = pair.Value?.SyntaxTree
            if tree == nil {
                continue
            }
            // Open buffers win over the on-disk project tree so the explorer reflects
            // unsaved edits; preserve the client's own URI string so run-at-cursor
            // matching stays byte-for-byte identical to the editor's document URI.
            let path = PathKeyFor(tree, DocumentUri.From(pair.Key)?.GetFileSystemPath() ?? pair.Key)
            // Reuse the project association captured above when the file is a known project
            // source; otherwise resolve it (e.g. a freshly created, not-yet-globbed file).
            var projectFile string? = nil
            var projectLabel string? = nil
            if byPath.TryGetValue(path, out var existing) {
                projectFile = existing.ProjectFile
                projectLabel = existing.ProjectLabel
            } else {
                let owning ProjectState? = this.workspaceState.GetProjectForFile(path)
                if owning != nil {
                    projectFile = owning.ProjectFilePath
                    projectLabel = ProjectLabel(owning)
                }
            }
            byPath[path] = TestSource(pair.Key, tree, projectFile, projectLabel)
        }
        return byPath.Values.OrderBy((s TestSource) -> s.Uri, StringComparer.Ordinal).ToList()
    }

    // A single test-bearing source: its emitted URI, parsed (immutable) tree, and the
    // identity of the owning project (null for loose files) used to build the grouping node.
    private struct TestSource {
        init(uri string, tree SyntaxTree, projectFile string?, projectLabel string?) {
            Uri = uri
            Tree = tree
            ProjectFile = projectFile
            ProjectLabel = projectLabel
        }

        prop Uri string {
            get;
        }

        prop Tree SyntaxTree {
            get;
        }

        prop ProjectFile string? {
            get;
        }

        prop ProjectLabel string? {
            get;
        }
    }

    private func LogHandlerException(handler string, ex Exception) {
        try {
            this.logger.LogError("${handler ?? "handler"} failed: ${ex.GetType().FullName}: ${ex.Message}", ex)
        } catch {
            // Logging is best-effort; never let a logger failure tear down the server.

        }
    }

    private func UpdateDocument(uri DocumentUri, text string) DiagnosticComputationResult {
        let filePath = uri.GetFileSystemPath()
        // Issue #1786 follow-up (B1): record the buffer before touching the project so a
        // concurrent background load that hasn't registered this file's project yet will see
        // it once it gets there, instead of loading stale disk text.
        if !string.IsNullOrEmpty(filePath) {
            this.workspaceState.SetOpenBuffer(filePath, text)
        }
        let project ProjectState? = if !string.IsNullOrEmpty(filePath) {
            this.workspaceState.GetProjectForFile(filePath!!)
        } else {
            default(ProjectState?)
        }
        if project != nil {
            project.UpdateFile(filePath!!, text)
        }
        // Parse-only content (no binding) feeds the content service used by other features;
        // diagnostics are produced on demand by the textDocument/diagnostic pull handler.
        // Issue #1664: this is the only parse of `text`; callers (didOpen/didChange push
        // publish, didSave's off-gate bind) reuse this result instead of re-parsing it.
        let result = DocumentSyncHandler.ComputeDiagnostics(
            text,
            skipBinding: true,
            project,
            filePath,
            this.workspaceState
        )
        this.documentContentService.AddOrUpdate(uri.ToString(), result.Content)
        this.TestOnParseResult?(uri, result)
        return result
    }

    /// Publishes the already-computed parse diagnostics immediately for push-mode clients.
    /// The off-gate full bind scheduled after this replaces them with semantic/binding diagnostics
    /// without delaying document synchronization (issue #1664).
    private func PublishDiagnosticsIfPushMode(uri DocumentUri, result DiagnosticComputationResult) {
        // Clients advertising pull diagnostics request them via textDocument/diagnostic, so push
        // is suppressed to avoid double reporting. Older push-only clients still get notifications.
        if this.clientSupportsPullDiagnostics {
            return
        }
        this.TestOnPublish?(uri, result.Diagnostics)
        this.rpc?.NotifyWithParameterObjectAsync(
            "textDocument/publishDiagnostics",
            PublishDiagnosticsParams{Uri: uri, Diagnostics: result.Diagnostics}
        )
    }

    private func CancelPendingPushDiagnosticsBind(uri DocumentUri?) {
        if uri != nil && this.pushBindCts.TryGetValue(uri.ToString(), out var cts) {
            cts.Cancel()
        }
    }

    /// Schedules the full (binding + `DocumentationValidator`) diagnostics pass push-mode
    /// document synchronization needs, off the write gate. Mirrors
    /// (cref:DocumentDiagnosticAsync): the already-parsed
    /// [`parseResult`](paramref)'s (cref:SyntaxTree) and owning
    /// project were captured under the gate by (cref:UpdateDocument) (brief, parse-only);
    /// the (potentially ~seconds-long, cold-workspace) bind itself runs on the thread pool via
    /// (cref:DocumentSyncHandler.ComputeDiagnosticsForSnapshot), which never calls
    /// (cref:ProjectState.UpdateFile) and so can never clobber a newer tree written by a
    /// concurrent didChange/didSave (issue #1657).
    ///
    /// A per-file (cref:CancellationTokenSource) supersedes stale binds: a newer edit to
    /// the same file cancels any still-running bind for the file's previous text, and the
    /// superseded bind's publish is skipped so it can never overwrite the newer diagnostics
    /// (issue #1664).
    private func SchedulePushDiagnosticsBind(uri DocumentUri, parseResult DiagnosticComputationResult) {
        if this.clientSupportsPullDiagnostics || this.workspaceDiscoveryPending {
            return
        }
        let filePath = uri.GetFileSystemPath()
        let project = parseResult.Content.Project
        let syntaxTree = parseResult.Content.SyntaxTree
        let key = uri.ToString()
        let cts = CancellationTokenSource()
        this.pushBindCts.AddOrUpdate(
            key,
            cts,
            func (_ string, previous CancellationTokenSource) CancellationTokenSource {
                previous.Cancel()
                previous.Dispose()
                return cts
            }
        )
        let token = cts.Token
        let _ = Task.Run(
            async () -> {
                let delay Func[CancellationToken, Task]? = this.TestPushBindDelay
                if delay != nil {
                    try {
                        await delay(token).ConfigureAwait(false)
                    } catch (OperationCanceledException) {
                        return
                    }
                } else {
                    try {
                        await Task.Delay(150, token).ConfigureAwait(false)
                    } catch (OperationCanceledException) {
                        return
                    }
                }
                var bound DiagnosticComputationResult
                var enteredBindGate = false
                try {
                    await this.pushBindGate.WaitAsync(token).ConfigureAwait(false)
                    enteredBindGate = true
                    token.ThrowIfCancellationRequested()
                    bound = DocumentSyncHandler.ComputeDiagnosticsForSnapshot(
                        syntaxTree,
                        skipBinding: false,
                        project,
                        filePath!!,
                        this.workspaceState
                    )
                } catch (OperationCanceledException) {
                    return
                } catch (ex Exception) {
                    LogHandlerException("SchedulePushDiagnosticsBind", ex)
                    return
                } finally {
                    if enteredBindGate {
                        this.pushBindGate.Release()
                    }
                }
                this.TestOnBindResult?(uri, bound)
                try {
                    await this.gate.WaitAsync(token).ConfigureAwait(false)
                    try {
                        // Mutations cancel/replace push binds while holding this same gate. Keep
                        // the final freshness check and notification enqueue atomic with them.
                        if token.IsCancellationRequested || !this.pushBindCts.TryGetValue(key, out var current) ||
                            !object.ReferenceEquals(current, cts) {
                            return
                        }
                        this.TestOnPublish?(uri, bound.Diagnostics)
                        this.rpc?.NotifyWithParameterObjectAsync(
                            "textDocument/publishDiagnostics",
                            PublishDiagnosticsParams{Uri: uri, Diagnostics: bound.Diagnostics}
                        )
                    } finally {
                        this.gate.Release()
                    }
                } catch (OperationCanceledException) {
                    return
                }
            }
        )
    }

    private func DetectClientDiagnosticCapabilities(capabilities JsonElement) {
        try {
            if capabilities.ValueKind == JsonValueKind.Object {
                if capabilities.TryGetProperty("textDocument", out var textDocument) &&
                    textDocument.ValueKind == JsonValueKind.Object &&
                    textDocument.TryGetProperty("diagnostic", out var diagnostic) &&
                    diagnostic.ValueKind == JsonValueKind.Object {
                    this.clientSupportsPullDiagnostics = true
                }
                if capabilities.TryGetProperty("workspace", out var workspace) &&
                    workspace.ValueKind == JsonValueKind.Object &&
                    workspace.TryGetProperty("diagnostics", out var wsDiagnostics) &&
                    wsDiagnostics.ValueKind == JsonValueKind.Object &&
                    wsDiagnostics.TryGetProperty("refreshSupport", out var refreshSupport) &&
                    refreshSupport.ValueKind == JsonValueKind.True {
                    this.clientSupportsDiagnosticRefresh = true
                }
            }
        } catch {
            // Capability probing is best-effort; absence of pull support falls back to push.

        }
    }

    // Refreshes open-document snapshots once background workspace discovery has finished.
    // A file opened before discovery completed was initially recorded without its owning
    // project, so every project-aware feature (definition, hover, references, diagnostics,
    // etc.) must see a replacement snapshot. Pull clients are then asked to re-pull
    // diagnostics; push-only clients get a new full bind immediately.
    private func RefreshOpenDocumentDiagnosticsAfterDiscovery() {
        this.TestOnDiagnosticRefreshAfterDiscovery?()
        this.RefreshOpenDocumentDiagnostics()
    }

    // Must be called while holding the write gate. This keeps each refreshed content snapshot
    // coherent with project discovery/watched-file mutations and lets SchedulePushDiagnosticsBind
    // retain its existing per-document cancellation ordering.
    private func RefreshOpenDocumentDiagnostics() {
        for document in this.documentContentService.AllDocuments.ToList() {
            let uri DocumentUri? = DocumentUri.From(document.Key)
            let filePath = uri?.GetFileSystemPath()
            if uri == nil {
                continue
            }
            let project = if !string.IsNullOrEmpty(filePath) {
                this.workspaceState.GetProjectForFile(filePath!!)
            } else {
                default(ProjectState?)
            }
            // Issue #5024: adopt a matching project tree without changing project source during watcher refreshes.
            // A regenerated file can differ from the buffer until the client synchronizes it.
            let syntaxTree = if project != nil && !string.IsNullOrEmpty(filePath) && project.TryGetSyntaxTree(
                filePath!!,
                out var projectTree
            ) &&
                projectTree != nil &&
                projectTree
                .Text
                .ToString() == document.Value.SyntaxTree.Text.ToString() {
                projectTree
            } else {
                document.Value.SyntaxTree
            }
            let content = DocumentContent(syntaxTree, document.Value.Lines, project, this.workspaceState)
            this.documentContentService.AddOrUpdate(document.Key, content)
            if !this.clientSupportsPullDiagnostics {
                this.SchedulePushDiagnosticsBind(uri, DiagnosticComputationResult(content, Array.Empty[Diagnostic]()))
            }
        }
        if this.clientSupportsPullDiagnostics {
            this.RequestDiagnosticRefresh()
        }
    }

    private func RequestDiagnosticRefresh(changedUri DocumentUri) {
        if !this.clientSupportsPullDiagnostics || !this.clientSupportsDiagnosticRefresh {
            return
        }
        // Single-file edits do not affect other documents, so skip refreshes for documents that
        // are not part of a multi-file project.
        let filePath = changedUri.GetFileSystemPath()
        let project ProjectState? = if !string.IsNullOrEmpty(filePath) {
            this.workspaceState.GetProjectForFile(filePath!!)
        } else {
            default(ProjectState?)
        }
        if project == nil || project.SourceFiles.Count <= 1 {
            return
        }
        this.RequestDiagnosticRefresh()
    }

    private func RefreshRelatedDiagnostics(changedUri DocumentUri) {
        if this.clientSupportsPullDiagnostics {
            this.RequestDiagnosticRefresh(changedUri)
            return
        }
        let changedPath = changedUri.GetFileSystemPath()
        let changedProject ProjectState? = if !string.IsNullOrEmpty(changedPath) {
            this.workspaceState.GetProjectForFile(changedPath!!)
        } else {
            default(ProjectState?)
        }
        if changedProject == nil || changedProject.SourceFiles.Count <= 1 {
            return
        }
        for document in this.documentContentService.AllDocuments.ToList() {
            if string.Equals(document.Key, changedUri.ToString(), StringComparison.Ordinal) {
                continue
            }
            let uri DocumentUri? = DocumentUri.From(document.Key)
            let filePath = uri?.GetFileSystemPath()
            if uri == nil || string.IsNullOrEmpty(filePath) || !object.ReferenceEquals(
                this.workspaceState.GetProjectForFile(filePath!!),
                changedProject
            ) {
                continue
            }
            this.SchedulePushDiagnosticsBind(
                uri,
                DiagnosticComputationResult(document.Value, Array.Empty[Diagnostic]())
            )
        }
    }

    private func RequestDiagnosticRefresh() {
        if !this.clientSupportsDiagnosticRefresh {
            return
        }
        // Debounce: coalesce bursts of changes into a single workspace/diagnostic/refresh request.
        lock this.refreshLock {
            this.refreshTimer ??= Timer(
                (_ object?) -> this.SendDiagnosticRefresh(),
                nil,
                Timeout.Infinite,
                Timeout.Infinite
            )
            this.refreshTimer!!.Change(500, Timeout.Infinite)
        }
    }

    private func SendDiagnosticRefresh() {
        try {
            this.rpc?.InvokeAsync("workspace/diagnostic/refresh")
        } catch {
            // The client may have disconnected; refresh is best-effort.

        }
    }

    private func ComputeSemanticTokens(
        content DocumentContent,
        ct CancellationToken = default(CancellationToken)
    ) SemanticTokens {
        let document = SemanticTokensDocument(SemanticTokensHandler.Legend)
        let builder = document.Create()
        SemanticTokensComputer.Tokenize(builder, content, ct)
        builder.Commit()
        return document.GetSemanticTokens()
    }

    private func FormatDocument(content DocumentContent, span TextSpan? = nil)[]GSharp
        .LanguageServer
        .Protocol
        .TextEdit {
        let sourceText = content.SyntaxTree.Text
        let result = if span is TextSpan requested {
            GSharpFormatter.Format(sourceText, requested)
        } else {
            GSharpFormatter.Format(sourceText)
        }
        if !result.Diagnostics.IsEmpty || !result.Changed {
            return Array.Empty[GSharp.LanguageServer.Protocol.TextEdit]()
        }
        return result
            .Edits
            .Select(
            (edit GSharp.Formatting.TextEdit) -> GSharp
                .LanguageServer
                .Protocol
                .TextEdit{Range: SemanticLookup.ToRange(sourceText, edit.Span), NewText: edit.NewText}
        )
            .ToArray()
    }

    private func ComputePrepareRename(
        content DocumentContent,
        request PrepareRenameParams,
        ct CancellationToken = default(CancellationToken)
    ) Range? {
        let offset = SemanticLookup.ToOffset(content, request.Position)
        let token SyntaxToken? = SemanticLookup.FindTokenAt(content.SyntaxTree, offset)
        if token == nil || token.Kind != SyntaxKind.IdentifierToken {
            return nil
        }
        let compilation Compilation? = TryGetCompilation(content)
        if compilation == nil {
            return nil
        }
        let symbol = SemanticLookup.ResolveSymbol(compilation, token, ct)
        return if SemanticLookup.CanRename(symbol) {
            SemanticLookup.ToRange(token)
        } else {
            default(Range?)
        }
    }

    private func ComputeImplementation(
        content DocumentContent,
        request ImplementationParams,
        ct CancellationToken = default(CancellationToken)
    )[]Location {
        let offset = SemanticLookup.ToOffset(content, request.Position)
        let token SyntaxToken? = SemanticLookup.FindTokenAt(content.SyntaxTree, offset)
        if token == nil || token.Kind != SyntaxKind.IdentifierToken {
            return Array.Empty[Location]()
        }
        let compilation Compilation? = TryGetCompilation(content)
        if compilation == nil {
            return Array.Empty[Location]()
        }
        let symbol = SemanticLookup.ResolveSymbol(compilation, token, ct)
        if symbol is not InterfaceSymbol iface {
            return Array.Empty[Location]()
        }
        let locations = List[Location]()
        // The structs of every tree that implement the interface, in tree order then source order.
        for tree in compilation.SyntaxTrees {
            let model = BoundSemantics.GetModel(compilation, tree)
            if model == nil {
                continue
            }
            for declaration in tree.Root.DescendantNodes().OfType[StructDeclarationSyntax]() {
                ct.ThrowIfCancellationRequested()
                if model.GetDeclaredSymbol(declaration, ct) is StructSymbol structSym && structSym.Interfaces.Contains(
                    iface
                ) {
                    locations.Add(
                        Location{Uri: request.TextDocument.Uri, Range: SemanticLookup.ToRange(declaration.Identifier)}
                    )
                }
            }
        }
        return locations.ToArray()
    }

    private func ComputeTypeDefinition(
        content DocumentContent,
        request TypeDefinitionParams,
        ct CancellationToken = default(CancellationToken)
    )[]Location {
        let offset = SemanticLookup.ToOffset(content, request.Position)
        let token SyntaxToken? = SemanticLookup.FindTokenAt(content.SyntaxTree, offset)
        if token == nil || token.Kind != SyntaxKind.IdentifierToken {
            return Array.Empty[Location]()
        }
        let compilation Compilation? = TryGetCompilation(content)
        if compilation == nil {
            return Array.Empty[Location]()
        }
        let symbol = SemanticLookup.ResolveSymbol(compilation, token, ct)
        // Issue #4989: the expression's bound (flow) type over the symbol's declared one.
        let typeSymbol TypeSymbol? = BoundSemantics.GetExpressionType(compilation, token.Parent as ExpressionSyntax) ??
            switch symbol {
            case ps is ParameterSymbol: ps.Type
            case vs is VariableSymbol: vs.Type
            case fs is FunctionSymbol: fs.Type
            default: default(TypeSymbol?)
        }
        // The type's declaration is the target, so a nullable or platform
        // wrapper (`Result?` from `c?.Make()`, a `Result?` local) is looked
        // through to the declared type.
        let navigationType TypeSymbol? = switch typeSymbol {
            case nullable is NullableTypeSymbol: nullable.UnderlyingType
            case platform is PlatformTypeSymbol: platform.UnderlyingType
            default: typeSymbol
        }
        if navigationType == nil {
            return Array.Empty[Location]()
        }
        let firstRef SyntaxToken? = SemanticLookup.FindReferences(compilation, navigationType, ct).FirstOrDefault()
        if firstRef == nil {
            return Array.Empty[Location]()
        }
        return []Location{Location{Uri: request.TextDocument.Uri, Range: SemanticLookup.ToRange(firstRef)}}
    }

    private func ComputeLinkedEditingRanges(
        content DocumentContent,
        request LinkedEditingRangeParams,
        ct CancellationToken = default(CancellationToken)
    ) LinkedEditingRanges? {
        let tree = content.SyntaxTree
        let offset = SemanticLookup.ToOffset(content, request.Position)
        let token SyntaxToken? = SemanticLookup.FindTokenAt(tree, offset)
        if token == nil || token.Kind != SyntaxKind.IdentifierToken {
            return nil
        }
        let compilation Compilation? = TryGetCompilation(content)
        if compilation == nil {
            return nil
        }
        let symbol = SemanticLookup.ResolveSymbol(compilation, token, ct)
        if !SemanticLookup.CanRename(symbol) {
            return nil
        }
        let references = SemanticLookup.FindReferences(compilation, symbol, ct).ToList()
        if references.Count == 0 {
            return nil
        }
        return LinkedEditingRanges{
            Ranges: references.Select(SemanticLookup.ToRange).ToList(),
            WordPattern: "[a-zA-Z_]\\w*"
        }
    }

    private func HandleProjectFileChange(filePath string, changeType FileChangeType) {
        switch changeType {
            case FileChangeType.Created, FileChangeType.Changed {
                var existing ProjectState? = this.workspaceState.GetProject(filePath)
                let rediscovered DiscoveredProject? = ProjectDiscovery.DiscoverProject(filePath)
                if rediscovered != nil {
                    existing ??= this.workspaceState.AddProject(rediscovered.ProjectFilePath)
                    existing!!.AssemblyName = rediscovered.AssemblyName
                    existing!!.TargetFramework = rediscovered.TargetFramework
                    existing!!.RootNamespace = rediscovered.RootNamespace
                    existing!!.ProjectReferences = rediscovered.ProjectReferences
                    existing!!.ReferenceSourcePath = rediscovered.ReferenceSourcePath
                    existing!!.References = rediscovered.References
                    for source in rediscovered.SourceFiles {
                        if !existing!!.ContainsFile(source) {
                            if this.workspaceState.TryGetOpenBuffer(source, out var text) {
                                existing!!.UpdateFile(source, text!!)
                            } else {
                                existing!!.AddFileFromDisk(source)
                            }
                            this.workspaceState.RegisterFile(source, existing!!)
                        }
                    }
                    for oldFile in existing!!.SourceFiles.ToList() {
                        if !rediscovered.SourceFiles.Contains(oldFile) {
                            existing!!.RemoveFile(oldFile)
                            this.workspaceState.UnregisterFile(oldFile)
                        }
                    }
                }
            }
            case FileChangeType.Deleted {
                this.workspaceState.RemoveProject(filePath)
            }
        }
    }

    private func HandleSourceFileChange(filePath string, changeType FileChangeType) {
        switch changeType {
            case FileChangeType.Created, FileChangeType.Changed {
                let project ProjectState? = this.workspaceState.GetProjectForFile(filePath) ?? this.FindOwningProject(
                    filePath
                )
                if project != nil {
                    if this.workspaceState.TryGetOpenBuffer(filePath, out var text) {
                        project.UpdateFile(filePath, text!!)
                    } else {
                        project.AddFileFromDisk(filePath)
                    }
                    this.workspaceState.RegisterFile(filePath, project)
                }
            }
            case FileChangeType.Deleted {
                let owning ProjectState? = this.workspaceState.GetProjectForFile(filePath)
                if owning != nil {
                    owning.RemoveFile(filePath)
                    this.workspaceState.UnregisterFile(filePath)
                }
            }
        }
    }

    // TODO(ADR-0145 §G): live in-editor regeneration (re-running gsgen as an out-of-proc
    // sidecar on each keystroke) is a separate increment; this slice only surfaces generated
    // members after a build.
    /// Keeps a generator-produced G# source part (ADR-0145 §G) in sync with the owning
    /// project when a build creates, rewrites, or removes it. The SDK writes these under
    /// `$(IntermediateOutputPath)gsgen/*.g.gs`;
    /// (cref:ProjectDiscovery.DiscoverGeneratedSourceFiles) seeds them at project
    /// discovery, and this handler refreshes them afterwards so generated members become
    /// visible in the editor once a build has run. Unlike an open `.gs` document, a
    /// generated part is never edited in the editor, so a (cref:FileChangeType.Changed)
    /// event re-reads the regenerated content from disk (which invalidates the compilation
    /// and refreshes the affected project's source set). The language server never runs the
    /// generator itself.
    private func HandleGeneratedSourceFileChange(filePath string, changeType FileChangeType) {
        switch changeType {
            case FileChangeType.Created, FileChangeType.Changed {
                let project ProjectState? = this.FindOwningProject(filePath)
                if project != nil {
                    // AddFileFromDisk re-reads and re-parses, replacing any prior tree and
                    // invalidating the compilation so regenerated members take effect.
                    project.AddFileFromDisk(filePath)
                    this.workspaceState.RegisterFile(filePath, project)
                }
            }
            case FileChangeType.Deleted {
                let owning ProjectState? = this.workspaceState.GetProjectForFile(filePath)
                if owning != nil {
                    owning.RemoveFile(filePath)
                    this.workspaceState.UnregisterFile(filePath)
                }
            }
        }
    }

    /// Regenerates a `.resx`'s strongly-typed codebehind class
    /// (ADR-0142, issue #2200) whenever the resx is created or saved within a
    /// gsproj's scope, mirroring Visual Studio's "run custom tool on save".
    /// Delegates to the shared (cref:GSharp.Core.Resx.ResxCodeGenerator)
    /// — the same generator `cs2gs` calls during migration — so the two
    /// integrations can never drift. The generated
    /// `{ResxBaseName}.Designer.gs` is written next to the resx and
    /// registered into the owning project like any other source file; a
    /// malformed resx (bad XML) is swallowed so a single bad file never takes
    /// down the watched-files handler for the rest of the batch. Deleting a
    /// `.resx` deliberately leaves its last-generated designer file on
    /// disk (matching Visual Studio, which never deletes
    /// `Resources.Designer.cs` when the `.resx` is removed).
    private func HandleResxFileChange(filePath string, changeType FileChangeType) {
        if changeType == FileChangeType.Deleted {
            return
        }
        let project ProjectState? = this.FindOwningProject(filePath)
        if project == nil {
            return
        }
        try {
            let rootNamespace = project.RootNamespace ?? project.AssemblyName ?? string.Empty
            let generated = ResxCodeGenerator.GenerateFromFile(filePath, project.ProjectDirectory, rootNamespace)
            let designerPath = ResxCodeGenerator.GetDesignerFilePath(filePath)
            File.WriteAllText(designerPath, generated)
            project.AddFileFromDisk(designerPath)
            this.workspaceState.RegisterFile(designerPath, project)
        } catch (ex Exception) {
            LogHandlerException("HandleResxFileChange", ex)
        }
    }

    private func FindOwningProject(filePath string) ProjectState? {
        let fileDir string? = Path.GetDirectoryName(Path.GetFullPath(filePath))
        return this
            .workspaceState
            .Projects
            .Where((project ProjectState) -> fileDir != nil && IsWithinDirectory(fileDir, project.ProjectDirectory))
            .OrderByDescending((project ProjectState) -> project.ProjectDirectory.Length)
            .FirstOrDefault() ??
            this
            .workspaceState
            .GetOrCreateImplicitProject()
    }

    private func TryGet(identifier TextDocumentIdentifier, @NotNullWhen(true) out content DocumentContent?) bool {
        content = nil
        let uri DocumentUri? = identifier?.Uri
        return uri != nil && this.documentContentService.TryGet(uri.ToString(), out content)
    }

    shared {
        // Builds the Test Explorer tree: a top-level grouping node per project, labelled
        // "<project-name> (<tfm>)" (matching the C# Dev Kit presentation), whose children are
        // the class/function items discovered in that project's sources. Loose files that
        // belong to no project are emitted at the top level, ungrouped, preserving prior
        // behavior for single-file scenarios.
        private func GroupDiscoveredTests(sources IReadOnlyList[TestSource], ct CancellationToken)[]TestDiscoveryItem {
            let results = List[TestDiscoveryItem]()
            let grouped = Dictionary[string, (Label string?, ProjectFile string?, Children List[TestDiscoveryItem])](
                StringComparer.OrdinalIgnoreCase
            )
            for source in sources {
                ct.ThrowIfCancellationRequested()
                let items = TestDiscoveryComputer.ComputeTests(source.Uri, source.Tree)
                if items.Count == 0 {
                    continue
                }
                let projectFile = source.ProjectFile
                if projectFile == nil || projectFile.Length == 0 {
                    // Loose / project-less file: keep its items at the top level.
                    results.AddRange(items)
                    continue
                }
                if !grouped.TryGetValue(projectFile, out var bucket) {
                    bucket = (source.ProjectLabel, projectFile, List[TestDiscoveryItem]())
                    grouped[projectFile] = bucket
                }
                bucket.Children.AddRange(items)
            }
            for bucket in grouped.Values.OrderBy(
                (b(Label string, ProjectFile string, Children List[TestDiscoveryItem])) -> b.Label,
                StringComparer.Ordinal
            ) {
                results.Add(
                    TestDiscoveryItem{
                        Id: "project:" + bucket.ProjectFile,
                        Label: bucket.Label!!,
                        Uri: DocumentUri.FromFileSystemPath(bucket.ProjectFile!!)!!.ToString(),
                        Line: 0,
                        Filter: nil,
                        ProjectFile: bucket.ProjectFile!!,
                        Children: bucket.Children.ToArray()
                    }
                )
            }
            return results.ToArray()
        }

        private func ProjectLabel(project ProjectState) string {
            let name = Path.GetFileNameWithoutExtension(project.ProjectFilePath)
            let tfm = project.TargetFramework
            return if string.IsNullOrEmpty(tfm) {
                name
            } else {
                "$name ($tfm)"
            }
        }

        private func PathKeyFor(tree SyntaxTree, fallback string) string {
            let fileName = tree?.Text?.FileName
            let candidate string? = if !string.IsNullOrEmpty(fileName) {
                fileName
            } else {
                fallback
            }
            try {
                return Path.GetFullPath(candidate!!)
            } catch (Exception) {
                return candidate ?? string.Empty
            }
        }

        private func EmptySemanticTokens() SemanticTokens -> SemanticTokens{Data: ImmutableArray[int32].Empty}

        private func ComputeResultId(diagnostics IReadOnlyList[Diagnostic]) string {
            let builder = StringBuilder()
            for d in diagnostics {
                builder.Append(int32(d.Severity)).Append('|')
                if d.Range != nil {
                    builder
                        .Append(d.Range.Start?.Line)
                        .Append(',')
                        .Append(d.Range.Start?.Character)
                        .Append('-')
                        .Append(d.Range.End?.Line)
                        .Append(',')
                        .Append(d.Range.End?.Character)
                }
                builder.Append('|').Append(d.Code?.Value).Append('|').Append(d.Message).Append('\n')
            }
            let bytes = SHA256.HashData(Encoding.UTF8.GetBytes(builder.ToString()))
            return Convert.ToHexString(bytes)
        }

        // A plain StartsWith check would let "/repo/Lib2" match project directory "/repo/Lib".
        // Require the prefix match to land on a path-separator boundary (or be an exact match)
        // so sibling directories that merely share a name prefix are never confused for one
        // another. Comparison is ordinal-ignore-case, matching ProjectDirectory's own case
        // handling, and accepts both '/' and '\' as separators for cross-platform paths.
        private func IsWithinDirectory(candidateDir string, projectDirectory string) bool {
            if string.Equals(candidateDir, projectDirectory, StringComparison.OrdinalIgnoreCase) {
                return true
            }
            if !candidateDir.StartsWith(projectDirectory, StringComparison.OrdinalIgnoreCase) {
                return false
            }
            let boundaryChar = candidateDir[projectDirectory.Length]
            return boundaryChar == Path.DirectorySeparatorChar || boundaryChar == Path.AltDirectorySeparatorChar
        }

        private func TryGetCompilation(content DocumentContent) Compilation? {
            try {
                return content.Project?.GetCompilation() ?? Compilation(content.SyntaxTree)
            } catch {
                return nil
            }
        }
    }
}
