<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">

  <PropertyGroup>
    <!-- MSBuild tasks loaded by both legacy MSBuild and the dotnet build host need
         to target netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Gsharp.NET.Sdk</RootNamespace>
    <AssemblyName>Gsharp.NET.Sdk</AssemblyName>
    <PackageId>Gsharp.NET.Sdk</PackageId>
    <Description>MSBuild Project SDK for the GSharp language. Enables `&lt;Project Sdk="Gsharp.NET.Sdk"&gt;` and .gsproj files to build with `dotnet build`.</Description>
    <PackageTags>gsharp;dotnet;sdk;msbuild;compiler</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DavidObando/gsharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Don't bundle StyleCop into this MSBuild-only project. -->
    <IsPackable>true</IsPackable>

    <!-- This is an MSBuild tool, not a runtime library: the BuildTask DLL belongs
         under tools/task/ (mirroring peachpie's layout), not under lib/. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

    <!-- TFM used to publish the gsc compiler payload into the NuGet. The host
         dotnet must have a runtime for this TFM installed for the SDK to work. -->
    <GsharpCompilerPackageTargetFramework Condition="'$(GsharpCompilerPackageTargetFramework)' == ''">net10.0</GsharpCompilerPackageTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.13.9" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.13.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GSharp.Sdk.Tests" />
    <Compile Include="../../Compiler/WorkerProtocol.gs" Link="WorkerProtocol.gs" />
  </ItemGroup>

  <!-- Issue #4921: the task assembly is netstandard2.0 and ships to .NET Framework
       MSBuild, so it must be compiled by the gsc built from THIS commit, not by the
       bootstrap gsc that global.json pins. A bootstrap gsc older than a codegen fix
       would otherwise put its defect (#4921: TypeRefs scoped at System.Private.CoreLib)
       into the next release's task assembly and only the following release could be
       clean. The pinned SDK's BuildTask still drives the build; only the compiler it
       launches is redirected through GsharpCompilerFullPath, so there is no cycle with
       this project's own BuildTask (the pinned one is used). The ProjectReference below
       orders the in-tree Compiler before this project's CoreCompile; it is build-only.
       The value is set in the project body because the SDK props only default it when
       empty. A controlled graph that disables Directory.Build.props (stage-2
       certification, build/selfhost-stage2.py, which requires every project to use the
       compiler it supplies) keeps the supplied compiler: the repository layout the
       path below assumes does not exist there.
       The pinned CoreCompile does not list the compiler as an input, so
       _GsharpTaskRecompileOnCompilerChange (below) discards the stale task assembly when
       the compiler is newer: a compiler change then recompiles it. -->
  <PropertyGroup Condition=" '$(ImportDirectoryBuildProps)' != 'false' ">
    <GsharpCompilerFullPath>$(MSBuildThisFileDirectory)..\..\..\out\bin\$(Configuration)\Compiler\gsc.dll</GsharpCompilerFullPath>
  </PropertyGroup>

  <ItemGroup Condition=" '$(ImportDirectoryBuildProps)' != 'false' ">
    <ProjectReference Include="../../Compiler/Compiler.gsproj" Private="false" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="_GsharpTaskRecompileOnCompilerChange" BeforeTargets="CoreCompile" Condition=" '$(ImportDirectoryBuildProps)' != 'false' ">
    <PropertyGroup>
      <_GsharpTaskIntermediate>@(IntermediateAssembly->'%(FullPath)')</_GsharpTaskIntermediate>
    </PropertyGroup>
    <Delete Files="$(_GsharpTaskIntermediate)"
            Condition=" Exists('$(_GsharpTaskIntermediate)') And Exists('$(GsharpCompilerFullPath)') And $([System.IO.File]::GetLastWriteTime('$(GsharpCompilerFullPath)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(_GsharpTaskIntermediate)').Ticks) " />
  </Target>

  <ItemGroup>
    <!-- Pack targets invoke these projects. Restore their assets in scoped graphs (#5006). -->
    <ProjectReference Include="../../Formatting/Gsfmt.Cli/Gsfmt.Cli.gsproj" Private="false" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../../tools/gsgen/Gsgen.Cli/Gsgen.Cli.gsproj" Private="false" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../Gsharp.Extensions/Gsharp.Extensions.csproj" Private="false" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../Gsharp.HotReload.Runtime/Gsharp.HotReload.Runtime.gsproj" Private="false" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <!-- ADR-0174 D1: the channel runtime is packed under tools/channels/ and
         auto-referenced by every consumer .gsproj (build/Gsharp.NET.Sdk.props). -->
    <ProjectReference Include="../Gsharp.Runtime.Channels/Gsharp.Runtime.Channels.gsproj" Private="false" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../Gsharp.Runtime.Values/Gsharp.Runtime.Values.gsproj" Private="false" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <!-- ADR-0207: the SDK restores the ReadyToRun compiler of its RID from Gsharp.NET.Sdk.Compiler.<rid>.
         Building the SDK package builds those six packages into the same folder. -->
    <ProjectReference Include="../Gsharp.NET.Sdk.Compiler/Gsharp.NET.Sdk.Compiler.gsproj" Private="false" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package layout mirrors peachpie's SDK NuGet:
           sdk/Sdk.props, sdk/Sdk.targets
           build/Gsharp.NET.Sdk.props, build/Gsharp.NET.Current.Sdk.targets, build/Gsharp.NET.Core.Sdk.targets
           tools/task/Gsharp.NET.Sdk.dll  (this assembly, packed by PackGsharpBuildTask)
           tools/compiler/gsc.dll        (built by src/Compiler, packed by PackGsharpCompiler) -->
    <None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk\Sdk.props" />
    <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk\Sdk.targets" />
    <None Include="build\Gsharp.NET.Sdk.props" Pack="true" PackagePath="build\Gsharp.NET.Sdk.props" />
    <None Include="build\Gsharp.NET.Current.Sdk.targets" Pack="true" PackagePath="build\Gsharp.NET.Current.Sdk.targets" />
    <None Include="build\Gsharp.NET.Core.Sdk.targets" Pack="true" PackagePath="build\Gsharp.NET.Core.Sdk.targets" />
    <None Include="build\Gsharp.NET.SourceLink.targets" Pack="true" PackagePath="build\Gsharp.NET.SourceLink.targets" />
    <None Include="build\Gsharp.File.xaml" Pack="true" PackagePath="build\Gsharp.File.xaml" />
    <None Include="build\Gsharp.CollectedPackageReference.xaml" Pack="true" PackagePath="build\Gsharp.CollectedPackageReference.xaml" />
    <None Include="build\Gsharp.ProjectItemsSchema.xaml" Pack="true" PackagePath="build\Gsharp.ProjectItemsSchema.xaml" />
    <!-- Package metadata files -->
    <None Include="$(MSBuildThisFileDirectory)..\..\..\assets\PACKAGE_README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\assets\gsharp-icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <!-- Pack the BuildTask DLL (this assembly's build output) under tools/task/. -->
  <Target Name="PackGsharpBuildTask" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <ItemGroup>
      <_GsharpTaskFiles Include="$(OutputPath)Gsharp.NET.Sdk.dll" />
    </ItemGroup>
    <Error Condition="!Exists('@(_GsharpTaskFiles)')" Text="Expected Gsharp.NET.Sdk build output not found at @(_GsharpTaskFiles); build this project first." />
    <ItemGroup>
      <None Include="@(_GsharpTaskFiles)" Pack="true" PackagePath="tools\task\" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Publish in the normal reference instance after Build, with a separate
       destination. Incompatible publish settings retain isolated build outputs. -->
  <Target Name="PackGsharpCompiler" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_GsharpCompilerPublishDir>$(IntermediateOutputPath)gsc-publish\</_GsharpCompilerPublishDir>
      <_GsharpCompilerStagingOutDir>$(IntermediateOutputPath)gsc-staging\bin\</_GsharpCompilerStagingOutDir>
    </PropertyGroup>
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="_GsharpGetSdkPublishPayload"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'$(ImportDirectoryBuildProps)' != 'false' and '%(_MSBuildProjectReferenceExistent.Filename)' == 'Compiler' and '%(_MSBuildProjectReferenceExistent.BuildReference)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_GsharpCompilerPayload" />
    </MSBuild>
    <RemoveDir Directories="$(_GsharpCompilerPublishDir)" Condition="'@(_GsharpCompilerPayload)' == '' and Exists('$(_GsharpCompilerPublishDir)')" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../Compiler/Compiler.gsproj" Targets="Publish" Condition="'@(_GsharpCompilerPayload)' == ''" Properties="Configuration=$(Configuration);TargetFramework=$(GsharpCompilerPackageTargetFramework);PublishDir=$(_GsharpCompilerPublishDir);BaseOutputPath=$(_GsharpCompilerStagingOutDir);GsharpObjRoot=$(IntermediateOutputPath)gsc-staging-obj;SelfContained=false;PublishReadyToRun=false;PublishSingleFile=false" />
    <ItemGroup Condition="'@(_GsharpCompilerPayload)' == ''">
      <_GsharpCompilerPayload Include="$(_GsharpCompilerPublishDir)**\*">
        <GsharpSdkPublishRoot>$(_GsharpCompilerPublishDir)</GsharpSdkPublishRoot>
      </_GsharpCompilerPayload>
    </ItemGroup>
    <Error Condition="'@(_GsharpCompilerPayload)' == ''" Text="gsc compiler publish output is empty under '$(_GsharpCompilerPublishDir)'." />
  </Target>

  <Target Name="PackGsharpFormatter" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_GsharpFormatterPublishDir>$(IntermediateOutputPath)gsfmt-publish\</_GsharpFormatterPublishDir>
      <_GsharpFormatterStagingOutDir>$(IntermediateOutputPath)gsfmt-staging\bin\</_GsharpFormatterStagingOutDir>
    </PropertyGroup>
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="_GsharpGetSdkPublishPayload"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'$(ImportDirectoryBuildProps)' != 'false' and '%(_MSBuildProjectReferenceExistent.Filename)' == 'Gsfmt.Cli' and '%(_MSBuildProjectReferenceExistent.BuildReference)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_GsharpFormatterPayload" />
    </MSBuild>
    <RemoveDir Directories="$(_GsharpFormatterPublishDir)" Condition="'@(_GsharpFormatterPayload)' == '' and Exists('$(_GsharpFormatterPublishDir)')" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../Formatting/Gsfmt.Cli/Gsfmt.Cli.gsproj" Targets="Publish" Condition="'@(_GsharpFormatterPayload)' == ''" Properties="Configuration=$(Configuration);TargetFramework=$(GsharpCompilerPackageTargetFramework);PublishDir=$(_GsharpFormatterPublishDir);BaseOutputPath=$(_GsharpFormatterStagingOutDir);GsharpObjRoot=$(IntermediateOutputPath)gsfmt-staging-obj;SelfContained=false;PublishReadyToRun=false;PublishSingleFile=false" />
    <ItemGroup Condition="'@(_GsharpFormatterPayload)' == ''">
      <_GsharpFormatterPayload Include="$(_GsharpFormatterPublishDir)**\*">
        <GsharpSdkPublishRoot>$(_GsharpFormatterPublishDir)</GsharpSdkPublishRoot>
      </_GsharpFormatterPayload>
    </ItemGroup>
    <Error Condition="'@(_GsharpFormatterPayload)' == ''" Text="gsfmt publish output is empty under '$(_GsharpFormatterPublishDir)'." />
  </Target>

  <!-- ADR-0145 §E/§F: publish the gsgen source-generator host (and its full
       closure — GeneratorHost + cs2gs translator + Core) into a staging dir and
       pack everything under tools/gsgen/. Mirrors PackGsharpCompiler. The publish
       closure is large today (it drags in MSBuildWorkspace via the translator);
       a follow-up will trim it via a project split. -->
  <Target Name="PackGsgen" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_GsgenPublishDir>$(IntermediateOutputPath)gsgen-publish\</_GsgenPublishDir>
      <_GsgenStagingOutDir>$(IntermediateOutputPath)gsgen-staging\bin\</_GsgenStagingOutDir>
    </PropertyGroup>
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="_GsharpGetSdkPublishPayload"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'$(ImportDirectoryBuildProps)' != 'false' and '%(_MSBuildProjectReferenceExistent.Filename)' == 'Gsgen.Cli' and '%(_MSBuildProjectReferenceExistent.BuildReference)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_GsgenPayload" />
    </MSBuild>
    <RemoveDir Directories="$(_GsgenPublishDir)" Condition="'@(_GsgenPayload)' == '' and Exists('$(_GsgenPublishDir)')" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../../tools/gsgen/Gsgen.Cli/Gsgen.Cli.gsproj" Targets="Publish" Condition="'@(_GsgenPayload)' == ''" Properties="Configuration=$(Configuration);TargetFramework=$(GsharpCompilerPackageTargetFramework);PublishDir=$(_GsgenPublishDir);BaseOutputPath=$(_GsgenStagingOutDir);GsharpObjRoot=$(IntermediateOutputPath)gsgen-staging-obj;SelfContained=false;PublishReadyToRun=false;PublishSingleFile=false" />
    <ItemGroup Condition="'@(_GsgenPayload)' == ''">
      <_GsgenPayload Include="$(_GsgenPublishDir)**\*">
        <GsharpSdkPublishRoot>$(_GsgenPublishDir)</GsharpSdkPublishRoot>
      </_GsgenPayload>
    </ItemGroup>
    <Error Condition="'@(_GsgenPayload)' == ''" Text="gsgen publish output is empty under '$(_GsgenPublishDir)'." />
  </Target>

  <!-- MSBuild target outputs do not preserve reserved RecursiveDir metadata.
       Derive relative directories from explicit roots for both publication paths.
       NuGet appends filenames, including extensionless apphosts, to these directories. -->
  <Target Name="_GsharpPackPublishedSdkPayloads" BeforeTargets="_GetPackageFiles"
          DependsOnTargets="PackGsharpCompiler;PackGsharpFormatter;PackGsgen">
    <ItemGroup>
      <_GsharpSdkPackagePayload Include="@(_GsharpCompilerPayload)">
        <GsharpSdkPackagePrefix>tools/compiler/</GsharpSdkPackagePrefix>
      </_GsharpSdkPackagePayload>
      <_GsharpSdkPackagePayload Include="@(_GsharpFormatterPayload)">
        <GsharpSdkPackagePrefix>tools/formatter/</GsharpSdkPackagePrefix>
      </_GsharpSdkPackagePayload>
      <_GsharpSdkPackagePayload Include="@(_GsgenPayload)">
        <GsharpSdkPackagePrefix>tools/gsgen/</GsharpSdkPackagePrefix>
      </_GsharpSdkPackagePayload>
    </ItemGroup>
    <Error Condition="'%(_GsharpSdkPackagePayload.GsharpSdkPublishRoot)' == ''"
           Text="SDK payload '%(_GsharpSdkPackagePayload.Identity)' has no publication root." />
    <ItemGroup>
      <_GsharpSdkPackagePayload Update="@(_GsharpSdkPackagePayload)">
        <GsharpSdkRelativePath>$([MSBuild]::MakeRelative('%(GsharpSdkPublishRoot)', '%(FullPath)'))</GsharpSdkRelativePath>
      </_GsharpSdkPackagePayload>
      <_GsharpSdkPackagePayload Update="@(_GsharpSdkPackagePayload)">
        <GsharpSdkRelativeDirectory>$([System.IO.Path]::GetDirectoryName('%(GsharpSdkRelativePath)'))</GsharpSdkRelativeDirectory>
        <GsharpSdkPackSource>%(FullPath)</GsharpSdkPackSource>
        <!-- ADR-0210: all tool copies use the SDK-owned ABI, not the bootstrap runtime. -->
        <GsharpSdkPackSource Condition="'%(Filename)' == 'Gsharp.Runtime.Values'">$(BaseOutputPath)Gsharp.Runtime.Values/%(Filename)%(Extension)</GsharpSdkPackSource>
      </_GsharpSdkPackagePayload>
    </ItemGroup>
    <Error Condition="!Exists('%(_GsharpSdkPackagePayload.GsharpSdkPackSource)')"
           Text="SDK payload source '%(_GsharpSdkPackagePayload.GsharpSdkPackSource)' is missing." />
    <ItemGroup>
      <None Include="%(_GsharpSdkPackagePayload.GsharpSdkPackSource)" Pack="true" Visible="false">
        <PackagePath>%(_GsharpSdkPackagePayload.GsharpSdkPackagePrefix)%(_GsharpSdkPackagePayload.GsharpSdkRelativeDirectory)/</PackagePath>
      </None>
    </ItemGroup>
  </Target>

  <!-- Pack the runtime-side hot-reload agent/delta builder. The build-only
       ProjectReference above orders this output before SDK packing. -->
  <Target Name="PackGsharpHotReloadRuntime" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <PropertyGroup>
      <_GsharpHotReloadRuntimeOutputDir>$(BaseOutputPath)\Gsharp.HotReload.Runtime\</_GsharpHotReloadRuntimeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_GsharpHotReloadRuntimePayload Include="$(_GsharpHotReloadRuntimeOutputDir)Gsharp.HotReload.Runtime.dll" />
      <_GsharpHotReloadRuntimePayload Include="$(_GsharpHotReloadRuntimeOutputDir)Gsharp.HotReload.Runtime.pdb" Condition="Exists('$(_GsharpHotReloadRuntimeOutputDir)Gsharp.HotReload.Runtime.pdb')" />
    </ItemGroup>
    <Error Condition="!Exists('$(_GsharpHotReloadRuntimeOutputDir)Gsharp.HotReload.Runtime.dll')" Text="Expected Gsharp.HotReload.Runtime output not found under '$(_GsharpHotReloadRuntimeOutputDir)'." />
    <ItemGroup>
      <None Include="@(_GsharpHotReloadRuntimePayload)" Pack="true" PackagePath="tools\hotreload\" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- ADR-0174 D1: pack the G#-owned channel runtime (Gsharp.Concurrency.Chan<T>
       and friends) under tools/channels/. Unlike the hot-reload runtime it is
       auto-referenced by every consumer project, because emitted programs
       reference it whenever they construct a channel; it is only *loaded*
       by programs that do, so the zero-cost property ADR-0082's gate
       protected is preserved by linking rather than by binding. -->
  <Target Name="PackGsharpChannelsRuntime" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <PropertyGroup>
      <_GsharpChannelsRuntimeOutputDir>$(BaseOutputPath)\Gsharp.Runtime.Channels\</_GsharpChannelsRuntimeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_GsharpChannelsRuntimePayload Include="$(_GsharpChannelsRuntimeOutputDir)Gsharp.Runtime.Channels.dll" />
      <_GsharpChannelsRuntimePayload Include="$(_GsharpChannelsRuntimeOutputDir)Gsharp.Runtime.Channels.pdb" Condition="Exists('$(_GsharpChannelsRuntimeOutputDir)Gsharp.Runtime.Channels.pdb')" />
      <_GsharpChannelsRuntimePayload Include="$(_GsharpChannelsRuntimeOutputDir)Gsharp.Runtime.Channels.xml" Condition="Exists('$(_GsharpChannelsRuntimeOutputDir)Gsharp.Runtime.Channels.xml')" />
    </ItemGroup>
    <Error Condition="!Exists('$(_GsharpChannelsRuntimeOutputDir)Gsharp.Runtime.Channels.dll')" Text="Expected Gsharp.Runtime.Channels output not found under '$(_GsharpChannelsRuntimeOutputDir)'." />
    <ItemGroup>
      <None Include="@(_GsharpChannelsRuntimePayload)" Pack="true" PackagePath="tools\channels\" Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="PackGsharpValuesRuntime" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <PropertyGroup>
      <_GsharpValuesRuntimeOutputDir>$(BaseOutputPath)\Gsharp.Runtime.Values\</_GsharpValuesRuntimeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_GsharpValuesRuntimePayload Include="$(_GsharpValuesRuntimeOutputDir)Gsharp.Runtime.Values.dll" />
      <_GsharpValuesRuntimePayload Include="$(_GsharpValuesRuntimeOutputDir)Gsharp.Runtime.Values.pdb" Condition="Exists('$(_GsharpValuesRuntimeOutputDir)Gsharp.Runtime.Values.pdb')" />
      <_GsharpValuesRuntimePayload Include="$(_GsharpValuesRuntimeOutputDir)Gsharp.Runtime.Values.xml" Condition="Exists('$(_GsharpValuesRuntimeOutputDir)Gsharp.Runtime.Values.xml')" />
    </ItemGroup>
    <Error Condition="!Exists('$(_GsharpValuesRuntimeOutputDir)Gsharp.Runtime.Values.dll')" Text="Expected Gsharp.Runtime.Values output not found under '$(_GsharpValuesRuntimeOutputDir)'." />
    <ItemGroup>
      <None Include="@(_GsharpValuesRuntimePayload)" Pack="true" PackagePath="tools\values\" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Pack the Gsharp.Extensions assembly under tools/extensions/ (ADR-0082 /
       issue #722). This is a *real* G# / .NET assembly bundled with the SDK
       NuGet; its presence in tools/extensions/ — combined with the
       auto-reference wired up in build/Gsharp.NET.Sdk.props — lets consumers
       write `import Gsharp.Extensions.Go` (and later `.Optional`, `.Sequences`)
       without ever adding a <PackageReference> for it. Mirrors the layout of
       tools/task/ (BuildTask) and tools/compiler/ (gsc). -->
  <Target Name="PackGsharpExtensions" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <PropertyGroup>
      <_GsharpCompilerProject>$(MSBuildThisFileDirectory)../../Compiler/Compiler.gsproj</_GsharpCompilerProject>
      <_GsharpExtensionsProject>$(MSBuildThisFileDirectory)..\Gsharp.Extensions\Gsharp.Extensions.csproj</_GsharpExtensionsProject>
      <_GsharpExtensionsOutDir>$(IntermediateOutputPath)gsharp-extensions\</_GsharpExtensionsOutDir>
    </PropertyGroup>
    <!-- Gsharp.Extensions is built with the bootstrap SDK, which requires
         gsc.dll at out/bin/$(Configuration)/Compiler/gsc.dll. When this
         SDK is packed directly (e.g. e2e tests running
         `dotnet build src/Sdk/Gsharp.NET.Sdk/Gsharp.NET.Sdk.csproj`),
         MSBuild's own ProjectReference walker doesn't traverse the
         Compiler arrow from inside Extensions.csproj because the nested
         MSBuild call below disables project-references. Build Compiler
         explicitly here so its output exists before the bootstrap fires. -->
    <MSBuild Projects="$(_GsharpCompilerProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <RemoveDir Directories="$(_GsharpExtensionsOutDir)" Condition="Exists('$(_GsharpExtensionsOutDir)')" />
    <MSBuild Projects="$(_GsharpExtensionsProject)" Targets="Build" Properties="Configuration=$(Configuration);OutputPath=$(_GsharpExtensionsOutDir);BuildProjectReferences=false" />
    <ItemGroup>
      <_GsharpExtensionsPayload Include="$(_GsharpExtensionsOutDir)Gsharp.Extensions.dll" />
      <_GsharpExtensionsPayload Include="$(_GsharpExtensionsOutDir)Gsharp.Extensions.xml" Condition="Exists('$(_GsharpExtensionsOutDir)Gsharp.Extensions.xml')" />
      <_GsharpExtensionsPayload Include="$(_GsharpExtensionsOutDir)Gsharp.Extensions.pdb" Condition="Exists('$(_GsharpExtensionsOutDir)Gsharp.Extensions.pdb')" />
    </ItemGroup>
    <Error Condition="'@(_GsharpExtensionsPayload)' == ''" Text="Expected Gsharp.Extensions build output not found under '$(_GsharpExtensionsOutDir)'." />
    <ItemGroup>
      <None Include="@(_GsharpExtensionsPayload)" Pack="true" PackagePath="tools\extensions\" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
