package Gsharp.NET.Sdk.Tools

import Microsoft.Build.Framework
import Microsoft.Build.Utilities
import System
import System.Collections
import System.Collections.Generic
import System.Globalization
import System.IO
import System.Linq
import System.Text

/// Issue #2814 / ADR-0143 §D: renders the .NET SDK's `@(AssemblyAttribute)`
/// item group as a G# source file of file-level `@assembly:` annotations.
/// @remarks The SDK's own `CoreGenerateAssemblyInfo` target is gated on
/// `Condition="'$(Language)'=='VB' or '$(Language)'=='C#'"`, so a project
/// that sets `<Language>Gsharp</Language>` never runs it and the
/// resulting assembly silently loses `AssemblyTitle`,
/// `AssemblyProduct`, `AssemblyCompany`, `AssemblyConfiguration`
/// and peers. Its `WriteCodeFragment` task cannot simply be re-invoked
/// here: that task is CodeDom-based and only knows C# and VB.
///
/// This task reproduces the same contract natively. It honors the same item
/// metadata conventions `WriteCodeFragment` defines — positional
/// `_Parameter1`…`_ParameterN` constructor arguments, any other
/// metadata as a named argument, and a `<name>_IsLiteral` sibling that
/// emits the value as raw code instead of a string literal — so a project that
/// already hand-authors `<AssemblyAttribute>` items for a C# build
/// keeps working unchanged after migration.
open class WriteGsharpAssemblyInfoTask : Task {
    /// Gets or sets the `@(AssemblyAttribute)` items to render. Each item's
    /// identity is the attribute type name; its metadata supplies the arguments.
    private var _assemblyAttributes[]ITaskItem = Array.Empty[ITaskItem]()!!

    @Required
    prop AssemblyAttributes[]ITaskItem {
        get {
            return _assemblyAttributes
        }
        set {
            _assemblyAttributes = value
        }
    }

    /// Gets or sets the `.gs` file to write. The file is only touched when
    /// its content changes so MSBuild incrementality (and gsc's own
    /// `Inputs`/`Outputs` check) does not see a spurious edit.
    @Required
    prop OutputFile string?

    /// ```xmldoc
    /// <inheritdoc />
    /// ```
    open override func Execute() bool {
        if string.IsNullOrEmpty(this.OutputFile) {
            this.Log.LogError("WriteGsharpAssemblyInfo: OutputFile is required.")
            return false
        }
        var content string
        try {
            content = Render(this.AssemblyAttributes)
        } catch (ex ArgumentException) {
            this.Log.LogError("WriteGsharpAssemblyInfo: " + ex.Message)
            return false
        }
        // Issue #4932: GetDirectoryName returns null when OutputFile is a root
        // path; there is then no directory to create, as in the C# task.
        let directory = Path.GetDirectoryName(Path.GetFullPath(this.OutputFile))
        if !string.IsNullOrEmpty(directory) {
            Directory.CreateDirectory(directory)
        }
        if !File.Exists(this.OutputFile) || !string.Equals(
            File.ReadAllText(this.OutputFile),
            content,
            StringComparison.Ordinal
        ) {
            File.WriteAllText(this.OutputFile, content)
        }
        this.Log.LogMessage(
            MessageImportance.Low,
            "WriteGsharpAssemblyInfo: wrote {0} assembly attribute(s) to {1}.",
            this.AssemblyAttributes?.Length ?? 0,
            this.OutputFile
        )
        return !this.Log.HasLoggedErrors
    }

    shared {
        private const ParameterPrefix string = "_Parameter"
        private const LiteralSuffix string = "_IsLiteral"

        /// Renders [`attributes`](paramref) as a G# compilation unit of
        /// file-level `@assembly:` annotations. Exposed for testing.
        /// @param attributes The assembly attribute items to render.
        /// @returns The complete G# source text.
        func Render(attributes IEnumerable[ITaskItem]) string {
            let sb = StringBuilder()
            sb.AppendLine("// <auto-generated>")
            sb.AppendLine("//     Generated by the Gsharp.NET.Sdk WriteGsharpAssemblyInfo task.")
            sb.AppendLine("//     Changes to this file will be lost when it is regenerated.")
            sb.AppendLine("// </auto-generated>")
            sb.AppendLine()
            for attribute in(attributes ?? Enumerable.Empty[ITaskItem]()) {
                if attribute == nil || string.IsNullOrWhiteSpace(attribute.ItemSpec) {
                    continue
                }
                sb.AppendLine("@assembly: " + RenderOne(attribute))
            }
            return sb.ToString()
        }

        /// Escapes [`value`](paramref) as a G# interpreted string literal,
        /// including the literal-`$` escape (`$$`) that G# interpolation
        /// requires but C# does not.
        /// @param value The raw string value.
        /// @returns The quoted, escaped G# literal.
        func QuoteGsharpString(value string) string {
            let sb = StringBuilder(value.Length + 2)
            sb.Append('"')
            for c in value {
                switch c {
                    case '\\' {
                        sb.Append("\\\\")
                    }
                    case '"' {
                        sb.Append("\\\"")
                    }
                    case '$' {
                        sb.Append("$$$$")
                    }
                    case '\u0000' {
                        sb.Append("\\0")
                    }
                    case '\u0007' {
                        sb.Append("\\a")
                    }
                    case '\u0008' {
                        sb.Append("\\b")
                    }
                    case '\u000C' {
                        sb.Append("\\f")
                    }
                    case '\n' {
                        sb.Append("\\n")
                    }
                    case '\r' {
                        sb.Append("\\r")
                    }
                    case '\t' {
                        sb.Append("\\t")
                    }
                    case '\u000B' {
                        sb.Append("\\v")
                    }
                    default {
                        if char.IsControl(c) {
                            sb.Append("\\u").Append((int32(c)).ToString("x4", CultureInfo.InvariantCulture))
                        } else {
                            sb.Append(c)
                        }
                    }
                }
            }
            sb.Append('"')
            return sb.ToString()
        }

        private func RenderOne(attribute ITaskItem) string {
            let positional = SortedDictionary[int32, string]()
            let named = SortedDictionary[string, string](StringComparer.Ordinal)
            let metadata = Dictionary[string, string](StringComparer.OrdinalIgnoreCase)
            for entry DictionaryEntry in attribute.CloneCustomMetadata() {
                metadata[cast[string](entry.Key)] = (entry.Value as string ?? string.Empty)
            }
            for entry in metadata {
                // '<name>_IsLiteral' is a modifier on '<name>', never an argument.
                if entry.Key.EndsWith(LiteralSuffix, StringComparison.OrdinalIgnoreCase) {
                    continue
                }
                let isLiteral = metadata.TryGetValue(entry.Key + LiteralSuffix, out var literalFlag) && string.Equals(
                    literalFlag,
                    "true",
                    StringComparison.OrdinalIgnoreCase
                )
                let rendered = if isLiteral {
                    entry.Value
                } else {
                    QuoteGsharpString(entry.Value)
                }
                if entry.Key.StartsWith(ParameterPrefix, StringComparison.OrdinalIgnoreCase) && int32.TryParse(
                    entry.Key.Substring(ParameterPrefix.Length),
                    NumberStyles.None,
                    CultureInfo.InvariantCulture,
                    out var index
                ) {
                    positional[index] = rendered
                } else {
                    named[entry.Key] = rendered
                }
            }
            // WriteCodeFragment treats a gap in the positional sequence as an error;
            // matching it here keeps a malformed item from silently shifting args.
            var expected = 1
            for index in positional.Keys!! {
                if index != expected++ {
                    throw ArgumentException(
                        "Assembly attribute '" +
                            attribute.ItemSpec +
                            "' skips constructor argument " +
                            expected.ToString(CultureInfo.InvariantCulture) +
                            "; positional '_ParameterN' metadata must be contiguous from 1."
                    )
                }
            }
            let arguments = positional.Values!!.Concat(
                named.Select((pair KeyValuePair[string, string]) -> pair.Key + ": " + pair.Value)
            )!!
            // A parameterless attribute is written bare, matching how G# source
            // spells '@assembly: DisableRuntimeMarshalling'.
            let argumentList = string.Join(", ", arguments.ToArray())!!
            return (
                if argumentList.Length == 0 {
                    attribute.ItemSpec
                } else {
                    attribute.ItemSpec + "(" + argumentList + ")"
                }
            )!!
        }
    }
}
