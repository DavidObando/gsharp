package GSharp.Core.Resx

import System
import System.Collections.Generic
import System.Text

/// Generates the G# equivalent of a resx codebehind file — the class a C#
/// project gets from `ResXFileCodeGenerator` / `PublicResXFileCodeGenerator`
/// (ADR-0142, issue #2200). The generated class exposes the same shape as the
/// CodeDom-produced C# class: a lazily-created `ResourceManager`, a
/// settable `Culture`, a private parameterless constructor, and one
/// static property per resx entry — a plain `string` property reading
/// through `GetString` for the dominant string-resource case, or a
/// typed property reading through `GetObject` (downcast with `as`)
/// for anything else. This is the single generator shared by the G# language
/// server (regenerates on `.resx` save) and by `cs2gs` (produces the
/// codebehind for a migrated project's `.resx` files instead of
/// translating the C# `Designer.cs`).
shared class ResxDesignerGenerator {
    /// Generates the full G# source text for a resx's strongly-typed
    /// resource class.
    /// @param document The parsed resx document.
    /// @param options The namespace/class-name/visibility inputs.
    /// @returns The generated G# source (a complete, self-contained compilation unit).
    func Generate(document ResxDocument, options ResxDesignerOptions) string {
        let sb = StringBuilder()
        sb.AppendLine("// <auto-generated>")
        sb.AppendLine("//     This code was generated by the GSharp resx code generator, from the")
        sb.AppendLine("//     matching .resx file. Changes to this file may cause incorrect behavior")
        sb.AppendLine("//     and will be lost if the code is regenerated.")
        sb.AppendLine("// </auto-generated>")
        sb.AppendLine()
        if !string.IsNullOrEmpty(options.Namespace) {
            sb.Append("package ").AppendLine(options.Namespace)
            sb.AppendLine()
        }
        sb.AppendLine("/// A strongly-typed resource class, for looking up localized strings, etc.")
        let classAccessibility = if options.IsPublic {
            "public"
        } else {
            "internal"
        }
        sb.Append(classAccessibility).Append(" class ").AppendLine(options.ClassName + " {")
        // Matches the real tool's `internal Resources() { }`: the class only
        // ever surfaces static members, so the constructor stays `internal`
        // regardless of the class's own accessibility, discouraging direct
        // instantiation without preventing static member access.
        sb.Append("    internal init() { }").AppendLine()
        sb.AppendLine()
        sb.AppendLine("    shared {")
        sb.AppendLine("        var resourceMan System.Resources.ResourceManager?")
        sb.AppendLine("        var resourceCulture System.Globalization.CultureInfo?")
        sb.AppendLine()
        sb.AppendLine("        /// Returns the cached ResourceManager instance used by this class.")
        sb.AppendLine("        prop ResourceManager System.Resources.ResourceManager {")
        sb.AppendLine("            get {")
        sb.AppendLine("                if resourceMan == nil {")
        sb
            .Append("                    var temp = System.Resources.ResourceManager(\"")
            .Append(options.ResourceManifestName)
            .Append("\", typeof(")
            .Append(options.ClassName)
            .AppendLine(").Assembly)")
        sb.AppendLine("                    resourceMan = temp")
        sb.AppendLine("                }")
        sb.AppendLine()
        sb.AppendLine("                return resourceMan!!")
        sb.AppendLine("            }")
        sb.AppendLine("        }")
        sb.AppendLine()
        sb.AppendLine("        /// Overrides the current thread's CurrentUICulture property for all")
        sb.AppendLine("        /// resource lookups using this strongly typed resource class.")
        sb.AppendLine("        prop Culture System.Globalization.CultureInfo? {")
        sb.AppendLine("            get { return resourceCulture }")
        sb.AppendLine("            set { resourceCulture = value }")
        sb.AppendLine("        }")
        let usedNames = HashSet[string](StringComparer.Ordinal){"ResourceManager", "Culture"}
        for entry in document.Entries {
            sb.AppendLine()
            AppendEntry(sb, entry, usedNames)
        }
        sb.AppendLine("    }")
        sb.AppendLine("}")
        return sb.ToString()
    }

    private func AppendEntry(sb StringBuilder, entry ResxEntry, usedNames HashSet[string]) {
        let identifier = ResxIdentifier.ToPropertyIdentifier(entry.Name, usedNames)
        sb.Append("        /// ").AppendLine(SummaryFor(entry))
        if entry.IsString {
            sb
                .Append("        prop ")
                .Append(identifier)
                .Append(" string -> ResourceManager.GetString(\"")
                .Append(entry.Name)
                .AppendLine("\", resourceCulture)!!")
            return
        }
        let gsType = ResxTypeNameMapper.Map(entry.TypeName)
        sb.Append("        prop ").Append(identifier).Append(' ').Append(gsType).AppendLine(" {")
        sb.AppendLine("            get {")
        sb
            .Append("                return cast[")
            .Append(gsType)
            .Append("](ResourceManager.GetObject(\"")
            .Append(entry.Name)
            .AppendLine("\", resourceCulture))")
        sb.AppendLine("            }")
        sb.AppendLine("        }")
    }

    private func SummaryFor(entry ResxEntry) string {
        if !entry.IsString {
            return "Looks up a localized resource of type " + entry.TypeName + "."
        }
        let value = entry.Value ?? string.Empty
        let newline = value.IndexOfAny([]char{'\r', '\n'})
        var truncated = newline >= 0
        var firstLine = if truncated {
            value.Substring(0, newline)
        } else {
            value
        }
        const maxLength = 80
        if firstLine.Length > maxLength {
            firstLine = firstLine.Substring(0, maxLength)
            truncated = true
        }
        return "Looks up a localized string similar to " +
            firstLine +
            (
            if truncated {
                " [...]."
            } else {
                "."
            }
        )
    }
}
