<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetCoreAppTargetFramework)</TargetFramework>
    <RootNamespace>GSharp.Gsfmt</RootNamespace>
    <AssemblyName>gsfmt</AssemblyName>
    <Nullable>enable</Nullable>
      <!-- Disable tiered PGO instrumentation in the published payload (#5120). Tiered compilation stays on. -->
    <TieredPGO>false</TieredPGO>
    <!-- ReadyToRun images in the SDK package (#5126). The fixed RID keeps lock files independent of the host.
         Only restore sees these two properties. It then downloads the crossgen2 pack and writes the RID target.
         A RuntimeIdentifiers value at build time changes dotnet tool packing (gsfmt) and output paths.
         The SDK package staging publish passes RuntimeIdentifier and PublishReadyToRun itself.
         Other hosts keep the portable IL payload until per-platform images exist. -->
    <RuntimeIdentifiers Condition="'$(MSBuildRestoreSessionId)' != ''">linux-x64</RuntimeIdentifiers>
    <PublishReadyToRun Condition="'$(MSBuildRestoreSessionId)' != '' and '$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">true</PublishReadyToRun>
    <GsharpPublishReadyToRunPayload Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">true</GsharpPublishReadyToRunPayload>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gsfmt</ToolCommandName>
    <PackageId>Gsharp.Gsfmt</PackageId>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>GSharp canonical formatter</Title>
    <Description>Canonical formatter for G# source files.</Description>
    <PackageTags>gsharp;formatter;gsfmt;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DavidObando/gsharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\..\assets\PACKAGE_README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\assets\gsharp-icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GSharp.Formatting/GSharp.Formatting.gsproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GSharp.Formatting.Tests" />
  </ItemGroup>

  <Import Project="../../../build/sdk-publish.targets" Condition="'$(ImportDirectoryBuildProps)' != 'false'" />

</Project>
