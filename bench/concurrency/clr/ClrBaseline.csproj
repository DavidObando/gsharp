<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tooling project (see ../../Directory.Build.props), so nullable
         warnings are off; `annotations` keeps the `T?` spellings in the
         source legal and meaningful as documentation. -->
    <Nullable>annotations</Nullable>
    <AssemblyName>ClrBaseline</AssemblyName>
    <RootNamespace>Gsharp.Bench.Concurrency</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!--
      Benchmark harness, not product code: it is deliberately written in a
      dense single-statement-per-line style so each measured sequence reads as
      one unit, and it reproduces the emitter's exact call sequences rather
      than idiomatic C#. Style analysis is off here for that reason. This
      project is intentionally not in GSharp.sln and not in the PR gate; see
      README.md and ADR-0174 D11 Phase 5.
    -->
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR-0174 Phase 1: measure the real G# channel runtime alongside the
         BCL reproductions (rendezvous ping-pong, closed receive). -->
    <ProjectReference Include="..\..\..\src\Sdk\Gsharp.Runtime.Channels\Gsharp.Runtime.Channels.csproj" />
  </ItemGroup>

</Project>
