<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">

  <!-- ADR-0174 Phase 1: pure C# tests of Gsharp.Runtime.Channels — real
       threads, no compiler dependency, so the stress suite stays fast and
       isolated. Auto-sharded by build/generate-ci-test-matrix.py. -->
  <PropertyGroup>
    <TargetFramework>$(NetCoreAppTargetFramework)</TargetFramework>
    <RootNamespace>GSharp.Runtime.Channels.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>annotations</Nullable>
    <!-- Issue #4903: test against the IN-TREE runtime build only. The SDK props otherwise
         add the pinned SDK package's copy of the same assembly as an explicit reference, and
         when both carry the same assembly version the SDK's (older, C#-built) copy silently
         wins in the output directory, masking the in-tree build under test. -->
    <GsharpNoChannelsRuntime>true</GsharpNoChannelsRuntime>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sdk/Gsharp.Runtime.Channels/Gsharp.Runtime.Channels.gsproj" />
  </ItemGroup>

</Project>
