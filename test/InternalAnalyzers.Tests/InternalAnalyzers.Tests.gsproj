<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppTargetFramework)</TargetFramework>
    <RootNamespace>GSharp.InternalAnalyzers.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Analyzers/InternalAnalyzers/InternalAnalyzers.gsproj" />
    
    
  </ItemGroup>

<ItemGroup><Reference Include="GSharp.Core"><HintPath>$([System.IO.Path]::GetDirectoryName('$(GsharpCompilerFullPath)'))/GSharp.Core.dll</HintPath><Private>true</Private></Reference></ItemGroup><ItemGroup><PackageReference Include="GSharp.CodeAnalysis.Analyzers.Testing" Version="0.5.199" /></ItemGroup></Project>
