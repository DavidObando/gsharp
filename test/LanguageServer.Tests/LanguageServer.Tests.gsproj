<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppTargetFramework)</TargetFramework>
    <RootNamespace>GSharp.LanguageServer.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="@(GsharpLanguageServer-&gt;'%(RootDir)%(Directory)%(Filename).gsproj')" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <Compile Include="..\Shared\EmittedFixture.gs" Link="EmittedFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RepositoryRootMarker.gs" Link="RepositoryRootMarker.cs" />
  </ItemGroup>

</Project>
