<?xml version="1.0" encoding="utf-8"?><Project Sdk="Gsharp.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppTargetFramework)</TargetFramework>
    <RootNamespace>GSharp.Sdk.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sdk/Gsharp.NET.Sdk/Gsharp.NET.Sdk.gsproj" />
    <!-- ADR-0174 P3-9: the hot-reload suspension-flip test compiles channel code, which binds against the channel runtime beside the test host. -->
    <ProjectReference Include="../../src/Sdk/Gsharp.Runtime.Channels/Gsharp.Runtime.Channels.gsproj" />
    <ProjectReference Include="../../src/Sdk/Gsharp.HotReload.Runtime/Gsharp.HotReload.Runtime.gsproj" />
    <ProjectReference Include="@(GsharpCompiler-&gt;'%(RootDir)%(Directory)%(Filename).gsproj')" />
  </ItemGroup>

  <ItemGroup>
    <!-- BuildTask derives from Microsoft.Build.Utilities.Task, so the test
         project needs the matching assemblies on its reference closure to
         resolve the base type. The SDK project marks them PrivateAssets="all"
         to keep them out of its NuGet, so they don't flow transitively. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.13.9" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.13.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RepositoryRootMarker.gs" Link="RepositoryRootMarker.cs" />
  </ItemGroup>

</Project>
