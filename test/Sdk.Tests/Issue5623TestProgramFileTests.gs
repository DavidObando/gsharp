package GSharp.Sdk.Tests

import System
import System.Diagnostics
import System.IO
import System.Linq
import System.Reflection.PortableExecutable
import System.Runtime.InteropServices
import System.Threading
import System.Threading.Tasks
import System.Xml.Linq
import Gsharp.NET.Sdk.Tools
import Xunit

/// Issue #5623: gsc reports GS0634 for an executable without an entry point.
/// Microsoft.NET.Test.Sdk makes a test project an executable, but it generates its entry point only for C#, Visual Basic and F#.
/// The G# SDK targets generate the same empty entry point, and gsc compiles it with the real CoreCompile target.
class Issue5623TestProgramFileTests : IDisposable {
    private let directory string = Path.Combine(
        RepoRoot.Path,
        "out",
        "test",
        "Issue5623TestProgramFileTests",
        Guid.NewGuid().ToString("N")
    )

    init() {
        Directory.CreateDirectory(directory)
        File.WriteAllText(
            Path.Combine(directory, "Tests.gs"),
            "package ProbeTests\n\nclass WidgetTests {\n    func Adds() { }\n}\n"
        )
    }

    func Dispose() -> Directory.Delete(directory, recursive: true)

    @Theory
    @InlineData("true", "Exe", true)
    @InlineData("true", "Library", false)
    func TestProject_WithGeneratedProgram_Builds(isTestProject string, outputType string, entryPoint bool) {
        let (exit, output) = Build(isTestProject, "true", outputType)
        Assert.True(exit == 0, output)
        Assert.DoesNotContain("GS0634", output, StringComparison.Ordinal)
        using let stream = File.OpenRead(Path.Combine(directory, "obj", "Probe.dll"))
        using let reader = PEReader(stream)
        Assert.Equal(entryPoint, reader.PEHeaders.CorHeader!!.EntryPointTokenOrRelativeVirtualAddress != 0)
        Assert.Equal(entryPoint, File.Exists(Path.Combine(directory, "obj", "Probe.AutoGeneratedProgram.gs")))
    }

    @Theory
    @InlineData("Exe", true)
    @InlineData("WinExe", true)
    @InlineData("Library", false)
    func OutputType_PreservesEntryPoint(outputType string, entryPoint bool) {
        File.WriteAllText(
            Path.Combine(directory, "Tests.gs"),
            "package ProbeTests\n\nfunc Main() { System.Console.WriteLine(\"sdk-entry-point\") }\n"
        )
        let (exit, output) = Build("false", "false", outputType)
        Assert.True(exit == 0, output)
        using let stream = File.OpenRead(Path.Combine(directory, "obj", "Probe.dll"))
        using let reader = PEReader(stream)
        Assert.Equal(entryPoint, reader.PEHeaders.CorHeader!!.EntryPointTokenOrRelativeVirtualAddress != 0)
    }

    @Theory
    @InlineData("true", "false")
    @InlineData("false", "true")
    func Executable_WithoutGeneratedProgram_ReportsGs0634(isTestProject string, generateProgramFile string) {
        let (exit, output) = Build(isTestProject, generateProgramFile, "Exe")
        Assert.True(exit != 0, output)
        Assert.Matches("Tests\\.gs\\(1,1[,)].*error GS0634: The program has no entry point\\.", output)
        Assert.False(File.Exists(Path.Combine(directory, "obj", "Probe.AutoGeneratedProgram.gs")))
    }

    // Issue #5623 review: the switches are inputs of CoreCompile, so a rebuild without the generated program does not keep
    // the previous executable.
    @Fact
    func Rebuild_WithoutGeneratedProgram_ReportsGs0634() {
        let (firstExit, firstOutput) = Build("true", "true", "Exe")
        Assert.True(firstExit == 0, firstOutput)
        let (exit, output) = Build("true", "false", "Exe")
        Assert.True(exit != 0, output)
        Assert.Contains("error GS0634: The program has no entry point.", output, StringComparison.Ordinal)
    }

    // The switches are global properties, so a rebuild does not rewrite the project file.
    private func Build(isTestProject string, generateProgramFile string, outputType string)(Exit int32, Output string) {
        let configuration = DirectoryInfo(AppContext.BaseDirectory).Parent?.Name ?? "Release"
        let compiler = Path.Combine(RepoRoot.Path, "out", "bin", configuration, "Compiler", "gsc.dll")
        Assert.True(File.Exists(compiler), compiler)
        let runtime = RuntimeEnvironment.GetRuntimeDirectory()
        let packRoot = Path.GetFullPath(Path.Combine(runtime, "..", "..", "..", "packs", "Microsoft.NETCore.App.Ref"))
        let pack = Directory
            .GetDirectories(packRoot)
            .OrderByDescending((path string) -> path, StringComparer.Ordinal)
            .FirstOrDefault((path string) -> Directory.Exists(Path.Combine(path, "ref", "net10.0"))) ??
            throw InvalidOperationException("The net10.0 targeting pack was not found.")
        let document = XDocument.Parse(Project)
        let root = document.Root ?? throw InvalidOperationException("The test project has no root.")
        let properties = root.Elements("PropertyGroup").Single()
        properties.SetElementValue("GsharpToolFullPath", typeof(BuildTask).Assembly.Location)
        properties.SetElementValue("GsharpCompilerFullPath", compiler)
        properties.SetElementValue("FrameworkReferences", Path.Combine(pack, "ref", "net10.0", "*.dll"))
        root
            .Elements("Import")
            .Single()
            .SetAttributeValue("Project", Path.Combine(RepoRoot.SdkSourceDir, "build", "Gsharp.NET.Core.Sdk.targets"))
        let projectPath = Path.Combine(directory, "Probe.proj")
        if !File.Exists(projectPath) {
            document.Save(projectPath)
        }
        let start = ProcessStartInfo("dotnet"){
            WorkingDirectory = directory,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            UseShellExecute = false
        }
        for argument in[]string{
            "msbuild",
            "Probe.proj",
            "-nologo",
            "-nr:false",
            "-v:minimal",
            "-p:IsTestProject=$isTestProject",
            "-p:GenerateProgramFile=$generateProgramFile",
            "-p:OutputType=$outputType"
        } {
            start.ArgumentList.Add(argument)
        }
        using let process = Process.Start(start) ?? throw InvalidOperationException("Cannot start the probe build.")
        using let outputDeadline = CancellationTokenSource(TimeSpan.FromSeconds(120))
        let stdout = process.StandardOutput.ReadToEndAsync(outputDeadline.Token)
        let stderr = process.StandardError.ReadToEndAsync(outputDeadline.Token)
        if !process.WaitForExit(120000) {
            process.Kill(entireProcessTree: true)
            process.WaitForExit()
            throw TimeoutException("The probe build timed out.")
        }
        Task.WaitAll(stdout, stderr)
        return (process.ExitCode, stdout.Result + stderr.Result)
    }

    shared {
        private const Project string = `<Project DefaultTargets="CoreCompile">
  <PropertyGroup>
    <IntermediateOutputPath>obj/</IntermediateOutputPath>
    <TargetName>Probe</TargetName>
    <TargetFramework>net10.0</TargetFramework>
    <GSharpUseSharedCompilation>false</GSharpUseSharedCompilation>
    <GSharpWorkerGrant>1</GSharpWorkerGrant>
    <GsharpRunSourceGenerators>false</GsharpRunSourceGenerators>
  </PropertyGroup>
  <Import Project="placeholder" />
  <ItemGroup>
    <Compile Include="*.gs" />
    <ReferencePathWithRefAssemblies Include="$(FrameworkReferences)" />
    <IntermediateAssembly Include="obj/Probe.dll" />
  </ItemGroup>
  <Target Name="_GsharpResolveAnalyzers" />
  <Target Name="ResolveReferences" />
  <Target Name="_ComputeNonExistentFileProperty" />
</Project>`
    }
}
