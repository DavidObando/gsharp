    <ProjectReference Include="@(GsharpRepl-&gt;'%(RootDir)%(Directory)%(Filename).gsproj')" />
    <ProjectReference Include="..\..\src\Sdk\Gsharp.Extensions\Gsharp.Extensions.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\Shared\Issue3081CompositeLiteralCases.gs" Link="Issue3081CompositeLiteralCases.cs" />
    <Compile Include="..\Shared\Issue3785MixedInitializerCases.gs" Link="Issue3785MixedInitializerCases.cs" />
    <Compile Include="..\Shared\EmittedOracle.gs" Link="EmittedOracle.cs" />
    <Compile Include="..\Shared\EmittedOracleOptions.gs" Link="EmittedOracleOptions.cs" />
    <Compile Include="..\Shared\EmittedOracleResult.gs" Link="EmittedOracleResult.cs" />
    <ProjectReference Include="../../test-assets/Issue3119.CrossConstants/Issue3119.CrossConstants.gsproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
