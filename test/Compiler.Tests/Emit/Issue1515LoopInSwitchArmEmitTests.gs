package GSharp.Compiler.Tests.Emit

import GSharp.Compiler
import GSharp.Compiler.Tests
import System
import System.Diagnostics
import System.IO
import Xunit

/// Issue #1515 — a loop (`for … in …` or C-style `for …; …; …`) placed
/// inside a `switch`-statement arm body crashed IL emission with
/// `GS9998: KeyNotFoundException` for a loop-generated branch label
/// (`Label1`, `check1`, …).
///
/// Root cause: `MethodBodyPlanner.CollectStatements` — the label/local
/// pre-pass that `il.DefineLabel()`s every label and allocates nested
/// locals — recursed into `scope`/`fixed`/`select`/`try`/
/// block bodies but had NO `BoundPatternSwitchStatement` case, so it never
/// descended into pattern-switch arm bodies. Labels generated by loop lowering
/// inside an arm were therefore never registered, and the later
/// `this.labels[target]` lookup in `EmitPatternSwitchStatement` threw.
///
/// The fix adds a `BoundPatternSwitchStatement` case to
/// `CollectStatements` in BOTH passes (mirroring the existing
/// `BoundTryStatement` handling) so every arm
/// body is recursed and every nested label/local-generating construct — at any
/// depth — is planned. Because the recursion re-uses `CollectStatements`,
/// it generalizes to nested switches, arms inside arms, `try`/`finally`,
/// `while`/`do-while`, `scope`, `fixed`, `select`, etc.
///
/// Each test uses a UNIQUE package name because the in-process
/// `FunctionTypeSymbol` cache is name-keyed and shared across the process.
open class Issue1515LoopInSwitchArmEmitTests {
    @Fact
    func EndToEnd_ForIn_InConstantSwitchArm_VerifiesAndRuns() {
        // Repro A from the issue: `for … in` inside a constant `case 1` arm.
        const source = `package Issue1515ForInArm
import System
func describe(n int32, xs []int32) {
    switch n {
        case 1 {
            for x in xs { Console.WriteLine(x) }
        }
    }
}
func Main() { describe(1, []int32{1, 2, 3}) }`
        let output = CompileAndRun(source)
        Assert.Equal("1${Environment.NewLine}2${Environment.NewLine}3${Environment.NewLine}", output)
    }

    @Fact
    func EndToEnd_CStyleFor_InConstantSwitchArm_WithDefault_VerifiesAndRuns() {
        // Repro B from the issue: C-style `for` inside a `case 1` arm alongside a
        // `default` arm.
        const source = `package Issue1515ForCArm
import System
func describe(n int32) {
    switch n {
        case 1 {
            for var i = 0; i < 3; i = i + 1 { Console.WriteLine(i) }
        }
        default { Console.WriteLine("other") }
    }
}
func Main() { describe(1) }`
        let output = CompileAndRun(source)
        Assert.Equal("0${Environment.NewLine}1${Environment.NewLine}2${Environment.NewLine}", output)
    }

    @Fact
    func EndToEnd_ForIn_InPatternSwitchArm_VerifiesAndRuns() {
        // Proves the bug is NOT pattern-specific: a loop inside a slice-pattern
        // arm (`case [1, _, 3]`) must also plan its labels.
        const source = `package Issue1515PatternArm
import System
func describe(xs []int32) {
    switch xs {
        case [1, _, 3] {
            for x in xs { Console.WriteLine(x) }
        }
        default { Console.WriteLine("no-match") }
    }
}
func Main() { describe([]int32{1, 2, 3}) }`
        let output = CompileAndRun(source)
        Assert.Equal("1${Environment.NewLine}2${Environment.NewLine}3${Environment.NewLine}", output)
    }

    @Fact
    func EndToEnd_ForIn_InArmNestedInsideAnotherArm_VerifiesAndRuns() {
        // Generalized case: a loop inside an arm that is itself inside another
        // arm — the recursion must descend to arbitrary depth.
        const source = `package Issue1515NestedArm
import System
func describe(n int32, m int32, xs []int32) {
    switch n {
        case 1 {
            switch m {
                case 2 {
                    for x in xs { Console.WriteLine(x) }
                }
                default { Console.WriteLine("inner-default") }
            }
        }
        default { Console.WriteLine("outer-default") }
    }
}
func Main() { describe(1, 2, []int32{7, 8, 9}) }`
        let output = CompileAndRun(source)
        Assert.Equal("7${Environment.NewLine}8${Environment.NewLine}9${Environment.NewLine}", output)
    }

    @Fact
    func EndToEnd_TryWhile_InSwitchArm_VerifiesAndRuns() {
        // Generalized case: a `while` loop whose body contains a `try`/`finally`
        // inside a switch arm exercises loop labels AND try leave-target labels
        // planned through the arm-body recursion.
        const source = `package Issue1515TryWhileArm
import System
func describe(n int32) {
    switch n {
        case 1 {
            var i = 0
            while i < 3 {
                try {
                    Console.WriteLine(i)
                } finally {
                    i = i + 1
                }
            }
        }
    }
}
func Main() { describe(1) }`
        let output = CompileAndRun(source)
        Assert.Equal("0${Environment.NewLine}1${Environment.NewLine}2${Environment.NewLine}", output)
    }

    shared {
        private func CompileAndRun(source string) string {
            let tempDir = Directory.CreateTempSubdirectory("gs_1515_exe_").FullName
            try {
                let srcPath = Path.Combine(tempDir, "test.gs")
                let dllPath = Path.Combine(tempDir, "test.dll")
                File.WriteAllText(srcPath, source)
                let args = []string{"/out:" + dllPath, "/target:exe", "/targetframework:net10.0", srcPath}
                using let stdoutWriter = StringWriter()
                using let stderrWriter = StringWriter()
                let prevOut = Console.Out
                let prevErr = Console.Error
                Console.SetOut(stdoutWriter)
                Console.SetError(stderrWriter)
                var compileExit int32
                try {
                    compileExit = Program.Main(args)
                } finally {
                    Console.SetOut(prevOut)
                    Console.SetError(prevErr)
                }
                Assert.True(compileExit == 0, (`gsc failed:
stdout:
` + "$stdoutWriter" + `
stderr:
` + "$stderrWriter"))
                IlVerifier.Verify(dllPath)
                let rtConfig = Path.ChangeExtension(dllPath, ".runtimeconfig.json")
                if !File.Exists(rtConfig) {
                    File.WriteAllText(rtConfig, `{
  "runtimeOptions": {
    "tfm": "net10.0",
    "framework": { "name": "Microsoft.NETCore.App", "version": "10.0.0" }
  }
}`)
                }
                let psi = ProcessStartInfo("dotnet"){
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    WorkingDirectory = tempDir
                }
                psi.ArgumentList.Add("exec")
                psi.ArgumentList.Add("--runtimeconfig")
                psi.ArgumentList.Add(rtConfig)
                psi.ArgumentList.Add(dllPath)
                using let proc = Process.Start(psi) ?? throw InvalidOperationException("Failed to start dotnet exec")
                let stdout = proc.StandardOutput.ReadToEnd()
                let stderr = proc.StandardError.ReadToEnd()
                Assert.True(proc.WaitForExit(30_000), "dotnet exec timed out")
                Assert.True(proc.ExitCode == 0, (`exited ` + "${proc.ExitCode}" + `
stdout:
` + "$stdout" + `
stderr:
` + "$stderr"))
                return stdout.ReplaceLineEndings(Environment.NewLine)
            } finally {
                try {
                    Directory.Delete(tempDir, recursive: true)
                } catch { }
            }
        }
    }
}
