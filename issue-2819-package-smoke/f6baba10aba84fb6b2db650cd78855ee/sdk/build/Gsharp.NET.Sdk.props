<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Language>Gsharp</Language>
    <TargetRuntime>Managed</TargetRuntime>
    <WarningLevel>4</WarningLevel>
    <GSharpUseSharedCompilation Condition=" '$(GSharpUseSharedCompilation)' == '' ">false</GSharpUseSharedCompilation>
    <GSharpWorkerGrant Condition=" '$(GSharpWorkerGrant)' == '' ">1</GSharpWorkerGrant>
    <!-- One per-request MSBuild grant bounds all cooperating compiler phases. -->
    <GSharpMaxWorkers Condition=" '$(GSharpMaxWorkers)'=='' ">1</GSharpMaxWorkers>
    <GSharpWorkerMemoryBudgetMiB Condition=" '$(GSharpWorkerMemoryBudgetMiB)'=='' ">1024</GSharpWorkerMemoryBudgetMiB>

    <!-- Resolve gsc and the build task. In a packed Gsharp.NET.Sdk NuGet these
         sit alongside this .props in ../tools/. -->
    <GsharpToolFullPath Condition=" '$(GsharpToolFullPath)'=='' ">$(MSBuildThisFileDirectory)..\tools\task\Gsharp.NET.Sdk.dll</GsharpToolFullPath>
    <_GsharpDefaultCompilerPath>$(MSBuildThisFileDirectory)..\tools\compiler\gsc.dll</_GsharpDefaultCompilerPath>
    <GsharpCompilerFullPath Condition=" '$(GsharpCompilerFullPath)'=='' ">$(MSBuildThisFileDirectory)..\tools\compiler\gsc.dll</GsharpCompilerFullPath>
    <GsharpFormatterFullPath Condition=" '$(GsharpFormatterFullPath)'=='' ">$(MSBuildThisFileDirectory)..\tools\formatter\gsfmt.dll</GsharpFormatterFullPath>

    <!-- ADR-0207: the SDK package tools folder. gsc uses it to find gsgen and the portable runtime
         files (channels/, values/, extensions/) when it runs from the RID compiler package. -->
    <GsharpSdkToolsDirectory Condition=" '$(GsharpSdkToolsDirectory)'=='' ">$(MSBuildThisFileDirectory)..\tools\</GsharpSdkToolsDirectory>

    <!-- ADR-0207: ReadyToRun compiler packages (Gsharp.NET.Sdk.Compiler.<rid>). The SDK version
         is the name of the package folder. A name that is not a version (an unpacked layout)
         disables the packages. -->
    <_GsharpSdkVersionCandidate>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))))</_GsharpSdkVersionCandidate>
    <GsharpSdkVersion Condition=" '$(GsharpSdkVersion)'=='' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GsharpSdkVersionCandidate)', '^[0-9]+\.[0-9]+\.[0-9]+')) ">$(_GsharpSdkVersionCandidate)</GsharpSdkVersion>
    <GsharpCompilerPackRuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</GsharpCompilerPackRuntimeIdentifiers>
    <GsharpCompilerPackTargetFramework>net10.0</GsharpCompilerPackTargetFramework>
    <!-- The RID of the host process that runs MSBuild, and so starts gsc (DOTNET_HOST_PATH).
         The exact value must be in the list. The restore and the build use the same rule.
         .NET Framework MSBuild (Visual Studio) has no such property, so the lookup runs only on .NET MSBuild. -->
    <_GsharpHostRid Condition=" '$(MSBuildRuntimeType)' == 'Core' ">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</_GsharpHostRid>
    <_GsharpCompilerPackWanted Condition=" '$(GsharpUseReadyToRunCompiler)' != 'false' and '$(GsharpSdkVersion)' != '' and '$(MSBuildRuntimeType)' == 'Core' and '$(DOTNET_HOST_PATH)' != '' and $([System.String]::Copy(';$(GsharpCompilerPackRuntimeIdentifiers);').Contains(';$(_GsharpHostRid);')) ">true</_GsharpCompilerPackWanted>

    <!-- ADR-0145 §E/§F: the gsgen source-generator host. In a packed
         Gsharp.NET.Sdk NuGet it sits alongside this .props under
         ../tools/gsgen/, next to task/ and compiler/. -->
    <GsgenToolFullPath Condition=" '$(GsgenToolFullPath)'=='' ">$(MSBuildThisFileDirectory)..\tools\gsgen\gsgen.dll</GsgenToolFullPath>

    <!-- Runtime-side delta compiler/agent used by Debug net10.0 projects
         launched through dotnet watch. -->
    <GsharpHotReloadRuntimeAssemblyFullPath Condition=" '$(GsharpHotReloadRuntimeAssemblyFullPath)'=='' ">$(MSBuildThisFileDirectory)..\tools\hotreload\Gsharp.HotReload.Runtime.dll</GsharpHotReloadRuntimeAssemblyFullPath>

    <!-- Selects the analyzers/dotnet/roslynX.Y/cs/ asset folder NuGet's
         ResolvePackageAssets picks when we re-resolve C# analyzers for gsgen
         (see _GsharpResolveAnalyzers). Because the SDK sets Language=Gsharp,
         the normal ResolvePackageAssets run never selects C# analyzer assets,
         so we re-invoke it with ProjectLanguage=C# + this CompilerApiVersion.
         roslyn4.8 is a safe, widely-shipped floor: most generator packages ship
         a roslyn4.x asset folder <= 4.8, and the gsgen host (Microsoft.CodeAnalysis
         5.6.0) forward-loads those 4.x analyzers via assembly unification.
         NOTE: this may need bumping if a package only ships higher roslynX.Y
         folders; the gsgen e2e validates the resolved set. -->
    <GsharpCompilerApiVersion Condition=" '$(GsharpCompilerApiVersion)'=='' ">roslyn4.8</GsharpCompilerApiVersion>

    <!-- Master switch to skip the gsgen source-generator pass entirely. -->
    <GsharpRunSourceGenerators Condition=" '$(GsharpRunSourceGenerators)'=='' ">true</GsharpRunSourceGenerators>

    <!-- ADR-0082 / issue #722. The Gsharp.Extensions assembly ships inside this
         SDK NuGet under tools/extensions/. We auto-reference it from every
         consumer .gsproj so an `import Gsharp.Extensions.Go` (this PR),
         `import Gsharp.Extensions.Optional` / `.Sequences` (#724), or any
         future Gsharp.Extensions.* sub-namespace resolves without the user
         adding a <PackageReference>. The import keyword is the user-visible
         opt-in; the reference is an SDK-private implementation detail. -->
    <GsharpExtensionsAssemblyFullPath Condition=" '$(GsharpExtensionsAssemblyFullPath)'=='' ">$(MSBuildThisFileDirectory)..\tools\extensions\Gsharp.Extensions.dll</GsharpExtensionsAssemblyFullPath>

    <!-- ADR-0174 D1. The G#-owned channel runtime (Gsharp.Concurrency.Chan<T>,
         ChannelOps, Context, ...) ships inside this SDK NuGet under
         tools/channels/. Emitted programs reference it whenever they
         construct a channel, so it is auto-referenced like Gsharp.Extensions;
         it is only loaded by programs that actually use channels. -->
    <GsharpChannelsRuntimeAssemblyFullPath Condition=" '$(GsharpChannelsRuntimeAssemblyFullPath)'=='' ">$(MSBuildThisFileDirectory)..\tools\channels\Gsharp.Runtime.Channels.dll</GsharpChannelsRuntimeAssemblyFullPath>
    <GsharpValuesRuntimeAssemblyFullPath Condition=" '$(GsharpValuesRuntimeAssemblyFullPath)'=='' ">$(MSBuildThisFileDirectory)..\tools\values\Gsharp.Runtime.Values.dll</GsharpValuesRuntimeAssemblyFullPath>

    <!-- Pull in the gsharp language targets (CoreCompile override). -->
    <LanguageTargets>$(MSBuildThisFileDirectory)Gsharp.NET.Current.Sdk.targets</LanguageTargets>
  </PropertyGroup>

  <!-- ADR-0082: thread the bundled Gsharp.Extensions assembly into the
       reference set the build task forwards to gsc. _ExplicitReference is the
       same path used for mscorlib in Gsharp.NET.Core.Sdk.targets, so the
       assembly participates in the ResolveAssemblyReference closure the same
       way (and consequently shows up under @(ReferencePathWithRefAssemblies)
       that BuildTask sends via /r:). -->
  <ItemGroup Condition=" '$(GsharpNoExtensions)' != 'true' and Exists('$(GsharpExtensionsAssemblyFullPath)') ">
    <_ExplicitReference Include="$(GsharpExtensionsAssemblyFullPath)" />
  </ItemGroup>

  <!-- ADR-0174 D1: same channel for the channel runtime. -->
  <ItemGroup Condition=" '$(GsharpNoChannelsRuntime)' != 'true' and Exists('$(GsharpChannelsRuntimeAssemblyFullPath)') ">
    <_ExplicitReference Include="$(GsharpChannelsRuntimeAssemblyFullPath)" />
  </ItemGroup>
  <ItemGroup Condition=" '$(GsharpNoValuesRuntime)' != 'true' and Exists('$(GsharpValuesRuntimeAssemblyFullPath)') ">
    <_ExplicitReference Include="$(GsharpValuesRuntimeAssemblyFullPath)" />
  </ItemGroup>


  <!-- ADR-0207: the known ReadyToRun compiler pack, in the shape of KnownCrossgen2Pack in the .NET SDK.
       The PackageDownload is for the host RID only, with an exact version. A host outside the list
       gets no PackageDownload, so restore never asks for a package that does not exist. -->
  <ItemGroup>
    <KnownGsharpCompilerPack Include="Gsharp.NET.Sdk.Compiler"
                             TargetFramework="$(GsharpCompilerPackTargetFramework)"
                             GsharpCompilerPackNamePattern="Gsharp.NET.Sdk.Compiler.**RID**"
                             GsharpCompilerPackVersion="$(GsharpSdkVersion)"
                             GsharpCompilerRuntimeIdentifiers="$(GsharpCompilerPackRuntimeIdentifiers)" />
    <PackageDownload Include="Gsharp.NET.Sdk.Compiler.$(_GsharpHostRid)"
                     Version="[$(GsharpSdkVersion)]"
                     Condition=" '$(_GsharpCompilerPackWanted)' == 'true' and '$(GsharpUseReadyToRunCompiler)' != 'false' " />
  </ItemGroup>

</Project>
